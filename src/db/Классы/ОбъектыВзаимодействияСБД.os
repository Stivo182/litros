#Использовать entity
#Использовать "../../dto"

&Деталька(Значение = "litros.ПутьКБД", ЗначениеПоУмолчанию = "./litros.db") 
Перем _ПутьКБД; // Строка

#Область ОбработчикиСобытий

&Дуб
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Создает и инициализирует менеджер сущностей для базы данных приложения.
//
// Параметры:
//   Настройки - НастройкиОтказоустойчивостиБД, Неопределено - Настройки соединения с SQLite.
//
// Возвращаемое значение:
//   МенеджерСущностей - Инициализированный менеджер сущностей.
&Завязь(Значение = "ВнутреннийМенеджерСущностей", Тип = "МенеджерСущностей")
Функция ВнутреннийМенеджерСущностей(
	&Пластилин("НастройкиОтказоустойчивостиБД") Настройки) Экспорт

	СтрокаСоединения = СтрокаСоединенияSQLite(Настройки);

	МенеджерСущностей = Новый МенеджерСущностей(Тип("КоннекторSQLite"), СтрокаСоединения);
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("СущностьОчередьПакета"));
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("СущностьСтатистикаПакета"));
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("СущностьЗависимыйРепозиторий"));
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("СущностьРепозиторий"));

	Попытка
		МенеджерСущностей.Инициализировать();
	Исключение
		ВызватьИсключение ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат МенеджерСущностей;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СтрокаСоединенияSQLite(Настройки)

	ТаймаутЗанятостиМс = Настройки.ТаймаутЗанятостиМс;
	ПроверитьТаймаутЗанятости(ТаймаутЗанятостиМс);
	РежимЖурнала = ?(Настройки.ИспользоватьWAL, "Wal", "Delete");

	Возврат СтрШаблон(
		"DataSource=%1;DefaultTimeout=0;BusyTimeout=%2;JournalMode=%3;",
		_ПутьКБД,
		Формат(ТаймаутЗанятостиМс, "ЧН=0; ЧГ="),
		РежимЖурнала);

КонецФункции

Процедура ПроверитьТаймаутЗанятости(ТаймаутЗанятостиМс)

	Если ТипЗнч(ТаймаутЗанятостиМс) <> Тип("Число") Тогда
		ВызватьИсключение
			"Настройка litros.db.ТаймаутЗанятостиМс должна быть целым числом от 0 до 2147483647";
	КонецЕсли;

	Если Цел(ТаймаутЗанятостиМс) <> ТаймаутЗанятостиМс
		Или ТаймаутЗанятостиМс < 0
		Или ТаймаутЗанятостиМс > 2147483647 Тогда

		ВызватьИсключение
			"Настройка litros.db.ТаймаутЗанятостиМс должна быть целым числом от 0 до 2147483647";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
