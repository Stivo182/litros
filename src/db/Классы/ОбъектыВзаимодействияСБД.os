#Использовать entity
#Использовать "../../dto"

&Деталька(Значение = "litros.ПутьКБД", ЗначениеПоУмолчанию = "./litros.db") 
Перем _ПутьКБД; // Строка

#Область ОбработчикиСобытий

&Дуб
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Создает компанейский пул независимых менеджеров SQLite.
//
// Параметры:
//   Настройки - НастройкиПулаМенеджеровСущностей - Настройки пула.
//   Лог - Лог - Лог пула.
//
// Возвращаемое значение:
//   ПулМенеджеровСущностей - Готовый пул.
&Завязь(Значение = "ПулМенеджеровСущностей", Тип = "ПулМенеджеровСущностей")
&Характер("Компанейский")
Функция ПулМенеджеровСущностей(
	&Пластилин("НастройкиПулаМенеджеровСущностей") Настройки,
	&Лог("litros.ПулМенеджеровСущностей") Лог) Экспорт

	Менеджеры = СоздатьМенеджерыПула(Настройки);
	Попытка
		Возврат Новый ПулМенеджеровСущностей(
			Менеджеры.Писатели, Менеджеры.Читатели, Настройки, Лог);
	Исключение
		ИсходнаяОшибка = ИнформацияОбОшибке();
		ЗакрытьМенеджеры(Менеджеры.Писатели);
		ЗакрытьМенеджеры(Менеджеры.Читатели);
		ВызватьИсключение ИсходнаяОшибка;
	КонецПопытки;

КонецФункции

Функция СоздатьМенеджерыПула(Настройки)

	BootstrapМенеджер = Неопределено;
	ОшибкаBootstrap = Неопределено;
	Попытка
		BootstrapМенеджер = СоздатьМенеджерЗаписи(Настройки);
		BootstrapМенеджер.Инициализировать();
		BootstrapМенеджер.ПолучитьКоннектор().ВыполнитьЗапрос(СтрокаРежимаЖурнала(Настройки));
	Исключение
		ОшибкаBootstrap = ИнформацияОбОшибке();
	КонецПопытки;

	Если BootstrapМенеджер <> Неопределено Тогда
		Попытка
			BootstrapМенеджер.Закрыть();
		Исключение
			Если ОшибкаBootstrap = Неопределено Тогда
				ОшибкаBootstrap = ИнформацияОбОшибке();
			КонецЕсли;
		КонецПопытки;
	КонецЕсли;

	Если ОшибкаBootstrap <> Неопределено Тогда
		ВызватьИсключение ОшибкаBootstrap;
	КонецЕсли;

	КоличествоПроцессоров = (Новый СистемнаяИнформация()).КоличествоПроцессоров;
	КоличествоПисателей = Настройки.РассчитатьКоличествоПисателей(КоличествоПроцессоров);
	КоличествоЧитателей = Настройки.РассчитатьКоличествоЧитателей(КоличествоПроцессоров);
	Писатели = Новый Массив();
	Читатели = Новый Массив();

	Попытка
		Для НомерМенеджера = 1 По КоличествоПисателей Цикл
			МенеджерЗаписи = СоздатьМенеджерЗаписи(Настройки);
			Писатели.Добавить(МенеджерЗаписи);
			МенеджерЗаписи.Инициализировать();
		КонецЦикла;
		Для НомерМенеджера = 1 По КоличествоЧитателей Цикл
			МенеджерЧтения = СоздатьМенеджерЧтения(Настройки);
			Читатели.Добавить(МенеджерЧтения);
			МенеджерЧтения.Инициализировать();
		КонецЦикла;
	Исключение
		ИсходнаяОшибка = ИнформацияОбОшибке();
		ЗакрытьМенеджеры(Писатели);
		ЗакрытьМенеджеры(Читатели);
		ВызватьИсключение ИсходнаяОшибка;
	КонецПопытки;

	Возврат Новый Структура("Писатели,Читатели", Писатели, Читатели);

КонецФункции

// Создает менеджер с разрешенной записью.
Функция СоздатьМенеджерЗаписи(Настройки) Экспорт

	МенеджерСущностей = Новый МенеджерСущностей(
		Тип("КоннекторSQLite"), СтрокаСоединенияЗаписиSQLite(Настройки));
	ДобавитьМодель(МенеджерСущностей);

	Возврат МенеджерСущностей;

КонецФункции

// Создает менеджер с физически запрещенной записью.
Функция СоздатьМенеджерЧтения(Настройки) Экспорт

	МенеджерСущностей = Новый МенеджерСущностей(
		Тип("КоннекторSQLite"), СтрокаСоединенияЧтенияSQLite(Настройки));
	ДобавитьМодель(МенеджерСущностей);

	Возврат МенеджерСущностей;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьМодель(МенеджерСущностей)

	МенеджерСущностей.ДобавитьКлассВМодель(Тип("СущностьОчередьПакета"));
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("СущностьСтатистикаПакета"));
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("СущностьЗависимыйРепозиторий"));
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("СущностьРепозиторий"));

КонецПроцедуры

Функция СтрокаСоединенияЗаписиSQLite(Настройки)

	ТаймаутЗанятостиМс = Настройки.ТаймаутЗанятостиМс;

	Возврат СтрШаблон(
		"DataSource=%1;DefaultTimeout=0;BusyTimeout=%2;",
		_ПутьКБД,
		Формат(ТаймаутЗанятостиМс, "ЧН=0; ЧГ="));

КонецФункции

Функция СтрокаСоединенияЧтенияSQLite(Настройки)

	Путь = СтрЗаменить((Новый Файл(_ПутьКБД)).ПолноеИмя, "\", "/");
	Возврат СтрШаблон(
		"FullUri=file:///%1?mode=ro;DefaultTimeout=0;BusyTimeout=%2;",
		Путь,
		Формат(Настройки.ТаймаутЗанятостиМс, "ЧН=0; ЧГ="));

КонецФункции

Функция СтрокаРежимаЖурнала(Настройки)

	Возврат ?(Настройки.ИспользоватьWAL,
		"PRAGMA journal_mode=WAL;",
		"PRAGMA journal_mode=DELETE;");

КонецФункции

Процедура ЗакрытьМенеджеры(Менеджеры)

	Для Каждого Менеджер Из Менеджеры Цикл
		Попытка
			Менеджер.Закрыть();
		Исключение
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
