#Использовать reflector

Перем _Настройки; // НастройкиПулаМенеджеровСущностей
Перем _СлотыЧтения; // Массив
Перем _СлотыЗаписи; // Массив
Перем _СледующийЧитатель; // Число
Перем _СледующийПисатель; // Число
Перем _Блокировка; // БлокировкаРесурса
Перем _Статистика; // Структура
Перем _Состояние; // Строка
Перем _ЗакрытиеВыполняется; // Булево
Перем _Лог; // Лог, Неопределено

#Область ОбработчикиСобытий

// Создает пул независимых менеджеров чтения и записи.
//
// Параметры:
//   Писатели - Массив - Read-write менеджеры.
//   Читатели - Массив - Read-only менеджеры.
//   Настройки - НастройкиПулаМенеджеровСущностей - Настройки ожидания слота.
//   Лог - Лог - Лог пула.
Процедура ПриСозданииОбъекта(Писатели, Читатели, Настройки, Лог = Неопределено)

	_Настройки = Настройки;
	_СлотыЗаписи = СоздатьСлоты(Писатели);
	_СлотыЧтения = СоздатьСлоты(Читатели);
	_СледующийЧитатель = 0;
	_СледующийПисатель = 0;
	_Блокировка = Новый БлокировкаРесурса(ЭтотОбъект);
	_Статистика = СоздатьСтатистику();
	_Состояние = "Работает";
	_ЗакрытиеВыполняется = Ложь;
	_Лог = Лог;
	ЛогироватьЗапуск();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

Функция Получить(ТипСущности, ОпцииПоиска = Неопределено) Экспорт

	Параметры = Новый Массив();
	Параметры.Добавить(ТипСущности);
	Параметры.Добавить(ОпцииПоиска);
	Возврат ВыполнитьСоСлотом(
		"Чтение", Новый Действие(ЭтотОбъект, "ПолучитьИзМенеджера"), Параметры);

КонецФункции

Функция ПолучитьОдно(ТипСущности, ОпцииПоиска = Неопределено) Экспорт

	Параметры = Новый Массив();
	Параметры.Добавить(ТипСущности);
	Параметры.Добавить(ОпцииПоиска);
	Возврат ВыполнитьСоСлотом(
		"Чтение", Новый Действие(ЭтотОбъект, "ПолучитьОдноИзМенеджера"), Параметры);

КонецФункции

Процедура Сохранить(Сущность) Экспорт

	ВыполнитьСоСлотом(
		"Запись", Новый Действие(ЭтотОбъект, "СохранитьВМенеджере"), Сущность);

КонецПроцедуры

Процедура Удалить(Сущность) Экспорт

	ВыполнитьСоСлотом(
		"Запись", Новый Действие(ЭтотОбъект, "УдалитьИзМенеджера"), Сущность);

КонецПроцедуры

Функция ВыполнитьЗапрос(ТекстЗапроса) Экспорт

	ПроверитьЗапросТолькоДляЧтения(ТекстЗапроса);
	Возврат ВыполнитьСоСлотом(
		"Чтение", Новый Действие(ЭтотОбъект, "ВыполнитьЗапросВМенеджере"), ТекстЗапроса);

КонецФункции

Функция ВыполнитьВТранзакции(Операция, Параметры = Неопределено) Экспорт

	Если ТипЗнч(Операция) <> Тип("Действие") Тогда
		ВызватьИсключение "ВыполнитьВТранзакции принимает Действие";
	КонецЕсли;

	ЗарегистрироватьВызов("Транзакция");
	Попытка
		Слот = АрендоватьСлот("Запись");
	Исключение
		ЗарегистрироватьОшибку();
		ВызватьИсключение;
	КонецПопытки;
	Менеджер = Слот.Менеджер;
	МоментНачалаОперации = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ТранзакцияНачата = Ложь;
	ДоступКБД = Неопределено;
	Попытка
		Менеджер.НачатьТранзакцию();
		ТранзакцияНачата = Истина;
		ДоступКБД = Новый ТранзакционныйДоступКБД(Менеджер);
		Результат = ВызватьТранзакционнуюОперацию(Операция, Параметры, ДоступКБД);
		Менеджер.ЗафиксироватьТранзакцию();
	Исключение
		ИсходнаяОшибка = ИнформацияОбОшибке();
		ЗарегистрироватьЗавершение("Запись", МоментНачалаОперации, Истина);
		ОбработатьОшибкуТранзакции(
			Слот, Менеджер, ДоступКБД, ТранзакцияНачата, ИсходнаяОшибка);
	КонецПопытки;

	ДоступКБД.Деактивировать();
	ОсвободитьСлот(Слот);
	ЗарегистрироватьЗавершение("Запись", МоментНачалаОперации, Ложь);
	Возврат Результат;

КонецФункции

Функция ПолучитьСтатистику() Экспорт

	_Блокировка.Заблокировать();
	Попытка
		Читатели = СостояниеСлотов(_СлотыЧтения);
		Писатели = СостояниеСлотов(_СлотыЗаписи);
		Результат = Новый Структура();
		Результат.Вставить("Состояние", _Состояние);
		Результат.Вставить("НастроеноЧитателей", _СлотыЧтения.Количество());
		Результат.Вставить("ДоступноЧитателей", Читатели.Доступно);
		Результат.Вставить("ЗанятоЧитателей", Читатели.Занято);
		Результат.Вставить("СломаноЧитателей", Читатели.Сломано);
		Результат.Вставить("НастроеноПисателей", _СлотыЗаписи.Количество());
		Результат.Вставить("ДоступноПисателей", Писатели.Доступно);
		Результат.Вставить("ЗанятоПисателей", Писатели.Занято);
		Результат.Вставить("СломаноПисателей", Писатели.Сломано);
		Результат.Вставить("Ожидают", _Статистика.Ожидают);
		Результат.Вставить("МаксимумОжидающих", _Статистика.МаксимумОжидающих);
		Результат.Вставить("КоличествоЧтений", _Статистика.КоличествоЧтений);
		Результат.Вставить("КоличествоЗаписей", _Статистика.КоличествоЗаписей);
		Результат.Вставить("КоличествоТранзакций", _Статистика.КоличествоТранзакций);
		Результат.Вставить("КоличествоОшибок", _Статистика.КоличествоОшибок);
		Результат.Вставить("КоличествоФатальныхОшибокСлотов",
			_Статистика.КоличествоФатальныхОшибокСлотов);
		Результат.Вставить("СреднееОжиданиеМс", Среднее(
			_Статистика.СуммарноеОжиданиеМс, _Статистика.КоличествоАренд));
		Результат.Вставить("МаксимальноеОжиданиеМс", _Статистика.МаксимальноеОжиданиеМс);
		Результат.Вставить("СредняяДлительностьЧтенияМс", Среднее(
			_Статистика.СуммарнаяДлительностьЧтенияМс, _Статистика.КоличествоЗамеровЧтения));
		Результат.Вставить("СредняяДлительностьЗаписиМс", Среднее(
			_Статистика.СуммарнаяДлительностьЗаписиМс, _Статистика.КоличествоЗамеровЗаписи));
	Исключение
		_Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	_Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

Процедура Закрыть() Экспорт

	МоментЗавершения = ТекущаяУниверсальнаяДатаВМиллисекундах()
		+ _Настройки.МаксимальноеОжиданиеЗакрытияМс;
	Пока Не ПолучитьПравоНаЗакрытие(МоментЗавершения) Цикл
		РезультатОжидания = ДождатьсяЧужогоЗакрытия(МоментЗавершения);
		Если РезультатОжидания = "Закрыт" Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Пока Истина Цикл
		_Блокировка.Заблокировать();
		Если КоличествоАктивныхАренд() = 0 Тогда
			Слоты = ПолучитьВсеСлоты();
			_Блокировка.Разблокировать();
			Прервать;
		КонецЕсли;
		_Блокировка.Разблокировать();

		Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= МоментЗавершения Тогда
			_Блокировка.Заблокировать();
			_ЗакрытиеВыполняется = Ложь;
			_Блокировка.Разблокировать();
			ВызватьИсключение "Превышено максимальное ожидание закрытия пула менеджеров сущностей";
		КонецЕсли;
		Приостановить(5);
	КонецЦикла;

	ПерваяОшибка = ЗакрытьМенеджеры(Слоты);
	_Блокировка.Заблокировать();
	
	Если ПерваяОшибка = Неопределено Тогда
		_Состояние = "Закрыт";
	КонецЕсли;

	_ЗакрытиеВыполняется = Ложь;
	_Блокировка.Разблокировать();

	Если ПерваяОшибка <> Неопределено Тогда
		ВызватьИсключение ПерваяОшибка;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ПолучитьИзМенеджера(Менеджер, ТипСущности, ОпцииПоиска) Экспорт
	Возврат Менеджер.Получить(ТипСущности, ОпцииПоиска);
КонецФункции

Функция ПолучитьОдноИзМенеджера(Менеджер, ТипСущности, ОпцииПоиска) Экспорт
	Возврат Менеджер.ПолучитьОдно(ТипСущности, ОпцииПоиска);
КонецФункции

Функция СохранитьВМенеджере(Менеджер, Сущность) Экспорт
	Менеджер.Сохранить(Сущность);
	Возврат Неопределено;
КонецФункции

Функция УдалитьИзМенеджера(Менеджер, Сущность) Экспорт
	Менеджер.Удалить(Сущность);
	Возврат Неопределено;
КонецФункции

Функция ВыполнитьЗапросВМенеджере(Менеджер, ТекстЗапроса) Экспорт
	Возврат Менеджер.ПолучитьКоннектор().ВыполнитьЗапрос(ТекстЗапроса);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыполнитьСоСлотом(Роль, Операция, Параметры = Неопределено) Экспорт

	ЗарегистрироватьВызов(Роль);
	Попытка
		Слот = АрендоватьСлот(Роль);
	Исключение
		ЗарегистрироватьОшибку();
		ВызватьИсключение;
	КонецПопытки;
	МоментНачалаОперации = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Результат = ВызватьОперацию(Операция, Слот.Менеджер, Параметры);
	Исключение
		ИсходнаяОшибка = ИнформацияОбОшибке();
		ОсвободитьСлот(Слот);
		ЗарегистрироватьЗавершение(Роль, МоментНачалаОперации, Истина);
		ВызватьИсключение ИсходнаяОшибка;
	КонецПопытки;

	ОсвободитьСлот(Слот);
	ЗарегистрироватьЗавершение(Роль, МоментНачалаОперации, Ложь);
	Возврат Результат;

КонецФункции

Функция АрендоватьСлот(Роль)

	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	МоментЗавершения = МоментНачала
		+ _Настройки.МаксимальноеОжиданиеСлотаМс;
	ОжиданиеЗарегистрировано = Ложь;

	Попытка
		Пока Истина Цикл
			Слот = ПопытатьсяАрендоватьСлот(Роль);
			Если Слот <> Неопределено Тогда
				ОжиданиеЗарегистрировано = ЗавершитьОжиданиеАренды(ОжиданиеЗарегистрировано);
				ЗарегистрироватьАренду(
					ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала);
				Возврат Слот;
			КонецЕсли;

			ОжиданиеЗарегистрировано = НачатьОжиданиеАренды(ОжиданиеЗарегистрировано);
			ПроверитьТаймаутАренды(Роль, МоментЗавершения);
			Приостановить(5);
		КонецЦикла;
	Исключение
		ЗавершитьОжиданиеАренды(ОжиданиеЗарегистрировано);
		ВызватьИсключение;
	КонецПопытки;

КонецФункции

Функция ПопытатьсяАрендоватьСлот(Роль)

	_Блокировка.Заблокировать();

	Попытка
		ПроверитьСостояниеДляАренды();
		НачальныйИндекс = 0;
		Слоты = ПолучитьСлотыРоли(Роль, НачальныйИндекс);
		Индекс = -1;
		ЕстьИсправныеСлоты = Ложь;
		Результат = НайтиКандидатаНаАренду(
			Слоты, НачальныйИндекс, Индекс, ЕстьИсправныеСлоты);
		ПроверитьНаличиеИсправныхСлотов(ЕстьИсправныеСлоты, Роль);
		Если Результат <> Неопределено Тогда
			ЗарегистрироватьВыборСлота(
				Результат, Роль, Индекс, Слоты.Количество());
		КонецЕсли;
	Исключение
		_Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

Процедура ПроверитьСостояниеДляАренды()

	Если _Состояние <> "Работает" Тогда
		ВызватьИсключение СтрШаблон(
			"Пул менеджеров сущностей не принимает операции: состояние %1", _Состояние);
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьСлотыРоли(Роль, НачальныйИндекс)

	Если Роль = "Чтение" Тогда
		НачальныйИндекс = _СледующийЧитатель;
		Возврат _СлотыЧтения;
	КонецЕсли;

	НачальныйИндекс = _СледующийПисатель;
	Возврат _СлотыЗаписи;

КонецФункции

Функция НайтиКандидатаНаАренду(Слоты, НачальныйИндекс, ИндексКандидата, ЕстьИсправныеСлоты)

	ИндексКандидата = -1;
	ЕстьИсправныеСлоты = Ложь;
	Для Смещение = 0 По Слоты.ВГраница() Цикл
		Индекс = (НачальныйИндекс + Смещение) % Слоты.Количество();
		Кандидат = Слоты[Индекс];
		Если Кандидат.Сломан Тогда
			Продолжить;
		КонецЕсли;

		ЕстьИсправныеСлоты = Истина;
		Если Кандидат.Занят Тогда
			Продолжить;
		КонецЕсли;

		ИндексКандидата = Индекс;
		Возврат Кандидат;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Процедура ПроверитьНаличиеИсправныхСлотов(ЕстьИсправныеСлоты, Роль)

	Если Не ЕстьИсправныеСлоты Тогда
		ИмяРоли = ?(Роль = "Чтение", "чтения", "записи");
		ВызватьИсключение СтрШаблон("Пул %1 не имеет исправных слотов", ИмяРоли);
	КонецЕсли;

КонецПроцедуры

Процедура ЗарегистрироватьВыборСлота(Слот, Роль, Индекс, КоличествоСлотов)

	Слот.Занят = Истина;
	СледующийИндекс = (Индекс + 1) % КоличествоСлотов;
	Если Роль = "Чтение" Тогда
		_СледующийЧитатель = СледующийИндекс;
	Иначе
		_СледующийПисатель = СледующийИндекс;
	КонецЕсли;

КонецПроцедуры

Функция НачатьОжиданиеАренды(ОжиданиеЗарегистрировано)

	Если ОжиданиеЗарегистрировано Тогда
		Возврат Истина;
	КонецЕсли;

	НачатьОжидание();
	Возврат Истина;

КонецФункции

Функция ЗавершитьОжиданиеАренды(ОжиданиеЗарегистрировано)

	Если Не ОжиданиеЗарегистрировано Тогда
		Возврат Ложь;
	КонецЕсли;

	ЗавершитьОжидание();
	Возврат Ложь;

КонецФункции

Процедура ПроверитьТаймаутАренды(Роль, МоментЗавершения)

	Если ТекущаяУниверсальнаяДатаВМиллисекундах() >= МоментЗавершения Тогда
		РольВРодительномПадеже = ?(Роль = "Чтение", "чтения", "записи");
		ВызватьИсключение СтрШаблон("Пул %1 насыщен", РольВРодительномПадеже);
	КонецЕсли;

КонецПроцедуры

Процедура ОсвободитьСлот(Слот)

	_Блокировка.Заблокировать();
	Слот.Занят = Ложь;
	_Блокировка.Разблокировать();

КонецПроцедуры

Процедура ПометитьСлотСломанным(Слот)

	_Блокировка.Заблокировать();

	Если Не Слот.Сломан Тогда
		Слот.Сломан = Истина;
		_Статистика.КоличествоФатальныхОшибокСлотов
			= _Статистика.КоличествоФатальныхОшибокСлотов + 1;
	КонецЕсли;

	Слот.Занят = Ложь;
	_Блокировка.Разблокировать();

	Если _Лог <> Неопределено Тогда
		_Лог.Предупреждение("Слот менеджера сущностей %1 исключен; емкость пула снижена", Слот.Номер);
	КонецЕсли;

КонецПроцедуры

Функция СоздатьСлоты(Менеджеры)

	Результат = Новый Массив();
	Для Индекс = 0 По Менеджеры.ВГраница() Цикл
		Результат.Добавить(СоздатьСлот(Менеджеры[Индекс], Индекс + 1));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция СоздатьСлот(Менеджер, Номер)

	Слот = Новый Структура();
	Слот.Вставить("Менеджер", Менеджер);
	Слот.Вставить("Номер", Номер);
	Слот.Вставить("Занят", Ложь);
	Слот.Вставить("Сломан", Ложь);
	Слот.Вставить("Закрыт", Ложь);

	Возврат Слот;

КонецФункции

Функция ВызватьОперацию(Операция, Менеджер, Параметры)

	ПараметрыВызова = Новый Массив();
	ПараметрыВызова.Добавить(Менеджер);

	Если Параметры <> Неопределено Тогда
		Если ТипЗнч(Параметры) = Тип("Массив")
			Или ТипЗнч(Параметры) = Тип("ФиксированныйМассив") Тогда
			Для Каждого Параметр Из Параметры Цикл
				ПараметрыВызова.Добавить(Параметр);
			КонецЦикла;
		Иначе
			ПараметрыВызова.Добавить(Параметры);
		КонецЕсли;
	КонецЕсли;

	Возврат Новый Рефлектор().ВызватьМетод(Операция, "Выполнить", ПараметрыВызова);

КонецФункции

Функция ВызватьТранзакционнуюОперацию(Операция, Параметры, ДоступКБД)

	ПараметрыВызова = Новый Массив();
	ПараметрыВызова.Добавить(ДоступКБД);

	Если Параметры <> Неопределено Тогда
		Если ТипЗнч(Параметры) = Тип("Массив")
			Или ТипЗнч(Параметры) = Тип("ФиксированныйМассив") Тогда
			Для Каждого Параметр Из Параметры Цикл
				ПараметрыВызова.Добавить(Параметр);
			КонецЦикла;
		Иначе
			ПараметрыВызова.Добавить(Параметры);
		КонецЕсли;
	КонецЕсли;

	Возврат Новый Рефлектор().ВызватьМетод(Операция, "Выполнить", ПараметрыВызова);

КонецФункции

Процедура ОбработатьОшибкуТранзакции(
	Слот, Менеджер, ДоступКБД, ТранзакцияНачата, ИсходнаяОшибка)

	Если ДоступКБД <> Неопределено Тогда
		ДоступКБД.Деактивировать();
	КонецЕсли;

	Если Не ТранзакцияНачата Тогда
		ОсвободитьСлот(Слот);
		ВызватьИсключение ИсходнаяОшибка;
	КонецЕсли;

	Попытка
		Менеджер.ОтменитьТранзакцию();
	Исключение
		ОшибкаОтката = ИнформацияОбОшибке();
		ПометитьСлотСломанным(Слот);
		ВызватьИсключение СтрШаблон(
			"Ошибка транзакции:%1%2%1Ошибка отката транзакции:%1%3",
			Символы.ПС,
			ПодробноеПредставлениеОшибки(ИсходнаяОшибка),
			ПодробноеПредставлениеОшибки(ОшибкаОтката));
	КонецПопытки;

	ОсвободитьСлот(Слот);

	ВызватьИсключение ИсходнаяОшибка;

КонецПроцедуры

Процедура ПроверитьЗапросТолькоДляЧтения(ТекстЗапроса)

	Если ТипЗнч(ТекстЗапроса) <> Тип("Строка") Тогда
		ВызватьИсключение "ВыполнитьЗапрос принимает строку read-only SQL";
	КонецЕсли;

	Текст = ВРег(СокрЛП(ТекстЗапроса));
	КлючевоеСлово = "";
	Для Индекс = 1 По СтрДлина(Текст) Цикл

		Символ = Сред(Текст, Индекс, 1);
		Если СтрНайти("ABCDEFGHIJKLMNOPQRSTUVWXYZ", Символ) = 0 Тогда
			Прервать;
		КонецЕсли;

		КлючевоеСлово = КлючевоеСлово + Символ;

	КонецЦикла;

	Разрешенные = Новый Массив();
	Разрешенные.Добавить("SELECT");
	Разрешенные.Добавить("WITH");
	Разрешенные.Добавить("EXPLAIN");
	Разрешенные.Добавить("PRAGMA");

	Если Разрешенные.Найти(КлючевоеСлово) = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			"ВыполнитьЗапрос допускает только read-only SQL; команда %1 запрещена", КлючевоеСлово);
	КонецЕсли;

КонецПроцедуры

Функция СоздатьСтатистику()

	Результат = Новый Структура();
	Результат.Вставить("Ожидают", 0);
	Результат.Вставить("МаксимумОжидающих", 0);
	Результат.Вставить("КоличествоЧтений", 0);
	Результат.Вставить("КоличествоЗаписей", 0);
	Результат.Вставить("КоличествоТранзакций", 0);
	Результат.Вставить("КоличествоОшибок", 0);
	Результат.Вставить("КоличествоФатальныхОшибокСлотов", 0);
	Результат.Вставить("КоличествоАренд", 0);
	Результат.Вставить("СуммарноеОжиданиеМс", 0);
	Результат.Вставить("МаксимальноеОжиданиеМс", 0);
	Результат.Вставить("КоличествоЗамеровЧтения", 0);
	Результат.Вставить("СуммарнаяДлительностьЧтенияМс", 0);
	Результат.Вставить("КоличествоЗамеровЗаписи", 0);
	Результат.Вставить("СуммарнаяДлительностьЗаписиМс", 0);

	Возврат Результат;

КонецФункции

Процедура ЗарегистрироватьВызов(Роль)

	_Блокировка.Заблокировать();

	Если Роль = "Чтение" Тогда
		_Статистика.КоличествоЧтений = _Статистика.КоличествоЧтений + 1;
	ИначеЕсли Роль = "Запись" Тогда
		_Статистика.КоличествоЗаписей = _Статистика.КоличествоЗаписей + 1;
	Иначе
		_Статистика.КоличествоТранзакций = _Статистика.КоличествоТранзакций + 1;
	КонецЕсли;

	_Блокировка.Разблокировать();

КонецПроцедуры

Процедура ЗарегистрироватьОшибку()

	_Блокировка.Заблокировать();
	_Статистика.КоличествоОшибок = _Статистика.КоличествоОшибок + 1;
	_Блокировка.Разблокировать();

КонецПроцедуры

Процедура ЗарегистрироватьЗавершение(Роль, МоментНачала, СОшибкой)

	Длительность = Макс(0, ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала);

	_Блокировка.Заблокировать();

	Если Роль = "Чтение" Тогда
		_Статистика.КоличествоЗамеровЧтения = _Статистика.КоличествоЗамеровЧтения + 1;
		_Статистика.СуммарнаяДлительностьЧтенияМс
			= _Статистика.СуммарнаяДлительностьЧтенияМс + Длительность;
	Иначе
		_Статистика.КоличествоЗамеровЗаписи = _Статистика.КоличествоЗамеровЗаписи + 1;
		_Статистика.СуммарнаяДлительностьЗаписиМс
			= _Статистика.СуммарнаяДлительностьЗаписиМс + Длительность;
	КонецЕсли;

	Если СОшибкой Тогда
		_Статистика.КоличествоОшибок = _Статистика.КоличествоОшибок + 1;
	КонецЕсли;

	_Блокировка.Разблокировать();

КонецПроцедуры

Процедура НачатьОжидание()

	_Блокировка.Заблокировать();

	_Статистика.Ожидают = _Статистика.Ожидают + 1;
	_Статистика.МаксимумОжидающих = Макс(_Статистика.МаксимумОжидающих, _Статистика.Ожидают);

	_Блокировка.Разблокировать();

КонецПроцедуры

Процедура ЗавершитьОжидание()

	_Блокировка.Заблокировать();
	_Статистика.Ожидают = Макс(0, _Статистика.Ожидают - 1);
	_Блокировка.Разблокировать();

КонецПроцедуры

Процедура ЗарегистрироватьАренду(ОжиданиеМс)

	_Блокировка.Заблокировать();

	_Статистика.КоличествоАренд = _Статистика.КоличествоАренд + 1;
	_Статистика.СуммарноеОжиданиеМс = _Статистика.СуммарноеОжиданиеМс + ОжиданиеМс;
	_Статистика.МаксимальноеОжиданиеМс = Макс(_Статистика.МаксимальноеОжиданиеМс, ОжиданиеМс);

	_Блокировка.Разблокировать();

КонецПроцедуры

Функция СостояниеСлотов(Слоты)

	Результат = Новый Структура("Доступно,Занято,Сломано", 0, 0, 0);

	Для Каждого Слот Из Слоты Цикл
		Если Слот.Сломан Тогда
			Результат.Сломано = Результат.Сломано + 1;
		ИначеЕсли Слот.Занят Тогда
			Результат.Занято = Результат.Занято + 1;
		Иначе
			Результат.Доступно = Результат.Доступно + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Среднее(Сумма, Количество)
	Возврат ?(Количество = 0, 0, Сумма / Количество);
КонецФункции

Функция ПолучитьПравоНаЗакрытие(МоментЗавершения)

	_Блокировка.Заблокировать();

	Если _Состояние = "Работает" Тогда
		_Состояние = "Закрывается";
		_ЗакрытиеВыполняется = Истина;
		Результат = Истина;
	ИначеЕсли _Состояние = "Закрывается"
		И Не _ЗакрытиеВыполняется
		И ТекущаяУниверсальнаяДатаВМиллисекундах() < МоментЗавершения Тогда
		_ЗакрытиеВыполняется = Истина;
		Результат = Истина;
	Иначе
		Результат = Ложь;
	КонецЕсли;

	_Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

Функция ДождатьсяЧужогоЗакрытия(МоментЗавершения)

	Пока Истина Цикл

		_Блокировка.Заблокировать();
		ЗакрытиеЗавершено = _Состояние = "Закрыт" И Не _ЗакрытиеВыполняется;
		ПравоОсвобождено = _Состояние = "Закрывается" И Не _ЗакрытиеВыполняется;
		ВремяИстекло = ТекущаяУниверсальнаяДатаВМиллисекундах() >= МоментЗавершения;
		_Блокировка.Разблокировать();

		Если ЗакрытиеЗавершено Тогда
			Возврат "Закрыт";
		КонецЕсли;

		Если ВремяИстекло Тогда
			ВызватьИсключение "Превышено максимальное ожидание закрытия пула менеджеров сущностей";
		КонецЕсли;

		Если ПравоОсвобождено Тогда
			Возврат "Повторить";
		КонецЕсли;

		Приостановить(5);

	КонецЦикла;

КонецФункции

Функция КоличествоАктивныхАренд()

	Результат = 0;

	Для Каждого Слот Из _СлотыЧтения Цикл
		Если Слот.Занят Тогда
			Результат = Результат + 1;
		КонецЕсли;
	КонецЦикла;

	Для Каждого Слот Из _СлотыЗаписи Цикл
		Если Слот.Занят Тогда
			Результат = Результат + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПолучитьВсеСлоты()

	Результат = Новый Массив();

	Для Каждого Слот Из _СлотыЗаписи Цикл
		Результат.Добавить(Слот);
	КонецЦикла;

	Для Каждого Слот Из _СлотыЧтения Цикл
		Результат.Добавить(Слот);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЗакрытьМенеджеры(Слоты)

	ПерваяОшибка = Неопределено;
	Для Каждого Слот Из Слоты Цикл
		Если Слот.Закрыт Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Слот.Менеджер.Закрыть();
			Слот.Закрыт = Истина;
		Исключение
			Если ПерваяОшибка = Неопределено Тогда
				ПерваяОшибка = ИнформацияОбОшибке();
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;

	Возврат ПерваяОшибка;

КонецФункции

Процедура ЛогироватьЗапуск()

	Если _Лог = Неопределено Тогда
		Возврат;
	КонецЕсли;

	CPU = (Новый СистемнаяИнформация()).КоличествоПроцессоров;

	_Лог.Отладка(
		"Пулы SQLite запущены: CPU=%1 R=%2 W=%3 WAL=%4 busy_timeout=%5",
		CPU,
		_СлотыЧтения.Количество(),
		_СлотыЗаписи.Количество(),
		_Настройки.ИспользоватьWAL,
		_Настройки.ТаймаутЗанятостиМс);

КонецПроцедуры

#КонецОбласти
