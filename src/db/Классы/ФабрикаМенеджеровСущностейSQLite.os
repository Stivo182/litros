#Использовать entity
#Использовать autumn-logos
#Использовать "../../dto"
#Использовать "../../migrate"

&Деталька(Значение = "litros.ПутьКБД", ЗначениеПоУмолчанию = "./litros.db")
Перем _ПутьКБД; // Строка

&Лог("litros.ФабрикаМенеджеровСущностейSQLite")
Перем _Лог; // Лог

#Область ОбработчикиСобытий

&Дуб
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Собирает одиночный пул независимых менеджеров SQLite.
//
// Параметры:
//   Настройки - НастройкиПулаМенеджеровСущностей - Настройки пула.
//   Лог - Лог - Лог пула.
//
// Возвращаемое значение:
//   ПулМенеджеровСущностей - Готовый пул.
&Завязь(Значение = "ПулМенеджеровСущностей", Тип = "ПулМенеджеровСущностей")
&Характер("Одиночка")
Функция ПулМенеджеровСущностей(
	&Пластилин("НастройкиПулаМенеджеровСущностей") Настройки,
	&Лог("litros.ПулМенеджеровСущностей") Лог) Экспорт

	Попытка
		Менеджеры = СоздатьМенеджерыПула(Настройки);
	Исключение
		_Лог.Ошибка(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Менеджеры = Новый Структура("Писатели, Читатели", Новый Массив, Новый Массив);
	КонецПопытки;

	Попытка
		Возврат Новый ПулМенеджеровСущностей(
			Менеджеры.Писатели,
			Менеджеры.Читатели,
			Настройки,
			Лог
		);
	Исключение
		ИсходнаяОшибка = ИнформацияОбОшибке();
		ЗакрытьМенеджеры(Менеджеры.Писатели);
		ЗакрытьМенеджеры(Менеджеры.Читатели);
		ВызватьИсключение ИсходнаяОшибка;
	КонецПопытки;

КонецФункции

// Создает менеджер сущностей с разрешенной записью в SQLite.
//
// Параметры:
//   Настройки - НастройкиПулаМенеджеровСущностей - Настройки соединения с SQLite.
//   НомерСлота - Число - Номер слота записи для изоляции cache сущностей.
//
// Возвращаемое значение:
//   МенеджерСущностей - Менеджер рабочего слота записи.
Функция СоздатьМенеджерЗаписи(Настройки, НомерСлота = 1) Экспорт

	МенеджерСущностей = Новый МенеджерСущностей(
		Тип("КоннекторSQLite"),
		СтрокаСоединенияСлотаSQLite(Настройки, "rw", "writer", НомерСлота)
	);

	ДобавитьМодель(МенеджерСущностей);

	Возврат МенеджерСущностей;

КонецФункции

// Создает менеджер сущностей с физически запрещенной записью в SQLite.
//
// Параметры:
//   Настройки - НастройкиПулаМенеджеровСущностей - Настройки соединения с SQLite.
//   НомерСлота - Число - Номер слота чтения для изоляции cache сущностей.
//
// Возвращаемое значение:
//   МенеджерСущностей - Менеджер рабочего слота чтения.
Функция СоздатьМенеджерЧтения(Настройки, НомерСлота = 1) Экспорт

	МенеджерСущностей = Новый МенеджерСущностей(
		Тип("КоннекторSQLite"),
		СтрокаСоединенияСлотаSQLite(Настройки, "ro", "reader", НомерСлота)
	);

	ДобавитьМодель(МенеджерСущностей);

	Возврат МенеджерСущностей;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьМенеджерыПула(Настройки)

	КоличествоПроцессоров = Новый СистемнаяИнформация().КоличествоПроцессоров;
	КоличествоПисателей = Настройки.РассчитатьКоличествоПисателей(КоличествоПроцессоров);
	КоличествоЧитателей = Настройки.РассчитатьКоличествоЧитателей(КоличествоПроцессоров);

	ВыполнитьНачальнуюИнициализациюSQLite(Настройки);

	Писатели = Новый Массив();
	Читатели = Новый Массив();

	Попытка
		СоздатьМенеджерыЗаписиПула(Писатели, Настройки, КоличествоПисателей);
		СоздатьМенеджерыЧтенияПула(Читатели, Настройки, КоличествоЧитателей);
	Исключение
		ИсходнаяОшибка = ИнформацияОбОшибке();
		ЗакрытьМенеджеры(Писатели);
		ЗакрытьМенеджеры(Читатели);
		ВызватьИсключение ИсходнаяОшибка;
	КонецПопытки;

	Возврат Новый Структура("Писатели, Читатели", Писатели, Читатели);

КонецФункции

Процедура ВыполнитьНачальнуюИнициализациюSQLite(Настройки)

	ПредставлениеРежима = ?(Настройки.ИспользоватьWAL, "WAL", "DELETE");

	_Лог.Отладка(
		"Начальная инициализация SQLite: путь=%1 режим_журнала=%2",
		_ПутьКБД,
		ПредставлениеРежима
	);

	МенеджерНачальнойИнициализации = Неопределено;
	ОшибкаНачальнойИнициализации = Неопределено;

	Попытка
		НоваяБаза = ЭтоНоваяБазаSQLite(Настройки);
		МенеджерНачальнойИнициализации = СоздатьМенеджерНачальнойИнициализации(Настройки);
		МенеджерНачальнойИнициализации.Инициализировать();
		_Лог.Отладка("Схема SQLite инициализирована");

		Мигратор = Новый МиграторSQLite(МенеджерНачальнойИнициализации, НоваяБаза);
		Мигратор.Применить();

		РезультатУстановкиРежима = МенеджерНачальнойИнициализации
			.ПолучитьКоннектор()
			.ВыполнитьЗапрос(СтрокаРежимаЖурнала(Настройки));

		ПроверитьРежимЖурнала(РезультатУстановкиРежима, Настройки.ИспользоватьWAL);
		_Лог.Отладка("Режим журнала SQLite установлен: %1", ПредставлениеРежима);
	Исключение
		ОшибкаНачальнойИнициализации = ИнформацияОбОшибке();
	КонецПопытки;

	Если МенеджерНачальнойИнициализации <> Неопределено Тогда
		Попытка
			МенеджерНачальнойИнициализации.Закрыть();
		Исключение
			Если ОшибкаНачальнойИнициализации = Неопределено Тогда
				ОшибкаНачальнойИнициализации = ИнформацияОбОшибке();
			КонецЕсли;
		КонецПопытки;
	КонецЕсли;

	Если ОшибкаНачальнойИнициализации <> Неопределено Тогда
		ВызватьИсключение ОшибкаНачальнойИнициализации;
	КонецЕсли;

	_Лог.Отладка("Начальная инициализация SQLite завершена");

КонецПроцедуры

Функция ЭтоНоваяБазаSQLite(Настройки)

	МенеджерПроверки = Новый МенеджерСущностей(
		Тип("КоннекторSQLite"),
		СтрокаСоединенияНачальнойИнициализацииSQLite(Настройки)
	);

	Попытка
		МенеджерПроверки.Инициализировать();
		Таблицы = МенеджерПроверки.ПолучитьКоннектор().ВыполнитьЗапрос(
			"SELECT COUNT(*) AS Количество
			|FROM sqlite_master
			|WHERE type = 'table'
			|	AND name NOT LIKE 'sqlite_%';"
		);
		Результат = Таблицы.Количество() > 0 И Таблицы[0].Количество = 0;
	Исключение
		ИсходнаяОшибка = ИнформацияОбОшибке();
		Попытка
			МенеджерПроверки.Закрыть();
		Исключение
		КонецПопытки;
		ВызватьИсключение ИсходнаяОшибка;
	КонецПопытки;

	МенеджерПроверки.Закрыть();

	Возврат Результат;

КонецФункции

Процедура СоздатьМенеджерыЗаписиПула(Менеджеры, Настройки, КоличествоМенеджеров)

	Для НомерМенеджера = 1 По КоличествоМенеджеров Цикл
		Менеджер = СоздатьМенеджерЗаписи(Настройки, НомерМенеджера);
		Менеджеры.Добавить(Менеджер);
		Менеджер.Инициализировать();
	КонецЦикла;

КонецПроцедуры

Процедура СоздатьМенеджерыЧтенияПула(Менеджеры, Настройки, КоличествоМенеджеров)

	Для НомерМенеджера = 1 По КоличествоМенеджеров Цикл
		Менеджер = СоздатьМенеджерЧтения(Настройки, НомерМенеджера);
		Менеджеры.Добавить(Менеджер);
		Менеджер.Инициализировать();
	КонецЦикла;

КонецПроцедуры

Функция СоздатьМенеджерНачальнойИнициализации(Настройки)

	МенеджерСущностей = Новый МенеджерСущностей(
		Тип("КоннекторSQLite"),
		СтрокаСоединенияНачальнойИнициализацииSQLite(Настройки)
	);

	ДобавитьМодель(МенеджерСущностей);

	Возврат МенеджерСущностей;

КонецФункции

Процедура ДобавитьМодель(МенеджерСущностей)

	МенеджерСущностей.ДобавитьКлассВМодель(Тип("СущностьОчередьПакета"));
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("СущностьСтатистикаПакета"));
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("СущностьЗависимыйРепозиторий"));
	МенеджерСущностей.ДобавитьКлассВМодель(Тип("СущностьРепозиторий"));

КонецПроцедуры

Функция СтрокаСоединенияНачальнойИнициализацииSQLite(Настройки)

	ТаймаутЗанятостиМс = Настройки.ТаймаутЗанятостиМс;

	Возврат СтрШаблон(
		"FullUri=%1?mode=rwc;DefaultTimeout=0;BusyTimeout=%2;",
		URIФайлаSQLite(),
		Формат(ТаймаутЗанятостиМс, "ЧН=0; ЧГ=")
	);

КонецФункции

Функция СтрокаСоединенияСлотаSQLite(Настройки, Режим, Роль, НомерСлота)

	Возврат СтрШаблон(
		"FullUri=%1?mode=%2#litros-%3-%4;DefaultTimeout=0;BusyTimeout=%5;",
		URIФайлаSQLite(),
		Режим,
		Роль,
		Формат(НомерСлота, "ЧН=0; ЧГ="),
		Формат(Настройки.ТаймаутЗанятостиМс, "ЧН=0; ЧГ=")
	);

КонецФункции

Функция URIФайлаSQLite()

	Путь = _ПутьКБД;
	Если Не ЭтоАбсолютныйПутьSQLite(Путь) Тогда
		Путь = (Новый Файл(Путь)).ПолноеИмя;
	КонецЕсли;

	Путь = СтрЗаменить(Путь, "%", "%25");
	Путь = СтрЗаменить(Путь, ";", "%3b");
	Путь = СтрЗаменить(Путь, "?", "%3f");
	Путь = СтрЗаменить(Путь, "#", "%23");
	Путь = СтрЗаменить(Путь, "\", "/");

	Если Лев(Путь, 1) = "/" Тогда
		Возврат "file://" + Путь;
	КонецЕсли;

	Возврат "file:///" + Путь;

КонецФункции

Функция ЭтоАбсолютныйПутьSQLite(Путь)

	Если Лев(Путь, 1) = "/" Или Лев(Путь, 2) = "\\" Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат СтрДлина(Путь) >= 3
		И Сред(Путь, 2, 1) = ":"
		И (Сред(Путь, 3, 1) = "\" Или Сред(Путь, 3, 1) = "/");

КонецФункции

Функция СтрокаРежимаЖурнала(Настройки)

	Возврат ?(Настройки.ИспользоватьWAL,
		"PRAGMA journal_mode=WAL;",
		"PRAGMA journal_mode=DELETE;"
	);

КонецФункции

Процедура ПроверитьРежимЖурнала(РезультатPRAGMA, ИспользоватьWAL) Экспорт

	ОжидаемыйРежим = ?(ИспользоватьWAL, "wal", "delete");
	ПредставлениеРежима = ?(ИспользоватьWAL, "WAL", "DELETE");

	Если РезультатPRAGMA.Количество() = 0
		Или НРег(СокрЛП(РезультатPRAGMA[0].journal_mode)) <> ОжидаемыйРежим Тогда
		ВызватьИсключение СтрШаблон(
			"SQLite: не удалось применить режим журнала %1",
			ПредставлениеРежима
		);
	КонецЕсли;

КонецПроцедуры

Процедура ЗакрытьМенеджеры(Менеджеры)

	Для Каждого Менеджер Из Менеджеры Цикл
		Попытка
			Менеджер.Закрыть();
		Исключение
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
