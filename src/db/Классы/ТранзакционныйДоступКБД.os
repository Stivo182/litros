Перем _МенеджерСущностей; // МенеджерСущностей
Перем _Активна; // Булево

#Область ОбработчикиСобытий

// Создает ограниченный доступ к БД для одной попытки транзакции.
//
// Параметры:
//   МенеджерСущностей - МенеджерСущностей - Исходный менеджер открытой транзакции.
Процедура ПриСозданииОбъекта(МенеджерСущностей)
	_МенеджерСущностей = МенеджерСущностей;
	_Активна = Истина;
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Получает сущности напрямую в текущей транзакции.
//
// Параметры:
//   ТипСущности - Тип - Тип сущности.
//   ОпцииПоиска - ОпцииПоиска, Неопределено - Условия поиска.
//
// Возвращаемое значение:
//   Массив - Найденные сущности.
Функция Получить(ТипСущности, ОпцииПоиска = Неопределено) Экспорт
	ПроверитьАктивность();
	Возврат _МенеджерСущностей.Получить(ТипСущности, ОпцииПоиска);
КонецФункции

// Получает одну сущность напрямую в текущей транзакции.
//
// Параметры:
//   ТипСущности - Тип - Тип сущности.
//   ОпцииПоиска - ОпцииПоиска, Неопределено - Условия поиска.
//
// Возвращаемое значение:
//   Произвольный, Неопределено - Найденная сущность.
Функция ПолучитьОдно(ТипСущности, ОпцииПоиска = Неопределено) Экспорт
	ПроверитьАктивность();
	Возврат _МенеджерСущностей.ПолучитьОдно(ТипСущности, ОпцииПоиска);
КонецФункции

// Сохраняет сущность напрямую в текущей транзакции.
//
// Параметры:
//   Сущность - Произвольный - Сохраняемая сущность.
Процедура Сохранить(Сущность) Экспорт
	ПроверитьАктивность();
	_МенеджерСущностей.Сохранить(Сущность);
КонецПроцедуры

// Удаляет сущность напрямую в текущей транзакции.
//
// Параметры:
//   Сущность - Произвольный - Удаляемая сущность.
Процедура Удалить(Сущность) Экспорт
	ПроверитьАктивность();
	_МенеджерСущностей.Удалить(Сущность);
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Запрещает дальнейшие обращения к базе через этот транзакционный доступ.
Процедура Деактивировать() Экспорт
	_Активна = Ложь;
	_МенеджерСущностей = Неопределено;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьАктивность()
	Если Не _Активна Тогда
		ВызватьИсключение "ТранзакционныйДоступКБД больше не активен; доступ разрешен только внутри обработчика транзакции";
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
