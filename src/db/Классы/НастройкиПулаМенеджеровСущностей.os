// BSLLS:MissingVariablesDescription-off
// BSLLS:ExportVariables-off

#Использовать asserts

// Число - Максимальное ожидание освобождения SQLite-блокировки внутри одного обращения к базе данных. После
// истечения таймаута ошибка возвращается вызывающему коду без автоматического повтора прикладной операции.
&Деталька(Значение = "litros.db.ТаймаутЗанятостиМс", ЗначениеПоУмолчанию = 1000)
Перем ТаймаутЗанятостиМс Экспорт;

&Деталька(Значение = "litros.db.МаксимальноеОжиданиеСлотаМс", ЗначениеПоУмолчанию = 10000)
Перем МаксимальноеОжиданиеСлотаМс Экспорт;

&Деталька(Значение = "litros.db.МаксимальноеОжиданиеЗакрытияМс", ЗначениеПоУмолчанию = 30000)
Перем МаксимальноеОжиданиеЗакрытияМс Экспорт;

&Деталька(Значение = "litros.db.КоличествоЧитателей", ЗначениеПоУмолчанию = 0)
Перем КоличествоЧитателей Экспорт;

&Деталька(Значение = "litros.db.КоличествоПисателей", ЗначениеПоУмолчанию = 0)
Перем КоличествоПисателей Экспорт;

&Деталька(Значение = "litros.db.ИспользоватьWAL", ЗначениеПоУмолчанию = Истина)
Перем ИспользоватьWAL Экспорт;

#Область ОбработчикиСобытий

&Желудь
Процедура ПриСозданииОбъекта()

	ТаймаутЗанятостиМс = 1000;
	МаксимальноеОжиданиеСлотаМс = 10000;
	МаксимальноеОжиданиеЗакрытияМс = 30000;
	КоличествоЧитателей = 0;
	КоличествоПисателей = 0;
	ИспользоватьWAL = Истина;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Рассчитывает количество слотов записи пула.
//
// Параметры:
//   КоличествоПроцессоров - Число - Количество доступных процессоров.
//
// Возвращаемое значение:
//   Число - Явно настроенное или рассчитанное количество слотов записи.
Функция РассчитатьКоличествоПисателей(КоличествоПроцессоров) Экспорт

	ПроверитьНастройки(КоличествоПроцессоров);
	Если КоличествоПисателей > 0 Тогда
		Возврат КоличествоПисателей;
	КонецЕсли;

	Возврат Макс(1, Мин(4, Цел(КоличествоПроцессоров / 4)));

КонецФункции

// Рассчитывает количество слотов чтения пула.
//
// Параметры:
//   КоличествоПроцессоров - Число - Количество доступных процессоров.
//
// Возвращаемое значение:
//   Число - Явно настроенное или рассчитанное количество слотов чтения.
Функция РассчитатьКоличествоЧитателей(КоличествоПроцессоров) Экспорт

	ПроверитьНастройки(КоличествоПроцессоров);
	Если КоличествоЧитателей > 0 Тогда
		Возврат КоличествоЧитателей;
	КонецЕсли;

	КоличествоПисателейПоУмолчанию = Макс(1, Мин(4, Цел(КоличествоПроцессоров / 4)));
	Возврат Макс(2, Мин(32, КоличествоПроцессоров - КоличествоПисателейПоУмолчанию));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьНастройки(КоличествоПроцессоров)

	МаксимальноеЦелое = 2147483647;
	Ожидаем.Что(КоличествоПроцессоров, "Количество процессоров")
		.ИмеетТип("Число")
		.Равно(Цел(КоличествоПроцессоров))
		.Между(1, МаксимальноеЦелое);
	Ожидаем.Что(ТаймаутЗанятостиМс, "Настройка litros.db.ТаймаутЗанятостиМс")
		.ИмеетТип("Число")
		.Равно(Цел(ТаймаутЗанятостиМс))
		.Между(0, МаксимальноеЦелое);
	Ожидаем.Что(МаксимальноеОжиданиеСлотаМс, "Настройка litros.db.МаксимальноеОжиданиеСлотаМс")
		.ИмеетТип("Число")
		.Равно(Цел(МаксимальноеОжиданиеСлотаМс))
		.Между(0, МаксимальноеЦелое);
	Ожидаем.Что(МаксимальноеОжиданиеЗакрытияМс, "Настройка litros.db.МаксимальноеОжиданиеЗакрытияМс")
		.ИмеетТип("Число")
		.Равно(Цел(МаксимальноеОжиданиеЗакрытияМс))
		.Между(1, МаксимальноеЦелое);
	Ожидаем.Что(КоличествоЧитателей, "Настройка litros.db.КоличествоЧитателей")
		.ИмеетТип("Число")
		.Равно(Цел(КоличествоЧитателей))
		.Между(0, МаксимальноеЦелое);
	Ожидаем.Что(КоличествоПисателей, "Настройка litros.db.КоличествоПисателей")
		.ИмеетТип("Число")
		.Равно(Цел(КоличествоПисателей))
		.Между(0, МаксимальноеЦелое);

КонецПроцедуры

#КонецОбласти
