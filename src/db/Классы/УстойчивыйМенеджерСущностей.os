#Использовать reflector
#Использовать resilience

Перем _Настройки; // НастройкиОтказоустойчивостиБД
Перем _Классификатор; // КлассификаторОшибокSQLite
Перем _ТабакеркаМенеджера; // Табакерка - МенеджерСущностей
Перем _МенеджерСущностей; // МенеджерСущностей, Неопределено
Перем _ФатальнаяОшибка; // Строка
Перем _Блокировка; // БлокировкаРесурса
Перем _Пайплайн; // ПайплайнОтказоустойчивости

#Область ОбработчикиСобытий

// Создает устойчивый прикладной фасад менеджера сущностей.
//
// Параметры:
//   Настройки - НастройкиОтказоустойчивостиБД - Настройки пайплайна отказоустойчивости.
//   Классификатор - КлассификаторОшибокSQLite - Классификатор временных ошибок.
//   ТабакеркаМенеджера - Табакерка - Ленивая зависимость исходного менеджера сущностей.
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин("НастройкиОтказоустойчивостиБД") Настройки,
	&Пластилин("КлассификаторОшибокSQLite") Классификатор,
	&Табакерка &Пластилин("ВнутреннийМенеджерСущностей") ТабакеркаМенеджера)

	_Настройки = Настройки;
	_Классификатор = Классификатор;
	_ТабакеркаМенеджера = ТабакеркаМенеджера;
	_МенеджерСущностей = Неопределено;
	_ФатальнаяОшибка = "";
	_Блокировка = Новый БлокировкаРесурса(ЭтотОбъект);
	_Пайплайн = СоздатьПайплайн();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Получает сущности через пайплайн отказоустойчивости.
//
// Параметры:
//   ТипСущности - Тип - Тип сущности.
//   ОпцииПоиска - ОпцииПоиска, Неопределено - Условия поиска.
//
// Возвращаемое значение:
//   Массив - Найденные сущности.
Функция Получить(ТипСущности, ОпцииПоиска = Неопределено) Экспорт

	ПроверитьРаботоспособность();

	Параметры = Новый Массив();
	Параметры.Добавить(ТипСущности);
	Параметры.Добавить(ОпцииПоиска);

	Возврат ВыполнитьОперацию(
		Новый Действие(ЭтотОбъект, "ПолучитьБезПовтора"), Параметры);

КонецФункции

// Получает одну сущность через пайплайн отказоустойчивости.
//
// Параметры:
//   ТипСущности - Тип - Тип сущности.
//   ОпцииПоиска - ОпцииПоиска, Неопределено - Условия поиска.
//
// Возвращаемое значение:
//   Произвольный, Неопределено - Найденная сущность.
Функция ПолучитьОдно(ТипСущности, ОпцииПоиска = Неопределено) Экспорт

	ПроверитьРаботоспособность();

	Параметры = Новый Массив();
	Параметры.Добавить(ТипСущности);
	Параметры.Добавить(ОпцииПоиска);

	Возврат ВыполнитьОперацию(
		Новый Действие(ЭтотОбъект, "ПолучитьОдноБезПовтора"), Параметры);

КонецФункции

// Сохраняет сущность через пайплайн отказоустойчивости.
//
// Параметры:
//   Сущность - Произвольный - Сохраняемая сущность.
Процедура Сохранить(Сущность) Экспорт

	ПроверитьРаботоспособность();

	ВыполнитьОперацию(
		Новый Действие(ЭтотОбъект, "СохранитьБезПовтора"), Сущность);

КонецПроцедуры

// Удаляет сущность через пайплайн отказоустойчивости.
//
// Параметры:
//   Сущность - Произвольный - Удаляемая сущность.
Процедура Удалить(Сущность) Экспорт

	ПроверитьРаботоспособность();

	ВыполнитьОперацию(
		Новый Действие(ЭтотОбъект, "УдалитьБезПовтора"), Сущность);

КонецПроцедуры

// Выполняет SQL через пайплайн отказоустойчивости.
//
// Параметры:
//   ТекстЗапроса - Строка - SQL-запрос.
//
// Возвращаемое значение:
//   ТаблицаЗначений - Результат запроса.
Функция ВыполнитьЗапрос(ТекстЗапроса) Экспорт

	ПроверитьРаботоспособность();

	Возврат ВыполнитьОперацию(
		Новый Действие(ЭтотОбъект, "ВыполнитьЗапросБезПовтора"), ТекстЗапроса);

КонецФункции

// Выполняет действие в транзакции и повторяет всю транзакцию после временной ошибки.
//
// Параметры:
//   Операция - Действие - Обработчик; первым аргументом получает ТранзакционныйДоступКБД.
//   Параметры - Массив, ФиксированныйМассив, Произвольный, Неопределено - Аргументы обработчика.
//
// Возвращаемое значение:
//   Произвольный - Результат обработчика.
Функция ВыполнитьВТранзакции(Операция, Параметры = Неопределено) Экспорт

	ПроверитьРаботоспособность();

	Если ТипЗнч(Операция) <> Тип("Действие") Тогда
		ВызватьИсключение "ВыполнитьВТранзакции принимает Действие";
	КонецЕсли;

	ПараметрыПопытки = Новый Массив();
	ПараметрыПопытки.Добавить(Операция);
	ПараметрыПопытки.Добавить(Параметры);

	Возврат ВыполнитьОперацию(
		Новый Действие(ЭтотОбъект, "ВыполнитьТранзакционнуюПопытку"),
		ПараметрыПопытки);

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Методы попыток экспортны только для вызова через Действие пайплайна.

// Выполняет одну попытку получения сущностей без самостоятельного повтора.
Функция ПолучитьБезПовтора(ТипСущности, ОпцииПоиска) Экспорт

	ПроверитьРаботоспособность();
	Возврат ПолучитьМенеджер().Получить(ТипСущности, ОпцииПоиска);

КонецФункции

// Выполняет одну попытку получения одной сущности без самостоятельного повтора.
Функция ПолучитьОдноБезПовтора(ТипСущности, ОпцииПоиска) Экспорт

	ПроверитьРаботоспособность();
	Возврат ПолучитьМенеджер().ПолучитьОдно(ТипСущности, ОпцииПоиска);

КонецФункции

// Выполняет одну попытку сохранения без самостоятельного повтора.
Процедура СохранитьБезПовтора(Сущность) Экспорт

	ПроверитьРаботоспособность();
	ПолучитьМенеджер().Сохранить(Сущность);

КонецПроцедуры

// Выполняет одну попытку удаления без самостоятельного повтора.
Процедура УдалитьБезПовтора(Сущность) Экспорт

	ПроверитьРаботоспособность();
	ПолучитьМенеджер().Удалить(Сущность);

КонецПроцедуры

// Выполняет одну попытку SQL-запроса без самостоятельного повтора.
Функция ВыполнитьЗапросБезПовтора(ТекстЗапроса) Экспорт

	ПроверитьРаботоспособность();
	Возврат ПолучитьМенеджер().ПолучитьКоннектор().ВыполнитьЗапрос(ТекстЗапроса);

КонецФункции

// Выполняет полную транзакционную попытку BEGIN-callback-COMMIT.
Функция ВыполнитьТранзакционнуюПопытку(Операция, Параметры) Экспорт

	ПроверитьРаботоспособность();
	Менеджер = ПолучитьМенеджер();
	Менеджер.НачатьТранзакцию();
	ДоступКБД = Новый ТранзакционныйДоступКБД(Менеджер);

	Попытка
		Результат = ВызватьОперацию(Операция, Параметры, ДоступКБД);
		Менеджер.ЗафиксироватьТранзакцию();
	Исключение
		ИсходнаяОшибка = ИнформацияОбОшибке();
		Попытка
			Менеджер.ОтменитьТранзакцию();
		Исключение
			ОшибкаОткатаТранзакции = ИнформацияОбОшибке();
			ДоступКБД.Деактивировать();
			ОбработатьНеудачныйОткатТранзакции(
				Менеджер,
				ИсходнаяОшибка,
				ОшибкаОткатаТранзакции);
		КонецПопытки;
		ДоступКБД.Деактивировать();
		ВызватьИсключение ИсходнаяОшибка;
	КонецПопытки;

	ДоступКБД.Деактивировать();

	Возврат Результат;

КонецФункции

// Определяет, нужно ли повторить операцию после текущей попытки.
//
// Параметры:
//   КонтекстПопыткиПовтора - КонтекстПопыткиПовтора - Результат текущей попытки.
//
// Возвращаемое значение:
//   Булево - Истина, если ошибка временная и операцию нужно повторить.
Функция НужноПовторитьОперацию(КонтекстПопыткиПовтора) Экспорт

	Если Не КонтекстПопыткиПовтора.ЕстьИсключение() Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат _Классификатор.ЭтоВременнаяОшибка(
		КонтекстПопыткиПовтора.ДанныеОшибки());

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьРаботоспособность()

	_Блокировка.Заблокировать();
	ОписаниеОшибки = _ФатальнаяОшибка;
	_Блокировка.Разблокировать();

	Если Не ПустаяСтрока(ОписаниеОшибки) Тогда
		ВызватьИсключение СоздатьИнформациюОФатальнойОшибке(ОписаниеОшибки);
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьМенеджер()

	_Блокировка.Заблокировать();

	Попытка
		Если Не ПустаяСтрока(_ФатальнаяОшибка) Тогда
			ВызватьИсключение СоздатьИнформациюОФатальнойОшибке(_ФатальнаяОшибка);
		КонецЕсли;

		Если _МенеджерСущностей = Неопределено Тогда
			_МенеджерСущностей = _ТабакеркаМенеджера.Достать();
		КонецЕсли;

		Результат = _МенеджерСущностей;
	Исключение
		_Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

Функция ВызватьОперацию(Операция, Параметры, ДоступКБД)

	ПараметрыВызова = Новый Массив();
	ПараметрыВызова.Добавить(ДоступКБД);

	Если Параметры <> Неопределено Тогда
		Если ТипЗнч(Параметры) = Тип("Массив")
			Или ТипЗнч(Параметры) = Тип("ФиксированныйМассив") Тогда

			Для Каждого Параметр Из Параметры Цикл
				ПараметрыВызова.Добавить(Параметр);
			КонецЦикла;
		Иначе
			ПараметрыВызова.Добавить(Параметры);
		КонецЕсли;
	КонецЕсли;

	Возврат Новый Рефлектор().ВызватьМетод(Операция, "Выполнить", ПараметрыВызова);

КонецФункции

Процедура ОбработатьНеудачныйОткатТранзакции(
	Менеджер,
	ИсходнаяОшибка,
	ОшибкаОткатаТранзакции)

	ОшибкаЗакрытия = Неопределено;

	Попытка
		Менеджер.Закрыть();
	Исключение
		ОшибкаЗакрытия = ИнформацияОбОшибке();
	КонецПопытки;

	ДиагностикаЗакрытия = "";
	Если ОшибкаЗакрытия <> Неопределено Тогда
		ДиагностикаЗакрытия = СтрШаблон("%1Ошибка закрытия:%1%2",
			Символы.ПС, ПодробноеПредставлениеОшибки(ОшибкаЗакрытия));
	КонецЕсли;

	ОписаниеОшибки = СтрШаблон(
		"Состояние транзакции неизвестно; пересоздать контекст Autumn или перезапустить приложение.
		|Исходная ошибка:
		|%1
		|Ошибка при откате транзакции:
		|%2%3",
		ПодробноеПредставлениеОшибки(ИсходнаяОшибка),
		ПодробноеПредставлениеОшибки(ОшибкаОткатаТранзакции),
		ДиагностикаЗакрытия);

	УстановитьФатальнуюОшибку(ОписаниеОшибки);
	
	ВызватьИсключение СоздатьИнформациюОФатальнойОшибке(ОписаниеОшибки);

КонецПроцедуры

Процедура УстановитьФатальнуюОшибку(ОписаниеОшибки)

	_Блокировка.Заблокировать();
	_ФатальнаяОшибка = ОписаниеОшибки;
	_Блокировка.Разблокировать();

КонецПроцедуры

Функция СоздатьИнформациюОФатальнойОшибке(ОписаниеОшибки)
	Возврат Новый ИнформацияОбОшибке(
		ОписаниеОшибки,
		"litros_db_rollback_failed");
КонецФункции

Функция ВыполнитьОперацию(Операция, Параметры = Неопределено)
	Возврат _Пайплайн.Запустить(Операция, Параметры);
КонецФункции

Функция СоздатьПайплайн()

	СтратегияПовтора = Новый СтратегияПовтора(
		_Настройки.КоличествоПовторов,
		_Настройки.БазоваяЗадержкаПовтораМс
	)
		.УстановитьТипЗадержки(ТипыРасчетаЗадержки.Экспоненциальная)
		.ИспользоватьРазбросЗадержки()
		.УстановитьМаксимальнуюЗадержку(_Настройки.МаксимальнаяЗадержкаПовтораМс)
		.УстановитьУсловиеПовтора(Новый Действие(ЭтотОбъект, "НужноПовторитьОперацию"));

	СтратегияОграниченияПараллелизма = Новый СтратегияОграниченияПараллелизма(1, _Настройки.ЛимитОчереди)
		.УстановитьМаксимальноеОжиданиеСлота(_Настройки.МаксимальноеОжиданиеСлотаМс);

	Возврат Новый ПайплайнОтказоустойчивости()
		.ДобавитьСтратегию(СтратегияПовтора)
		.ДобавитьСтратегию(СтратегияОграниченияПараллелизма);

КонецФункции

#КонецОбласти
