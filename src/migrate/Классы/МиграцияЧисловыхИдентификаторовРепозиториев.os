#Использовать logos
#Использовать "../../dto"

Перем _МенеджерСущностей; // МенеджерСущностей
Перем _Коннектор; // КоннекторSQLite
Перем _Лог; // Лог

#Область ОбработчикиСобытий

// Создает миграцию строковых Node ID на числовые Repository ID.
//
// Параметры:
//   МенеджерСущностей - МенеджерСущностей - Менеджер открытого соединения SQLite.
Процедура ПриСозданииОбъекта(МенеджерСущностей)
	_МенеджерСущностей = МенеджерСущностей;
	_Коннектор = МенеджерСущностей.ПолучитьКоннектор();
	_Лог = Логирование.ПолучитьЛог("litros.МиграцияЧисловыхИдентификаторовРепозиториев");
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Перестраивает таблицы репозиториев и преобразует legacy Node ID в числовые Repository ID.
Процедура Применить() Экспорт

	Если СхемаУжеАктуальна() Тогда
		_Лог.Отладка("Схема репозиториев уже актуальна");
		Возврат;
	КонецЕсли;

	КолонкиРепозиториев = _Коннектор.ВыполнитьЗапрос("PRAGMA table_info(Репозитории);");
	СтарыеРепозитории = _Коннектор.ВыполнитьЗапрос("SELECT * FROM Репозитории;");
	СтарыеЗависимости = _Коннектор.ВыполнитьЗапрос("SELECT * FROM ЗависимыеРепозитории;");

	_Лог.Отладка(
		"Миграция идентификаторов репозиториев: репозитории=%1 зависимости=%2",
		СтарыеРепозитории.Количество(),
		СтарыеЗависимости.Количество()
	);

	ПреобразованныеДанные = ПреобразоватьДанные(
		СтарыеРепозитории,
		СтарыеЗависимости,
		КолонкиРепозиториев
	);

	ПересоздатьТаблицы();
	СохранитьПреобразованныеДанные(ПреобразованныеДанные);
	УдалитьСтарыеТаблицы();
	СброситьДатыОбновленияСтатистикиПакетов();

	_Лог.Отладка("Миграция идентификаторов репозиториев завершена");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СхемаУжеАктуальна()

	КолонкиРепозиториев = _Коннектор.ВыполнитьЗапрос("PRAGMA table_info(Репозитории);");
	КолонкиЗависимостей = _Коннектор.ВыполнитьЗапрос("PRAGMA table_info(ЗависимыеРепозитории);");

	Возврат ТипКолонки(КолонкиРепозиториев, "Идентификатор") = "INTEGER"
		И ТипКолонки(КолонкиРепозиториев, "ИдентификаторУзла") = "TEXT"
		И ТипКолонки(КолонкиЗависимостей, "ИдентификаторРепозитория") = "INTEGER";

КонецФункции

Функция ТипКолонки(Колонки, ИмяКолонки)

	Для Каждого Колонка Из Колонки Цикл
		Если Колонка.name = ИмяКолонки Тогда
			Возврат ВРег(Колонка.type);
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция ПреобразоватьДанные(СтарыеРепозитории, СтарыеЗависимости, КолонкиРепозиториев)

	Идентификаторы = Новый Соответствие();
	Репозитории = Новый Соответствие();
	Зависимости = Новый Массив();
	РепозиторииБезЧисловогоИдентификатора = Новый Массив();

	Для Каждого СтараяСтрока Из СтарыеРепозитории Цикл
		ИсходныйИдентификатор = СтараяСтрока.Идентификатор;
		Идентификатор = ПолучитьЧисловойИдентификатор(
			ИсходныйИдентификатор,
			Идентификаторы
		);

		Если Идентификатор = 0 Тогда
			РепозиторииБезЧисловогоИдентификатора.Добавить(СтараяСтрока);
			Продолжить;
		КонецЕсли;

		Репозиторий = СоздатьРепозиторий(
			СтараяСтрока,
			КолонкиРепозиториев,
			Идентификатор,
			ИсходныйИдентификатор
		);

		ДобавитьИлиОбъединитьРепозиторий(Репозитории, Репозиторий);
	КонецЦикла;

	КоличествоПропущенных = ОбъединитьРепозиторииБезЧисловогоИдентификатора(
		Репозитории,
		РепозиторииБезЧисловогоИдентификатора,
		Идентификаторы
	);
	Если КоличествоПропущенных > 0 Тогда
		_Лог.Отладка(
			"Репозитории без числового идентификатора пропущены: %1",
			КоличествоПропущенных
		);
	КонецЕсли;

	КоличествоПропущенныхЗависимостей = 0;
	Для Каждого СтараяСтрока Из СтарыеЗависимости Цикл

		ИсходныйИдентификатор = СтараяСтрока.ИдентификаторРепозитория;
		Идентификатор = ПолучитьЧисловойИдентификатор(
			ИсходныйИдентификатор,
			Идентификаторы
		);
		Если Идентификатор = 0 Тогда
			КоличествоПропущенныхЗависимостей = КоличествоПропущенныхЗависимостей + 1;
			Продолжить;
		КонецЕсли;

		Зависимости.Добавить(СоздатьЗависимость(СтараяСтрока, Идентификатор));

		Если Репозитории[Идентификатор] = Неопределено Тогда
			Репозитории.Вставить(
				Идентификатор,
				СоздатьОтсутствующийРепозиторий(Идентификатор, ИсходныйИдентификатор)
			);
		КонецЕсли;

	КонецЦикла;

	Если КоличествоПропущенныхЗависимостей > 0 Тогда
		_Лог.Предупреждение(
			"Зависимости без числового идентификатора репозитория пропущены: %1",
			КоличествоПропущенныхЗависимостей
		);
	КонецЕсли;

	Возврат Новый Структура("Репозитории, Зависимости", Репозитории, Зависимости);

КонецФункции

Функция ОбъединитьРепозиторииБезЧисловогоИдентификатора(Репозитории, СтарыеРепозитории, Идентификаторы)

	КоличествоПропущенных = 0;

	Для Каждого СтараяСтрока Из СтарыеРепозитории Цикл

		Репозиторий = НайтиРепозиторийПоПолномуИмени(Репозитории, СтараяСтрока.ПолноеИмя);
		Если Репозиторий = Неопределено Тогда
			КоличествоПропущенных = КоличествоПропущенных + 1;
			Продолжить;
		КонецЕсли;

		Идентификатор = Репозиторий.Идентификатор;
		ЗаполнитьЗначенияСвойств(Репозиторий, СтараяСтрока);
		Репозиторий.Идентификатор = Идентификатор;
		Репозиторий.ИдентификаторУзла = Строка(СтараяСтрока.Идентификатор);
		Репозиторий.ТребуетсяОбновление = Истина;

		Идентификаторы.Вставить(Строка(СтараяСтрока.Идентификатор), Идентификатор);

	КонецЦикла;

	Возврат КоличествоПропущенных;

КонецФункции

Функция НайтиРепозиторийПоПолномуИмени(Репозитории, ПолноеИмя)

	КлючПолногоИмени = НРег(СокрЛП(Строка(ПолноеИмя)));
	Если Не ЗначениеЗаполнено(КлючПолногоИмени) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Для Каждого Элемент Из Репозитории Цикл
		Если НРег(СокрЛП(Строка(Элемент.Значение.ПолноеИмя))) = КлючПолногоИмени Тогда
			Возврат Элемент.Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

Функция ПолучитьЧисловойИдентификатор(ИсходныйИдентификатор, Идентификаторы)

	Ключ = Строка(ИсходныйИдентификатор);

	СуществующийИдентификатор = Идентификаторы[Ключ];
	Если СуществующийИдентификатор <> Неопределено Тогда
		Возврат СуществующийИдентификатор;
	КонецЕсли;

	Идентификатор = ПолучитьЧисло(ИсходныйИдентификатор);
	Если Идентификатор = 0 Тогда
		Идентификатор = ПолучитьИдентификаторИзLegacyNodeID(Ключ);
	КонецЕсли;

	Если Идентификатор = 0 Тогда
		_Лог.Предупреждение(
			"Не удалось получить числовой Repository ID из Node ID %1",
			Ключ
		);
		Возврат Идентификатор;
	КонецЕсли;

	Идентификаторы.Вставить(Ключ, Идентификатор);

	Возврат Идентификатор;

КонецФункции

Функция ПолучитьЧисло(Значение)

	ОписаниеТипа = Новый ОписаниеТипов("Число");
	Возврат ОписаниеТипа.ПривестиЗначение(Значение);

КонецФункции

Функция ПолучитьИдентификаторИзLegacyNodeID(ИдентификаторУзла)

	Префикс = "010:Repository";

	Попытка
		РасшифрованноеЗначение = ПолучитьСтрокуИзДвоичныхДанных(Base64Значение(ИдентификаторУзла));
	Исключение
		Возврат 0;
	КонецПопытки;

	Если Лев(РасшифрованноеЗначение, СтрДлина(Префикс)) <> Префикс Тогда
		Возврат 0;
	КонецЕсли;

	Возврат ПолучитьЧисло(Сред(РасшифрованноеЗначение, СтрДлина(Префикс) + 1));

КонецФункции

Функция СоздатьРепозиторий(СтараяСтрока, Колонки, Идентификатор, ИсходныйИдентификатор)

	Репозиторий = Новый СущностьРепозиторий();
	ЗаполнитьЗначенияСвойств(Репозиторий, СтараяСтрока);
	Репозиторий.Идентификатор = Идентификатор;
	Репозиторий.ИдентификаторУзла = ПолучитьИдентификаторУзла(
		СтараяСтрока,
		Колонки,
		ИсходныйИдентификатор
	);
	Репозиторий.ТребуетсяОбновление = Истина;

	Возврат Репозиторий;

КонецФункции

Функция ПолучитьИдентификаторУзла(СтараяСтрока, Колонки, ИсходныйИдентификатор)

	Если ТипКолонки(Колонки, "ИдентификаторУзла") <> "" Тогда
		Возврат СтараяСтрока["ИдентификаторУзла"];
	КонецЕсли;

	Если ТипКолонки(Колонки, "ИдентификаторУзлаGitHub") <> "" Тогда
		Возврат СтараяСтрока["ИдентификаторУзлаGitHub"];
	КонецЕсли;

	Если ПолучитьЧисло(ИсходныйИдентификатор) = 0 Тогда
		Возврат Строка(ИсходныйИдентификатор);
	КонецЕсли;

	Возврат "";

КонецФункции

Процедура ДобавитьИлиОбъединитьРепозиторий(Репозитории, Репозиторий)

	СуществующийРепозиторий = Репозитории[Репозиторий.Идентификатор];
	Если СуществующийРепозиторий = Неопределено Тогда
		Репозитории.Вставить(Репозиторий.Идентификатор, Репозиторий);
	ИначеЕсли Не ЗначениеЗаполнено(СуществующийРепозиторий.ИдентификаторУзла) Тогда
		СуществующийРепозиторий.ИдентификаторУзла = Репозиторий.ИдентификаторУзла;
	КонецЕсли;

КонецПроцедуры

Функция СоздатьЗависимость(СтараяСтрока, ИдентификаторРепозитория)

	Зависимость = Новый СущностьЗависимыйРепозиторий();
	ЗаполнитьЗначенияСвойств(Зависимость, СтараяСтрока);
	Зависимость.ИдентификаторРепозитория = ИдентификаторРепозитория;

	Возврат Зависимость;

КонецФункции

Функция СоздатьОтсутствующийРепозиторий(Идентификатор, ИсходныйИдентификатор)

	Репозиторий = Новый СущностьРепозиторий();
	Репозиторий.Идентификатор = Идентификатор;
	Репозиторий.ИдентификаторУзла = ?(
		ПолучитьЧисло(ИсходныйИдентификатор) = 0,
		Строка(ИсходныйИдентификатор),
		""
	);
	Репозиторий.ТребуетсяОбновление = Истина;

	Возврат Репозиторий;

КонецФункции

Процедура ПересоздатьТаблицы()

	_Коннектор.ВыполнитьЗапрос(
		"ALTER TABLE ЗависимыеРепозитории RENAME TO ЗависимыеРепозиторииДоМиграции;");
	_Коннектор.ВыполнитьЗапрос("ALTER TABLE Репозитории RENAME TO РепозиторииДоМиграции;");
	_Коннектор.ВыполнитьЗапрос(
		"CREATE TABLE Репозитории (
		|	Идентификатор INTEGER PRIMARY KEY,
		|	ИдентификаторУзла TEXT,
		|	Имя TEXT,
		|	ПолноеИмя TEXT,
		|	URL TEXT,
		|	Владелец TEXT,
		|	Описание TEXT,
		|	ЭтоФорк BOOLEAN,
		|	КоличествоЗвезд INTEGER,
		|	КоличествоФорков INTEGER,
		|	ДатаОбновления DATETIME,
		|	ТребуетсяОбновление BOOLEAN
		|);");
	_Коннектор.ВыполнитьЗапрос(
		"CREATE TABLE ЗависимыеРепозитории (
		|	Идентификатор INTEGER PRIMARY KEY AUTOINCREMENT,
		|	ИдентификаторРепозитория INTEGER,
		|	ИмяПакета TEXT
		|);"
	);

КонецПроцедуры

Процедура СохранитьПреобразованныеДанные(Данные)

	Для Каждого Репозиторий Из Данные.Репозитории Цикл
		_МенеджерСущностей.Сохранить(Репозиторий.Значение);
	КонецЦикла;

	Для Каждого Зависимость Из Данные.Зависимости Цикл
		_МенеджерСущностей.Сохранить(Зависимость);
	КонецЦикла;

КонецПроцедуры

Процедура УдалитьСтарыеТаблицы()

	_Коннектор.ВыполнитьЗапрос("DROP TABLE ЗависимыеРепозиторииДоМиграции;");
	_Коннектор.ВыполнитьЗапрос("DROP TABLE РепозиторииДоМиграции;");

КонецПроцедуры

Процедура СброситьДатыОбновленияСтатистикиПакетов()

	_Коннектор.ВыполнитьЗапрос(
		"UPDATE СтатистикаПакетов
		|SET ДатаОбновления = '2000-01-01 00:00:00';"
	);

	_Лог.Отладка("Даты обновления статистики пакетов сброшены");

КонецПроцедуры

#КонецОбласти
