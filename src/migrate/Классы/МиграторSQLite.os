#Использовать logos

Перем _МенеджерСущностей; // МенеджерСущностей
Перем _ЭтоНоваяБаза; // Булево
Перем _Лог; // Лог

#Область ОбработчикиСобытий

// Создает исполнитель версионных миграций SQLite.
//
// Параметры:
//   МенеджерСущностей - МенеджерСущностей - Менеджер открытого соединения начальной инициализации.
//   ЭтоНоваяБаза - Булево - Признак базы без прикладных таблиц до инициализации актуальной модели.
Процедура ПриСозданииОбъекта(МенеджерСущностей, ЭтоНоваяБаза = Ложь)
	_МенеджерСущностей = МенеджерСущностей;
	_ЭтоНоваяБаза = ЭтоНоваяБаза;
	_Лог = Логирование.ПолучитьЛог("litros.МиграторSQLite");
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Последовательно применяет еще не выполненные миграции SQLite.
Процедура Применить() Экспорт

	_Лог.Отладка("Проверка миграций SQLite начата");

	СоздатьТаблицуМиграций();
	ОписанияМиграций = ПолучитьОписанияМиграций();

	Если _ЭтоНоваяБаза Тогда
		ПоследняяМиграция = ОписанияМиграций[ОписанияМиграций.Количество() - 1];
		ПрименитьВерсиюСхемы(ПоследняяМиграция, Ложь);
	Иначе
		Для Каждого ОписаниеМиграции Из ОписанияМиграций Цикл
			ПрименитьВерсиюСхемы(ОписаниеМиграции, Истина);
		КонецЦикла;
	КонецЕсли;

	_Лог.Отладка("Проверка миграций SQLite завершена");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьОписанияМиграций()

	Миграции = Новый Массив();
	Миграции.Добавить(НовоеОписаниеМиграции(
		1,
		"Числовые идентификаторы репозиториев",
		Тип("МиграцияЧисловыхИдентификаторовРепозиториев")
	));

	Возврат Миграции;

КонецФункции

Процедура СоздатьТаблицуМиграций()

	_МенеджерСущностей.ПолучитьКоннектор().ВыполнитьЗапрос(
		"CREATE TABLE IF NOT EXISTS Миграции (
		|	Версия INTEGER PRIMARY KEY,
		|	Имя TEXT NOT NULL,
		|	ДатаПрименения DATETIME NOT NULL
		|);");

КонецПроцедуры

Процедура ПрименитьВерсиюСхемы(ОписаниеМиграции, ВыполнитьМиграцию)

	Версия = ОписаниеМиграции.Версия;
	Имя = ОписаниеМиграции.Имя;

	_МенеджерСущностей.ПолучитьКоннектор().ВыполнитьЗапрос("BEGIN IMMEDIATE TRANSACTION;");

	Попытка
		Если МиграцияУжеПрименена(Версия) Тогда
			_МенеджерСущностей.ЗафиксироватьТранзакцию();
			_Лог.Отладка("Версия схемы SQLite уже применена: версия=%1 имя=%2", Версия, Имя);
			Возврат;
		КонецЕсли;

		Если ВыполнитьМиграцию Тогда
			_Лог.Отладка("Применение миграции SQLite: версия=%1 имя=%2", Версия, Имя);
			Миграция = СоздатьМиграцию(ОписаниеМиграции.ТипМиграции);
			Миграция.Применить();
		КонецЕсли;

		ЗарегистрироватьМиграцию(Версия, Имя);
		_МенеджерСущностей.ЗафиксироватьТранзакцию();

		Если Не ВыполнитьМиграцию Тогда
			_Лог.Отладка("Начальная версия схемы SQLite зарегистрирована: версия=%1", Версия);
		Иначе
			_Лог.Отладка("Миграция SQLite применена: версия=%1 имя=%2", Версия, Имя);
		КонецЕсли;
	Исключение
		ИсходнаяОшибка = ИнформацияОбОшибке();
		Попытка
			_МенеджерСущностей.ОтменитьТранзакцию();
		Исключение
		КонецПопытки;
		ВызватьИсключение ИсходнаяОшибка;
	КонецПопытки;

КонецПроцедуры

Функция СоздатьМиграцию(ТипМиграции)

	ПараметрыКонструктора = Новый Массив();
	ПараметрыКонструктора.Добавить(_МенеджерСущностей);

	Возврат Новый(ТипМиграции, ПараметрыКонструктора);

КонецФункции

Функция МиграцияУжеПрименена(Версия)

	ТекстЗапроса = СтрШаблон(
		"SELECT Версия FROM Миграции WHERE Версия >= %1 LIMIT 1;",
		Формат(Версия, "ЧН=0; ЧГ=")
	);

	Результат = _МенеджерСущностей.ПолучитьКоннектор().ВыполнитьЗапрос(ТекстЗапроса);

	Возврат Результат.Количество() > 0;

КонецФункции

Процедура ЗарегистрироватьМиграцию(Версия, Имя)

	БезопасноеИмя = СтрЗаменить(Имя, "'", "''");
	ТекстЗапроса = СтрШаблон(
		"INSERT INTO Миграции (Версия, Имя, ДатаПрименения) VALUES (%1, '%2', CURRENT_TIMESTAMP);",
		Формат(Версия, "ЧН=0; ЧГ="),
		БезопасноеИмя
	);

	_МенеджерСущностей.ПолучитьКоннектор().ВыполнитьЗапрос(ТекстЗапроса);

КонецПроцедуры

Функция НовоеОписаниеМиграции(Версия, Имя, ТипМиграции)
	Возврат Новый Структура(
		"Версия, Имя, ТипМиграции",
		Версия,
		Имя,
		ТипМиграции
	);
КонецФункции

#КонецОбласти
