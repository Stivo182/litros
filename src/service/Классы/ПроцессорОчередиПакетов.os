#Использовать collectionos
#Использовать entity
#Использовать autumn-logos
#Использовать "../../dto"

&Пластилин("УстойчивыйМенеджерСущностей")
Перем _УстойчивыйМенеджерСущностей; // УстойчивыйМенеджерСущностей

&Пластилин("ОбновляторЗависимыхРепозиториев")
Перем _ОбновляторЗависимыхРепозиториев; // ОбновляторЗависимыхРепозиториев

&Лог("litros.ПроцессорОчередиПакетов")
Перем _Лог; // Лог

&Деталька(Значение = "litros.ИнтервалОбработкиОчереди", ЗначениеПоУмолчанию = 60) 
Перем _ИнтервалОбработкиОчереди; // Число

&Желудь
&Прозвище("Сервис")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ПрограммныйИнтерфейс

// Запускает непрерывную обработку очереди пакетами.
// Ошибка одного цикла регистрируется и не останавливает последующие циклы обработки.
Процедура Запустить() Экспорт

	РазмерВыборки = 10;

	_Лог.Отладка("Запуск обработки очереди пакетов");

	Пока Истина Цикл

		Попытка
			ОбработатьОднуПачку(РазмерВыборки);
		Исключение
			ТекстОшибки = СтрШаблон("Возникла ошибка при обработке очереди пакетов: 
			|%1", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			_Лог.Ошибка(ТекстОшибки);
		КонецПопытки;

		Приостановить(_ИнтервалОбработкиОчереди * 1000);

	КонецЦикла;

КонецПроцедуры

// Добавляет пакет в очередь, если он еще не поставлен на обработку.
//
// Параметры:
//   ИмяПакета - Строка - Имя добавляемого пакета.
Процедура ДобавитьВОчередь(Знач ИмяПакета) Экспорт

	ИмяПакета = РаботаСДаннымиБД.НормализироватьИмяПакета(ИмяПакета);
	ПакетДобавлен = _УстойчивыйМенеджерСущностей.ВыполнитьВТранзакции(
		Новый Действие(ЭтотОбъект, "ДобавитьВОчередьВБД"), ИмяПакета);
	Если Не ПакетДобавлен Тогда
		Возврат;
	КонецЕсли;

	_Лог.Отладка("Пакет %1 добавлен в очередь", ИмяПакета);

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Получает и обрабатывает одну пачку очереди без ожидания следующего цикла.
//
// Параметры:
//   РазмерВыборки - Число - Максимальное количество элементов в пачке.
Процедура ОбработатьОднуПачку(РазмерВыборки) Экспорт

	ОчередьПакетов = ПолучитьПачкуОчереди(РазмерВыборки);
	Для Каждого ОчередьПакета Из ОчередьПакетов Цикл
		ОбработатьПакет(ОчередьПакета);
	КонецЦикла;

КонецПроцедуры

// Получает одну пачку элементов очереди в порядке их добавления.
//
// Параметры:
//   РазмерВыборки - Число - Максимальное количество элементов в пачке.
//
// Возвращаемое значение:
//   Массив, ТаблицаЗначений - Элементы очереди для обработки.
Функция ПолучитьПачкуОчереди(РазмерВыборки) Экспорт

	ОпцииПоиска = Новый ОпцииПоиска();
	ОпцииПоиска.Первые(РазмерВыборки);
	ОпцииПоиска.СортироватьПо("ДатаДобавления", НаправлениеСортировки.Возр);

	Возврат _УстойчивыйМенеджерСущностей.Получить(
		Тип("СущностьОчередьПакета"), ОпцииПоиска);

КонецФункции

// Проверяет отсутствие пакета в очереди и сохраняет новый элемент.
//
// Параметры:
//   ДоступКБД - ТранзакционныйДоступКБД - Ограниченный доступ к текущей транзакции.
//   ИмяПакета - Строка - Нормализованное имя добавляемого пакета.
//
// Возвращаемое значение:
//   Булево - Истина, если пакет добавлен; Ложь, если он уже был в очереди.
Функция ДобавитьВОчередьВБД(ДоступКБД, ИмяПакета) Экспорт

	ОпцииПоиска = Новый ОпцииПоиска();
	ОпцииПоиска.Отбор("ИмяПакета", ВидСравнения.Равно, ИмяПакета);

	ОчередьПакета = ДоступКБД.ПолучитьОдно(
		Тип("СущностьОчередьПакета"), ОпцииПоиска);
	Если ОчередьПакета <> Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ОчередьПакета = Новый СущностьОчередьПакета();
	ОчередьПакета.ИмяПакета = ИмяПакета;	
	ОчередьПакета.ДатаДобавления = РаботаСДаннымиБД.НормализоватьУниверсальнуюДату(ТекущаяУниверсальнаяДата());

	ДоступКБД.Сохранить(ОчередьПакета);

	Возврат Истина;

КонецФункции

// Удаляет успешно обработанный элемент из очереди.
//
// Параметры:
//   ОчередьПакета - СущностьОчередьПакета - Удаляемый элемент очереди.
Процедура УдалитьИзОчереди(ОчередьПакета) Экспорт
	_УстойчивыйМенеджерСущностей.Удалить(ОчередьПакета);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбработатьПакет(ОчередьПакета)

	ИмяПакета = ОчередьПакета.ИмяПакета;
	Успех = Ложь;

	Попытка
		Результат = _ОбновляторЗависимыхРепозиториев.ОбновитьПакет(ИмяПакета);
		Успех = Результат.Успех;
	Исключение
		ТекстОшибки = СтрШаблон("Не удалось обновить статистику пакета '%1': 
		|%2", ИмяПакета, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		_Лог.Ошибка(ТекстОшибки);
	КонецПопытки;

	Если Успех Тогда
		УдалитьИзОчереди(ОчередьПакета);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
