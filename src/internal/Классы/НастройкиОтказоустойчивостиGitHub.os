// Число - Минимальная задержка после вторичного ограничения GitHub.
&Деталька(Значение = "litros.github.МинимальнаяЗадержкаВторичногоЛимитаМс", ЗначениеПоУмолчанию = 60000)
Перем МинимальнаяЗадержкаВторичногоЛимитаМс Экспорт;

// Число - Максимальная допустимая задержка перед повтором.
&Деталька(Значение = "litros.github.МаксимальнаяЗадержкаПовтораМс", ЗначениеПоУмолчанию = 60000)
Перем МаксимальнаяЗадержкаПовтораМс Экспорт;

// Число - Базовая задержка повтора GitHub API.
&Деталька(Значение = "litros.github.БазоваяЗадержкаПовтораМс", ЗначениеПоУмолчанию = 1000)
Перем БазоваяЗадержкаПовтораМс Экспорт;

// Число - Максимальное количество вызовов Search Code за интервал.
&Деталька(Значение = "litros.github.ЛимитВызововПоискаКода", ЗначениеПоУмолчанию = 10)
Перем ЛимитВызововПоискаКода Экспорт;

// Число - Интервал ограничения Search Code.
&Деталька(Значение = "litros.github.ИнтервалЛимитаПоискаКодаМс", ЗначениеПоУмолчанию = 60000)
Перем ИнтервалЛимитаПоискаКодаМс Экспорт;

// Число - Максимальное ожидание разрешения Search Code.
&Деталька(Значение = "litros.github.МаксимальноеОжиданиеЛимитаПоискаКодаМс", ЗначениеПоУмолчанию = 6500)
Перем МаксимальноеОжиданиеЛимитаПоискаКодаМс Экспорт;

// Число - Количество повторов временно неуспешной операции.
&Деталька(Значение = "litros.github.КоличествоПовторов", ЗначениеПоУмолчанию = 2)
Перем КоличествоПовторов Экспорт;

// Число - Количество последовательных ошибок для размыкания предохранителя.
&Деталька(Значение = "litros.github.ПорогОшибокПредохранителя", ЗначениеПоУмолчанию = 3)
Перем ПорогОшибокПредохранителя Экспорт;

// Число - Длительность разомкнутого состояния предохранителя.
&Деталька(Значение = "litros.github.ДлительностьРазмыканияПредохранителяМс", ЗначениеПоУмолчанию = 60000)
Перем ДлительностьРазмыканияПредохранителяМс Экспорт;

// Число - Размер окна оценки предохранителя.
&Деталька(Значение = "litros.github.РазмерОкнаПредохранителя", ЗначениеПоУмолчанию = 10)
Перем РазмерОкнаПредохранителя Экспорт;

// Число - Минимум вызовов для оценки процента ошибок.
&Деталька(Значение = "litros.github.МинимумВызововДляОценкиПредохранителя", ЗначениеПоУмолчанию = 10)
Перем МинимумВызововДляОценкиПредохранителя Экспорт;

// Число - Процент ошибок для размыкания предохранителя.
&Деталька(Значение = "litros.github.ПорогПроцентаОшибокПредохранителя", ЗначениеПоУмолчанию = 50)
Перем ПорогПроцентаОшибокПредохранителя Экспорт;

// Число - Лимит вызовов в полуоткрытом состоянии.
&Деталька(Значение = "litros.github.ЛимитПробныхВызововПредохранителя", ЗначениеПоУмолчанию = 1)
Перем ЛимитПробныхВызововПредохранителя Экспорт;

// Число - Количество успешных проб для закрытия предохранителя.
&Деталька(Значение = "litros.github.ПорогУспешныхПробныхВызововПредохранителя", ЗначениеПоУмолчанию = 2)
Перем ПорогУспешныхПробныхВызововПредохранителя Экспорт;

#Область ОбработчикиСобытий

// Создает настройки отказоустойчивости GitHub API со значениями по умолчанию.
&Желудь
Процедура ПриСозданииОбъекта()

	МинимальнаяЗадержкаВторичногоЛимитаМс = 60000;
	МаксимальнаяЗадержкаПовтораМс = 60000;
	БазоваяЗадержкаПовтораМс = 1000;
	ЛимитВызововПоискаКода = 10;
	ИнтервалЛимитаПоискаКодаМс = 60000;
	МаксимальноеОжиданиеЛимитаПоискаКодаМс = 6500;
	КоличествоПовторов = 2;
	ПорогОшибокПредохранителя = 3;
	ДлительностьРазмыканияПредохранителяМс = 60000;
	РазмерОкнаПредохранителя = 10;
	МинимумВызововДляОценкиПредохранителя = 10;
	ПорогПроцентаОшибокПредохранителя = 50;
	ЛимитПробныхВызововПредохранителя = 1;
	ПорогУспешныхПробныхВызововПредохранителя = 2;

КонецПроцедуры

#КонецОбласти
