Перем _Контекст; // КонтекстУстойчивогоМенеджераСущностей
Перем _ИмяОперации; // Строка

#Область ОбработчикиСобытий

// Создает внутреннюю простую операцию одного executor-вызова.
//
// Параметры:
//   Контекст     - КонтекстУстойчивогоМенеджераСущностей - Общее состояние фасада.
//   ИмяОперации - Строка - Имя прямой операции менеджера сущностей.
Процедура ПриСозданииОбъекта(Контекст, ИмяОперации)
	_Контекст = Контекст;
	_ИмяОперации = ИмяОперации;
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Выполняет ровно один прямой вызов после получения executor-слота.
//
// Параметры:
//   Параметр1 - Произвольный, Неопределено - Первый параметр прямой операции.
//   Параметр2 - Произвольный, Неопределено - Второй параметр прямой операции.
//
// Возвращаемое значение:
//   Произвольный, Неопределено - Исходный результат менеджера сущностей.
Функция Исполнить(Параметр1 = Неопределено, Параметр2 = Неопределено) Экспорт
	Менеджер = _Контекст.ПолучитьМенеджер();
	Если _ИмяОперации = "Получить" Тогда
		Возврат Менеджер.Получить(Параметр1, Параметр2);
	ИначеЕсли _ИмяОперации = "ПолучитьОдно" Тогда
		Возврат Менеджер.ПолучитьОдно(Параметр1, Параметр2);
	ИначеЕсли _ИмяОперации = "Сохранить" Тогда
		Менеджер.Сохранить(Параметр1);
	ИначеЕсли _ИмяОперации = "Удалить" Тогда
		Менеджер.Удалить(Параметр1);
	ИначеЕсли _ИмяОперации = "ВыполнитьЗапрос" Тогда
		Возврат Менеджер.ПолучитьКоннектор().ВыполнитьЗапрос(Параметр1);
	Иначе
		ВызватьИсключение СтрШаблон("Неизвестная операция устойчивого менеджера: %1", _ИмяОперации);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

#КонецОбласти
