Перем _ТабакеркаМенеджера; // Табакерка
Перем _МенеджерСущностей; // МенеджерСущностей, Неопределено
Перем _ФатальнаяОшибка; // Строка
Перем _Блокировка; // БлокировкаРесурса

#Область ОбработчикиСобытий

// Создает общее состояние фасада и его внутренних операций.
//
// Параметры:
//   ТабакеркаМенеджера - Табакерка - Ленивая зависимость исходного менеджера.
Процедура ПриСозданииОбъекта(ТабакеркаМенеджера)
	_ТабакеркаМенеджера = ТабакеркаМенеджера;
	_МенеджерСущностей = Неопределено;
	_ФатальнаяОшибка = "";
	_Блокировка = Новый БлокировкаРесурса(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Проверяет, что контекст не поврежден неудачным rollback.
Процедура ПроверитьРаботоспособность() Экспорт
	_Блокировка.Заблокировать();
	ОписаниеОшибки = _ФатальнаяОшибка;
	_Блокировка.Разблокировать();
	Если Не ПустаяСтрока(ОписаниеОшибки) Тогда
		ВызватьИсключение ОписаниеОшибки;
	КонецЕсли;
КонецПроцедуры

// Возвращает один лениво разрешенный исходный менеджер.
//
// Возвращаемое значение:
//   МенеджерСущностей - Исходный менеджер текущего Autumn-контекста.
Функция ПолучитьМенеджер() Экспорт
	_Блокировка.Заблокировать();
	Попытка
		Если Не ПустаяСтрока(_ФатальнаяОшибка) Тогда
			ВызватьИсключение _ФатальнаяОшибка;
		КонецЕсли;
		Если _МенеджерСущностей = Неопределено Тогда
			_МенеджерСущностей = _ТабакеркаМенеджера.Достать();
		КонецЕсли;
		Результат = _МенеджерСущностей;
	Исключение
		_Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	_Блокировка.Разблокировать();
	Возврат Результат;
КонецФункции

// Запоминает общую фатальную диагностику для всех текущих и ожидающих операций.
//
// Параметры:
//   ОписаниеОшибки - Строка - Диагностика с префиксом litros_db_rollback_failed:.
Процедура УстановитьФатальнуюОшибку(ОписаниеОшибки) Экспорт
	_Блокировка.Заблокировать();
	_ФатальнаяОшибка = ОписаниеОшибки;
	_Блокировка.Разблокировать();
КонецПроцедуры

#КонецОбласти
