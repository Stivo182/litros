Перем _ИмяОперации; // Строка
Перем _Параметры; // Произвольный, Неопределено
Перем _ОбработчикТранзакции; // Действие, Неопределено

#Область ОбработчикиСобытий

// Создает неизменяемую команду операции базы данных.
//
// Параметры:
//   ИмяОперации - Строка - Разрешенное имя операции базы данных.
//   Параметры - Произвольный, Неопределено - Параметры операции.
//   ОбработчикТранзакции - Действие, Неопределено - Callback транзакции.
Процедура ПриСозданииОбъекта(
	ИмяОперации,
	Параметры,
	ОбработчикТранзакции = Неопределено)

	ПроверитьИнварианты(ИмяОперации, ОбработчикТранзакции);
	_ИмяОперации = ИмяОперации;
	_Параметры = Параметры;
	_ОбработчикТранзакции = ОбработчикТранзакции;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает имя операции базы данных.
//
// Возвращаемое значение:
//   Строка - Имя операции.
Функция ИмяОперации() Экспорт

	Возврат _ИмяОперации;

КонецФункции

// Возвращает параметры операции базы данных.
//
// Возвращаемое значение:
//   Произвольный, Неопределено - Параметры операции.
Функция Параметры() Экспорт

	Возврат _Параметры;

КонецФункции

// Возвращает callback транзакции.
//
// Возвращаемое значение:
//   Действие, Неопределено - Callback транзакции.
Функция ОбработчикТранзакции() Экспорт

	Возврат _ОбработчикТранзакции;

КонецФункции

// Определяет, представляет ли команда транзакцию.
//
// Возвращаемое значение:
//   Булево - Истина для операции ВыполнитьВТранзакции.
Функция ЭтоТранзакция() Экспорт

	Возврат _ИмяОперации = "ВыполнитьВТранзакции";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьИнварианты(ИмяОперации, ОбработчикТранзакции)

	РазрешенныеИмена = Новый Массив();
	РазрешенныеИмена.Добавить("Получить");
	РазрешенныеИмена.Добавить("ПолучитьОдно");
	РазрешенныеИмена.Добавить("Сохранить");
	РазрешенныеИмена.Добавить("Удалить");
	РазрешенныеИмена.Добавить("ВыполнитьЗапрос");
	РазрешенныеИмена.Добавить("ВыполнитьВТранзакции");
	Если РазрешенныеИмена.Найти(ИмяОперации) = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Неизвестная операция БД: %1", ИмяОперации);
	КонецЕсли;
	Если ИмяОперации = "ВыполнитьВТранзакции" Тогда
		Если ТипЗнч(ОбработчикТранзакции) <> Тип("Действие") Тогда
			ВызватьИсключение "ВыполнитьВТранзакции принимает Действие";
		КонецЕсли;
	ИначеЕсли ОбработчикТранзакции <> Неопределено Тогда
		ВызватьИсключение "Обработчик транзакции допустим только для ВыполнитьВТранзакции";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
