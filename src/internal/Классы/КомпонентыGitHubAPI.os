&Дуб
Процедура ПриСозданииОбъекта()

КонецПроцедуры

#Область СлужебныйПрограммныйИнтерфейс

// Создает клиент GitHub API из настроек Autumn.
//
// Параметры:
//   Токен             - Строка, Неопределено - Токен из нового ключа настройки.
//   АдресAPI          - Строка, Неопределено - Адрес API из нового ключа настройки.
//   ТокенGitHub       - Строка, Неопределено - Токен из устаревшего ключа настройки.
//   АдресGitHubAPI    - Строка, Неопределено - Адрес API из устаревшего ключа настройки.
//   Настройки         - НастройкиОтказоустойчивостиGitHub - Настройки отказоустойчивости.
//   Лог               - Лог, Неопределено - Лог клиента.
//
// Возвращаемое значение:
//   КлиентGitHubAPI
&Завязь(Тип = "КлиентGitHubAPI")
&Характер("Компанейский")
Функция КлиентGitHubAPI(
	&Деталька(Значение = "litros.github.Токен", ЗначениеПоУмолчанию = Неопределено) Токен,
	&Деталька(Значение = "litros.github.АдресAPI", ЗначениеПоУмолчанию = Неопределено) АдресAPI,
	&Деталька(Значение = "litros.ТокенGitHub", ЗначениеПоУмолчанию = Неопределено) ТокенGitHub,
	&Деталька(Значение = "litros.АдресGitHubAPI", ЗначениеПоУмолчанию = Неопределено) АдресGitHubAPI,
	&Пластилин("НастройкиОтказоустойчивостиGitHub") Настройки,
	&Лог("litros.КлиентGitHubAPI") Лог
) Экспорт

	Токен = ПолучитьПредпочтительноеЗначение(Токен, ТокенGitHub, "");
	АдресAPI = ПолучитьПредпочтительноеЗначение(АдресAPI, АдресGitHubAPI, "");

	Возврат Новый КлиентGitHubAPI(Токен, АдресAPI, Настройки, Лог);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьПредпочтительноеЗначение(НовоеЗначение, УстаревшееЗначение, ЗначениеПоУмолчанию)

	Если НовоеЗначение <> Неопределено Тогда
		Возврат НовоеЗначение;
	КонецЕсли;

	Если УстаревшееЗначение <> Неопределено Тогда
		Возврат УстаревшееЗначение;
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

#КонецОбласти
