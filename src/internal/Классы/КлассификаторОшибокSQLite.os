#Область ОбработчикиСобытий

// Создает классификатор ошибок SQLite.
Процедура ПриСозданииОбъекта()

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Определяет, является ли ошибка временной ошибкой занятости SQLite.
//
// Параметры:
//   ДанныеОшибки - ИнформацияОбОшибке, Неопределено - Проверяемая ошибка.
//
// Возвращаемое значение:
//   Булево - Истина для ошибок SQLITE_BUSY и SQLITE_LOCKED, иначе Ложь.
Функция ЭтоВременнаяОшибка(ДанныеОшибки) Экспорт

	ТекущаяОшибка = ДанныеОшибки;
	Пока ТекущаяОшибка <> Неопределено Цикл
		ОписаниеОшибки = НРег(Строка(ТекущаяОшибка.Описание));
		Если СодержитУстойчивыйМаркер(ОписаниеОшибки) Тогда
			Возврат Истина;
		КонецЕсли;

		ТекущаяОшибка = ТекущаяОшибка.Причина;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СодержитУстойчивыйМаркер(ОписаниеОшибки)

	Возврат СодержитОтдельныйМаркер(ОписаниеОшибки, "sqlite_busy")
		Или СодержитОтдельныйМаркер(ОписаниеОшибки, "sqlite_locked")
		Или СодержитОтдельныйМаркер(ОписаниеОшибки, "database is locked")
		Или СодержитОтдельныйМаркер(ОписаниеОшибки, "database table is locked");

КонецФункции

Функция СодержитОтдельныйМаркер(ОписаниеОшибки, Маркер)

	ПозицияПоиска = 1;
	Пока ПозицияПоиска <= СтрДлина(ОписаниеОшибки) Цикл
		ОстатокСтроки = Сред(ОписаниеОшибки, ПозицияПоиска);
		ОтносительнаяПозиция = СтрНайти(ОстатокСтроки, Маркер);
		Если ОтносительнаяПозиция = 0 Тогда
			Возврат Ложь;
		КонецЕсли;

		ПозицияМаркера = ПозицияПоиска + ОтносительнаяПозиция - 1;
		ПозицияПослеМаркера = ПозицияМаркера + СтрДлина(Маркер);
		Если ЭтоГраницаМаркера(ОписаниеОшибки, ПозицияМаркера - 1)
			И ЭтоГраницаМаркера(ОписаниеОшибки, ПозицияПослеМаркера) Тогда
			Возврат Истина;
		КонецЕсли;

		ПозицияПоиска = ПозицияМаркера + 1;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ЭтоГраницаМаркера(Текст, Позиция)

	Если Позиция < 1 Или Позиция > СтрДлина(Текст) Тогда
		Возврат Истина;
	КонецЕсли;

	Символ = Сред(Текст, Позиция, 1);
	Разделители = " .,;:!?()[]{}<>+-=*/\|""'`~@#$%^&—–…«»„“”"
		+ Символы.Таб
		+ Символы.ПС
		+ Символы.ВК;

	Возврат СтрНайти(Разделители, Символ) > 0;

КонецФункции

#КонецОбласти
