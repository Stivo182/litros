#Использовать reflector

Перем _ТабакеркаМенеджера; // Табакерка - МенеджерСущностей
Перем _МенеджерСущностей; // МенеджерСущностей, Неопределено
Перем _ФатальнаяОшибка; // Строка
Перем _Блокировка; // БлокировкаРесурса

#Область ОбработчикиСобытий

// Создает координатор выполнения операций базы данных.
//
// Параметры:
//   ТабакеркаМенеджера - Табакерка - Ленивая зависимость исходного менеджера сущностей.
&Желудь
Процедура ПриСозданииОбъекта(
	&Табакерка &Пластилин("ВнутреннийМенеджерСущностей") ТабакеркаМенеджера = Неопределено)

	_ТабакеркаМенеджера = ТабакеркаМенеджера;
	_МенеджерСущностей = Неопределено;
	_ФатальнаяОшибка = "";
	_Блокировка = Новый БлокировкаРесурса(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Проверяет, что состояние соединения не повреждено неудачным rollback.
Процедура ПроверитьРаботоспособность() Экспорт

	_Блокировка.Заблокировать();
	ОписаниеОшибки = _ФатальнаяОшибка;
	_Блокировка.Разблокировать();

	Если Не ПустаяСтрока(ОписаниеОшибки) Тогда
		ВызватьИсключение ОписаниеОшибки;
	КонецЕсли;

КонецПроцедуры

// Исполняет одну фиксированную команду после получения executor-слота.
//
// Параметры:
//   Команда - ФиксированнаяСтруктура - Описание простой операции или полной попытки транзакции.
//
// Возвращаемое значение:
//   Произвольный, Неопределено - Исходный результат менеджера или callback.
Функция Исполнить(Команда) Экспорт

	Менеджер = ПолучитьМенеджер();

	Если Команда.Режим = "Простая" Тогда
		Возврат ВыполнитьПростуюОперацию(Менеджер, Команда.ИмяОперации, Команда.Параметры);
	ИначеЕсли Команда.Режим = "Транзакция" Тогда
		Возврат ВыполнитьТранзакцию(Менеджер, Команда.Операция, Команда.Параметры);
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Неизвестный режим операции БД: %1", Команда.Режим);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьМенеджер()

	_Блокировка.Заблокировать();

	Попытка
		Если Не ПустаяСтрока(_ФатальнаяОшибка) Тогда
			ВызватьИсключение _ФатальнаяОшибка;
		КонецЕсли;

		Если _МенеджерСущностей = Неопределено Тогда
			_МенеджерСущностей = _ТабакеркаМенеджера.Достать();
		КонецЕсли;

		Результат = _МенеджерСущностей;
	Исключение
		_Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

Функция ВыполнитьПростуюОперацию(Менеджер, ИмяОперации, Параметры)

	Если ИмяОперации = "Получить" Тогда
		Возврат Менеджер.Получить(Параметры[0], Параметры[1]);
	ИначеЕсли ИмяОперации = "ПолучитьОдно" Тогда
		Возврат Менеджер.ПолучитьОдно(Параметры[0], Параметры[1]);
	ИначеЕсли ИмяОперации = "Сохранить" Тогда
		Менеджер.Сохранить(Параметры);
	ИначеЕсли ИмяОперации = "Удалить" Тогда
		Менеджер.Удалить(Параметры);
	ИначеЕсли ИмяОперации = "ВыполнитьЗапрос" Тогда
		Возврат Менеджер.ПолучитьКоннектор().ВыполнитьЗапрос(Параметры);
	Иначе
		ВызватьИсключение СтрШаблон("Неизвестная операция устойчивого менеджера: %1", ИмяОперации);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ВыполнитьТранзакцию(Менеджер, Операция, Параметры)

	Менеджер.НачатьТранзакцию();
	ДоступКБД = Новый ТранзакционныйДоступКБД(Менеджер);

	Попытка
		Результат = ВызватьОперацию(Операция, Параметры, ДоступКБД);
		Менеджер.ЗафиксироватьТранзакцию();
	Исключение
		ИсходнаяОшибка = ИнформацияОбОшибке();
		Попытка
			Менеджер.ОтменитьТранзакцию();
		Исключение
			ОшибкаRollback = ИнформацияОбОшибке();
			ДоступКБД.Деактивировать();
			ОбработатьНеудачныйRollback(Менеджер, ИсходнаяОшибка, ОшибкаRollback);
		КонецПопытки;
		ДоступКБД.Деактивировать();
		ВызватьИсключение ИсходнаяОшибка;
	КонецПопытки;

	ДоступКБД.Деактивировать();

	Возврат Результат;

КонецФункции

Функция ВызватьОперацию(Операция, Параметры, ДоступКБД)

	ПараметрыВызова = Новый Массив();
	ПараметрыВызова.Добавить(ДоступКБД);

	Если Параметры <> Неопределено Тогда
		Если ТипЗнч(Параметры) = Тип("Массив")
			Или ТипЗнч(Параметры) = Тип("ФиксированныйМассив") Тогда

			Для Каждого Параметр Из Параметры Цикл
				ПараметрыВызова.Добавить(Параметр);
			КонецЦикла;
		Иначе
			ПараметрыВызова.Добавить(Параметры);
		КонецЕсли;
	КонецЕсли;

	Возврат Новый Рефлектор().ВызватьМетод(Операция, "Выполнить", ПараметрыВызова);

КонецФункции

Процедура ОбработатьНеудачныйRollback(Менеджер, ИсходнаяОшибка, ОшибкаRollback)

	ОшибкаЗакрытия = Неопределено;

	Попытка
		Менеджер.Закрыть();
	Исключение
		ОшибкаЗакрытия = ИнформацияОбОшибке();
	КонецПопытки;

	ДиагностикаЗакрытия = "";
	Если ОшибкаЗакрытия <> Неопределено Тогда
		ДиагностикаЗакрытия = СтрШаблон("%1Ошибка закрытия:%1%2",
			Символы.ПС, ПодробноеПредставлениеОшибки(ОшибкаЗакрытия));
	КонецЕсли;

	ОписаниеОшибки = СтрШаблон(
		"litros_db_rollback_failed: состояние транзакции неизвестно; пересоздать контекст Autumn или перезапустить приложение.%1Исходная ошибка:%1%2%1Ошибка rollback:%1%3%4",
		Символы.ПС,
		ПодробноеПредставлениеОшибки(ИсходнаяОшибка),
		ПодробноеПредставлениеОшибки(ОшибкаRollback),
		ДиагностикаЗакрытия);

	УстановитьФатальнуюОшибку(ОписаниеОшибки);

	ВызватьИсключение ОписаниеОшибки;

КонецПроцедуры

Процедура УстановитьФатальнуюОшибку(ОписаниеОшибки)

	_Блокировка.Заблокировать();
	_ФатальнаяОшибка = ОписаниеОшибки;
	_Блокировка.Разблокировать();

КонецПроцедуры

#КонецОбласти
