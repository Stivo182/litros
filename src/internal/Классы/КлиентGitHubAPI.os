#Использовать 1connector
#Использовать logos
#Использовать resilience

Перем _Лог; // Лог
Перем _Токен; // Строка
Перем _АдресAPI; // Строка
Перем _ПайплайнGraphQL; // ПайплайнОтказоустойчивости
Перем _ПайплайнПоискаКода; // ПайплайнОтказоустойчивости
Перем _СостоянияОшибокОпераций; // Соответствие
Перем _СостоянияЛимитов; // Соответствие
Перем _БлокировкаСостоянийОшибок; // БлокировкаРесурса
Перем _БлокировкаHTTP; // БлокировкаРесурса
Перем _БлокировкаGraphQL; // БлокировкаРесурса
Перем _БлокировкаПоискаКода; // БлокировкаРесурса
Перем _МинимальнаяЗадержкаВторичногоЛимитаМс; // Число
Перем _МаксимальнаяЗадержкаПовтораМс; // Число

#Область ОбработчикиСобытий

// Создает клиент GitHub API с локальным учетом лимитов и пайплайнами отказоустойчивости.
//
// Параметры:
//   Токен    - Строка - Персональный токен доступа GitHub.
//   АдресAPI - Строка - Базовый адрес GitHub API.
//                       Если не задан, используется https://api.github.com.
//   Настройки - НастройкиОтказоустойчивостиGitHub - Настройки повторов, предохранителя и ограничения вызовов.
//   Лог       - Лог, Неопределено - Лог клиента. Если не задан, используется лог litros.КлиентGitHubAPI.
Процедура ПриСозданииОбъекта(
	Токен = "",
	АдресAPI = "",
	Настройки = Неопределено,
	Лог = Неопределено
)

	Если Настройки = Неопределено Тогда
		Настройки = Новый НастройкиОтказоустойчивостиGitHub();
	КонецЕсли;

	_Лог = Лог;
	_Токен = Токен;
	_АдресAPI = АдресAPI;
	_МинимальнаяЗадержкаВторичногоЛимитаМс = Настройки.МинимальнаяЗадержкаВторичногоЛимитаМс;
	_МаксимальнаяЗадержкаПовтораМс = Настройки.МаксимальнаяЗадержкаПовтораМс;
	_СостоянияОшибокОпераций = Новый Соответствие();
	_СостоянияЛимитов = Новый Соответствие();
	_СостоянияЛимитов.Вставить("GraphQL", СоздатьСостояниеЛимита());
	_СостоянияЛимитов.Вставить("SearchCode", СоздатьСостояниеЛимита());
	_БлокировкаСостоянийОшибок = Новый БлокировкаРесурса(ЭтотОбъект);
	_БлокировкаHTTP = Новый БлокировкаРесурса(ЭтотОбъект);
	_БлокировкаGraphQL = Новый БлокировкаРесурса(ЭтотОбъект);
	_БлокировкаПоискаКода = Новый БлокировкаРесурса(ЭтотОбъект);

	Если _Лог = Неопределено Тогда
		_Лог = Логирование.ПолучитьЛог("litros.КлиентGitHubAPI");
	КонецЕсли;

	Если Не ЗначениеЗаполнено(_АдресAPI) Тогда
		_АдресAPI = "https://api.github.com";
	КонецЕсли;

	_ПайплайнGraphQL = СоздатьПайплайн(
		"GraphQL",
		Настройки
	);

	_ПайплайнПоискаКода = СоздатьПайплайн(
		"SearchCode",
		Настройки,
		Истина
	);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Выполняет GraphQL-запрос к GitHub API.
//
// Параметры:
//   ТекстЗапроса - Строка - Текст GraphQL-запроса.
//   Переменные   - Произвольный - Переменные GraphQL-запроса.
//
// Возвращаемое значение:
//   HTTPОтвет, Неопределено
Функция ВыполнитьGraphQL(ТекстЗапроса, Переменные = Неопределено) Экспорт

	ПараметрыОперации = Новый Массив();
	ПараметрыОперации.Добавить(ТекстЗапроса);
	ПараметрыОперации.Добавить(Переменные);

	Возврат ЗапуститьПайплайнСБлокировкой(
		_ПайплайнGraphQL,
		_БлокировкаGraphQL,
		Новый Действие(ЭтотОбъект, "ВыполнитьЗапросGraphQL"),
		ПараметрыОперации,
		"GraphQL"
	);

КонецФункции

// Выполняет поиск кода через GitHub Search API.
//
// Параметры:
//   СтрокаПоиска                     - Строка - Поисковый запрос GitHub.
//   НомерСтраницы                    - Число  - Номер страницы результата.
//   МаксимальноеКоличествоНаСтранице - Число  - Количество элементов на странице.
//
// Возвращаемое значение:
//   HTTPОтвет, Неопределено
Функция ВыполнитьПоискКода(СтрокаПоиска, НомерСтраницы = 1, МаксимальноеКоличествоНаСтранице = 100) Экспорт

	ПараметрыОперации = Новый Массив();
	ПараметрыОперации.Добавить(СтрокаПоиска);
	ПараметрыОперации.Добавить(НомерСтраницы);
	ПараметрыОперации.Добавить(МаксимальноеКоличествоНаСтранице);

	Возврат ЗапуститьПайплайнСБлокировкой(
		_ПайплайнПоискаКода,
		_БлокировкаПоискаКода,
		Новый Действие(ЭтотОбъект, "ВыполнитьЗапросПоискаКода"),
		ПараметрыОперации,
		"SearchCode"
	);

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Выполняет одну HTTP-попытку GraphQL-запроса внутри пайплайна.
//
// Параметры:
//   ТекстЗапроса - Строка - Текст GraphQL-запроса.
//   Переменные   - Произвольный - Переменные GraphQL-запроса.
//
// Возвращаемое значение:
//   HTTPОтвет
Функция ВыполнитьЗапросGraphQL(ТекстЗапроса, Переменные = Неопределено) Экспорт

	ОчиститьСостояниеОшибкиОперации("GraphQL");

	URL = _АдресAPI + ?(СтрЗаканчиваетсяНа(_АдресAPI, "/"), "", "/") + "graphql";
	ТелоЗапроса = Новый Структура("query", ТекстЗапроса);

	Если Переменные <> Неопределено Тогда
		ТелоЗапроса.Вставить("variables", Переменные);
	КонецЕсли;

	Заголовки = ПолучитьСтандартныеЗаголовки();

	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Заголовки", Заголовки);
	ДополнительныеПараметры.Вставить("Json", ТелоЗапроса);

	Ответ = ВыполнитьHTTPМетод("GraphQL", "POST", URL, ДополнительныеПараметры);

	ОбработатьВременнуюОшибкуЕслиНужно("GraphQL", Ответ, Истина);

	ОчиститьСостояниеОшибкиОперации("GraphQL");

	Возврат Ответ;

КонецФункции

// Выполняет одну HTTP-попытку поиска кода внутри пайплайна.
//
// Параметры:
//   СтрокаПоиска                     - Строка - Поисковый запрос GitHub.
//   НомерСтраницы                    - Число - Номер страницы результата.
//   МаксимальноеКоличествоНаСтранице - Число - Количество элементов на странице.
//
// Возвращаемое значение:
//   HTTPОтвет
Функция ВыполнитьЗапросПоискаКода(СтрокаПоиска, НомерСтраницы, МаксимальноеКоличествоНаСтранице) Экспорт

	ОчиститьСостояниеОшибкиОперации("SearchCode");

	URL = _АдресAPI + ?(СтрЗаканчиваетсяНа(_АдресAPI, "/"), "", "/") + "search/code";

	Заголовки = ПолучитьСтандартныеЗаголовки();
	Заголовки.Вставить("Accept", "application/vnd.github.text-match+json");
	Заголовки.Вставить("X-GitHub-Api-Version", "2022-11-28");

	ПараметрыЗапроса = Новый Структура();
	ПараметрыЗапроса.Вставить("q", СтрокаПоиска);
	ПараметрыЗапроса.Вставить("per_page", Формат(МаксимальноеКоличествоНаСтранице, "ЧГ="));
	ПараметрыЗапроса.Вставить("page", Формат(НомерСтраницы, "ЧГ="));

	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Заголовки", Заголовки);
	ДополнительныеПараметры.Вставить("ПараметрыЗапроса", ПараметрыЗапроса);

	Ответ = ВыполнитьHTTPМетод("SearchCode", "GET", URL, ДополнительныеПараметры);

	ОбработатьВременнуюОшибкуЕслиНужно("SearchCode", Ответ);

	ОчиститьСостояниеОшибкиОперации("SearchCode");

	Возврат Ответ;

КонецФункции

// Определяет, нужно ли повторить попытку после классифицированной временной ошибки.
//
// Параметры:
//   КонтекстПовтора - КонтекстПопыткиПовтора - Контекст завершившейся попытки.
//   ИмяОперации     - Строка - Имя операции GitHub API.
//
// Возвращаемое значение:
//   Булево
Функция НужноПовторитьОперацию(КонтекстПовтора, ИмяОперации) Экспорт

	Если Не КонтекстПовтора.ЕстьИсключение() Тогда
		Возврат Ложь;
	КонецЕсли;

	СостояниеОшибки = ПолучитьСостояниеОшибкиОперации(ИмяОперации);
	Если СостояниеОшибки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если _МаксимальнаяЗадержкаПовтораМс > 0
		И СостояниеОшибки.РекомендованнаяЗадержка > _МаксимальнаяЗадержкаПовтораМс Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СостояниеОшибки.Повторять;

КонецФункции

// Возвращает пользовательскую задержку GitHub перед повтором.
//
// Параметры:
//   КонтекстПовтора - КонтекстПопыткиПовтора - Контекст завершившейся попытки.
//   ИмяОперации     - Строка - Имя операции GitHub API.
//
// Возвращаемое значение:
//   Число, Неопределено - Задержка в миллисекундах.
Функция ВычислитьЗадержкуПовтора(КонтекстПовтора, ИмяОперации) Экспорт

	СостояниеОшибки = ПолучитьСостояниеОшибкиОперации(ИмяОперации);
	Если СостояниеОшибки = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если СостояниеОшибки.РекомендованнаяЗадержка > 0 Тогда
		Возврат СостояниеОшибки.РекомендованнаяЗадержка;
	КонецЕсли;

КонецФункции

// Определяет, допустим ли запасной результат для завершившейся ошибки.
//
// Параметры:
//   КонтекстОшибки - КонтекстОшибкиЗапасногоСценария - Контекст завершившейся ошибки.
//   ИмяОперации    - Строка - Имя операции GitHub API.
//
// Возвращаемое значение:
//   Булево
Функция НужноВернутьЗапаснойРезультат(КонтекстОшибки, ИмяОперации) Экспорт

	СостояниеОшибки = ПолучитьСостояниеОшибкиОперации(ИмяОперации);

	Возврат СостояниеОшибки <> Неопределено И СостояниеОшибки.Временная;

КонецФункции

// Возвращает запасной результат классифицированной временной ошибки.
//
// Параметры:
//   КонтекстОшибки - КонтекстОшибкиЗапасногоСценария - Контекст завершившейся ошибки.
//   ИмяОперации    - Строка - Имя операции GitHub API.
//
// Возвращаемое значение:
//   Неопределено
Функция ВернутьЗапаснойРезультат(КонтекстОшибки, ИмяОперации) Экспорт

	ОчиститьСостояниеОшибкиОперации(ИмяОперации);

	Возврат Неопределено;

КонецФункции

// Определяет, нужно ли скрыть программное исключение от предохранителя.
//
// Параметры:
//   КонтекстОшибки - КонтекстОшибкиЗапасногоСценария - Контекст завершившейся ошибки.
//   ИмяОперации    - Строка - Имя операции GitHub API.
//
// Возвращаемое значение:
//   Булево
Функция НужноСкрытьПрограммноеИсключение(КонтекстОшибки, ИмяОперации) Экспорт

	СостояниеОшибки = ПолучитьСостояниеОшибкиОперации(ИмяОперации);

	Возврат СостояниеОшибки = Неопределено Или Не СостояниеОшибки.Временная;

КонецФункции

// Сохраняет программное исключение и возвращает нейтральный результат для предохранителя.
//
// Параметры:
//   КонтекстОшибки - КонтекстОшибкиЗапасногоСценария - Контекст завершившейся ошибки.
//   ИмяОперации    - Строка - Имя операции GitHub API.
//
// Возвращаемое значение:
//   Неопределено
Функция СкрытьПрограммноеИсключение(КонтекстОшибки, ИмяОперации) Экспорт

	ДанныеОшибки = КонтекстОшибки.ДанныеОшибки();
	СохранитьСостояниеОшибкиОперации(
		ИмяОперации,
		Ложь,
		Ложь,
		0,
		КраткоеПредставлениеОшибки(ДанныеОшибки),
		0,
		ДанныеОшибки
	);

	Возврат Неопределено;

КонецФункции

// Регистрирует в логе запланированный повтор операции.
//
// Параметры:
//   КонтекстПовтора - КонтекстПопыткиПовтора - Контекст запланированного повтора.
//   ИмяОперации     - Строка - Имя операции GitHub API.
Процедура ЗарегистрироватьПовтор(КонтекстПовтора, ИмяОперации) Экспорт

	_Лог.Предупреждение(
		"Повтор операции GitHub %1 #%2 через %3 мс.",
		ИмяОперации,
		КонтекстПовтора.СледующаяПопытка(),
		КонтекстПовтора.Задержка()
	);

КонецПроцедуры

// Регистрирует в логе размыкание предохранителя операции.
//
// Параметры:
//   КонтекстРазмыкания - КонтекстРазмыканияПредохранителя - Контекст размыкания.
//   ИмяОперации        - Строка - Имя операции GitHub API.
Процедура ЗарегистрироватьРазмыканиеПредохранителя(КонтекстРазмыкания, ИмяОперации) Экспорт

	_Лог.Предупреждение(
		"Предохранитель GitHub %1 разомкнут. Причина: %2, ошибок в окне: %3 из %4 (%5%%).",
		ИмяОперации,
		КонтекстРазмыкания.ПричинаРазмыкания(),
		КонтекстРазмыкания.КоличествоОшибокВОкне(),
		КонтекстРазмыкания.КоличествоВызововВОкне(),
		КонтекстРазмыкания.ПроцентОшибок()
	);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьПайплайн(
	ИмяОперации,
	Настройки,
	ДобавитьОграничениеВызовов = Ложь)

	СтратегияЗапасногоСценария = Новый СтратегияЗапасногоСценария();
	СтратегияЗапасногоСценария.УстановитьОбработчик(
		Новый Действие(ЭтотОбъект, "ВернутьЗапаснойРезультат"),
		ИмяОперации
	).УстановитьУсловиеЗапасногоСценария(
		Новый Действие(ЭтотОбъект, "НужноВернутьЗапаснойРезультат"),
		ИмяОперации
	);

	СтратегияПовтора = Новый СтратегияПовтора(
		Настройки.КоличествоПовторов,
		Настройки.БазоваяЗадержкаПовтораМс
	)
		.УстановитьТипЗадержки(ТипыРасчетаЗадержки.Экспоненциальная)
		.ИспользоватьРазбросЗадержки()
		.УстановитьМаксимальнуюЗадержку(Настройки.МаксимальнаяЗадержкаПовтораМс)
		.УстановитьУсловиеПовтора(
			Новый Действие(ЭтотОбъект, "НужноПовторитьОперацию"),
			ИмяОперации
		)
		.УстановитьВычислениеЗадержки(
			Новый Действие(ЭтотОбъект, "ВычислитьЗадержкуПовтора"),
			ИмяОперации
		)
		.УстановитьОбработчикПовтора(
			Новый Действие(ЭтотОбъект, "ЗарегистрироватьПовтор"),
			ИмяОперации
		);

	СтратегияПредохранителя = Новый СтратегияПредохранителя()
		.УстановитьПорогОшибок(Настройки.ПорогОшибокПредохранителя)
		.УстановитьДлительностьРазмыкания(Настройки.ДлительностьРазмыканияПредохранителяМс)
		.УстановитьРазмерОкнаОценки(Настройки.РазмерОкнаПредохранителя)
		.УстановитьМинимумВызововДляОценки(Настройки.МинимумВызововДляОценкиПредохранителя)
		.УстановитьПорогПроцентаОшибок(Настройки.ПорогПроцентаОшибокПредохранителя)
		.УстановитьЛимитПробныхВызовов(Настройки.ЛимитПробныхВызововПредохранителя)
		.УстановитьПорогУспешныхПробныхВызововДляЗакрытия(Настройки.ПорогУспешныхПробныхВызововПредохранителя)
		.УстановитьОбработчикРазмыкания(
			Новый Действие(ЭтотОбъект, "ЗарегистрироватьРазмыканиеПредохранителя"),
			ИмяОперации
		);

	СтратегияИсключенияПредохранителя = Новый СтратегияЗапасногоСценария()
		.УстановитьОбработчик(
			Новый Действие(ЭтотОбъект, "СкрытьПрограммноеИсключение"),
			ИмяОперации
		)
		.УстановитьУсловиеЗапасногоСценария(
			Новый Действие(ЭтотОбъект, "НужноСкрытьПрограммноеИсключение"),
			ИмяОперации
		);

	Пайплайн = Новый ПайплайнОтказоустойчивости()
		.ДобавитьСтратегию(СтратегияЗапасногоСценария)
		.ДобавитьСтратегию(СтратегияПредохранителя)
		.ДобавитьСтратегию(СтратегияИсключенияПредохранителя)
		.ДобавитьСтратегию(СтратегияПовтора);

	Если ДобавитьОграничениеВызовов Тогда
		СтратегияОграниченияВызовов = Новый СтратегияОграниченияВызовов()
			.УстановитьЛимитВызовов(Настройки.ЛимитВызововПоискаКода)
			.УстановитьИнтервалЛимита(Настройки.ИнтервалЛимитаПоискаКодаМс)
			.УстановитьТипОграничения(ТипыОграниченияВызовов.РавномерноеРаспределение)
			.УстановитьМаксимальноеОжиданиеРазрешения(Настройки.МаксимальноеОжиданиеЛимитаПоискаКодаМс);
		Пайплайн.ДобавитьСтратегию(СтратегияОграниченияВызовов);
	КонецЕсли;

	Возврат Пайплайн;

КонецФункции

Функция ЗапуститьПайплайнСБлокировкой(Пайплайн, Блокировка, Операция, ПараметрыОперации, ИмяОперации)

	Результат = Неопределено;
	ДанныеОшибки = Неопределено;
	Блокировка.Заблокировать();

	Попытка
		Результат = Пайплайн.Запустить(Операция, ПараметрыОперации);

		СостояниеОшибки = ПолучитьСостояниеОшибкиОперации(ИмяОперации);
		Если СостояниеОшибки <> Неопределено
			И СостояниеОшибки.ДанныеОшибки <> Неопределено Тогда
			ДанныеОшибки = СостояниеОшибки.ДанныеОшибки;
			ОчиститьСостояниеОшибкиОперации(ИмяОперации);
		КонецЕсли;
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Если ДанныеОшибки <> Неопределено Тогда
		ВызватьИсключение ДанныеОшибки;
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ПолучитьСтандартныеЗаголовки()

	Заголовки = Новый Соответствие();

	Если ЗначениеЗаполнено(_Токен) Тогда
		Заголовки.Вставить("Authorization", "Bearer " + _Токен);
	КонецЕсли;

	Возврат Заголовки;

КонецФункции

Функция ВыполнитьHTTPМетод(ИмяОперации, Метод, URL, ДополнительныеПараметры)

	_Лог.Отладка("Отправка %1 запроса на %2", Метод, URL);
	ОчиститьСостояниеОшибкиОперации(ИмяОперации);

	_БлокировкаHTTP.Заблокировать();

	Попытка
		СостояниеЛимита = ПолучитьСостояниеЛимита(ИмяОперации);

		Если МожноВыполнитьЗапрос(СостояниеЛимита) Тогда
			Ответ = КоннекторHTTP.ВызватьМетод(Метод, URL, ДополнительныеПараметры);
			ОбновитьЛимитыИзОтвета(СостояниеЛимита, Ответ);
		Иначе
			Ответ = Неопределено;
			_Лог.Отладка(
				"Отменена отправка %1 запроса на %2. Остаток лимита: %3, дата сброса: %4",
				Метод,
				URL,
				СостояниеЛимита.Остаток,
				СостояниеЛимита.ДатаСброса
			);
		КонецЕсли;
	Исключение
		ОшибкаHTTP = ИнформацияОбОшибке();
		_БлокировкаHTTP.Разблокировать();

		Если ЭтоТранспортнаяОшибкаКоннектораHTTP(ОшибкаHTTP) Тогда
			СохранитьСостояниеОшибкиОперации(
				ИмяОперации,
				Истина,
				Истина,
				0,
				КраткоеПредставлениеОшибки(ОшибкаHTTP)
			);
		КонецЕсли;

		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаHTTP.Разблокировать();

	Если Ответ <> Неопределено Тогда
		_Лог.Отладка(
			"Завершен %1 запрос на %2. Остаток лимита: %3, дата сброса: %4",
			Метод,
			URL,
			СостояниеЛимита.Остаток,
			СостояниеЛимита.ДатаСброса
		);
	КонецЕсли;

	Возврат Ответ;

КонецФункции

Функция ЭтоТранспортнаяОшибкаКоннектораHTTP(ОшибкаHTTP)

	Если ОшибкаHTTP = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ИмяМодуля = НРег(Строка(ОшибкаHTTP.ИмяМодуля));
	ИсходнаяСтрока = НРег(Строка(ОшибкаHTTP.ИсходнаяСтрока));

	// В 1connector 2.3.3 транспортные исключения повторно выбрасываются из этой единственной точки.
	Возврат СтрЗаканчиваетсяНа(ИмяМодуля, "коннекторhttpслужебный.os")
		И СтрНайти(ИсходнаяСтрока, "подробноепредставлениеошибки(ошибкавыполнениязапроса)") > 0;

КонецФункции

Функция МожноВыполнитьЗапрос(СостояниеЛимита)

	Если СостояниеЛимита.ОжиданиеДоМс > ТекущаяУниверсальнаяДатаВМиллисекундах() Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат СостояниеЛимита.Остаток > 0 Или СостояниеЛимита.ДатаСброса < ТекущаяУниверсальнаяДата();

КонецФункции

Процедура ОбновитьЛимитыИзОтвета(СостояниеЛимита, Ответ)

	ОбновитьОстатокЛимита(СостояниеЛимита, Ответ);
	ОбновитьДатуСбросаЛимита(СостояниеЛимита, Ответ);
	ОбновитьОжиданиеПоRetryAfter(СостояниеЛимита, Ответ);

КонецПроцедуры

Процедура ОбновитьОжиданиеПоRetryAfter(СостояниеЛимита, Ответ)

	RetryAfter = ЗначениеЗаголовка(Ответ, "Retry-After");
	Если Не ЗначениеЗаполнено(RetryAfter) Тогда
		Возврат;
	КонецЕсли;

	ОписаниеТипа = Новый ОписаниеТипов("Число");
	ЗадержкаМс = ОписаниеТипа.ПривестиЗначение(RetryAfter) * 1000;
	СостояниеЛимита.ОжиданиеДоМс = ТекущаяУниверсальнаяДатаВМиллисекундах() + ЗадержкаМс;

КонецПроцедуры

Процедура ОбновитьОстатокЛимита(СостояниеЛимита, Ответ)

	СостояниеЛимита.Остаток = 0;

	Остаток = ЗначениеЗаголовка(Ответ, "X-RateLimit-Remaining");
	Если ЗначениеЗаполнено(Остаток) Тогда
		СостояниеЛимита.Остаток = Макс(Число(Остаток), 0);
	КонецЕсли;

КонецПроцедуры

Процедура ОбновитьДатуСбросаЛимита(СостояниеЛимита, Ответ)

	СостояниеЛимита.ДатаСброса = '00010101';

	ДатаСброса = ЗначениеЗаголовка(Ответ, "X-RateLimit-Reset");
	Если ЗначениеЗаполнено(ДатаСброса) Тогда
		СостояниеЛимита.ДатаСброса = TimestampВДату(ДатаСброса);
	КонецЕсли;

КонецПроцедуры

Процедура ОбработатьВременнуюОшибкуЕслиНужно(ИмяОперации, Ответ, ЭтоGraphQL = Ложь)

	Если Ответ = Неопределено Тогда
		РекомендованнаяЗадержка = ОсталосьЖдатьДоСброса(ИмяОперации);
		СохранитьСостояниеОшибкиОперации(
			ИмяОперации,
			Истина,
			РекомендованнаяЗадержка > 0,
			РекомендованнаяЗадержка,
			"Запрос к GitHub не был выполнен из-за локального ограничения лимита."
		);

		ВызватьИсключение "Запрос к GitHub не выполнен из-за ограничения лимита.";
	КонецЕсли;

	СостояниеОшибки = ОпределитьСостояниеОшибкиПоОтвету(ИмяОперации, Ответ, ЭтоGraphQL);
	Если СостояниеОшибки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СохранитьСостояниеОшибкиОперации(
		ИмяОперации,
		СостояниеОшибки.Временная,
		СостояниеОшибки.Повторять,
		СостояниеОшибки.РекомендованнаяЗадержка,
		СостояниеОшибки.Текст,
		СостояниеОшибки.КодСостояния
	);

	ВызватьИсключение СостояниеОшибки.Текст;

КонецПроцедуры

Функция ОпределитьСостояниеОшибкиПоОтвету(ИмяОперации, Ответ, ЭтоGraphQL = Ложь)

	КодСостояния = Ответ.КодСостояния;
	ЭтоОшибкаСервера = КодСостояния >= 500;
	ЭтоСлишкомМногоЗапросов = КодСостояния = 429;
	ЭтоОграничениеЛимита = ЭтоСлишкомМногоЗапросов Или ЭтоОшибкаСервера;

	ДанныеОтвета = Неопределено;
	Если ЭтоGraphQL Или КодСостояния = 403 Или КодСостояния = 429 Тогда
		ДанныеОтвета = БезопасноПрочитатьJson(Ответ);
	КонецЕсли;

	Если КодСостояния = 403 И ЭтоПохожеНаОграничениеЛимита(Ответ, ДанныеОтвета, ЭтоGraphQL) Тогда
		ЭтоОграничениеЛимита = Истина;
	КонецЕсли;

	Если КодСостояния = 200
		И ЭтоGraphQL
		И ЭтоПохожеНаОграничениеЛимита(Ответ, ДанныеОтвета, Истина, Ложь) Тогда

		ЭтоОграничениеЛимита = Истина;
	КонецЕсли;

	Если Не ЭтоОграничениеЛимита Тогда
		Возврат Неопределено;
	КонецЕсли;

	РекомендованнаяЗадержка = ОпределитьРекомендованнуюЗадержку(
		ИмяОперации,
		Ответ,
		ДанныеОтвета,
		ЭтоGraphQL
	);
	Сообщение = ?(
		КодСостояния = 200 И ЭтоGraphQL,
		"GitHub GraphQL временно отклонил запрос из-за ограничения лимита.",
		СтрШаблон("GitHub временно вернул код состояния %1.", КодСостояния)
	);

	СостояниеОшибки = Новый Структура();
	СостояниеОшибки.Вставить("Временная", Истина);
	СостояниеОшибки.Вставить("Повторять", ЭтоОшибкаСервера Или ЭтоСлишкомМногоЗапросов Или РекомендованнаяЗадержка > 0);
	СостояниеОшибки.Вставить("РекомендованнаяЗадержка", РекомендованнаяЗадержка);
	СостояниеОшибки.Вставить("Текст", Сообщение);
	СостояниеОшибки.Вставить("КодСостояния", КодСостояния);

	Возврат СостояниеОшибки;

КонецФункции

Функция ЭтоПохожеНаОграничениеЛимита(
	Ответ,
	ДанныеОтвета = Неопределено,
	ЭтоGraphQL = Ложь,
	УчитыватьЯвныеЗаголовки = Истина)

	Если Ответ = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Если УчитыватьЯвныеЗаголовки И ЕстьЯвныеЗаголовкиОграничения(Ответ) Тогда
		Возврат Истина;
	КонецЕсли;

	Если ДанныеОтвета = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Сообщение = "";
	Если ЗначениеЗаполнено(ДанныеОтвета["message"]) Тогда
		Сообщение = ДанныеОтвета["message"];
	ИначеЕсли ЭтоGraphQL И ЗначениеЗаполнено(ДанныеОтвета["errors"]) Тогда
		Сообщение = ПолучитьТекстОшибокGraphQL(ДанныеОтвета["errors"]);
	КонецЕсли;

	Сообщение = НРег(Сообщение);

	Возврат СтрНайти(Сообщение, "rate limit") > 0
		Или СтрНайти(Сообщение, "secondary rate limit") > 0;

КонецФункции

Функция ЕстьЯвныеЗаголовкиОграничения(Ответ)

	ОстатокЛимита = ЗначениеЗаголовка(Ответ, "X-RateLimit-Remaining");
	RetryAfter = ЗначениеЗаголовка(Ответ, "Retry-After");
	СбросЛимита = ЗначениеЗаголовка(Ответ, "X-RateLimit-Reset");

	Возврат RetryAfter <> ""
		Или (ОстатокЛимита = "0" И СбросЛимита <> "");

КонецФункции

Функция ОпределитьРекомендованнуюЗадержку(
	ИмяОперации,
	Ответ,
	ДанныеОтвета = Неопределено,
	ЭтоGraphQL = Ложь)

	RetryAfter = ЗначениеЗаголовка(Ответ, "Retry-After");
	Если ЗначениеЗаполнено(RetryAfter) Тогда
		ОписаниеТипа = Новый ОписаниеТипов("Число");
		Возврат ОписаниеТипа.ПривестиЗначение(RetryAfter) * 1000;
	КонецЕсли;

	ОстатокЛимита = ЗначениеЗаголовка(Ответ, "X-RateLimit-Remaining");
	Если ОстатокЛимита = "0" Тогда
		ОсталосьЖдатьПоЛимиту = ОсталосьЖдатьДоСброса(ИмяОперации);
		Если ОсталосьЖдатьПоЛимиту > 0 Тогда
			Возврат ОсталосьЖдатьПоЛимиту;
		КонецЕсли;
	КонецЕсли;

	Если ДанныеОтвета <> Неопределено Тогда
		Сообщение = "";
		Если ЗначениеЗаполнено(ДанныеОтвета["message"]) Тогда
			Сообщение = НРег(ДанныеОтвета["message"]);
		ИначеЕсли ЭтоGraphQL И ЗначениеЗаполнено(ДанныеОтвета["errors"]) Тогда
			Сообщение = НРег(ПолучитьТекстОшибокGraphQL(ДанныеОтвета["errors"]));
		КонецЕсли;

		Если СтрНайти(Сообщение, "secondary rate limit") > 0 Тогда
			Возврат _МинимальнаяЗадержкаВторичногоЛимитаМс;
		КонецЕсли;
	КонецЕсли;

	Возврат 0;

КонецФункции

Функция БезопасноПрочитатьJson(Ответ)

	Попытка
		Возврат Ответ.Json();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

Функция ПолучитьТекстОшибокGraphQL(КоллекцияОшибокGraphQL)

	Сообщения = Новый Массив();

	Для Каждого ОшибкаGraphQL Из КоллекцияОшибокGraphQL Цикл
		Если ЗначениеЗаполнено(ОшибкаGraphQL["message"]) Тогда
			Сообщения.Добавить(ОшибкаGraphQL["message"]);
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Сообщения, " ");

КонецФункции

Функция ЗначениеЗаголовка(Ответ, ИмяЗаголовка)

	Если Ответ = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Значение = Ответ.Заголовки.Получить(ИмяЗаголовка);
	Если Значение = Неопределено Тогда
		Значение = Ответ.Заголовки.Получить(НРег(ИмяЗаголовка));
	КонецЕсли;

	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

Функция TimestampВДату(Значение)
	Возврат Дата(1970, 1, 1) + Число(Значение);
КонецФункции

Функция ОсталосьЖдатьДоСброса(ИмяОперации)

	_БлокировкаHTTP.Заблокировать();

	Попытка
		СостояниеЛимита = ПолучитьСостояниеЛимита(ИмяОперации);
		Результат = Макс(
			СостояниеЛимита.ОжиданиеДоМс - ТекущаяУниверсальнаяДатаВМиллисекундах(),
			0
		);

		Если СостояниеЛимита.Остаток = 0
			И СостояниеЛимита.ДатаСброса > ТекущаяУниверсальнаяДата() Тогда
			ОжиданиеСбросаМс = Цел((СостояниеЛимита.ДатаСброса - ТекущаяУниверсальнаяДата()) * 1000);
			Результат = Макс(Результат, ОжиданиеСбросаМс);
		КонецЕсли;
	Исключение
		_БлокировкаHTTP.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаHTTP.Разблокировать();

	Возврат Результат;

КонецФункции

Функция СоздатьСостояниеЛимита()

	Возврат Новый Структура("Остаток, ДатаСброса, ОжиданиеДоМс", 0, '00010101', 0);

КонецФункции

Функция ПолучитьСостояниеЛимита(ИмяОперации)

	СостояниеЛимита = _СостоянияЛимитов.Получить(ИмяОперации);
	Если СостояниеЛимита = Неопределено Тогда
		СостояниеЛимита = СоздатьСостояниеЛимита();
		_СостоянияЛимитов.Вставить(ИмяОперации, СостояниеЛимита);
	КонецЕсли;

	Возврат СостояниеЛимита;

КонецФункции

Процедура СохранитьСостояниеОшибкиОперации(
	ИмяОперации,
	Временная,
	Повторять,
	РекомендованнаяЗадержка,
	Текст,
	КодСостояния = 0,
	ДанныеОшибки = Неопределено)

	СостояниеОшибки = Новый Структура();
	СостояниеОшибки.Вставить("Временная", Временная);
	СостояниеОшибки.Вставить("Повторять", Повторять);
	СостояниеОшибки.Вставить("РекомендованнаяЗадержка", РекомендованнаяЗадержка);
	СостояниеОшибки.Вставить("Текст", Текст);
	СостояниеОшибки.Вставить("КодСостояния", КодСостояния);
	СостояниеОшибки.Вставить("ДанныеОшибки", ДанныеОшибки);

	_БлокировкаСостоянийОшибок.Заблокировать();

	Попытка
		_СостоянияОшибокОпераций.Вставить(ИмяОперации, СостояниеОшибки);
	Исключение
		_БлокировкаСостоянийОшибок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаСостоянийОшибок.Разблокировать();

КонецПроцедуры

Процедура ОчиститьСостояниеОшибкиОперации(ИмяОперации)

	_БлокировкаСостоянийОшибок.Заблокировать();

	Попытка
		_СостоянияОшибокОпераций.Удалить(ИмяОперации);
	Исключение
		_БлокировкаСостоянийОшибок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаСостоянийОшибок.Разблокировать();

КонецПроцедуры

Функция ПолучитьСостояниеОшибкиОперации(ИмяОперации)

	СостояниеОшибки = Неопределено;

	_БлокировкаСостоянийОшибок.Заблокировать();

	Попытка
		СостояниеОшибки = _СостоянияОшибокОпераций.Получить(ИмяОперации);
	Исключение
		_БлокировкаСостоянийОшибок.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	_БлокировкаСостоянийОшибок.Разблокировать();

	Возврат СостояниеОшибки;

КонецФункции

#КонецОбласти
