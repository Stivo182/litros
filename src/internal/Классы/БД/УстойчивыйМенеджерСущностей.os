#Использовать resilience

Перем _Настройки; // НастройкиОтказоустойчивостиБД
Перем _Классификатор; // КлассификаторОшибокSQLite
Перем _КоординаторОперацийБД; // КоординаторОперацийБД
Перем _Пайплайн; // ПайплайнОтказоустойчивости

#Область ОбработчикиСобытий

// Создает устойчивый прикладной фасад менеджера сущностей.
//
// Параметры:
//   Настройки - НастройкиОтказоустойчивостиБД - Настройки pipeline.
//   Классификатор - КлассификаторОшибокSQLite - Классификатор временных ошибок.
//   КоординаторОперацийБД - КоординаторОперацийБД - Координатор операций и состояния БД.
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин("НастройкиОтказоустойчивостиБД") Настройки,
	&Пластилин("КлассификаторОшибокSQLite") Классификатор,
	&Пластилин("КоординаторОперацийБД") КоординаторОперацийБД)

	_Настройки = Настройки;
	_Классификатор = Классификатор;
	_КоординаторОперацийБД = КоординаторОперацийБД;
	_Пайплайн = СоздатьПайплайн();

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Получает сущности через отказоустойчивый pipeline.
//
// Параметры:
//   ТипСущности - Тип - Тип сущности.
//   ОпцииПоиска - ОпцииПоиска, Неопределено - Условия поиска.
//
// Возвращаемое значение:
//   Массив - Найденные сущности.
Функция Получить(ТипСущности, ОпцииПоиска = Неопределено) Экспорт
	Параметры = Новый Массив();
	Параметры.Добавить(ТипСущности);
	Параметры.Добавить(ОпцииПоиска);
	Возврат ВыполнитьПростуюОперацию("Получить", Параметры);
КонецФункции

// Получает одну сущность через отказоустойчивый pipeline.
//
// Параметры:
//   ТипСущности - Тип - Тип сущности.
//   ОпцииПоиска - ОпцииПоиска, Неопределено - Условия поиска.
//
// Возвращаемое значение:
//   Произвольный, Неопределено - Найденная сущность.
Функция ПолучитьОдно(ТипСущности, ОпцииПоиска = Неопределено) Экспорт
	Параметры = Новый Массив();
	Параметры.Добавить(ТипСущности);
	Параметры.Добавить(ОпцииПоиска);
	Возврат ВыполнитьПростуюОперацию("ПолучитьОдно", Параметры);
КонецФункции

// Сохраняет сущность через отказоустойчивый pipeline.
//
// Параметры:
//   Сущность - Произвольный - Сохраняемая сущность.
Процедура Сохранить(Сущность) Экспорт
	ВыполнитьПростуюОперацию("Сохранить", Сущность);
КонецПроцедуры

// Удаляет сущность через отказоустойчивый pipeline.
//
// Параметры:
//   Сущность - Произвольный - Удаляемая сущность.
Процедура Удалить(Сущность) Экспорт
	ВыполнитьПростуюОперацию("Удалить", Сущность);
КонецПроцедуры

// Выполняет SQL через отказоустойчивый pipeline.
//
// Параметры:
//   ТекстЗапроса - Строка - SQL-запрос.
//
// Возвращаемое значение:
//   ТаблицаЗначений - Результат запроса.
Функция ВыполнитьЗапрос(ТекстЗапроса) Экспорт
	Возврат ВыполнитьПростуюОперацию("ВыполнитьЗапрос", ТекстЗапроса);
КонецФункции

// Выполняет действие в транзакции и повторяет всю транзакцию после временной ошибки.
//
// Параметры:
//   Операция - Действие - Callback; первым аргументом получает ТранзакционныйДоступКБД.
//   Параметры - Массив, ФиксированныйМассив, Произвольный, Неопределено - Аргументы callback.
//
// Возвращаемое значение:
//   Произвольный - Результат callback.
Функция ВыполнитьВТранзакции(Операция, Параметры = Неопределено) Экспорт

	_КоординаторОперацийБД.ПроверитьРаботоспособность();

	Команда = Новый КомандаОперацииБД("ВыполнитьВТранзакции", Параметры, Операция);

	Возврат ВыполнитьКоманду(Команда);

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Определяет, нужно ли повторить операцию после текущей попытки.
//
// Параметры:
//   КонтекстПопыткиПовтора - КонтекстПопыткиПовтора - Результат текущей попытки.
//
// Возвращаемое значение:
//   Булево - Истина, если ошибка временная и операцию нужно повторить.
Функция НужноПовторитьОперацию(КонтекстПопыткиПовтора) Экспорт

	Если Не КонтекстПопыткиПовтора.ЕстьИсключение() Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат _Классификатор.ЭтоВременнаяОшибка(
		КонтекстПопыткиПовтора.ДанныеОшибки());

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыполнитьПростуюОперацию(ИмяОперации, Параметры)

	_КоординаторОперацийБД.ПроверитьРаботоспособность();
	Команда = Новый КомандаОперацииБД(ИмяОперации, Параметры);

	Возврат ВыполнитьКоманду(Команда);

КонецФункции

Функция ВыполнитьКоманду(Команда)
	Возврат ВыполнитьОперацию(
		Новый Действие(_КоординаторОперацийБД, "Исполнить"), Команда);
КонецФункции

Функция ВыполнитьОперацию(Операция, Параметры = Неопределено)
	Возврат _Пайплайн.Запустить(Операция, Параметры);
КонецФункции

Функция СоздатьПайплайн()

	СтратегияПовтора = Новый СтратегияПовтора(
		_Настройки.КоличествоПовторов,
		_Настройки.БазоваяЗадержкаПовтораМс
	)
		.УстановитьТипЗадержки(ТипыРасчетаЗадержки.Экспоненциальная)
		.ИспользоватьРазбросЗадержки()
		.УстановитьМаксимальнуюЗадержку(_Настройки.МаксимальнаяЗадержкаПовтораМс)
		.УстановитьУсловиеПовтора(Новый Действие(ЭтотОбъект, "НужноПовторитьОперацию"));

	СтратегияОграниченияПараллелизма = Новый СтратегияОграниченияПараллелизма(1, _Настройки.ЛимитОчереди)
		.УстановитьМаксимальноеОжиданиеСлота(_Настройки.МаксимальноеОжиданиеСлотаМс);

	Возврат Новый ПайплайнОтказоустойчивости()
		.ДобавитьСтратегию(СтратегияПовтора)
		.ДобавитьСтратегию(СтратегияОграниченияПараллелизма);

КонецФункции

#КонецОбласти
