// Число - Максимальное ожидание освобождения занятой базы данных.
&Деталька(Значение = "litros.db.ТаймаутЗанятостиМс", ЗначениеПоУмолчанию = 1000)
Перем ТаймаутЗанятостиМс Экспорт;

// Число - Количество повторов временно неуспешной операции базы данных.
&Деталька(Значение = "litros.db.КоличествоПовторов", ЗначениеПоУмолчанию = 3)
Перем КоличествоПовторов Экспорт;

// Число - Базовая задержка повтора операции базы данных.
&Деталька(Значение = "litros.db.БазоваяЗадержкаПовтораМс", ЗначениеПоУмолчанию = 50)
Перем БазоваяЗадержкаПовтораМс Экспорт;

// Число - Максимальная задержка повтора операции базы данных.
&Деталька(Значение = "litros.db.МаксимальнаяЗадержкаПовтораМс", ЗначениеПоУмолчанию = 500)
Перем МаксимальнаяЗадержкаПовтораМс Экспорт;

// Число - Максимальное количество операций в очереди базы данных.
&Деталька(Значение = "litros.db.ЛимитОчереди", ЗначениеПоУмолчанию = 32)
Перем ЛимитОчереди Экспорт;

// Число - Максимальное ожидание слота для выполнения операции базы данных.
&Деталька(Значение = "litros.db.МаксимальноеОжиданиеСлотаМс", ЗначениеПоУмолчанию = 10000)
Перем МаксимальноеОжиданиеСлотаМс Экспорт;

// Булево - Признак использования журналирования WAL.
&Деталька(Значение = "litros.db.ИспользоватьWAL", ЗначениеПоУмолчанию = Истина)
Перем ИспользоватьWAL Экспорт;

#Область ОбработчикиСобытий

// Создает настройки отказоустойчивости базы данных со значениями по умолчанию.
&Желудь
Процедура ПриСозданииОбъекта()

	ТаймаутЗанятостиМс = 1000;
	КоличествоПовторов = 3;
	БазоваяЗадержкаПовтораМс = 50;
	МаксимальнаяЗадержкаПовтораМс = 500;
	ЛимитОчереди = 32;
	МаксимальноеОжиданиеСлотаМс = 10000;
	ИспользоватьWAL = Истина;

КонецПроцедуры

#КонецОбласти
