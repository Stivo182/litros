#Использовать reflector

Перем _Контекст; // КонтекстУстойчивогоМенеджераСущностей
Перем _Операция; // Действие
Перем _Параметры; // Произвольный, Неопределено

#Область ОбработчикиСобытий

// Создает внутреннюю операцию одной полной попытки транзакции.
Процедура ПриСозданииОбъекта(Контекст, Операция, Параметры = Неопределено)
	_Контекст = Контекст;
	_Операция = Операция;
	_Параметры = Параметры;
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Выполняет BEGIN, callback и COMMIT внутри одного executor-слота.
Функция Исполнить() Экспорт
	Менеджер = _Контекст.ПолучитьМенеджер();
	Менеджер.НачатьТранзакцию();
	ДоступКБД = Новый ТранзакционныйДоступКБД(Менеджер);
	Попытка
		Результат = ВызватьОперацию(ДоступКБД);
		Менеджер.ЗафиксироватьТранзакцию();
	Исключение
		ИсходнаяОшибка = ИнформацияОбОшибке();
		Попытка
			Менеджер.ОтменитьТранзакцию();
		Исключение
			ОшибкаRollback = ИнформацияОбОшибке();
			ДоступКБД.Деактивировать();
			ОбработатьНеудачныйRollback(Менеджер, ИсходнаяОшибка, ОшибкаRollback);
		КонецПопытки;
		ДоступКБД.Деактивировать();
		ВызватьИсключение ИсходнаяОшибка;
	КонецПопытки;
	ДоступКБД.Деактивировать();
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВызватьОперацию(ДоступКБД)
	ПараметрыВызова = Новый Массив();
	ПараметрыВызова.Добавить(ДоступКБД);
	Если _Параметры <> Неопределено Тогда
		Если ТипЗнч(_Параметры) = Тип("Массив")
			Или ТипЗнч(_Параметры) = Тип("ФиксированныйМассив") Тогда
			Для Каждого Параметр Из _Параметры Цикл
				ПараметрыВызова.Добавить(Параметр);
			КонецЦикла;
		Иначе
			ПараметрыВызова.Добавить(_Параметры);
		КонецЕсли;
	КонецЕсли;
	Возврат Новый Рефлектор().ВызватьМетод(_Операция, "Выполнить", ПараметрыВызова);
КонецФункции

Процедура ОбработатьНеудачныйRollback(Менеджер, ИсходнаяОшибка, ОшибкаRollback)
	ОшибкаЗакрытия = Неопределено;
	Попытка
		Менеджер.Закрыть();
	Исключение
		ОшибкаЗакрытия = ИнформацияОбОшибке();
	КонецПопытки;
	ДиагностикаЗакрытия = "";
	Если ОшибкаЗакрытия <> Неопределено Тогда
		ДиагностикаЗакрытия = СтрШаблон("%1Ошибка закрытия:%1%2",
			Символы.ПС, ПодробноеПредставлениеОшибки(ОшибкаЗакрытия));
	КонецЕсли;
	ОписаниеОшибки = СтрШаблон(
		"litros_db_rollback_failed: состояние транзакции неизвестно; пересоздать контекст Autumn или перезапустить приложение.%1Исходная ошибка:%1%2%1Ошибка rollback:%1%3%4",
		Символы.ПС,
		ПодробноеПредставлениеОшибки(ИсходнаяОшибка),
		ПодробноеПредставлениеОшибки(ОшибкаRollback),
		ДиагностикаЗакрытия);
	_Контекст.УстановитьФатальнуюОшибку(ОписаниеОшибки);
	ВызватьИсключение ОписаниеОшибки;
КонецПроцедуры

#КонецОбласти
