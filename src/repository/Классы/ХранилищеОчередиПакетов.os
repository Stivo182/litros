#Использовать entity
#Использовать "../../dto"
#Использовать "../../db"

Перем _ПулМенеджеровСущностей; // ПулМенеджеровСущностей

#Область ОбработчикиСобытий

// Создает хранилище очереди пакетов.
//
// Параметры:
//   ПулМенеджеровСущностей - ПулМенеджеровСущностей - Пул доступа к БД.
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин("ПулМенеджеровСущностей") ПулМенеджеровСущностей)

	_ПулМенеджеровСущностей = ПулМенеджеровСущностей;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Добавляет пакет в очередь, если он еще не ожидает обработки.
//
// Параметры:
//   ИмяПакета - Строка - Имя добавляемого пакета.
//
// Возвращаемое значение:
//   Булево - Истина, если пакет добавлен; Ложь, если он уже находился в очереди.
Функция Добавить(Знач ИмяПакета) Экспорт

	ИмяПакета = РаботаСДаннымиБД.НормализироватьИмяПакета(ИмяПакета);

	Возврат _ПулМенеджеровСущностей.ВыполнитьВТранзакции(
		Новый Действие(ЭтотОбъект, "ДобавитьВТранзакции"), ИмяПакета);

КонецФункции

// Возвращает имена пакетов, дольше всего ожидающих обработки.
//
// Параметры:
//   РазмерВыборки - Число - Максимальное количество возвращаемых имен.
//
// Возвращаемое значение:
//   Массив из Строка - Имена пакетов в порядке добавления в очередь.
Функция ПолучитьПачку(РазмерВыборки) Экспорт

	ОпцииПоиска = Новый ОпцииПоиска();
	ОпцииПоиска.Первые(РазмерВыборки);
	ОпцииПоиска.СортироватьПо("ДатаДобавления", НаправлениеСортировки.Возр);

	ОчередьПакетов = _ПулМенеджеровСущностей.Получить(
		Тип("СущностьОчередьПакета"), ОпцииПоиска);
	ИменаПакетов = Новый Массив();
	Для Каждого ОчередьПакета Из ОчередьПакетов Цикл
		ИменаПакетов.Добавить(ОчередьПакета.ИмяПакета);
	КонецЦикла;

	Возврат ИменаПакетов;

КонецФункции

// Удаляет пакет из очереди, если он еще присутствует.
//
// Параметры:
//   ИмяПакета - Строка - Имя удаляемого пакета.
Процедура Удалить(Знач ИмяПакета) Экспорт

	ИмяПакета = РаботаСДаннымиБД.НормализироватьИмяПакета(ИмяПакета);
	ОпцииПоиска = Новый ОпцииПоиска();
	ОпцииПоиска.Отбор("ИмяПакета", ВидСравнения.Равно, ИмяПакета);

	ОчередьПакета = _ПулМенеджеровСущностей.ПолучитьОдно(
		Тип("СущностьОчередьПакета"), ОпцииПоиска);
	Если ОчередьПакета = Неопределено Тогда
		Возврат;
	КонецЕсли;

	_ПулМенеджеровСущностей.Удалить(ОчередьПакета);

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Проверяет отсутствие пакета и сохраняет новый элемент в текущей транзакции.
//
// Параметры:
//   ДоступКБД - ТранзакционныйДоступКБД - Ограниченный доступ к текущей транзакции.
//   ИмяПакета - Строка - Нормализованное имя пакета.
//
// Возвращаемое значение:
//   Булево - Истина, если пакет добавлен; Ложь, если он уже находился в очереди.
Функция ДобавитьВТранзакции(ДоступКБД, ИмяПакета) Экспорт

	ОпцииПоиска = Новый ОпцииПоиска();
	ОпцииПоиска.Отбор("ИмяПакета", ВидСравнения.Равно, ИмяПакета);

	ОчередьПакета = ДоступКБД.ПолучитьОдно(
		Тип("СущностьОчередьПакета"), ОпцииПоиска);
	Если ОчередьПакета <> Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ОчередьПакета = Новый СущностьОчередьПакета();
	ОчередьПакета.ИмяПакета = ИмяПакета;
	ОчередьПакета.ДатаДобавления = РаботаСДаннымиБД.НормализоватьУниверсальнуюДату(
		ТекущаяУниверсальнаяДата());

	ДоступКБД.Сохранить(ОчередьПакета);

	Возврат Истина;

КонецФункции

#КонецОбласти
