#Использовать entity
#Использовать collectionos
#Использовать "../../dto"
#Использовать "../../db"

Перем _ПулМенеджеровСущностей; // ПулМенеджеровСущностей
Перем _ХранилищеРепозиториев; // ХранилищеРепозиториев

#Область ОбработчикиСобытий

// Создает хранилище зависимых репозиториев.
//
// Параметры:
//   ПулМенеджеровСущностей - ПулМенеджеровСущностей - Пул доступа к БД.
//   ХранилищеРепозиториев - ХранилищеРепозиториев - Хранилище данных репозиториев.
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин("ПулМенеджеровСущностей") ПулМенеджеровСущностей,
	&Пластилин("ХранилищеРепозиториев") ХранилищеРепозиториев)

	_ПулМенеджеровСущностей = ПулМенеджеровСущностей;
	_ХранилищеРепозиториев = ХранилищеРепозиториев;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Сохраняет репозитории, зависящих от пакета
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета
//   ЗависимыеРепозитории - Массив из Структура - Список репозиториев:
//     * Идентификатор - Строка - Глобальный идентификатор GitHub
//     * Имя           - Строка - Короткое имя репозитория. Пустая строка, если неизвестно
//     * URL           - Строка - URL репозитория
//     * ПолноеИмя     - Строка - Полное имя репозитория
//     * Владелец      - Строка - Логин владельца
//     * ЭтоФорк       - Булево - Признак форка
Процедура Сохранить(Знач ИмяПакета, ЗависимыеРепозитории) Экспорт

	ИмяПакета = РаботаСДаннымиБД.НормализироватьИмяПакета(ИмяПакета);

	Параметры = Новый Массив();
	Параметры.Добавить(ИмяПакета);
	Параметры.Добавить(ЗависимыеРепозитории);

	Попытка
		_ПулМенеджеровСущностей.ВыполнитьВТранзакции(Новый Действие(ЭтотОбъект, "СохранитьВТранзакции"), Параметры);
	Исключение
		ВызватьИсключение СтрШаблон("Ошибка при сохранении зависимых репозиториев пакета %1: %2",
			ИмяПакета,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())
		);
	КонецПопытки;

КонецПроцедуры

// Возвращает количество репозиториев, зависящих от пакета 
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета
//
// Возвращаемое значение:
//   Число, Неопределено
Функция КоличествоРепозиториев(Знач ИмяПакета) Экспорт

	ИмяПакета = РаботаСДаннымиБД.НормализироватьИмяПакета(ИмяПакета);

	ОпцииПоиска = Новый ОпцииПоиска();
	ОпцииПоиска.Отбор("ИмяПакета", ВидСравнения.Равно, ИмяПакета);

	СтатистикаПакета = _ПулМенеджеровСущностей.ПолучитьОдно(Тип("СущностьСтатистикаПакета"), ОпцииПоиска);

	Если Не СтатистикаПакета = Неопределено Тогда
		Возврат СтатистикаПакета.КоличествоОбратныхЗависимостей;
	КонецЕсли;

КонецФункции

// Возвращает описания репозиториев, зависящих от пакета
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета
//   Сортировка - Строка - Список имён полей с указанием направления сортировки, разделённых запятыми
//
// Возвращаемое значение:
//   Массив из СущностьРепозиторий
Функция ПолучитьРепозитории(Знач ИмяПакета, Сортировка = "") Экспорт

	ИмяПакета = РаботаСДаннымиБД.НормализироватьИмяПакета(ИмяПакета);

	ОпцииПоиска = Новый ОпцииПоиска();
	ОпцииПоиска.Отбор("ИмяПакета", ВидСравнения.Равно, ИмяПакета);

	Репозитории = _ПулМенеджеровСущностей.Получить(Тип("СущностьЗависимыйРепозиторий"), ОпцииПоиска);

	Идентификаторы = Новый Массив();
	Для Каждого Элемент Из Репозитории Цикл
		Идентификаторы.Добавить(Элемент.ИдентификаторРепозитория);
	КонецЦикла;

	Возврат _ХранилищеРепозиториев.ПолучитьРепозитории(Идентификаторы, Сортировка);

КонецФункции

// Возвращает список имен пакетов, требующих обновления на указанную дату.
//
// Параметры:
//   НаДату - Дата - Дата, на которую необходимо определить актуальные пакеты для обновления
//   РазмерВыборки - Число - Максимальное количество возвращаемых пакетов
//
// Возвращаемое значение:
//   Массив из Строка
Функция ПолучитьПакетыДляОбновления(НаДату, РазмерВыборки) Экспорт
		
	ДатаОкончания = РаботаСДаннымиБД.НормализоватьУниверсальнуюДату(НаДату);

	ОпцииПоиска = Новый ОпцииПоиска();
	ОпцииПоиска.Первые(РазмерВыборки);
	ОпцииПоиска.Отбор("ДатаОбновления", ВидСравнения.МеньшеИлиРавно, ДатаОкончания);
	ОпцииПоиска.СортироватьПо("ДатаОбновления", НаправлениеСортировки.Возр);

	СтатистикаПакетов = _ПулМенеджеровСущностей.Получить(Тип("СущностьСтатистикаПакета"), ОпцииПоиска);

	Результат = Новый Массив();
	Для Каждого СтатистикаПакета Из СтатистикаПакетов Цикл
		Результат.Добавить(СтатистикаПакета.ИмяПакета);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверяет есть ли данные по пакету 
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета
//
// Возвращаемое значение:
//   Булево
Функция ЕстьДанныеПоПакету(ИмяПакета) Экспорт
	Возврат КоличествоРепозиториев(ИмяПакета) <> Неопределено;
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Сохраняет статистику, зависимости и новые репозитории в одной попытке транзакции.
//
// Параметры:
//   ДоступКБД - ТранзакционныйДоступКБД - Ограниченный доступ к текущей транзакции.
//   ИмяПакета - Строка - Нормализованное имя пакета.
//   ЗависимыеРепозитории - Массив из Структура - Описания зависимых репозиториев:
//     * Идентификатор - Строка - Глобальный идентификатор GitHub.
//     * Имя           - Строка - Короткое имя репозитория. Пустая строка, если неизвестно.
//     * URL           - Строка - URL репозитория.
//     * ПолноеИмя     - Строка - Полное имя репозитория.
//     * Владелец      - Строка - Логин владельца.
//     * ЭтоФорк       - Булево - Признак форка.
Процедура СохранитьВТранзакции(ДоступКБД, ИмяПакета, ЗависимыеРепозитории) Экспорт
	КоличествоОбратныхЗависимостей = ЗависимыеРепозитории.Количество();
	ОбновитьСтатистикуПакета(ДоступКБД, ИмяПакета, КоличествоОбратныхЗависимостей);
	ОбновитьЗависимыеРепозитории(ДоступКБД, ИмяПакета, ЗависимыеРепозитории);
	ДобавитьНовыеРепозитории(ДоступКБД, ЗависимыеРепозитории);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбновитьСтатистикуПакета(ДоступКБД, ИмяПакета, КоличествоОбратныхЗависимостей)
	
	ОпцииПоиска = Новый ОпцииПоиска();
	ОпцииПоиска.Отбор("ИмяПакета", ВидСравнения.Равно, ИмяПакета);

	СтатистикаПакета = ДоступКБД.ПолучитьОдно(Тип("СущностьСтатистикаПакета"), ОпцииПоиска);
	Если СтатистикаПакета = Неопределено Тогда
		СтатистикаПакета = Новый СущностьСтатистикаПакета();
		СтатистикаПакета.ИмяПакета = ИмяПакета;
		СтатистикаПакета.ДатаДобавления = РаботаСДаннымиБД.НормализоватьУниверсальнуюДату(ТекущаяУниверсальнаяДата());
	КонецЕсли;

	СтатистикаПакета.ДатаОбновления = РаботаСДаннымиБД.НормализоватьУниверсальнуюДату(ТекущаяУниверсальнаяДата());
	СтатистикаПакета.КоличествоОбратныхЗависимостей = КоличествоОбратныхЗависимостей;
	
	ДоступКБД.Сохранить(СтатистикаПакета);

КонецПроцедуры

Процедура ОбновитьЗависимыеРепозитории(ДоступКБД, ИмяПакета, ЗависимыеРепозитории)

	УдалитьЗависимыеРепозитории(ДоступКБД, ИмяПакета);

	Для Каждого ОписаниеРепозитория Из ЗависимыеРепозитории Цикл

		Если Не ЗначениеЗаполнено(ОписаниеРепозитория.Идентификатор) Тогда
			Продолжить;
		КонецЕсли;

		ЗависимыйРепозиторий = Новый СущностьЗависимыйРепозиторий();
		ЗависимыйРепозиторий.ИдентификаторРепозитория = ОписаниеРепозитория.Идентификатор;
		ЗависимыйРепозиторий.ИмяПакета = ИмяПакета;

		ДоступКБД.Сохранить(ЗависимыйРепозиторий);

	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьЗависимыеРепозитории(ДоступКБД, ИмяПакета)

	ОпцииПоиска = Новый ОпцииПоиска();
	ОпцииПоиска.Отбор("ИмяПакета", ВидСравнения.Равно, ИмяПакета);

	Сущности = ДоступКБД.Получить(Тип("СущностьЗависимыйРепозиторий"), ОпцииПоиска);
	Для Каждого Сущность Из Сущности Цикл
		ДоступКБД.Удалить(Сущность);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьНовыеРепозитории(ДоступКБД, ЗависимыеРепозитории)

	ОписанияПоИдентификатору = СобратьОписанияПоИдентификатору(ЗависимыеРепозитории);
	Если ОписанияПоИдентификатору.Пусто() Тогда
		Возврат;
	КонецЕсли;

	ИсключитьСуществующиеРепозитории(ДоступКБД, ОписанияПоИдентификатору);

	Для Каждого ОписаниеРепозитория Из ОписанияПоИдентификатору.Значения() Цикл
		ДоступКБД.Сохранить(СоздатьРепозиторий(ОписаниеРепозитория));
	КонецЦикла;

КонецПроцедуры

Функция СобратьОписанияПоИдентификатору(ЗависимыеРепозитории)

	Результат = Новый КартаСоответствие();
	Для Каждого ОписаниеРепозитория Из ЗависимыеРепозитории Цикл
		Если Не ЗначениеЗаполнено(ОписаниеРепозитория.Идентификатор) Тогда
			Продолжить;
		КонецЕсли;

		Результат.Вставить(ОписаниеРепозитория.Идентификатор, ОписаниеРепозитория);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ИсключитьСуществующиеРепозитории(ДоступКБД, ОписанияПоИдентификатору)

	ОпцииПоиска = Новый ОпцииПоиска();
	ОпцииПоиска.Отбор("Идентификатор", ВидСравнения.В, ОписанияПоИдентификатору.Ключи().ВМассив());

	СуществующиеРепозитории = ДоступКБД.Получить(Тип("СущностьРепозиторий"), ОпцииПоиска);
	
	Для Каждого Репозиторий Из СуществующиеРепозитории Цикл
		ОписанияПоИдентификатору.Удалить(Репозиторий.Идентификатор);
	КонецЦикла;

КонецПроцедуры

Функция СоздатьРепозиторий(ОписаниеРепозитория)

	Репозиторий = Новый СущностьРепозиторий();
	Репозиторий.Идентификатор = ОписаниеРепозитория.Идентификатор;
	Репозиторий.ПолноеИмя = ОписаниеРепозитория.ПолноеИмя;
	Репозиторий.URL = ОписаниеРепозитория.URL;
	Репозиторий.Владелец = ОписаниеРепозитория.Владелец;
	Репозиторий.Имя = РаботаСДаннымиБД.НормализироватьИмяПакета(ОписаниеРепозитория.Имя);
	Репозиторий.ЭтоФорк = ОписаниеРепозитория.ЭтоФорк;
	Репозиторий.ДатаОбновления = РаботаСДаннымиБД.НормализоватьУниверсальнуюДату(ТекущаяУниверсальнаяДата());
	Репозиторий.ТребуетсяОбновление = Истина;

	Возврат Репозиторий;

КонецФункции

#КонецОбласти
