#Область Тесты

&Тест
Процедура ТестДолжен_ПовторитьВыборкуОднойПачкиПриВременнойБлокировкеБД() Экспорт

	// Подготовка
	Сценарий = Новый СценарийОчередиПакетов();
	Сценарий.НастроитьОшибкиВыборки(1, "database is locked");
	Процессор = СоздатьПроцессор(Сценарий, СоздатьИсполнитель(), Новый РегистраторЛогаОчереди());

	// Действие
	ОшибкаОбработки = ПолучитьОшибкуОбработкиОднойПачки(Процессор);

	// Проверка
	Ожидаем.Что(ОшибкаОбработки, "Временная блокировка выборки обработана исполнителем").ЭтоНеопределено();
	Ожидаем.Что(Сценарий.КоличествоВыборок(), "Выборка одной пачки повторена после блокировки").Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОбновитьПакетВнеФасадаИУдалитьУспешныйЧерезФасад() Экспорт

	// Подготовка
	Сценарий = Новый СценарийОчередиПакетов();
	Сценарий.ДобавитьПакетВПачку("test-package");
	Исполнитель = Новый РегистраторВызововИсполнителяБД();
	Обновлятор = Новый СценарийОбновленияПакета();
	Обновлятор.Настроить(Исполнитель, Истина);
	Процессор = СоздатьПроцессор(Сценарий, Исполнитель, Новый РегистраторЛогаОчереди(), Обновлятор);

	// Действие
	ОшибкаОбработки = ПолучитьОшибкуОбработкиОднойПачки(Процессор);

	// Проверка
	Ожидаем.Что(ОшибкаОбработки, "Одна пачка очереди обработана без ошибки").ЭтоНеопределено();
	Ожидаем.Что(Сценарий.КоличествоВыборок(), "Пачка очереди выбрана одной операцией БД").Равно(1);
	Ожидаем.Что(Обновлятор.КоличествоВызовов(), "Пакет обновлен один раз").Равно(1);
	Ожидаем.Что(Обновлятор.ВызванВнутриОперацииБД(), "Обновлятор вызван после завершения операции выборки").ЭтоЛожь();
	Ожидаем.Что(Сценарий.КоличествоУдалений(), "Успешно обновленный пакет удален из очереди").Равно(1);
	Ожидаем.Что(Исполнитель.КоличествоВызовов(), "Выборка и удаление выполнили две простые операции фасада").Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеУдалитьНеуспешноОбновленныйПакет() Экспорт

	// Подготовка
	Сценарий = Новый СценарийОчередиПакетов();
	Сценарий.ДобавитьПакетВПачку("test-package");
	Исполнитель = Новый РегистраторВызововИсполнителяБД();
	Обновлятор = Новый СценарийОбновленияПакета();
	Обновлятор.Настроить(Исполнитель, Ложь);
	Процессор = СоздатьПроцессор(Сценарий, Исполнитель, Новый РегистраторЛогаОчереди(), Обновлятор);

	// Действие
	ОшибкаОбработки = ПолучитьОшибкуОбработкиОднойПачки(Процессор);

	// Проверка
	Ожидаем.Что(ОшибкаОбработки, "Неуспешный результат обновления обработан штатно").ЭтоНеопределено();
	Ожидаем.Что(Обновлятор.ВызванВнутриОперацииБД(), "Неуспешный обновлятор также вызван вне операции БД").ЭтоЛожь();
	Ожидаем.Что(Сценарий.КоличествоУдалений(), "Неуспешно обновленный пакет оставлен в очереди").Равно(0);
	Ожидаем.Что(Исполнитель.КоличествоВызовов(), "Без удаления исполнитель вызван только для выборки").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеПовторитьДобавлениеПриПрограммнойОшибке() Экспорт

	// Подготовка
	Сценарий = Новый СценарийОчередиПакетов();
	Сценарий.НастроитьОшибкиПроверки(3, "Ошибка в программе");
	Процессор = СоздатьПроцессор(Сценарий, СоздатьИсполнитель(2), Новый РегистраторЛогаОчереди());

	// Действие
	ДанныеОшибки = ПолучитьОшибкуДобавления(Процессор, "test-package");

	// Проверка
	Ожидаем.Что(Сценарий.КоличествоПроверок(), "Программная ошибка завершила операцию после первой попытки").Равно(1);
	Ожидаем.Что(Сценарий.КоличествоСохранений(), "После программной ошибки пакет не сохранялся").Равно(0);
	Ожидаем.Что(ДанныеОшибки.Описание, "Исходная программная ошибка проброшена вызывающему коду").Содержит("Ошибка в программе");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСохранитьИНеЛогироватьСуществующийПакет() Экспорт

	// Подготовка
	Сценарий = Новый СценарийОчередиПакетов();
	Сценарий.НастроитьДубликат(Истина);
	Исполнитель = Новый РегистраторВызововИсполнителяБД();
	Лог = Новый РегистраторЛогаОчереди();
	Процессор = СоздатьПроцессор(Сценарий, Исполнитель, Лог);

	// Действие
	Процессор.ДобавитьВОчередь("test-package");

	// Проверка
	Ожидаем.Что(Исполнитель.КоличествоВызовов(), "Проверка и сохранение заняли executor одной транзакцией фасада").Равно(1);
	Ожидаем.Что(Сценарий.КоличествоПроверок(), "Наличие пакета проверено один раз").Равно(1);
	Ожидаем.Что(Сценарий.КоличествоСохранений(), "Существующий пакет повторно не сохранялся").Равно(0);
	Ожидаем.Что(Лог.КоличествоСообщений(), "Для существующего пакета сообщение о добавлении не записано").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НормализоватьИмяДоТранзакцииФасада() Экспорт

	// Подготовка
	Сценарий = Новый СценарийОчередиПакетов();
	Исполнитель = Новый РегистраторВызововИсполнителяБД();
	Лог = Новый РегистраторЛогаОчереди();
	Процессор = СоздатьПроцессор(Сценарий, Исполнитель, Лог);

	// Действие
	Процессор.ДобавитьВОчередь(" Test-Package ");

	// Проверка
	Ожидаем.Что(Исполнитель.КоличествоВызовов(), "Добавление передано исполнителю ровно один раз").Равно(1);
	Ожидаем.Что(Сценарий.ПоследнееСохраненноеИмя(),
		"Транзакционный доступ сохранил нормализованное имя пакета").Равно("test-package");
	Ожидаем.Что(Сценарий.КоличествоСохранений(), "Новый пакет сохранен один раз").Равно(1);
	Ожидаем.Что(Лог.КоличествоСообщений(), "Успешное добавление залогировано вне операции БД один раз").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПолучитьУстойчивыйФасадЧерезAutumn() Экспорт

	// Подготовка
	Поделка = Новый Поделка();
	Рефлектор = Новый Рефлектор();

	// Действие
	Поделка.ЗапуститьПриложение();
	Процессор = Поделка.НайтиЖелудь("ПроцессорОчередиПакетов");
	Фасад = Поделка.НайтиЖелудь("УстойчивыйМенеджерСущностей");
	ВнедренныйФасад = Рефлектор.ПолучитьСвойство(
		Процессор, "_УстойчивыйМенеджерСущностей");

	// Проверка
	Ожидаем.Что(ВнедренныйФасад = Фасад, "Autumn внедрил в процессор устойчивый фасад").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПовторитьДобавлениеПриВременнойБлокировкеБД() Экспорт

	// Подготовка
	Сценарий = Новый СценарийОчередиПакетов();
	Сценарий.НастроитьОшибкиПроверки(1, "database is locked");
	Процессор = Новый ПроцессорОчередиПакетов();
	Рефлектор = Новый Рефлектор();
	ОшибкаПодготовки = Неопределено;
	Попытка
		Фасад = СоздатьФасад(Сценарий, СоздатьИсполнитель());
		Рефлектор.УстановитьСвойство(Процессор, "_УстойчивыйМенеджерСущностей", Фасад);
		Рефлектор.УстановитьСвойство(Процессор, "_Лог", Новый РегистраторЛогаОчереди());
	Исключение
		ОшибкаПодготовки = ИнформацияОбОшибке();
	КонецПопытки;

	// Действие
	ОшибкаДобавления = Неопределено;
	Если ОшибкаПодготовки = Неопределено Тогда
		Попытка
			Процессор.ДобавитьВОчередь(" Test-Package ");
		Исключение
			ОшибкаДобавления = ИнформацияОбОшибке();
		КонецПопытки;
	КонецЕсли;

	// Проверка
	Ожидаем.Что(ОшибкаПодготовки, "Процессор допускает внедрение устойчивого фасада").ЭтоНеопределено();
	Ожидаем.Что(ОшибкаДобавления, "Временная блокировка БД обработана фасадом").ЭтоНеопределено();
	Ожидаем.Что(Сценарий.КоличествоПроверок(), "Вся операция проверки и сохранения повторена после блокировки").Равно(2);
	Ожидаем.Что(Сценарий.КоличествоСохранений(), "После успешного повтора пакет сохранен один раз").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеДублироватьПакетПослеНеоднозначнойОшибкиСохранения() Экспорт

	// Подготовка
	Сценарий = Новый СценарийОчередиПакетов();
	Сценарий.НастроитьОшибкиПослеСохранения(1, "database is locked");
	Лог = Новый РегистраторЛогаОчереди();
	Процессор = СоздатьПроцессор(Сценарий, СоздатьИсполнитель(), Лог);

	// Действие
	Процессор.ДобавитьВОчередь("test-package");

	// Проверка
	Ожидаем.Что(Сценарий.КоличествоПроверок(), "После неоднозначной ошибки исполнитель повторил проверку пакета").Равно(2);
	Ожидаем.Что(Сценарий.КоличествоСохранений(), "Уже созданный элемент очереди повторно не сохранялся").Равно(1);
	Ожидаем.Что(Лог.КоличествоСообщений(), "Повтор, обнаруживший пакет, не сообщил о повторном добавлении").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнитель(КоличествоПовторов = 1)

	Настройки = Новый НастройкиОтказоустойчивостиБД();
	Настройки.КоличествоПовторов = КоличествоПовторов;
	Настройки.БазоваяЗадержкаПовтораМс = 0;
	Настройки.МаксимальнаяЗадержкаПовтораМс = 0;

	Возврат Новый ИсполнительОперацийБД(Настройки, Новый КлассификаторОшибокSQLite());

КонецФункции

Функция СоздатьПроцессор(МенеджерСущностей, Исполнитель, Лог, Обновлятор = Неопределено)

	Процессор = Новый ПроцессорОчередиПакетов();
	Рефлектор = Новый Рефлектор();
	Фасад = СоздатьФасад(МенеджерСущностей, Исполнитель);
	Рефлектор.УстановитьСвойство(
		Процессор, "_УстойчивыйМенеджерСущностей", Фасад);
	Рефлектор.УстановитьСвойство(Процессор, "_Лог", Лог);
	Если Обновлятор <> Неопределено Тогда
		Рефлектор.УстановитьСвойство(Процессор, "_ОбновляторЗависимыхРепозиториев", Обновлятор);
	КонецЕсли;

	Возврат Процессор;

КонецФункции

Функция СоздатьФасад(МенеджерСущностей, Исполнитель)

	Табакерка = Мок.Получить(Тип("Табакерка"));
	Табакерка.Когда().Достать().ТогдаВозвращает(МенеджерСущностей);
	Фасад = Новый УстойчивыйМенеджерСущностей();
	Рефлектор = Новый Рефлектор();
	Рефлектор.УстановитьСвойство(Фасад, "_ВнутреннийМенеджерСущностей", Табакерка);
	Рефлектор.УстановитьСвойство(Фасад, "_ИсполнительОперацийБД", Исполнитель);

	Возврат Фасад;

КонецФункции

Функция ПолучитьОшибкуОбработкиОднойПачки(Процессор)

	Параметры = Новый Массив();
	Параметры.Добавить(10);
	Рефлектор = Новый Рефлектор();
	Попытка
		Рефлектор.ВызватьМетод(Процессор, "ОбработатьОднуПачку", Параметры);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

Функция ПолучитьОшибкуДобавления(Процессор, ИмяПакета)

	Попытка
		Процессор.ДобавитьВОчередь(ИмяПакета);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалась ошибка добавления пакета в очередь.";

КонецФункции

#КонецОбласти
