Перем _СценарийДляУдаления; // СценарийОчередиПакетов
Перем _УдаленныеИмена; // Массив
Перем _ИмяСОшибкойУдаления; // Строка

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область Тесты

&Тест
Процедура ТестДолжен_НормализоватьИмяИДелегироватьДобавлениеОдинРаз() Экспорт

	// Подготовка
	Сценарий = Новый СценарийОчередиПакетов();
	Процессор = СоздатьПроцессор(Сценарий);

	// Действие
	Процессор.ДобавитьВОчередь(" Test-Package ");

	// Проверка
	Ожидаем.Что(Сценарий.КоличествоДобавлений(),
		"Хранилище получило одно добавление").Равно(1);
	Ожидаем.Что(Сценарий.ПоследнееДобавленноеИмя(),
		"Процессор передал хранилищу нормализованное имя").Равно("test-package");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЛогироватьДобавлениеТолькоНовогоПакета() Экспорт

	// Подготовка
	Сценарий = Новый СценарийОчередиПакетов();
	Процессор = СоздатьПроцессор(Сценарий);

	// Действие
	Процессор.ДобавитьВОчередь(" Test-Package ");

	// Проверка
	Ожидаем.Что(Сценарий.КоличествоОтладочныхСообщений(),
		"Новое добавление сразу записало одно сообщение").Равно(1);
	Ожидаем.Что(Сценарий.ПоследнийШаблонОтладки(),
		"Записан ожидаемый смысл сообщения о добавлении").Равно(
			"Пакет %1 добавлен в очередь");
	Ожидаем.Что(Сценарий.ПоследнийПараметрОтладки(),
		"В сообщение передано нормализованное имя пакета").Равно("test-package");

	// Действие
	Сценарий.НастроитьДобавление(Ложь);
	Процессор.ДобавитьВОчередь("existing-package");

	// Проверка
	Ожидаем.Что(Сценарий.КоличествоОтладочныхСообщений(),
		"Дубликат не добавил новое сообщение").Равно(1);
	Ожидаем.Что(Сценарий.ПоследнийШаблонОтладки(),
		"Дубликат не изменил шаблон сообщения").Равно("Пакет %1 добавлен в очередь");
	Ожидаем.Что(Сценарий.ПоследнийПараметрОтладки(),
		"Дубликат не изменил параметр сообщения").Равно("test-package");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОбновитьИменаВнеВызоваХранилищаИУдалитьТолькоУспешные() Экспорт

	// Подготовка
	Сценарий = Новый СценарийОчередиПакетов();
	Сценарий.ДобавитьИмяВПачку("successful-package");
	Сценарий.ДобавитьИмяВПачку("failed-package");
	Сценарий.НастроитьРезультатОбновления("failed-package", Ложь);
	Процессор = СоздатьПроцессор(Сценарий);

	// Действие
	Процессор.ОбработатьОднуПачку(10);

	// Проверка
	ПроверитьМассив(Сценарий.ИменаОбновления(),
		"Обновлятор получил имена пакетов из хранилища",
		"successful-package", "failed-package");
	Ожидаем.Что(Сценарий.ОбновляторВызванВнутриХранилища(),
		"Обновлятор вызван после возврата хранилища").ЭтоЛожь();
	ПроверитьМассив(Сценарий.РезультатыВызововОбновления(),
		"Сценарий вернул результаты обновления для всех пакетов", Истина, Ложь);
	ПроверитьМассив(_УдаленныеИмена,
		"Из очереди удалено только успешно обновленное имя", "successful-package");
	ПроверитьМассив(Сценарий.ПоследовательностьВызовов(),
		"Получение, обновления и удаление происходят в наблюдаемом порядке",
		"ПолучитьПачку",
		"ОбновитьПакет:successful-package",
		"Удалить:successful-package",
		"ОбновитьПакет:failed-package");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПродолжитьПачкуПослеОшибкиУдаления() Экспорт

	Сценарий = Новый СценарийОчередиПакетов();
	Сценарий.ДобавитьИмяВПачку("first-package");
	Сценарий.ДобавитьИмяВПачку("second-package");
	Процессор = СоздатьПроцессор(Сценарий);
	_ИмяСОшибкойУдаления = "first-package";

	Процессор.ОбработатьОднуПачку(10);

	ПроверитьМассив(Сценарий.ИменаОбновления(),
		"Ошибка удаления не прервала обработку пачки", "first-package", "second-package");
	ПроверитьМассив(_УдаленныеИмена,
		"Успешно удален следующий элемент пачки", "second-package");
	Ожидаем.Что(Сценарий.КоличествоОшибок(), "Ошибка удаления записана в лог").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗалогироватьИНеУдалитьПакетПриИсключенииОбновлятора() Экспорт

	// Подготовка
	Сценарий = Новый СценарийОчередиПакетов();
	Сценарий.ДобавитьИмяВПачку("broken-package");
	Сценарий.НастроитьОшибкуОбновления("broken-package", "Ошибка обновления");
	Процессор = СоздатьПроцессор(Сценарий);

	// Действие
	Процессор.ОбработатьОднуПачку(10);

	// Проверка
	Ожидаем.Что(Сценарий.КоличествоОшибок(),
		"Исключение обновлятора записано в лог").Равно(1);
	Ожидаем.Что(_УдаленныеИмена,
		"Пакет с исключением обновлятора остался в очереди").ИмеетДлину(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьПроцессор(Сценарий)

	_СценарийДляУдаления = Сценарий;
	_УдаленныеИмена = Новый Массив();
	_ИмяСОшибкойУдаления = "";
	Хранилище = Мок.Получить(Тип("ХранилищеОчередиПакетов"));
	Хранилище.Когда().Добавить(Матчеры.ЛюбоеЗначение())
		.ТогдаОтвечает(Новый Ответ(Сценарий, "ЗарегистрироватьДобавление"));
	Хранилище.Когда().ПолучитьПачку(Матчеры.ЛюбоеЗначение())
		.ТогдаОтвечает(Новый Ответ(Сценарий, "ЗарегистрироватьПолучениеПачки"));
	Хранилище.Когда().Удалить(Матчеры.ЛюбоеЗначение())
		.ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ЗарегистрироватьУдаление"));
	Обновлятор = Мок.Получить(Тип("ОбновляторЗависимыхРепозиториев"));
	Обновлятор.Когда().ОбновитьПакет(Матчеры.ЛюбоеЗначение())
		.ТогдаОтвечает(Новый Ответ(Сценарий, "ЗарегистрироватьОбновление"));

	Процессор = Новый ПроцессорОчередиПакетов();
	Рефлектор = Новый Рефлектор();
	Рефлектор.УстановитьСвойство(Процессор, "_ХранилищеОчередиПакетов", Хранилище);
	Рефлектор.УстановитьСвойство(
		Процессор, "_ОбновляторЗависимыхРепозиториев", Обновлятор);
	Рефлектор.УстановитьСвойство(Процессор, "_Лог", Сценарий);

	Возврат Процессор;

КонецФункции

Функция ЗарегистрироватьУдаление(ИнформацияОВызове) Экспорт

	ИмяПакета = ИнформацияОВызове.Параметры()[0];
	Если ИмяПакета = _ИмяСОшибкойУдаления Тогда
		ВызватьИсключение "ошибка удаления";
	КонецЕсли;
	_УдаленныеИмена.Добавить(ИмяПакета);
	_СценарийДляУдаления.ЗарегистрироватьУдаление(ИнформацияОВызове);

	Возврат Неопределено;

КонецФункции

Процедура ПроверитьМассив(ФактическийМассив, Описание,
	ПервоеЗначение = Неопределено, ВтороеЗначение = Неопределено,
	ТретьеЗначение = Неопределено, ЧетвертоеЗначение = Неопределено)

	ОжидаемыеЗначения = Новый Массив();
	Если ПервоеЗначение <> Неопределено Тогда
		ОжидаемыеЗначения.Добавить(ПервоеЗначение);
	КонецЕсли;
	Если ВтороеЗначение <> Неопределено Тогда
		ОжидаемыеЗначения.Добавить(ВтороеЗначение);
	КонецЕсли;
	Если ТретьеЗначение <> Неопределено Тогда
		ОжидаемыеЗначения.Добавить(ТретьеЗначение);
	КонецЕсли;
	Если ЧетвертоеЗначение <> Неопределено Тогда
		ОжидаемыеЗначения.Добавить(ЧетвертоеЗначение);
	КонецЕсли;
	Ожидаем.Что(ФактическийМассив, Описание).ИмеетДлину(ОжидаемыеЗначения.Количество());
	Для Индекс = 0 По ОжидаемыеЗначения.ВГраница() Цикл
		Ожидаем.Что(ФактическийМассив[Индекс], Описание).Равно(ОжидаемыеЗначения[Индекс]);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
