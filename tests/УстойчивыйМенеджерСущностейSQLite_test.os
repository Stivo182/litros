#Использовать asserts
#Использовать autumn
#Использовать entity
#Использовать reflector
#Использовать "../src/internal"
#Использовать "../src/dto"
#Использовать "fixtures"

Перем _Менеджеры; // Массив
Перем _Коннекторы; // Массив
Перем _КоннекторыСТранзакцией; // Массив
Перем _ПутиКБД; // Массив
Перем _ФоновыеЗадачи; // Массив

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередКаждым() Экспорт

	_Менеджеры = Новый Массив();
	_Коннекторы = Новый Массив();
	_КоннекторыСТранзакцией = Новый Массив();
	_ПутиКБД = Новый Массив();
	_ФоновыеЗадачи = Новый Массив();

КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт

	ОшибкаОчистки = Неопределено;
	Для Каждого Коннектор Из _КоннекторыСТранзакцией Цикл
		Попытка
			Коннектор.ОтменитьТранзакцию();
		Исключение
			СохранитьПервуюОшибкуОчистки(ОшибкаОчистки);
		КонецПопытки;
	КонецЦикла;
	_КоннекторыСТранзакцией.Очистить();

	Для Каждого ФоноваяЗадача Из _ФоновыеЗадачи Цикл
		ДождатьсяФоновойЗадачиПриОчистке(ФоноваяЗадача, ОшибкаОчистки);
	КонецЦикла;
	_ФоновыеЗадачи.Очистить();

	Для Каждого Коннектор Из _Коннекторы Цикл
		Попытка
			Коннектор.Закрыть();
		Исключение
			СохранитьПервуюОшибкуОчистки(ОшибкаОчистки);
		КонецПопытки;
	КонецЦикла;
	_Коннекторы.Очистить();

	Для Каждого Менеджер Из _Менеджеры Цикл
		Попытка
			Менеджер.Закрыть();
		Исключение
			СохранитьПервуюОшибкуОчистки(ОшибкаОчистки);
		КонецПопытки;
	КонецЦикла;
	_Менеджеры.Очистить();
	ВыполнитьСборкуМусора();

	Для Каждого ПутьКБД Из _ПутиКБД Цикл
		Попытка
			УдалитьФайлЕслиСуществует(ПутьКБД);
			УдалитьФайлЕслиСуществует(ПутьКБД + "-wal");
			УдалитьФайлЕслиСуществует(ПутьКБД + "-shm");
		Исключение
			СохранитьПервуюОшибкуОчистки(ОшибкаОчистки);
		КонецПопытки;
	КонецЦикла;
	_ПутиКБД.Очистить();

	Если ОшибкаОчистки <> Неопределено Тогда
		ВызватьИсключение ОшибкаОчистки;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ПовторитьСохранениеПослеРеальнойБлокировкиSQLite() Экспорт

	// Подготовка
	ПутьКБД = НовыйПутьКБД();
	Затвор = Новый ЗатворSQLiteФасада();
	Фасад = СоздатьФасад(ПутьКБД, 2, Затвор);
	КоннекторБлокировки = СоздатьКоннектор(ПутьКБД);
	КоннекторБлокировки.НачатьТранзакцию();
	_КоннекторыСТранзакцией.Добавить(КоннекторБлокировки);
	КоннекторБлокировки.ВыполнитьЗапрос(
		"INSERT INTO ОчередьПакетов (ИмяПакета, ДатаДобавления) VALUES ('locker', '2026-07-23 00:00:00');");
	Сущность = Новый СущностьОчередьПакета();
	Сущность.ИмяПакета = "after-real-lock";
	Сущность.ДатаДобавления = ТекущаяУниверсальнаяДата();
	Параметры = Новый Массив();
	Параметры.Добавить(Фасад);
	Параметры.Добавить(Сущность);

	// Действие
	Задача = ФоновыеЗадания.Выполнить(Затвор, "СохранитьЧерезФасад", Параметры);
	_ФоновыеЗадачи.Добавить(Задача);
	ПерваяОшибкаБлокировкиОбнаружена = ДождатьсяВременнойОшибки(Затвор);
	КоннекторБлокировки.ОтменитьТранзакцию();
	_КоннекторыСТранзакцией.Удалить(_КоннекторыСТранзакцией.Найти(КоннекторБлокировки));
	Завершена = Задача.ОжидатьЗавершения(5000);

	// Проверка
	Ожидаем.Что(ПерваяОшибкаБлокировкиОбнаружена,
		"Блокировка освобождена только после фактической временной ошибки первой попытки").ЭтоИстина();
	Ожидаем.Что(Затвор.КоличествоВременныхОшибок(),
		"Executor классифицировал как минимум одну реальную ошибку и выполнил retry").БольшеИлиРавно(1);
	Ожидаем.Что(Затвор.ОписаниеПоследнейВременнойОшибки(),
		"Наблюдаемая временная ошибка пришла от реальной блокировки SQLite").Содержит("database is locked");
	Ожидаем.Что(Завершена, "Фоновая запись завершилась после освобождения реальной блокировки").ЭтоИстина();
	Ожидаем.Что(Задача.Результат, "Retry простой операции вернул успешный результат").ЭтоИстина();
	Строки = Фасад.ВыполнитьЗапрос(
		"SELECT COUNT(*) AS Количество FROM ОчередьПакетов WHERE ИмяПакета = 'after-real-lock';");
	Ожидаем.Что(Строки[0].Количество, "После retry сохранена ровно одна строка").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УдалитьЧастичныеДанныеПередПовторомВсейТранзакции() Экспорт

	// Подготовка
	ПутьКБД = НовыйПутьКБД();
	Фасад = СоздатьФасад(ПутьКБД);
	Затвор = Новый ЗатворSQLiteФасада();

	// Действие
	НомерПопытки = Фасад.ВыполнитьВТранзакции(
		Новый Действие(Затвор, "СохранитьДваПакетаСПервойВременнойОшибкой"));
	Строки = Фасад.ВыполнитьЗапрос(
		"SELECT ИмяПакета FROM ОчередьПакетов WHERE ИмяПакета LIKE 'transaction-%' ORDER BY ИмяПакета;");

	// Проверка
	Ожидаем.Что(НомерПопытки, "Успех достигнут на второй полной попытке").Равно(2);
	Ожидаем.Что(Строки.Количество(), "Rollback не оставил частичной или дублирующей строки").Равно(2);
	Ожидаем.Что(Строки[0].ИмяПакета, "Первая логическая запись зафиксирована один раз").Равно(
		"transaction-first");
	Ожидаем.Что(Строки[1].ИмяПакета, "Вторая логическая запись зафиксирована один раз").Равно(
		"transaction-second");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОткатитьРеальнуюТранзакциюПослеПрограммнойОшибки() Экспорт

	// Подготовка
	ПутьКБД = НовыйПутьКБД();
	Фасад = СоздатьФасад(ПутьКБД, 2);
	Затвор = Новый ЗатворSQLiteФасада();

	// Действие
	Ошибка = ПолучитьОшибкуТранзакции(
		Фасад, Новый Действие(Затвор, "СохранитьИЗавершитьПрограммнойОшибкой"));
	Строки = Фасад.ВыполнитьЗапрос(
		"SELECT COUNT(*) AS Количество FROM ОчередьПакетов WHERE ИмяПакета = 'program-error';");

	// Проверка
	Ожидаем.Что(Ошибка.Описание, "Наружу вышла исходная программная ошибка").Содержит(
		"программная ошибка после записи");
	Ожидаем.Что(Строки[0].Количество, "Rollback удалил запись неуспешного callback").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыполнитьСыройSQLЧерезНастроенноеСоединениеФасада() Экспорт

	// Подготовка
	ПутьКБД = НовыйПутьКБД();
	Фасад = СоздатьФасад(ПутьКБД);

	// Действие
	Результат = Фасад.ВыполнитьЗапрос("PRAGMA busy_timeout;");

	// Проверка
	Ожидаем.Что(Результат[0].timeout,
		"Сырой SQL фасада использует настроенное соединение SQLite").Равно(25);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьФасад(ПутьКБД, КоличествоПовторов = 2, НаблюдающийКлассификатор = Неопределено)

	Значения = Новый Соответствие();
	Значения.Вставить("litros.ПутьКБД", ПутьКБД);
	Значения.Вставить("litros.db.ТаймаутЗанятостиМс", 25);
	Значения.Вставить("litros.db.КоличествоПовторов", КоличествоПовторов);
	Значения.Вставить("litros.db.БазоваяЗадержкаПовтораМс", 200);
	Значения.Вставить("litros.db.МаксимальнаяЗадержкаПовтораМс", 200);
	Значения.Вставить("litros.db.ИспользоватьWAL", Ложь);
	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Значения);
	Совет.ИмяФайлаСоЗначениямиДеталек("заведомо-отсутствующие-настройки-фасада-бд");
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();
	Фасад = Поделка.НайтиЖелудь("УстойчивыйМенеджерСущностей");
	Если НаблюдающийКлассификатор <> Неопределено Тогда
		УстановитьНаблюдающийКлассификатор(Поделка, НаблюдающийКлассификатор);
	КонецЕсли;
	Фасад.ВыполнитьЗапрос("SELECT 1 AS Проверка;");
	_Менеджеры.Добавить(Поделка.НайтиЖелудь("ВнутреннийМенеджерСущностей"));
	Возврат Фасад;

КонецФункции

Функция СоздатьКоннектор(ПутьКБД)

	СтрокаСоединения = СтрШаблон(
		"DataSource=%1;DefaultTimeout=0;BusyTimeout=25;JournalMode=Delete;", ПутьКБД);
	Коннектор = Новый КоннекторSQLite();
	Коннектор.Открыть(СтрокаСоединения, Новый Массив());
	_Коннекторы.Добавить(Коннектор);
	Возврат Коннектор;

КонецФункции

Функция НовыйПутьКБД()

	ПутьКБД = ПолучитьИмяВременногоФайла("db");
	_ПутиКБД.Добавить(ПутьКБД);
	Возврат ПутьКБД;

КонецФункции

Процедура УдалитьФайлЕслиСуществует(Путь)

	Если Новый Файл(Путь).Существует() Тогда
		УдалитьФайлы(Путь);
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьОшибкуТранзакции(Фасад, Операция)

	Попытка
		Фасад.ВыполнитьВТранзакции(Операция);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;
	ВызватьИсключение "Ожидалась ошибка транзакции";

КонецФункции

Функция ДождатьсяВременнойОшибки(Затвор)

	Для НомерПопытки = 1 По 400 Цикл
		Если Затвор.КоличествоВременныхОшибок() > 0 Тогда
			Возврат Истина;
		КонецЕсли;
		Приостановить(5);
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Подменяет только наблюдаемую зависимость классификации у штатного singleton-исполнителя.
// Pipeline и все настройки Autumn остаются production-экземплярами; подмена нужна тесту,
// чтобы освободить реальную SQLite-блокировку после фактической первой временной ошибки.
Процедура УстановитьНаблюдающийКлассификатор(Поделка, НаблюдающийКлассификатор)

	Исполнитель = Поделка.НайтиЖелудь("ИсполнительОперацийБД");
	Рефлектор = Новый Рефлектор();
	Рефлектор.УстановитьСвойство(
		Исполнитель, "_Классификатор", НаблюдающийКлассификатор);

КонецПроцедуры

Процедура ДождатьсяФоновойЗадачиПриОчистке(ФоноваяЗадача, ОшибкаОчистки)

	Попытка
		Завершена = ФоноваяЗадача.ОжидатьЗавершения(5000);
		Если Не Завершена Тогда
			Попытка
				ВызватьИсключение "Фоновая задача SQLite-фасада не завершилась за 5 секунд";
			Исключение
				СохранитьПервуюОшибкуОчистки(ОшибкаОчистки);
			КонецПопытки;
			// Не закрываем менеджеры и не удаляем БД, пока задача действительно не завершилась.
			ФоноваяЗадача.ОжидатьЗавершения();
		КонецЕсли;
		РезультатФоновойЗадачи = ФоноваяЗадача.Результат;
	Исключение
		СохранитьПервуюОшибкуОчистки(ОшибкаОчистки);
	КонецПопытки;

КонецПроцедуры

Процедура СохранитьПервуюОшибкуОчистки(ОшибкаОчистки)

	Если ОшибкаОчистки = Неопределено Тогда
		ОшибкаОчистки = ИнформацияОбОшибке();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
