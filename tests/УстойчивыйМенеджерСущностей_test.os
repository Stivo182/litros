		"BEGIN,BEGIN,CALLBACK,COMMIT");
КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыполнитьRollbackПослеПрограммнойОшибкиБезRetry() Экспорт
	// Подготовка
	Регистратор = Новый РегистраторТранзакцииБД();
	НастроитьТранзакционныйМенеджер(Регистратор);
	Операции = Новый ОперацииТранзакцииБД();
	Операции.НастроитьОшибки(1, "программная ошибка callback");
	Фасад = СоздатьФасад(СоздатьРеальныйИсполнитель(2));
	// Действие
	Ошибка = ПолучитьОшибкуТранзакции(Фасад, Новый Действие(Операции, "СохранитьИВернуть"));
