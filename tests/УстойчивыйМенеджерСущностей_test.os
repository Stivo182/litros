		"BEGIN,CALLBACK,ROLLBACK");
	Ожидаем.Что(Ошибка.Описание, "Наружу проброшена исходная программная ошибка").Содержит(
		"программная ошибка callback");
КонецПроцедуры

&Тест
Процедура ТестДолжен_ПослеОшибкиCommitВыполнитьRollbackИПовторитьТранзакцию() Экспорт
	// Подготовка
	Регистратор = Новый РегистраторТранзакцииБД();
	Регистратор.НастроитьОшибку("COMMIT", 1, "database is locked");
	НастроитьТранзакционныйМенеджер(Регистратор);
	Операции = Новый ОперацииТранзакцииБД();
	Фасад = СоздатьФасад(СоздатьРеальныйИсполнитель(1));
	// Действие
	Фасад.ВыполнитьВТранзакции(Новый Действие(Операции, "СохранитьИВернуть"));
	// Проверка
	Ожидаем.Что(Регистратор.Порядок(), "Ошибка commit отменена до новой полной попытки").Равно(
		"BEGIN,CALLBACK,COMMIT,ROLLBACK,BEGIN,CALLBACK,COMMIT");
КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаблокироватьФасадПослеНеудачногоRollback() Экспорт
	// Подготовка
	Регистратор = Новый РегистраторТранзакцииБД();
	Регистратор.НастроитьОшибку("ROLLBACK", 1, "rollback database is locked");
	Регистратор.НастроитьОшибку("CLOSE", 1, "ошибка закрытия");
	НастроитьТранзакционныйМенеджер(Регистратор);
	Операции = Новый ОперацииТранзакцииБД();
	Операции.НастроитьОшибки(1, "database is locked в callback");
	Фасад = СоздатьФасад(СоздатьРеальныйИсполнитель(2));
	// Действие
	ПерваяОшибка = ПолучитьОшибкуТранзакции(Фасад, Новый Действие(Операции, "СохранитьИВернуть"));
	ВтораяОшибка = ПолучитьОшибкуПолученияФасада(Фасад);
	// Проверка
	Ожидаем.Что(Регистратор.Порядок(), "Неудачный rollback остановил retry и вызвал аварийное закрытие").Равно(
		"BEGIN,CALLBACK,ROLLBACK,CLOSE");
	Ожидаем.Что(
		Лев(ПерваяОшибка.Описание, СтрДлина("litros_db_rollback_failed:")),
		"Фатальная ошибка начинается точным зарезервированным prefix").Равно("litros_db_rollback_failed:");
	Ожидаем.Что(ПерваяОшибка.Описание, "Диагностика содержит исходную ошибку").Содержит(
		"database is locked в callback");
	Ожидаем.Что(ПерваяОшибка.Описание, "Диагностика содержит ошибку rollback").Содержит(
		"rollback database is locked");
	Ожидаем.Что(ПерваяОшибка.Описание, "Ошибка best-effort закрытия добавлена в диагностику").Содержит(
		"ошибка закрытия");
	Ожидаем.Что(ВтораяОшибка.Описание, "Следующий DB-вызов требует пересоздания контекста").Содержит(
		"пересоздать контекст Autumn или перезапустить приложение");
КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНеДействиеДоExecutor() Экспорт
	// Подготовка
	Фасад = СоздатьФасад();
