КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьОжидающуюОперациюПослеНеудачногоRollbackДоОбращенияКБД() Экспорт
	// Подготовка
	Регистратор = Новый РегистраторТранзакцииБД();
	НастроитьТранзакционныйМенеджер(Регистратор);
	Затвор = Новый ЗатворФатальногоСостоянияФасада();
	_Менеджер.Когда().ОтменитьТранзакцию().ТогдаОтвечает(
		Новый Ответ(Затвор, "ОтветитьНаRollback"));
	_Менеджер.Когда().Получить(Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение())
		.ТогдаОтвечает(Новый Ответ(Затвор, "ОтветитьНаПолучение"));
	Операции = Новый ОперацииТранзакцииБД();
	Операции.НастроитьОшибки(1, "database is locked в callback");
	Фасад = СоздатьФасад(Затвор);
	ПараметрыПервой = Новый Массив();
	ПараметрыПервой.Добавить(Фасад);
	ПараметрыПервой.Добавить(Новый Действие(Операции, "СохранитьИВернуть"));
	ПараметрыВторой = Новый Массив();
	ПараметрыВторой.Добавить(Фасад);

	// Действие
	ПерваяЗадача = ФоновыеЗадания.Выполнить(
		Затвор, "ВыполнитьПервуюОперацию", ПараметрыПервой);
	ПерваяВошла = ДождатьсяФлагаЗатвора(Затвор, "ПерваяВошлаВExecutor");
	ВтораяЗадача = ФоновыеЗадания.Выполнить(
		Затвор, "ВыполнитьВторуюОперацию", ПараметрыВторой);
	ПерваяЗавершена = ПерваяЗадача.ОжидатьЗавершения(5000);
	ВтораяЗавершена = ВтораяЗадача.ОжидатьЗавершения(5000);

	// Проверка
	Ожидаем.Что(ПерваяВошла, "Первая транзакция заняла executor до запуска второй").ЭтоИстина();
	Ожидаем.Что(ПерваяЗавершена, "Транзакция с неудачным rollback завершила работу").ЭтоИстина();
	Ожидаем.Что(ВтораяЗавершена, "Ожидающая операция вышла после освобождения executor").ЭтоИстина();
	Ожидаем.Что(
		Лев(ПерваяЗадача.Результат, СтрДлина("litros_db_rollback_failed:")),
		"Первая ошибка имеет фатальный маркер").Равно("litros_db_rollback_failed:");
	Ожидаем.Что(ВтораяЗадача.Результат, "Ожидающая операция получила ту же фатальную диагностику").Равно(
		ПерваяЗадача.Результат);
	Ожидаем.Что(Затвор.КоличествоПолучений(),
		"После фатального rollback ожидающая операция не обратилась к менеджеру").Равно(0);
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ДостатьМенеджер(ИнформацияОВызове) Экспорт
	_КоличествоИзвлечений = _КоличествоИзвлечений + 1;
	Возврат _Менеджер;
КонецФункции

Функция ВыполнитьОперацию(ИнформацияОВызове) Экспорт
	_КоличествоВызововИсполнителя = _КоличествоВызововИсполнителя + 1;
	ПараметрыВызова = ИнформацияОВызове.Параметры();
	Операция = ПараметрыВызова[0];
	ИсходныеПараметры = ПараметрыВызова[1];
	Если ИсходныеПараметры = Неопределено Тогда
		ПараметрыОперации = Новый Массив();
	ИначеЕсли ТипЗнч(ИсходныеПараметры) = Тип("Массив")
		Или ТипЗнч(ИсходныеПараметры) = Тип("ФиксированныйМассив") Тогда
		ПараметрыОперации = Новый Массив();
		Для Каждого Параметр Из ИсходныеПараметры Цикл
			ПараметрыОперации.Добавить(Параметр);
		КонецЦикла;
	Иначе
		ПараметрыОперации = Новый Массив();
		ПараметрыОперации.Добавить(ИсходныеПараметры);
	КонецЕсли;
	Возврат Новый Рефлектор().ВызватьМетод(Операция, "Выполнить", ПараметрыОперации);
КонецФункции

Функция ЗарегистрироватьПрямойВызов(ИнформацияОВызове, Результат) Экспорт
	_КоличествоПрямыхВызовов = _КоличествоПрямыхВызовов + 1;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьОтветПрямогоВызова(Результат)
	ДополнительныеПараметры = Новый Массив();
	ДополнительныеПараметры.Добавить(Результат);
	Возврат Новый Ответ(
		ЭтотОбъект, "ЗарегистрироватьПрямойВызов", ДополнительныеПараметры);
КонецФункции

Функция СоздатьФасад(Исполнитель = Неопределено)
	Если Исполнитель = Неопределено Тогда
		Исполнитель = _Исполнитель;
	КонецЕсли;
	Фасад = Новый УстойчивыйМенеджерСущностей();
	Рефлектор = Новый Рефлектор();
	Рефлектор.УстановитьСвойство(Фасад, "_ВнутреннийМенеджерСущностей", _Табакерка);
	Рефлектор.УстановитьСвойство(Фасад, "_ИсполнительОперацийБД", Исполнитель);
	Возврат Фасад;
КонецФункции

Процедура НастроитьТранзакционныйМенеджер(Регистратор)
	_Менеджер.Когда().НачатьТранзакцию().ТогдаОтвечает(
		Новый Ответ(Регистратор, "ОтветитьНаНачало"));
	_Менеджер.Когда().Сохранить(Матчеры.ЛюбоеЗначение()).ТогдаОтвечает(
		Новый Ответ(Регистратор, "ОтветитьНаСохранение"));
	_Менеджер.Когда().ЗафиксироватьТранзакцию().ТогдаОтвечает(
		Новый Ответ(Регистратор, "ОтветитьНаCommit"));
	_Менеджер.Когда().ОтменитьТранзакцию().ТогдаОтвечает(
		Новый Ответ(Регистратор, "ОтветитьНаRollback"));
	_Менеджер.Когда().Закрыть().ТогдаОтвечает(
		Новый Ответ(Регистратор, "ОтветитьНаЗакрытие"));
КонецПроцедуры

Функция СоздатьРеальныйИсполнитель(КоличествоПовторов)
	Настройки = Новый НастройкиОтказоустойчивостиБД();
	Настройки.КоличествоПовторов = КоличествоПовторов;
	Настройки.БазоваяЗадержкаПовтораМс = 0;
	Настройки.МаксимальнаяЗадержкаПовтораМс = 0;
	Возврат Новый ИсполнительОперацийБД(Настройки, Новый КлассификаторОшибокSQLite());
КонецФункции

Функция ПолучитьОшибкуТранзакции(Фасад, Операция, Параметры = Неопределено)
	Попытка
		Фасад.ВыполнитьВТранзакции(Операция, Параметры);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;
	ВызватьИсключение "Ожидалась ошибка транзакции";
КонецФункции

Функция ПолучитьОшибкуДоступаКБД(ДоступКБД)
	Попытка
		ДоступКБД.Получить(Тип("СущностьРепозиторий"));
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;
	ВызватьИсключение "Ожидалась ошибка завершенного транзакционного доступа";
КонецФункции

Функция ПолучитьОшибкуПолученияФасада(Фасад)
	Попытка
		Фасад.Получить(Тип("СущностьРепозиторий"));
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;
	ВызватьИсключение "Ожидалась ошибка непригодного фасада";
КонецФункции

Функция ДождатьсяФлагаЗатвора(Затвор, ИмяМетода)
	Для НомерОжидания = 1 По 400 Цикл
		Если Новый Рефлектор().ВызватьМетод(Затвор, ИмяМетода) Тогда
			Возврат Истина;
		КонецЕсли;
		Приостановить(5);
	КонецЦикла;
	Возврат Ложь;
КонецФункции

#КонецОбласти
