&Тест
Процедура ТестДолжен_НеВызыватьRollbackПослеОшибкиBegin() Экспорт
	// Подготовка
	Регистратор = Новый РегистраторТранзакцииБД();
	Регистратор.НастроитьОшибку("BEGIN", 1, "database is locked");
	НастроитьТранзакционныйМенеджер(Регистратор);
	Операции = Новый ОперацииТранзакцииБД();
	Фасад = СоздатьФасад(1);
	// Действие
	Фасад.ВыполнитьВТранзакции(Новый Действие(Операции, "СохранитьИВернуть"));
	// Проверка
	Ожидаем.Что(Регистратор.Порядок(), "Ошибка BEGIN повторена без rollback неоткрытой транзакции").Равно(
		"BEGIN,BEGIN,CALLBACK,COMMIT");
КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыполнитьRollbackПослеПрограммнойОшибкиБезRetry() Экспорт
	// Подготовка
	Регистратор = Новый РегистраторТранзакцииБД();
	НастроитьТранзакционныйМенеджер(Регистратор);
	Операции = Новый ОперацииТранзакцииБД();
	Операции.НастроитьОшибки(1, "программная ошибка callback");
	Фасад = СоздатьФасад(2);
	// Действие
	Ошибка = ПолучитьОшибкуТранзакции(Фасад, Новый Действие(Операции, "СохранитьИВернуть"));
	// Проверка
	Ожидаем.Что(Регистратор.Порядок(), "Программная ошибка привела к rollback одной попытки").Равно(
		"BEGIN,CALLBACK,ROLLBACK");
	Ожидаем.Что(Ошибка.Описание, "Наружу проброшена исходная программная ошибка").Содержит(
		"программная ошибка callback");
	ЕстьИсходныйКадрСтека = Ложь;
	ТекущаяОшибка = Ошибка;
	Пока ТекущаяОшибка <> Неопределено И Не ЕстьИсходныйКадрСтека Цикл
		Для Каждого КадрСтека Из ТекущаяОшибка.ПолучитьСтекВызовов() Цикл
			Если КадрСтека.Метод = "СохранитьИВернуть" Тогда
				ЕстьИсходныйКадрСтека = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		ТекущаяОшибка = ТекущаяОшибка.Причина;
	КонецЦикла;
	Ожидаем.Что(ЕстьИсходныйКадрСтека,
		"Цепочка причины сохранила исходный callback-кадр ИнформацияОбОшибке").ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ТестДолжен_ПослеОшибкиCommitВыполнитьRollbackИПовторитьТранзакцию() Экспорт
	// Подготовка
	Регистратор = Новый РегистраторТранзакцииБД();
	Регистратор.НастроитьОшибку("COMMIT", 1, "database is locked");
	НастроитьТранзакционныйМенеджер(Регистратор);
	Операции = Новый ОперацииТранзакцииБД();
	Фасад = СоздатьФасад(1);
	// Действие
	Фасад.ВыполнитьВТранзакции(Новый Действие(Операции, "СохранитьИВернуть"));
	// Проверка
	Ожидаем.Что(Регистратор.Порядок(), "Ошибка commit отменена до новой полной попытки").Равно(
		"BEGIN,CALLBACK,COMMIT,ROLLBACK,BEGIN,CALLBACK,COMMIT");
КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаблокироватьФасадПослеНеудачногоRollback() Экспорт
	// Подготовка
	Регистратор = Новый РегистраторТранзакцииБД();
	Регистратор.НастроитьОшибку("ROLLBACK", 1, "rollback database is locked");
	Регистратор.НастроитьОшибку("CLOSE", 1, "ошибка закрытия");
	НастроитьТранзакционныйМенеджер(Регистратор);
	Операции = Новый ОперацииТранзакцииБД();
	Операции.НастроитьОшибки(1, "database is locked в callback");
	Фасад = СоздатьФасад(2);
	// Действие
	ПерваяОшибка = ПолучитьОшибкуТранзакции(Фасад, Новый Действие(Операции, "СохранитьИВернуть"));
	ВтораяОшибка = ПолучитьОшибкуПолученияФасада(Фасад);
	// Проверка
	Ожидаем.Что(Регистратор.Порядок(), "Неудачный rollback остановил retry и вызвал аварийное закрытие").Равно(
		"BEGIN,CALLBACK,ROLLBACK,CLOSE");
	Ожидаем.Что(ПерваяОшибка.Параметры,
		"Фатальная ошибка содержит машинный маркер в параметрах").Равно("litros_db_rollback_failed");
	Ожидаем.Что(СтрНайти(ПерваяОшибка.Описание, "litros_db_rollback_failed"),
		"Машинный маркер не попал в пользовательское описание").Равно(0);
	Ожидаем.Что(ПерваяОшибка.Описание, "Диагностика содержит исходную ошибку").Содержит(
		"database is locked в callback");
	Ожидаем.Что(ПерваяОшибка.Описание, "Диагностика содержит ошибку rollback").Содержит(
		"rollback database is locked");
	Ожидаем.Что(ПерваяОшибка.Описание, "Ошибка best-effort закрытия добавлена в диагностику").Содержит(
		"ошибка закрытия");
	Ожидаем.Что(ВтораяОшибка.Описание, "Следующий DB-вызов требует пересоздания контекста").Содержит(
		"пересоздать контекст Autumn или перезапустить приложение");
КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьФатальнуюДиагностикуДоПроверкиCallback() Экспорт
	// Подготовка
	Регистратор = Новый РегистраторТранзакцииБД();
	Регистратор.НастроитьОшибку("ROLLBACK", 1, "rollback database is locked");
	НастроитьТранзакционныйМенеджер(Регистратор);
	Операции = Новый ОперацииТранзакцииБД();
	Операции.НастроитьОшибки(1, "database is locked в callback");
	Фасад = СоздатьФасад(2);

	// Действие
	ФатальнаяОшибка = ПолучитьОшибкуТранзакции(
		Фасад, Новый Действие(Операции, "СохранитьИВернуть"));
	ОшибкаНеверногоCallback = ПолучитьОшибкуТранзакции(Фасад, "не действие");

	// Проверка
	Ожидаем.Что(ОшибкаНеверногоCallback.Описание,
		"После неудачного rollback фатальная диагностика доминирует над проверкой callback")
		.Равно(ФатальнаяОшибка.Описание);
КонецПроцедуры

