#Использовать asserts
#Использовать moskito
#Использовать autumn
#Использовать entity
#Использовать reflector
#Использовать "../src/internal"
#Использовать "../src/dto"

Перем _Менеджер; // Мок МенеджерСущностей
Перем _Табакерка; // Мок Табакерка
Перем _Исполнитель; // Мок ИсполнительОперацийБД
Перем _КоличествоИзвлечений; // Число
Перем _КоличествоВызововИсполнителя; // Число
Перем _КоличествоПрямыхВызовов; // Число

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередКаждым() Экспорт
	_КоличествоИзвлечений = 0;
	_КоличествоВызововИсполнителя = 0;
	_КоличествоПрямыхВызовов = 0;
	_Менеджер = Мок.Получить(Тип("МенеджерСущностей"));
	_Табакерка = Мок.Получить(Тип("Табакерка"));
	_Исполнитель = Мок.Получить(Тип("ИсполнительОперацийБД"));
	_Табакерка.Когда().Достать().ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ДостатьМенеджер"));
	_Исполнитель.Когда().ВыполнитьОперацию(
		Матчеры.ИмеетТип(Тип("Действие")), Матчеры.ЛюбоеЗначение())
		.ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ВыполнитьОперацию"));
КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ЛенивоИзвлечьМенеджерОдинРазИВыполнитьCRUDЧерезExecutor() Экспорт

	// Подготовка
	Фасад = СоздатьФасад();
	ТипСущности = Тип("СущностьРепозиторий");
	Опции = Новый ОпцииПоиска();
	Результат = Новый Массив();
	_Менеджер.Когда().Получить(ТипСущности, Опции).ТогдаОтвечает(
		СоздатьОтветПрямогоВызова(Результат));
	_Менеджер.Когда().ПолучитьОдно(ТипСущности, Опции).ТогдаОтвечает(
		СоздатьОтветПрямогоВызова(Неопределено));

	// Действие
	КоличествоДоПервогоВызова = _КоличествоИзвлечений;
	Полученные = Фасад.Получить(ТипСущности, Опции);
	Фасад.ПолучитьОдно(ТипСущности, Опции);

	// Проверка
	Ожидаем.Что(КоличествоДоПервогоВызова, "Создание фасада не разрешило табакерку менеджера").Равно(0);
	Ожидаем.Что(_КоличествоИзвлечений, "Два DB-вызова извлекли внутренний менеджер один раз").Равно(1);
	Ожидаем.Что(_КоличествоВызововИсполнителя, "Каждая простая операция заняла executor ровно один раз").Равно(2);
	Ожидаем.Что(_КоличествоПрямыхВызовов, "Каждая попытка делегировала менеджеру ровно один вызов").Равно(2);
	Ожидаем.Что(Полученные = Результат, "Фасад не преобразовал результат entity").ЭтоИстина();
	_Менеджер.ПроверитьЧтоВызывалсяМетод().Получить(ТипСущности, Опции);
	_Менеджер.ПроверитьЧтоВызывалсяМетод().ПолучитьОдно(ТипСущности, Опции);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДелегироватьСохранениеУдалениеИСыройSQL() Экспорт

	// Подготовка
	Фасад = СоздатьФасад();
	Сущность = Новый СущностьРепозиторий();
	Таблица = Новый ТаблицаЗначений();
	Коннектор = Мок.Получить(Тип("КоннекторSQLite"));
	_Менеджер.Когда().Сохранить(Сущность).ТогдаОтвечает(
		СоздатьОтветПрямогоВызова(Неопределено));
	_Менеджер.Когда().Удалить(Сущность).ТогдаОтвечает(
		СоздатьОтветПрямогоВызова(Неопределено));
	_Менеджер.Когда().ПолучитьКоннектор().ТогдаОтвечает(
		СоздатьОтветПрямогоВызова(Коннектор));
	Коннектор.Когда().ВыполнитьЗапрос("SELECT 1").ТогдаОтвечает(
		СоздатьОтветПрямогоВызова(Таблица));

	// Действие
	Фасад.Сохранить(Сущность);
	Фасад.Удалить(Сущность);
	Результат = Фасад.ВыполнитьЗапрос("SELECT 1");

	// Проверка
	Ожидаем.Что(_КоличествоВызововИсполнителя, "Три простые операции создали три внешних executor-вызова").Равно(3);
	Ожидаем.Что(_КоличествоПрямыхВызовов, "CRUD вызваны по одному разу, SQL получил коннектор и выполнил один запрос").Равно(4);
	Ожидаем.Что(Результат = Таблица, "Сырой SQL вернул исходную таблицу значений").ЭтоИстина();
	_Менеджер.ПроверитьЧтоВызывалсяМетод().Сохранить(Сущность);
	_Менеджер.ПроверитьЧтоВызывалсяМетод().Удалить(Сущность);
	Коннектор.ПроверитьЧтоВызывалсяМетод().ВыполнитьЗапрос("SELECT 1");

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ДостатьМенеджер(ИнформацияОВызове) Экспорт
	_КоличествоИзвлечений = _КоличествоИзвлечений + 1;
	Возврат _Менеджер;
КонецФункции

Функция ВыполнитьОперацию(ИнформацияОВызове) Экспорт
	_КоличествоВызововИсполнителя = _КоличествоВызововИсполнителя + 1;
	ПараметрыВызова = ИнформацияОВызове.Параметры();
	Операция = ПараметрыВызова[0];
	ИсходныеПараметры = ПараметрыВызова[1];
	Если ИсходныеПараметры = Неопределено Тогда
		ПараметрыОперации = Новый Массив();
	ИначеЕсли ТипЗнч(ИсходныеПараметры) = Тип("Массив")
		Или ТипЗнч(ИсходныеПараметры) = Тип("ФиксированныйМассив") Тогда
		ПараметрыОперации = Новый Массив();
		Для Каждого Параметр Из ИсходныеПараметры Цикл
			ПараметрыОперации.Добавить(Параметр);
		КонецЦикла;
	Иначе
		ПараметрыОперации = Новый Массив();
		ПараметрыОперации.Добавить(ИсходныеПараметры);
	КонецЕсли;
	Возврат Новый Рефлектор().ВызватьМетод(Операция, "Выполнить", ПараметрыОперации);
КонецФункции

Функция ЗарегистрироватьПрямойВызов(ИнформацияОВызове, Результат) Экспорт
	_КоличествоПрямыхВызовов = _КоличествоПрямыхВызовов + 1;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьОтветПрямогоВызова(Результат)
	ДополнительныеПараметры = Новый Массив();
	ДополнительныеПараметры.Добавить(Результат);
	Возврат Новый Ответ(
		ЭтотОбъект, "ЗарегистрироватьПрямойВызов", ДополнительныеПараметры);
КонецФункции

Функция СоздатьФасад()
	Фасад = Новый УстойчивыйМенеджерСущностей();
	Рефлектор = Новый Рефлектор();
	Рефлектор.УстановитьСвойство(Фасад, "_ВнутреннийМенеджерСущностей", _Табакерка);
	Рефлектор.УстановитьСвойство(Фасад, "_ИсполнительОперацийБД", _Исполнитель);
	Возврат Фасад;
КонецФункции

#КонецОбласти
