#Использовать asserts
#Использовать moskito
#Использовать autumn
#Использовать entity
#Использовать reflector
#Использовать "../src/internal"
#Использовать "../src/db"
#Использовать "../src/repository"
#Использовать "../src/dto"

Перем Идентификатор Экспорт; // Строка - Идентификатор сущности старого формата.
Перем Имя Экспорт; // Строка - Имя сущности старого формата.
Перем ПолноеИмя Экспорт; // Строка - Полное имя сущности старого формата.

Перем _ПоследняяСохраненнаяСущность; // СущностьРепозиторий
Перем _ПоследниеОпцииПолучитьОдно; // ОпцииПоиска
Перем _ПоследниеОпцииПолучить; // ОпцииПоиска
Перем _РезультатПолучитьОдно; // Произвольный
Перем _РезультатПолучить; // Массив
Перем _УдаленнаяСущность; // Произвольный
Перем _КоличествоУдалений; // Число
Перем _ПоследнийТекстЗапроса; // Строка
Перем _РезультатЗапроса; // ТаблицаЗначений

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

&ПередКаждым
Процедура ПередКаждым() Экспорт

	_ПоследняяСохраненнаяСущность = Неопределено;
	_ПоследниеОпцииПолучитьОдно = Неопределено;
	_ПоследниеОпцииПолучить = Неопределено;
	_РезультатПолучитьОдно = Неопределено;
	_РезультатПолучить = Новый Массив();
	_УдаленнаяСущность = Неопределено;
	_КоличествоУдалений = 0;
	_ПоследнийТекстЗапроса = "";
	_РезультатЗапроса = Новый ТаблицаЗначений();
	Идентификатор = "";
	Имя = "";
	ПолноеИмя = "";

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_СохранитьНормализованнуюСущностьЧерезФасад() Экспорт

	// Подготовка
	Фасад = СоздатьФасад();
	Фасад.Когда().Сохранить(Матчеры.ЛюбоеЗначение())
		.ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ЗарегистрироватьСохранение"));
	Хранилище = СоздатьХранилище(Фасад);
	Сущность = Новый СущностьРепозиторий();
	Сущность.Имя = " Test-Package ";
	ДатаДоСохранения = РаботаСДаннымиБД.НормализоватьУниверсальнуюДату(
		ТекущаяУниверсальнаяДата());

	// Действие
	Хранилище.Сохранить(Сущность);
	ДатаПослеСохранения = РаботаСДаннымиБД.НормализоватьУниверсальнуюДату(
		ТекущаяУниверсальнаяДата());

	// Проверка
	Ожидаем.Что(Сущность.Имя, "Имя нормализовано перед сохранением").Равно("test-package");
	Ожидаем.Что(Сущность.ДатаОбновления >= ДатаДоСохранения
		И Сущность.ДатаОбновления <= ДатаПослеСохранения,
		"Дата обновления нормализована и попадает в интервал вызова").ЭтоИстина();
	Ожидаем.Что(_ПоследняяСохраненнаяСущность = Сущность,
		"Фасад получил тот же объект сущности").ЭтоИстина();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("repo-id")
&ИсточникЗначение("missing-id")
Процедура ТестДолжен_АтомарноПередатьУдалениеПоИдентификатору(Идентификатор) Экспорт

	// Подготовка
	Фасад = СоздатьФасад();
	НастроитьУдаление(Фасад);
	Хранилище = СоздатьХранилище(Фасад);

	// Действие
	Хранилище.Удалить(Идентификатор);

	// Проверка
	Ожидаем.Что(_ПоследниеОпцииПолучитьОдно, "Удаление не выполняет предварительное чтение").ЭтоНеопределено();
	Ожидаем.Что(_КоличествоУдалений, "Удаление выполнено одной операцией").Равно(1);
	Ожидаем.Что(_УдаленнаяСущность.Идентификатор, "Идентификатор передан без изменений").Равно(Идентификатор);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПолучитьРепозиторииСОтборомСортировкамиИПреобразованием() Экспорт

	// Подготовка
	Фасад = СоздатьФасад();
	Фасад.Когда().Получить(Тип("СущностьРепозиторий"), Матчеры.ИмеетТип(Тип("ОпцииПоиска")))
		.ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ЗарегистрироватьПолучение"));
	ИсходнаяСущность = Новый СущностьРепозиторий();
	ИсходнаяСущность.Идентификатор = "dto-id";
	СущностьСтарогоФормата = СоздатьСущностьСтарогоФормата();
	_РезультатПолучить.Добавить(ИсходнаяСущность);
	_РезультатПолучить.Добавить(СущностьСтарогоФормата);
	Хранилище = СоздатьХранилище(Фасад);
	Идентификаторы = Новый Массив();
	Идентификаторы.Добавить("dto-id");
	Идентификаторы.Добавить("legacy-id");

	// Действие
	Результат = Хранилище.ПолучитьРепозитории(Идентификаторы, "ПолноеИмя Убыв, ДатаОбновления");

	// Проверка
	ПроверитьОтборПоИдентификатору(_ПоследниеОпцииПолучить, ВидСравнения.В, Идентификаторы);
	Сортировки = _ПоследниеОпцииПолучить.Сортировки();
	Ожидаем.Что(Сортировки.Количество(), "Переданы обе сортировки").Равно(2);
	Ожидаем.Что(Сортировки[0].ПутьКДанным, "Сохранено первое поле сортировки").Равно("ПолноеИмя");
	Ожидаем.Что(Сортировки[0].НаправлениеСортировки,
		"Сохранено убывающее направление первой сортировки").Равно(НаправлениеСортировки.Убыв);
	Ожидаем.Что(Сортировки[1].ПутьКДанным, "Сохранено второе поле сортировки").Равно("ДатаОбновления");
	Ожидаем.Что(Сортировки[1].НаправлениеСортировки,
		"Для второй сортировки использовано направление по умолчанию").Равно(НаправлениеСортировки.Возр);
	Ожидаем.Что(Результат[0] = ИсходнаяСущность, "DTO возвращен без замены объекта").ЭтоИстина();
	Ожидаем.Что(ТипЗнч(Результат[1]), "Сущность старого формата преобразована в DTO").Равно(Тип("СущностьРепозиторий"));
	Ожидаем.Что(Результат[1].Идентификатор, "Идентификатор перенесен из старого формата").Равно("legacy-id");
	Ожидаем.Что(Результат[1].ПолноеИмя, "Данные перенесены из старого формата").Равно("owner/legacy-name");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыполнитьПолныйЗапросОбновленияЧерезФасадИСохранитьПорядок() Экспорт

	// Подготовка
	Фасад = СоздатьФасад();
	Фасад.Когда().ВыполнитьЗапрос(Матчеры.ЛюбоеЗначение())
		.ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ЗарегистрироватьЗапрос"));
	_РезультатЗапроса.Колонки.Добавить("Идентификатор");
	_РезультатЗапроса.Колонки.Добавить("ИдентификаторУзла");
	ПерваяСтрока = _РезультатЗапроса.Добавить();
	ПерваяСтрока.Идентификатор = 2;
	ПерваяСтрока.ИдентификаторУзла = "second-node-id";
	ВтораяСтрока = _РезультатЗапроса.Добавить();
	ВтораяСтрока.Идентификатор = 1;
	ВтораяСтрока.ИдентификаторУзла = "first-node-id";
	Хранилище = СоздатьХранилище(Фасад);

	// Действие
	Результат = Хранилище.ПолучитьРепозиторииДляОбновления('20260723142500', 17);

	// Проверка
	ПроверитьЗапросОбновления(_ПоследнийТекстЗапроса);
	Ожидаем.Что(Результат.Количество(), "Возвращены все задания")
		.Равно(2);
	Ожидаем.Что(Результат[0].Идентификатор, "Порядок первого репозитория сохранен").Равно(2);
	Ожидаем.Что(Результат[0].ИдентификаторУзла, "Первый Node ID возвращен")
		.Равно("second-node-id");
	Ожидаем.Что(Результат[1].Идентификатор, "Порядок второго репозитория сохранен").Равно(1);
	Ожидаем.Что(Результат[1].ИдентификаторУзла, "Второй Node ID возвращен")
		.Равно("first-node-id");

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ЗарегистрироватьСохранение(ИнформацияОВызове) Экспорт

	_ПоследняяСохраненнаяСущность = ИнформацияОВызове.Параметры()[0];
	Возврат Неопределено;

КонецФункции

Функция ЗарегистрироватьПолучениеОдного(ИнформацияОВызове) Экспорт

	_ПоследниеОпцииПолучитьОдно = ИнформацияОВызове.Параметры()[1];
	Возврат _РезультатПолучитьОдно;

КонецФункции

Функция ЗарегистрироватьПолучение(ИнформацияОВызове) Экспорт

	_ПоследниеОпцииПолучить = ИнформацияОВызове.Параметры()[1];
	Возврат _РезультатПолучить;

КонецФункции

Функция ЗарегистрироватьУдаление(ИнформацияОВызове) Экспорт

	_КоличествоУдалений = _КоличествоУдалений + 1;
	_УдаленнаяСущность = ИнформацияОВызове.Параметры()[0];
	Возврат Неопределено;

КонецФункции

Функция ЗарегистрироватьЗапрос(ИнформацияОВызове) Экспорт

	_ПоследнийТекстЗапроса = ИнформацияОВызове.Параметры()[0];
	Возврат _РезультатЗапроса;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьФасад()

	Возврат Мок.Получить(Тип("ПулМенеджеровСущностей"));

КонецФункции

Функция СоздатьХранилище(Фасад)

	Возврат Новый ХранилищеРепозиториев(Фасад);

КонецФункции

Процедура НастроитьУдаление(Фасад)

	Фасад.Когда().ПолучитьОдно(
		Тип("СущностьРепозиторий"), Матчеры.ИмеетТип(Тип("ОпцииПоиска")))
		.ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ЗарегистрироватьПолучениеОдного"));
	Фасад.Когда().Удалить(Матчеры.ЛюбоеЗначение())
		.ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ЗарегистрироватьУдаление"));

КонецПроцедуры

Процедура ПроверитьОтборПоИдентификатору(Опции, ОжидаемыйВидСравнения, ОжидаемоеЗначение)

	Ожидаем.Что(Опции, "Фасад получил опции поиска").ИмеетТип(Тип("ОпцииПоиска"));
	Отборы = Опции.Отборы();
	Ожидаем.Что(Отборы.Количество(), "Передан единственный отбор").Равно(1);
	Ожидаем.Что(Отборы[0].ПутьКДанным, "Отбор построен по идентификатору")
		.Равно("Идентификатор");
	Ожидаем.Что(Отборы[0].ВидСравнения, "Передан ожидаемый вид сравнения")
		.Равно(ОжидаемыйВидСравнения);
	Ожидаем.Что(Отборы[0].Значение = ОжидаемоеЗначение,
		"В отбор передано исходное значение").ЭтоИстина();

КонецПроцедуры

Функция СоздатьСущностьСтарогоФормата()

	ПутьКСценарию = ОбъединитьПути(
		ТекущийКаталог(), "tests/ХранилищеРепозиториев_test.os");
	Сущность = ЗагрузитьСценарий(ПутьКСценарию);
	Сущность.Идентификатор = "legacy-id";
	Сущность.Имя = "legacy-name";
	Сущность.ПолноеИмя = "owner/legacy-name";
	Возврат Сущность;

КонецФункции

Процедура ПроверитьЗапросОбновления(ТекстЗапроса)

	Ожидаем.Что(ТекстЗапроса, "Источники объединены").Содержит("UNION");
	Ожидаем.Что(ТекстЗапроса, "Учтены репозитории, требующие обновления")
		.Содержит("Репозитории.ТребуетсяОбновление");
	Ожидаем.Что(ТекстЗапроса, "Для GraphQL выбран отдельный Node ID")
		.Содержит("ИдентификаторУзла");
	Ожидаем.Что(ТекстЗапроса, "Дата передана в запрос").Содержит("2026-07-23");
	Ожидаем.Что(ТекстЗапроса, "Результат сортируется по дате")
		.Содержит("ДатаОбновления DESC");
	Ожидаем.Что(ТекстЗапроса, "Лимит передан в запрос").Содержит("LIMIT 17");

КонецПроцедуры

#КонецОбласти
