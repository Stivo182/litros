#Использовать moskito
#Использовать entity
#Использовать autumn
#Использовать "../src/internal"
#Использовать "../src/dto"

Перем _КоличествоОбращений; // Число
Перем _ОжидаемыйРезультат; // Произвольный

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередКаждым() Экспорт
	_КоличествоОбращений = 0;
	_ОжидаемыйРезультат = Новый Массив();
КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ДелегироватьCRUDИСыройЗапросМенеджеру() Экспорт

	// Подготовка
	Менеджер = Мок.Получить(Тип("МенеджерСущностей"));
	Коннектор = Мок.Получить(Тип("КоннекторSQLite"));
	ТипСущности = Тип("СущностьРепозиторий");
	Опции = Новый ОпцииПоиска();
	Сущность = Новый СущностьРепозиторий();
	Менеджер.Когда().Получить(ТипСущности, Опции).ТогдаВозвращает(_ОжидаемыйРезультат);
	Менеджер.Когда().ПолучитьОдно(ТипСущности, Опции).ТогдаВозвращает(Сущность);
	Менеджер.Когда().ПолучитьКоннектор().ТогдаВозвращает(Коннектор);
	Коннектор.Когда().ВыполнитьЗапрос("SELECT 1").ТогдаВозвращает(_ОжидаемыйРезультат);
	ЕдиницаРаботы = Новый ЕдиницаРаботыБД(Менеджер);

	// Действие
	Все = ЕдиницаРаботы.Получить(ТипСущности, Опции);
	Один = ЕдиницаРаботы.ПолучитьОдно(ТипСущности, Опции);
	ЕдиницаРаботы.Сохранить(Сущность);
	ЕдиницаРаботы.Удалить(Сущность);
	Таблица = ЕдиницаРаботы.ВыполнитьЗапрос("SELECT 1");

	// Проверка
	Ожидаем.Что(Все = _ОжидаемыйРезультат, "Результат Получить возвращён без преобразования").ЭтоИстина();
	Ожидаем.Что(Один = Сущность, "Результат ПолучитьОдно возвращён без преобразования").ЭтоИстина();
	Ожидаем.Что(Таблица = _ОжидаемыйРезультат, "Результат сырого SQL возвращён без преобразования").ЭтоИстина();
	Менеджер.ПроверитьЧтоВызывалсяМетод().Получить(ТипСущности, Опции);
	Менеджер.ПроверитьЧтоВызывалсяМетод().ПолучитьОдно(ТипСущности, Опции);
	Менеджер.ПроверитьЧтоВызывалсяМетод().Сохранить(Сущность);
	Менеджер.ПроверитьЧтоВызывалсяМетод().Удалить(Сущность);
	Коннектор.ПроверитьЧтоВызывалсяМетод().ВыполнитьЗапрос("SELECT 1");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗапретитьОбращениеПослеДеактивацииДоВызоваМенеджера() Экспорт

	// Подготовка
	Менеджер = Мок.Получить(Тип("МенеджерСущностей"));
	Менеджер.Когда().Получить(Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение())
		.ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ЗарегистрироватьОбращение"));
	ЕдиницаРаботы = Новый ЕдиницаРаботыБД(Менеджер);
	ЕдиницаРаботы.Деактивировать();

	// Действие
	Ошибка = ПолучитьОшибкуПолучения(ЕдиницаРаботы);

	// Проверка
	Ожидаем.Что(Ошибка.Описание, "Ошибка объясняет завершение срока жизни единицы работы").Содержит(
		"ЕдиницаРаботыБД больше не активна");
	Ожидаем.Что(_КоличествоОбращений, "Деактивированная единица работы не обратилась к менеджеру").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ЗарегистрироватьОбращение(ИнформацияОВызове) Экспорт
	_КоличествоОбращений = _КоличествоОбращений + 1;
	Возврат _ОжидаемыйРезультат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьОшибкуПолучения(ЕдиницаРаботы)
	Попытка
		ЕдиницаРаботы.Получить(Тип("СущностьРепозиторий"));
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;
	ВызватьИсключение "Ожидалась ошибка деактивированной единицы работы";
КонецФункции

#КонецОбласти
