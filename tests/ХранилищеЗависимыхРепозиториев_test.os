#Использовать autumn
#Использовать entity
#Использовать reflector
#Использовать "../src/internal"
#Использовать "../src/db"
#Использовать "../src/repository"
#Использовать "../src/dto"

Перем _ДоступКБД; // Мок ТранзакционныйДоступКБД
Перем _КоличествоТранзакций; // Число
Перем _СохраненныеСущности; // Массив
Перем _УдаленныеСущности; // Массив

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередКаждым
Процедура ПередКаждым() Экспорт
	_КоличествоТранзакций = 0;
	_СохраненныеСущности = Новый Массив();
	_УдаленныеСущности = Новый Массив();
	_ДоступКБД = Мок.Получить(Тип("ТранзакционныйДоступКБД"));
КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_СохранитьГрафОднойТранзакциейБезВложенногоХранилища() Экспорт

	// Подготовка
	Фасад = Мок.Получить(Тип("ПулМенеджеровСущностей"));
	Фасад.Когда().ВыполнитьВТранзакции(
		Матчеры.ИмеетТип(Тип("Действие")), Матчеры.ЛюбоеЗначение())
		.ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ВыполнитьТранзакцию"));
	_ДоступКБД.Когда().ПолучитьОдно(
		Тип("СущностьСтатистикаПакета"), Матчеры.ЛюбоеЗначение()).ТогдаВозвращает(Неопределено);
	СтараяЗависимость = Новый СущностьЗависимыйРепозиторий();
	СтараяЗависимость.ИдентификаторРепозитория = "stale-id";
	СтарыеЗависимости = Новый Массив();
	СтарыеЗависимости.Добавить(СтараяЗависимость);
	_ДоступКБД.Когда().Получить(
		Тип("СущностьЗависимыйРепозиторий"), Матчеры.ЛюбоеЗначение()).ТогдаВозвращает(СтарыеЗависимости);
	СуществующийРепозиторий = Новый СущностьРепозиторий();
	СуществующийРепозиторий.Идентификатор = "existing-id";
	СуществующиеРепозитории = Новый Массив();
	СуществующиеРепозитории.Добавить(СуществующийРепозиторий);
	_ДоступКБД.Когда().Получить(
		Тип("СущностьРепозиторий"), Матчеры.ЛюбоеЗначение()).ТогдаВозвращает(СуществующиеРепозитории);
	_ДоступКБД.Когда().Сохранить(Матчеры.ЛюбоеЗначение())
		.ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ЗарегистрироватьСохранение"));
	_ДоступКБД.Когда().Удалить(Матчеры.ЛюбоеЗначение())
		.ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ЗарегистрироватьУдаление"));
	ВложенноеХранилище = Мок.Получить(Тип("ХранилищеРепозиториев"));
	ВложенноеХранилище.Когда().ПолучитьРепозитории(
		Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение())
		.ТогдаВыбрасываетИсключение("вложенное хранилище вызвано внутри транзакции");
	Хранилище = СоздатьХранилище(Фасад, ВложенноеХранилище);
	Зависимые = Новый Массив();
	Зависимые.Добавить(СоздатьОписаниеРепозитория(
		"new-id", " NewRepo ", "Owner/NewRepo", "new-url", "owner", Истина));
	Зависимые.Добавить(СоздатьОписаниеРепозитория(
		"existing-id", " ExistingRepo ", "Owner/ExistingRepo", "existing-url", "owner", Ложь));
	Зависимые.Добавить(СоздатьОписаниеРепозитория(
		"nameless-id", "", "Owner/Nameless", "nameless-url", "owner", Ложь));
	ДатаДоСохранения = РаботаСДаннымиБД.НормализоватьУниверсальнуюДату(ТекущаяУниверсальнаяДата());

	// Действие
	Ошибка = Неопределено;
	Попытка
		Хранилище.Сохранить(" Test-Package ", Зависимые);
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	ДатаПослеСохранения = РаботаСДаннымиБД.НормализоватьУниверсальнуюДату(ТекущаяУниверсальнаяДата());

	// Проверка
	Ожидаем.Что(Ошибка, "Сохранение не вызвало вложенное хранилище внутри транзакции").ЭтоНеопределено();
	Ожидаем.Что(_КоличествоТранзакций, "Весь граф сохранен одним вызовом фасада").Равно(1);
	Ожидаем.Что(_СохраненныеСущности.Количество(),
		"Сохранены статистика, три зависимости и два новых репозитория").Равно(6);
	Ожидаем.Что(_УдаленныеСущности.Количество(), "Старая зависимость удалена").Равно(1);
	Ожидаем.Что(_УдаленныеСущности[0] = СтараяЗависимость,
		"Удалена сущность прежней зависимости").ЭтоИстина();
	НовыйРепозиторий = НайтиСохраненныйРепозиторий("new-id");
	Ожидаем.Что(НовыйРепозиторий <> Неопределено,
		"Отсутствующий репозиторий создан через транзакционный доступ").ЭтоИстина();
	Ожидаем.Что(НовыйРепозиторий.Имя, "Переданное короткое имя нормализовано").Равно("newrepo");
	Ожидаем.Что(НовыйРепозиторий.ПолноеИмя, "Полное имя перенесено без потери").Равно("Owner/NewRepo");
	Ожидаем.Что(НовыйРепозиторий.URL, "URL перенесен без потери").Равно("new-url");
	Ожидаем.Что(НовыйРепозиторий.Владелец, "Владелец перенесен без потери").Равно("owner");
	Ожидаем.Что(НовыйРепозиторий.ЭтоФорк, "Признак форка перенесен без потери").ЭтоИстина();
	Ожидаем.Что(НовыйРепозиторий.ТребуетсяОбновление,
		"Новый репозиторий помечен для обновления").ЭтоИстина();
	Ожидаем.Что(НовыйРепозиторий.ДатаОбновления >= ДатаДоСохранения
		И НовыйРепозиторий.ДатаОбновления <= ДатаПослеСохранения,
		"Дата обновления задана нормализованным текущим временем").ЭтоИстина();
	Ожидаем.Что(НайтиСохраненныйРепозиторий("existing-id"),
		"Существующий репозиторий повторно не сохранен").ЭтоНеопределено();
	Ожидаем.Что(НайтиСохраненныйРепозиторий("nameless-id").Имя,
		"Пустое короткое имя сохраняется без изменений").Равно("");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПолучитьКоличествоРепозиториевЧерезФасад() Экспорт

	// Подготовка
	Фасад = Мок.Получить(Тип("ПулМенеджеровСущностей"));
	Статистика = Новый СущностьСтатистикаПакета();
	Статистика.КоличествоОбратныхЗависимостей = 7;
	Фасад.Когда().ПолучитьОдно(Тип("СущностьСтатистикаПакета"), Матчеры.ЛюбоеЗначение()).ТогдаВозвращает(Статистика);
	Хранилище = СоздатьХранилище(Фасад, Мок.Получить(Тип("ХранилищеРепозиториев")));

	// Действие
	Количество = Хранилище.КоличествоРепозиториев(" TEST-PACKAGE ");

	// Проверка
	Ожидаем.Что(Количество, "Количество получено через фасад").Равно(7);
	Фасад.ПроверитьЧтоВызывалсяМетод().ПолучитьОдно(Тип("СущностьСтатистикаПакета"), Матчеры.ЛюбоеЗначение());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПолучитьЗависимыеРепозиторииЧерезХранилищеРепозиториев() Экспорт

	// Подготовка
	Фасад = Мок.Получить(Тип("ПулМенеджеровСущностей"));
	Зависимость = Новый СущностьЗависимыйРепозиторий();
	Зависимость.ИдентификаторРепозитория = "repo-id";
	Зависимости = Новый Массив();
	Зависимости.Добавить(Зависимость);
	Фасад.Когда().Получить(Тип("СущностьЗависимыйРепозиторий"), Матчеры.ЛюбоеЗначение()).ТогдаВозвращает(Зависимости);
	Репозитории = Новый Массив();
	Репозитории.Добавить(Новый СущностьРепозиторий());
	ХранилищеРепозиториев = Мок.Получить(Тип("ХранилищеРепозиториев"));
	ХранилищеРепозиториев.Когда().ПолучитьРепозитории(
		Матчеры.ЛюбоеЗначение(), "ПолноеИмя Возр").ТогдаВозвращает(Репозитории);
	Хранилище = СоздатьХранилище(Фасад, ХранилищеРепозиториев);

	// Действие
	ПолученныеРепозитории = Хранилище.ПолучитьРепозитории(" TEST-PACKAGE ", "ПолноеИмя Возр");

	// Проверка
	Ожидаем.Что(ПолученныеРепозитории = Репозитории, "Возвращен результат вложенного хранилища").ЭтоИстина();
	Фасад.ПроверитьЧтоВызывалсяМетод().Получить(Тип("СущностьЗависимыйРепозиторий"), Матчеры.ЛюбоеЗначение());
	ХранилищеРепозиториев.ПроверитьЧтоВызывалсяМетод().ПолучитьРепозитории(Матчеры.ЛюбоеЗначение(), "ПолноеИмя Возр");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПолучитьПакетыДляОбновленияЧерезФасад() Экспорт

	// Подготовка
	Фасад = Мок.Получить(Тип("ПулМенеджеровСущностей"));
	ПерваяСтатистика = Новый СущностьСтатистикаПакета();
	ПерваяСтатистика.ИмяПакета = "first";
	ВтораяСтатистика = Новый СущностьСтатистикаПакета();
	ВтораяСтатистика.ИмяПакета = "second";
	Статистики = Новый Массив();
	Статистики.Добавить(ПерваяСтатистика);
	Статистики.Добавить(ВтораяСтатистика);
	Фасад.Когда().Получить(Тип("СущностьСтатистикаПакета"), Матчеры.ЛюбоеЗначение()).ТогдаВозвращает(Статистики);
	Хранилище = СоздатьХранилище(Фасад, Мок.Получить(Тип("ХранилищеРепозиториев")));

	// Действие
	Пакеты = Хранилище.ПолучитьПакетыДляОбновления(ТекущаяУниверсальнаяДата(), 2);

	// Проверка
	Ожидаем.Что(Пакеты, "Список пакетов собран из результата фасада").ИмеетДлину(2);
	Ожидаем.Что(Пакеты[0], "Первое имя пакета сохранено").Равно("first");
	Ожидаем.Что(Пакеты[1], "Второе имя пакета сохранено").Равно("second");
	Фасад.ПроверитьЧтоВызывалсяМетод().Получить(Тип("СущностьСтатистикаПакета"), Матчеры.ЛюбоеЗначение());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДополнитьОшибкуТранзакцииКонтекстомПакета() Экспорт

	// Подготовка
	Фасад = Мок.Получить(Тип("ПулМенеджеровСущностей"));
	Фасад.Когда().ВыполнитьВТранзакции(
		Матчеры.ИмеетТип(Тип("Действие")), Матчеры.ЛюбоеЗначение())
		.ТогдаВыбрасываетИсключение("исходная ошибка транзакции");
	Хранилище = СоздатьХранилище(Фасад, Мок.Получить(Тип("ХранилищеРепозиториев")));

	// Действие
	Ошибка = Неопределено;
	Попытка
		Хранилище.Сохранить(" TEST-PACKAGE ", Новый Массив());
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(Ошибка <> Неопределено,
		"Ошибка транзакции проброшена вызывающему коду").ЭтоИстина();
	Ожидаем.Что(Ошибка.Описание, "Ошибка дополнена нормализованным именем пакета").Содержит(
		"пакета test-package");
	Ожидаем.Что(Ошибка.Описание, "Исходная ошибка сохранена в диагностике").Содержит(
		"исходная ошибка транзакции");

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ВыполнитьТранзакцию(ИнформацияОВызове) Экспорт
	_КоличествоТранзакций = _КоличествоТранзакций + 1;
	ПараметрыВызова = ИнформацияОВызове.Параметры();
	Операция = ПараметрыВызова[0];
	ПользовательскиеПараметры = ПараметрыВызова[1];
	ПараметрыОперации = Новый Массив();
	ПараметрыОперации.Добавить(_ДоступКБД);
	Для Каждого Параметр Из ПользовательскиеПараметры Цикл
		ПараметрыОперации.Добавить(Параметр);
	КонецЦикла;

	Возврат Новый Рефлектор().ВызватьМетод(Операция, "Выполнить", ПараметрыОперации);
КонецФункции

Функция ЗарегистрироватьСохранение(ИнформацияОВызове) Экспорт
	_СохраненныеСущности.Добавить(ИнформацияОВызове.Параметры()[0]);
	Возврат Неопределено;
КонецФункции

Функция ЗарегистрироватьУдаление(ИнформацияОВызове) Экспорт
	_УдаленныеСущности.Добавить(ИнформацияОВызове.Параметры()[0]);
	Возврат Неопределено;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьХранилище(Фасад, ХранилищеРепозиториев)
	Возврат Новый ХранилищеЗависимыхРепозиториев(Фасад, ХранилищеРепозиториев);
КонецФункции

Функция СоздатьОписаниеРепозитория(Идентификатор, Имя, ПолноеИмя, URL, Владелец, ЭтоФорк)
	Возврат Новый Структура(
		"Идентификатор,Имя,ПолноеИмя,URL,Владелец,ЭтоФорк",
		Идентификатор, Имя, ПолноеИмя, URL, Владелец, ЭтоФорк);
КонецФункции

Функция НайтиСохраненныйРепозиторий(Идентификатор)
	Для Каждого Сущность Из _СохраненныеСущности Цикл
		Если ТипЗнч(Сущность) = Тип("СущностьРепозиторий")
			И Сущность.Идентификатор = Идентификатор Тогда
			Возврат Сущность;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;
КонецФункции

#КонецОбласти
