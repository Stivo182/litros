&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область Тесты

&Тест
Процедура ТестДолжен_РазместитьКлассыБДВОтдельнойБиблиотеке() Экспорт

	ИменаКлассов = Новый Массив();
	ИменаКлассов.Добавить("КлассификаторОшибокSQLite");
	ИменаКлассов.Добавить("КомандаОперацииБД");
	ИменаКлассов.Добавить("КоординаторОперацийБД");
	ИменаКлассов.Добавить("НастройкиОтказоустойчивостиБД");
	ИменаКлассов.Добавить("ОбъектыВзаимодействияСБД");
	ИменаКлассов.Добавить("ТранзакционныйДоступКБД");
	ИменаКлассов.Добавить("УстойчивыйМенеджерСущностей");

	ПроверитьРазмещениеКлассовБД(ИменаКлассов);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОписатьСамостоятельнуюБиблиотекуБД() Экспорт

	ИменаКлассов = Новый Массив();
	ИменаКлассов.Добавить("КлассификаторОшибокSQLite");
	ИменаКлассов.Добавить("КомандаОперацииБД");
	ИменаКлассов.Добавить("КоординаторОперацийБД");
	ИменаКлассов.Добавить("НастройкиОтказоустойчивостиБД");
	ИменаКлассов.Добавить("ОбъектыВзаимодействияСБД");
	ИменаКлассов.Добавить("ТранзакционныйДоступКБД");
	ИменаКлассов.Добавить("УстойчивыйМенеджерСущностей");

	ПутьМанифеста = ПутьПроекта("src", "db", "lib.config");
	Ожидаем.Что(Новый Файл(ПутьМанифеста).Существует(),
		"Библиотека БД имеет canonical manifest").ЭтоИстина();
	Манифест = ПрочитатьФайл(ПутьМанифеста);
	Для Каждого ИмяКласса Из ИменаКлассов Цикл
		ОписаниеКласса = СтрШаблон("<class name=""%1"" file=""Классы/%1.os""/>", ИмяКласса);
		Ожидаем.Что(Манифест,
			СтрШаблон("Manifest библиотеки БД описывает класс %1", ИмяКласса)).Содержит(ОписаниеКласса);
	КонецЦикла;
	Ожидаем.Что(Манифест, "Manifest библиотеки БД описывает служебный модуль")
		.Содержит("<module name=""РаботаСДаннымиБД"" file=""Модули/РаботаСДаннымиБД.os""/>");

	ВнутреннийМанифест = ПрочитатьФайлПроекта("src", "internal", "lib.config");
	Для Каждого ИмяКласса Из ИменаКлассов Цикл
		Ожидаем.Что(СтрНайти(ВнутреннийМанифест, ИмяКласса),
			СтрШаблон("Internal manifest не экспортирует DB-класс %1", ИмяКласса)).Равно(0);
	КонецЦикла;
	Ожидаем.Что(СтрНайти(ВнутреннийМанифест, "РаботаСДаннымиБД"),
		"Internal manifest не экспортирует модуль БД").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_УдалитьПрежниеПосредникиДоступаКБД() Экспорт

	ОсновныеТипы = Новый Массив();
	ОсновныеТипы.Добавить("УстойчивыйМенеджерСущностей");
	ОсновныеТипы.Добавить("КоординаторОперацийБД");
	ОсновныеТипы.Добавить("ТранзакционныйДоступКБД");
	ОсновныеТипы.Добавить("КомандаОперацииБД");
	УдаленныеТипы = Новый Массив();
	УдаленныеТипы.Добавить("ИсполнительОперацийБД");
	УдаленныеТипы.Добавить("КонтекстУстойчивогоМенеджераСущностей");
	УдаленныеТипы.Добавить("ОперацияУстойчивогоМенеджераСущностей");
	УдаленныеТипы.Добавить("ТранзакционнаяОперацияМенеджераСущностей");
	УдаленныеТипы.Добавить("ЕдиницаРаботыБД");

	ЭтотТест = ПолноеИмяФайлаПроекта("tests", "АрхитектураОтказоустойчивостиБД_test.os");
	ВсеИсходникиИТесты = ПрочитатьФайлыПроекта("src") + ПрочитатьФайлыПроекта("tests", ЭтотТест);
	Для Каждого ИмяТипа Из ОсновныеТипы Цикл
		ПутьКласса = ПутьПроекта("src", "db", "Классы", ИмяТипа + ".os");
		Ожидаем.Что(Новый Файл(ПутьКласса).Существует(),
			СтрШаблон("Класс упрощенного DB-ядра %1 существует", ИмяТипа)).ЭтоИстина();
	КонецЦикла;
	Для Каждого ИмяТипа Из УдаленныеТипы Цикл
		ПутьКласса = ПутьПроекта("src", "internal", "Классы", ИмяТипа + ".os");
		Ожидаем.Что(Новый Файл(ПутьКласса).Существует(),
			СтрШаблон("Файл удаленного посредника %1 отсутствует", ИмяТипа)).ЭтоЛожь();
		Ожидаем.Что(СтрНайти(ВсеИсходникиИТесты, ИмяТипа),
			СтрШаблон("Удаленный тип %1 нигде не упоминается", ИмяТипа)).Равно(0);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОставитьСыройМенеджерТолькоВКоординаторе() Экспорт

	ВсеИсходники = ПрочитатьФайлыПроекта("src");
	Координатор = ПрочитатьФайлПроекта("src", "db", "Классы", "КоординаторОперацийБД.os");
	ОбъектыБД = ПрочитатьФайлПроекта("src", "db", "Классы", "ОбъектыВзаимодействияСБД.os");
	ИменованнаяЗавязь = "&Завязь(Значение = ""ВнутреннийМенеджерСущностей"", Тип = ""МенеджерСущностей"")";
	ВнедрениеМенеджера = "&Пластилин(""ВнутреннийМенеджерСущностей"")";

	Ожидаем.Что(ОбъектыБД, "Сырая завязь имеет отдельное внутреннее имя")
		.Содержит(ИменованнаяЗавязь);
	Ожидаем.Что(КоличествоВхождений(ВсеИсходники, ИменованнаяЗавязь),
		"Именованная завязь сырого менеджера объявлена ровно один раз").Равно(1);
	Ожидаем.Что(КоличествоВхождений(ВсеИсходники, "Тип = ""МенеджерСущностей"""),
		"Во всех исходниках есть ровно одна завязь типа МенеджерСущностей").Равно(1);
	Ожидаем.Что(Координатор, "Только координатор лениво получает внутренний менеджер")
		.Содержит(ВнедрениеМенеджера);
	Ожидаем.Что(КоличествоВхождений(ВсеИсходники, ВнедрениеМенеджера),
		"Внутренний менеджер внедряется ровно один раз и только в координатор").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗапретитьСыройМенеджерИExecutorВоВсехProductionПотребителях() Экспорт

	ЗапрещенныеФрагменты = Новый Массив();
	ЗапрещенныеФрагменты.Добавить("&Пластилин(""ВнутреннийМенеджерСущностей"")");
	ЗапрещенныеФрагменты.Добавить("&Пластилин(""МенеджерСущностей"")");
	ЗапрещенныеФрагменты.Добавить("&Пластилин(""ИсполнительОперацийБД"")");
	ЗапрещенныеФрагменты.Добавить("&Пластилин(""КоннекторSQLite"")");
	ЗапрещенныеФрагменты.Добавить("Новый МенеджерСущностей(");
	ЗапрещенныеФрагменты.Добавить("Новый ИсполнительОперацийБД(");
	ЗапрещенныеФрагменты.Добавить("Новый КоннекторSQLite(");
	ЗапрещенныеФрагменты.Добавить("Тип(""КоннекторSQLite"")");
	ЗапрещенныеФрагменты.Добавить(".ПолучитьКоннектор(");
	ЗапрещенныеФрагменты.Добавить(".ПолучитьХранилищеСущностей(");
	ЗапрещенныеФрагменты.Добавить(".НачатьТранзакцию(");
	ЗапрещенныеФрагменты.Добавить(".ЗафиксироватьТранзакцию(");
	ЗапрещенныеФрагменты.Добавить(".ОтменитьТранзакцию(");
	ЗапрещенныеФрагменты.Добавить(".ВыполнитьОперацию(");

	Для Каждого КаталогПотребителей Из КаталогиProductionПотребителей() Цикл
		Для Каждого ФайлПотребителя Из НайтиФайлы(КаталогПотребителей, "*.os", Истина) Цикл
			Текст = ПрочитатьФайл(ФайлПотребителя.ПолноеИмя);
			Для Каждого Фрагмент Из ЗапрещенныеФрагменты Цикл
				Ожидаем.Что(СтрНайти(Текст, Фрагмент),
					СтрШаблон("Production-потребитель %1 не обходит DB-фасад через %2",
						ФайлПотребителя.ПолноеИмя, Фрагмент)).Равно(0);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОставитьУФасадаСемьЭкспортовИТриЗависимости() Экспорт

	ТекстФасада = ПрочитатьФайлПроекта("src", "db", "Классы", "УстойчивыйМенеджерСущностей.os");
	ОжидаемыеИмена = Новый Массив();
	ОжидаемыеИмена.Добавить("Получить");
	ОжидаемыеИмена.Добавить("ПолучитьОдно");
	ОжидаемыеИмена.Добавить("Сохранить");
	ОжидаемыеИмена.Добавить("Удалить");
	ОжидаемыеИмена.Добавить("ВыполнитьЗапрос");
	ОжидаемыеИмена.Добавить("ВыполнитьВТранзакции");
	ОжидаемыеИмена.Добавить("НужноПовторитьОперацию");

	Фасад = Новый УстойчивыйМенеджерСущностей(
		Новый НастройкиОтказоустойчивостиБД(),
		Новый КлассификаторОшибокSQLite(),
		Новый КоординаторОперацийБД());
	ПроверитьЭкспортныеМетоды(Фасад, ОжидаемыеИмена, "Фасад");
	Ожидаем.Что(КоличествоВхождений(ТекстФасада, "&Пластилин("),
		"Фасад имеет ровно три внедряемые зависимости").Равно(3);
	Ожидаем.Что(ТекстФасада, "Фасад зависит от настроек").Содержит("&Пластилин(""НастройкиОтказоустойчивостиБД"")");
	Ожидаем.Что(ТекстФасада, "Фасад зависит от классификатора").Содержит("&Пластилин(""КлассификаторОшибокSQLite"")");
	Ожидаем.Что(ТекстФасада, "Фасад зависит от координатора").Содержит("&Пластилин(""КоординаторОперацийБД"")");
	Ожидаем.Что(СтрНайти(ТекстФасада, "ИсполнительОперацийБД"),
		"Отдельная executor dependency удалена").Равно(0);

	ЗапрещенныеЗависимости = Новый Массив();
	ЗапрещенныеЗависимости.Добавить("ВнутреннийМенеджерСущностей");
	ЗапрещенныеЗависимости.Добавить("МенеджерСущностей");
	ЗапрещенныеЗависимости.Добавить("КоннекторSQLite");
	ЗапрещенныеЗависимости.Добавить("ТранзакционныйДоступКБД");
	Для Каждого Зависимость Из ЗапрещенныеЗависимости Цикл
		Ожидаем.Что(СтрНайти(ТекстФасада, "&Пластилин(""" + Зависимость + """)"),
			СтрШаблон("Фасад не внедряет %1", Зависимость)).Равно(0);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПередаватьКомандыТолькоКоординатору() Экспорт

	Фасад = ПрочитатьФайлПроекта("src", "db", "Классы", "УстойчивыйМенеджерСущностей.os");
	ДействиеКоординатора = "Новый Действие(_КоординаторОперацийБД, ""Исполнить"")";
	ДействиеПовтора = "Новый Действие(ЭтотОбъект, ""НужноПовторитьОперацию"")";

	Ожидаем.Что(КоличествоВхождений(Фасад, "Новый Действие("),
		"Фасад создает только coordinator action и retry callback").Равно(2);
	Ожидаем.Что(КоличествоВхождений(Фасад, ДействиеКоординатора),
		"Pipeline-действие нацелено только на КоординаторОперацийБД.Исполнить").Равно(1);
	Ожидаем.Что(КоличествоВхождений(Фасад, ДействиеПовтора),
		"Retry callback нацелен только на фасадный предикат повтора").Равно(1);
	Ожидаем.Что(КоличествоВхождений(Фасад, "Новый КомандаОперацииБД("),
		"Фасад создает именованные команды для простого и транзакционного путей").Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОграничитьТранзакционныйДоступCRUDОперациями() Экспорт

	Доступ = ПрочитатьФайлПроекта("src", "db", "Классы", "ТранзакционныйДоступКБД.os");
	ОжидаемыеИмена = Новый Массив();
	ОжидаемыеИмена.Добавить("Получить");
	ОжидаемыеИмена.Добавить("ПолучитьОдно");
	ОжидаемыеИмена.Добавить("Сохранить");
	ОжидаемыеИмена.Добавить("Удалить");
	ОжидаемыеИмена.Добавить("Деактивировать");

	ПроверитьЭкспортныеМетоды(Новый ТранзакционныйДоступКБД(Неопределено), ОжидаемыеИмена,
		"Транзакционный доступ");
	Ожидаем.Что(СтрНайти(Доступ, "ВыполнитьЗапрос"),
		"Транзакционный доступ не предоставляет выполнение SQL").Равно(0);
	Ожидаем.Что(СтрНайти(Доступ, "ПолучитьКоннектор"),
		"Транзакционный доступ не предоставляет коннектор").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазрешитьТранзакционныеCallbacksТолькоДвумХранилищам() Экспорт

	РазрешенныеФайлы = Новый Массив();
	РазрешенныеФайлы.Добавить(ПолноеИмяФайлаПроекта("src", "repository", "Классы", "ХранилищеЗависимыхРепозиториев.os"));
	РазрешенныеФайлы.Добавить(ПолноеИмяФайлаПроекта("src", "repository", "Классы", "ХранилищеОчередиПакетов.os"));

	ФактическиеФайлы = НайтиФайлыСФрагментом(ПутьПроекта("src"), ".ВыполнитьВТранзакции");
	Для Каждого ИмяФайла Из ФактическиеФайлы Цикл
		Ожидаем.Что(РазрешенныеФайлы.Найти(ИмяФайла) <> Неопределено,
			СтрШаблон("Транзакционный callback разрешен только двум repositories: %1", ИмяФайла)).ЭтоИстина();
	КонецЦикла;
	Ожидаем.Что(ФактическиеФайлы.Количество(),
		"Транзакционный callback используется ровно двумя repositories").Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОставитьПроцессорБезPersistenceЗависимостей() Экспорт

	Процессор = ПрочитатьФайлПроекта("src", "service", "Классы", "ПроцессорОчередиПакетов.os");
	ЗапрещенныеФрагменты = Новый Массив();
	ЗапрещенныеФрагменты.Добавить("УстойчивыйМенеджерСущностей");
	ЗапрещенныеФрагменты.Добавить("ИсполнительОперацийБД");
	ЗапрещенныеФрагменты.Добавить("МенеджерСущностей");
	ЗапрещенныеФрагменты.Добавить("ТранзакционныйДоступКБД");
	ЗапрещенныеФрагменты.Добавить("СущностьОчередьПакета");
	ЗапрещенныеФрагменты.Добавить("ОпцииПоиска");

	Для Каждого Фрагмент Из ЗапрещенныеФрагменты Цикл
		Ожидаем.Что(СтрНайти(Процессор, Фрагмент),
			СтрШаблон("Процессор не зависит от persistence API: %1", Фрагмент)).Равно(0);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗапретитьСыруюИнфраструктуруИПриватныеПоляФасадаВConsumerТестах() Экспорт

	ЗапрещенныеФрагменты = Новый Массив();
	ЗапрещенныеФрагменты.Добавить("Новый МенеджерСущностей(");
	ЗапрещенныеФрагменты.Добавить("Новый КоннекторSQLite(");
	ЗапрещенныеФрагменты.Добавить("Тип(""КоннекторSQLite"")");
	ЗапрещенныеФрагменты.Добавить("&Пластилин(""ВнутреннийМенеджерСущностей"")");
	ЗапрещенныеФрагменты.Добавить(".ПолучитьКоннектор(");
	ЗапрещенныеФрагменты.Добавить(".НачатьТранзакцию(");
	ЗапрещенныеФрагменты.Добавить(".ЗафиксироватьТранзакцию(");
	ЗапрещенныеФрагменты.Добавить(".ОтменитьТранзакцию(");
	ЗапрещенныеФрагменты.Добавить("_ВнутреннийМенеджерСущностей");
	ЗапрещенныеФрагменты.Добавить("_ИсполнительОперацийБД");
	ЗапрещенныеФрагменты.Добавить("_КоординаторОперацийБД");
	ЗапрещенныеФрагменты.Добавить("_Контекст");
	ЗапрещенныеФрагменты.Добавить("_БлокировкаКонтекста");

	Для Каждого ФайлТеста Из ConsumerТесты() Цикл
		Текст = ПрочитатьФайл(ФайлТеста);
		ТекстБезПробелов = СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст,
			Символы.ПС, ""), Символы.Таб, ""), " ", "");
		Ожидаем.Что(СтрНайти(ТекстБезПробелов, "УстановитьСвойство(Фасад,"),
			СтрШаблон("Consumer-тест %1 не меняет приватные поля фасада", ФайлТеста)).Равно(0);
		Для Каждого Фрагмент Из ЗапрещенныеФрагменты Цикл
			Ожидаем.Что(СтрНайти(Текст, Фрагмент),
				СтрШаблон("Consumer-тест %1 не создает raw DB и не меняет приватные поля фасада: %2",
					ФайлТеста, Фрагмент)).Равно(0);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьРазмещениеКлассовБД(ИменаКлассов)

	Для Каждого ИмяКласса Из ИменаКлассов Цикл
		НовыйПуть = ПутьПроекта("src", "db", "Классы", ИмяКласса + ".os");
		СтарыйПутьПодсистемы = ПутьПроекта("src", "internal", "Классы", "БД", ИмяКласса + ".os");
		СтарыйПутьКорня = ПутьПроекта("src", "internal", "Классы", ИмяКласса + ".os");
		Ожидаем.Что(Новый Файл(НовыйПуть).Существует(),
			СтрШаблон("Класс %1 размещен в самостоятельной библиотеке db", ИмяКласса)).ЭтоИстина();
		Ожидаем.Что(Новый Файл(СтарыйПутьПодсистемы).Существует(),
			СтрШаблон("Класс %1 отсутствует в internal/Классы/БД", ИмяКласса)).ЭтоЛожь();
		Ожидаем.Что(Новый Файл(СтарыйПутьКорня).Существует(),
			СтрШаблон("Класс %1 отсутствует в корне internal/Классы", ИмяКласса)).ЭтоЛожь();
	КонецЦикла;

КонецПроцедуры

Функция КаталогиProductionПотребителей()
	Результат = Новый Массив();
	ИменаКаталогов = Новый Массив();
	ИменаКаталогов.Добавить("repository");
	ИменаКаталогов.Добавить("service");
	ИменаКаталогов.Добавить("web");
	Для Каждого ИмяКаталога Из ИменаКаталогов Цикл
		Каталог = ПутьПроекта("src", ИмяКаталога);
		Если Новый Файл(Каталог).Существует() Тогда
			Результат.Добавить(Каталог);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ПроверитьЭкспортныеМетоды(Объект, ОжидаемыеИмена, ИмяКонтракта)

	РефлекторОбъекта = Новый РефлекторОбъекта(Объект);
	Методы = РефлекторОбъекта.ПолучитьТаблицуМетодов();
	ФактическиеИмена = Методы.ВыгрузитьКолонку("Имя");

	Ожидаем.Что(ФактическиеИмена.Количество(),
		СтрШаблон("%1 имеет утвержденное число экспортных методов", ИмяКонтракта))
		.Равно(ОжидаемыеИмена.Количество());
	Для Каждого ИмяМетода Из ОжидаемыеИмена Цикл
		Ожидаем.Что(ФактическиеИмена.Найти(ИмяМетода) <> Неопределено,
			СтрШаблон("%1 экспортирует утвержденный метод %2", ИмяКонтракта, ИмяМетода)).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

Функция ConsumerТесты()
	ИнфраструктурныеТесты = Новый Массив();
	ИнфраструктурныеТесты.Добавить(ПолноеИмяФайлаПроекта("tests", "АрхитектураОтказоустойчивостиБД_test.os"));
	ИнфраструктурныеТесты.Добавить(ПолноеИмяФайлаПроекта("tests", "УстойчивыйМенеджерСущностейОтказоустойчивость_test.os"));
	ИнфраструктурныеТесты.Добавить(ПолноеИмяФайлаПроекта("tests", "КлассификаторОшибокSQLite_test.os"));
	ИнфраструктурныеТесты.Добавить(ПолноеИмяФайлаПроекта("tests", "НастройкиОтказоустойчивостиБД_test.os"));
	ИнфраструктурныеТесты.Добавить(ПолноеИмяФайлаПроекта("tests", "ОбъектыВзаимодействияСБД_test.os"));
	ИнфраструктурныеТесты.Добавить(ПолноеИмяФайлаПроекта("tests", "ТранзакционныйДоступКБД_test.os"));
	ИнфраструктурныеТесты.Добавить(ПолноеИмяФайлаПроекта("tests", "УстойчивыйМенеджерСущностей_test.os"));
	ИнфраструктурныеТесты.Добавить(ПолноеИмяФайлаПроекта("tests", "УстойчивыйМенеджерСущностейSQLite_test.os"));

	Результат = Новый Массив();
	Для Каждого ФайлТеста Из НайтиФайлы(ПутьПроекта("tests"), "*_test.os", Ложь) Цикл
		Если ИнфраструктурныеТесты.Найти(ФайлТеста.ПолноеИмя) = Неопределено Тогда
			Результат.Добавить(ФайлТеста.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПрочитатьФайлыПроекта(КорневойКаталог, ИсключенныйФайл = "")
	Результат = "";
	Для Каждого ФайлПроекта Из НайтиФайлы(ПутьПроекта(КорневойКаталог), "*.os", Истина) Цикл
		Если ФайлПроекта.ПолноеИмя <> ИсключенныйФайл Тогда
			Результат = Результат + ПрочитатьФайл(ФайлПроекта.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НайтиФайлыСФрагментом(Каталог, Фрагмент)
	Результат = Новый Массив();
	Для Каждого ФайлПроекта Из НайтиФайлы(Каталог, "*.os", Истина) Цикл
		Если СтрНайти(ПрочитатьФайл(ФайлПроекта.ПолноеИмя), Фрагмент) > 0 Тогда
			Результат.Добавить(ФайлПроекта.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПрочитатьФайлПроекта(Сегмент1, Сегмент2 = Неопределено, Сегмент3 = Неопределено, Сегмент4 = Неопределено, Сегмент5 = Неопределено)
	Возврат ПрочитатьФайл(ПутьПроекта(Сегмент1, Сегмент2, Сегмент3, Сегмент4, Сегмент5));
КонецФункции

Функция ПолноеИмяФайлаПроекта(Сегмент1, Сегмент2 = Неопределено, Сегмент3 = Неопределено, Сегмент4 = Неопределено, Сегмент5 = Неопределено)
	Возврат Новый Файл(ПутьПроекта(Сегмент1, Сегмент2, Сегмент3, Сегмент4, Сегмент5)).ПолноеИмя;
КонецФункции

Функция ПутьПроекта(Сегмент1, Сегмент2 = Неопределено, Сегмент3 = Неопределено, Сегмент4 = Неопределено, Сегмент5 = Неопределено)
	Путь = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
	Сегменты = Новый Массив();
	Сегменты.Добавить(Сегмент1);
	Сегменты.Добавить(Сегмент2);
	Сегменты.Добавить(Сегмент3);
	Сегменты.Добавить(Сегмент4);
	Сегменты.Добавить(Сегмент5);
	Для Каждого Сегмент Из Сегменты Цикл
		Если Сегмент <> Неопределено Тогда
			Путь = ОбъединитьПути(Путь, Сегмент);
		КонецЕсли;
	КонецЦикла;
	Возврат Путь;
КонецФункции

Функция ПрочитатьФайл(Путь)
	Документ = Новый ТекстовыйДокумент();
	Документ.Прочитать(Путь, КодировкаТекста.UTF8);
	Возврат Документ.ПолучитьТекст();
КонецФункции

Функция КоличествоВхождений(Текст, Фрагмент)
	Возврат (СтрДлина(Текст) - СтрДлина(СтрЗаменить(Текст, Фрагмент, ""))) / СтрДлина(Фрагмент);
КонецФункции

#КонецОбласти
