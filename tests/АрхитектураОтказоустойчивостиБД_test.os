&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область Тесты

&Тест
Процедура ТестДолжен_ЗапретитьОбходУстойчивогоФасадаВПотребителях() Экспорт

	// Подготовка
	ЗапрещенныеФрагменты = Новый Массив();
	ЗапрещенныеФрагменты.Добавить("&Пластилин(""МенеджерСущностей"")");
	ЗапрещенныеФрагменты.Добавить("&Пластилин(""ВнутреннийМенеджерСущностей"")");
	ЗапрещенныеФрагменты.Добавить("&Пластилин(""ИсполнительОперацийБД"")");
	ЗапрещенныеФрагменты.Добавить("&Пластилин(""КоннекторSQLite"")");
	ЗапрещенныеФрагменты.Добавить("Новый МенеджерСущностей(");
	ЗапрещенныеФрагменты.Добавить("Новый КоннекторSQLite(");
	ЗапрещенныеФрагменты.Добавить("Тип(""КоннекторSQLite"")");
	ЗапрещенныеФрагменты.Добавить(".ПолучитьКоннектор(");
	ЗапрещенныеФрагменты.Добавить(".ПолучитьХранилищеСущностей(");
	ЗапрещенныеФрагменты.Добавить(".НачатьТранзакцию(");
	ЗапрещенныеФрагменты.Добавить(".ЗафиксироватьТранзакцию(");
	ЗапрещенныеФрагменты.Добавить(".ОтменитьТранзакцию(");
	ЗапрещенныеФрагменты.Добавить(".ВыполнитьОперацию(");

	// Действие и Проверка
	Для Каждого КаталогПотребителей Из КаталогиПотребителей() Цикл
		Для Каждого ФайлПотребителя Из НайтиФайлы(КаталогПотребителей, "*.os", Истина) Цикл
			Текст = ПрочитатьФайл(ФайлПотребителя.ПолноеИмя);
			Для Каждого Фрагмент Из ЗапрещенныеФрагменты Цикл
				Ожидаем.Что(
					СтрНайти(Текст, Фрагмент),
					СтрШаблон("%1 не содержит запрещенный обход %2", ФайлПотребителя.ПолноеИмя, Фрагмент))
					.Равно(0);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазделитьВнутреннююЗавязьИПрикладнойФасад() Экспорт

	// Подготовка
	ВсеИсходники = ПрочитатьВсеИсходники();
	ОбъектыБД = ПрочитатьФайлПроекта("src", "internal", "Классы", "ОбъектыВзаимодействияСБД.os");
	Фасад = ПрочитатьФайлПроекта("src", "internal", "Классы", "УстойчивыйМенеджерСущностей.os");
	ИменованнаяЗавязь = "&Завязь(Значение = ""ВнутреннийМенеджерСущностей"", Тип = ""МенеджерСущностей"")";
	ВнедрениеМенеджера = "&Пластилин(""ВнутреннийМенеджерСущностей"")";
	ВнедрениеИсполнителя = "&Пластилин(""ИсполнительОперацийБД"")";

	// Действие и Проверка
	Ожидаем.Что(ОбъектыБД, "Сырая завязь имеет отдельное внутреннее имя")
		.Содержит(ИменованнаяЗавязь);
	Ожидаем.Что(КоличествоВхождений(ВсеИсходники, ИменованнаяЗавязь),
		"Именованная завязь сырого менеджера объявлена ровно один раз").Равно(1);
	Ожидаем.Что(КоличествоВхождений(ВсеИсходники, "Тип = ""МенеджерСущностей"""),
		"Во всех исходниках есть ровно одна завязь типа МенеджерСущностей").Равно(1);
	Ожидаем.Что(Фасад, "Только фасад лениво получает внутренний менеджер")
		.Содержит(ВнедрениеМенеджера);
	Ожидаем.Что(КоличествоВхождений(ВсеИсходники, ВнедрениеМенеджера),
		"Внутренний менеджер внедряется ровно один раз и только в фасад").Равно(1);
	Ожидаем.Что(Фасад, "Фасад является единственной границей executor")
		.Содержит(ВнедрениеИсполнителя);
	Ожидаем.Что(КоличествоВхождений(ВсеИсходники, ВнедрениеИсполнителя),
		"Исполнитель операций БД внедряется ровно один раз и только в фасад").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОставитьУФасадаРовноШестьЭкспортныхМетодов() Экспорт

	// Подготовка
	Фасад = Новый УстойчивыйМенеджерСущностей();
	ОжидаемыеИмена = Новый Массив();
	ОжидаемыеИмена.Добавить("Получить");
	ОжидаемыеИмена.Добавить("ПолучитьОдно");
	ОжидаемыеИмена.Добавить("Сохранить");
	ОжидаемыеИмена.Добавить("Удалить");
	ОжидаемыеИмена.Добавить("ВыполнитьЗапрос");
	ОжидаемыеИмена.Добавить("ВыполнитьВТранзакции");

	// Действие
	РефлекторФасада = Новый РефлекторОбъекта(Фасад);
	Методы = РефлекторФасада.ПолучитьТаблицуМетодов();
	ФактическиеИмена = Методы.ВыгрузитьКолонку("Имя");

	// Проверка
	Ожидаем.Что(ФактическиеИмена.Количество(),
		"Фасад не публикует служебные executor-callback методы").Равно(6);
	Для Каждого ИмяМетода Из ОжидаемыеИмена Цикл
		Ожидаем.Что(
			ФактическиеИмена.Найти(ИмяМетода) <> Неопределено,
			СтрШаблон("Фасад экспортирует утвержденный метод %1", ИмяМетода)).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция КаталогиПотребителей()
	Результат = Новый Массив();
	Результат.Добавить(ПутьПроекта("src", "repository"));
	Результат.Добавить(ПутьПроекта("src", "service"));
	Возврат Результат;
КонецФункции

Функция ПрочитатьВсеИсходники()
	Результат = "";
	Для Каждого ФайлИсходника Из НайтиФайлы(ПутьПроекта("src"), "*.os", Истина) Цикл
		Результат = Результат + ПрочитатьФайл(ФайлИсходника.ПолноеИмя);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПрочитатьФайлПроекта(Сегмент1, Сегмент2 = Неопределено, Сегмент3 = Неопределено, Сегмент4 = Неопределено)
	Сегменты = Новый Массив();
	Сегменты.Добавить(Сегмент1);
	Если Сегмент2 <> Неопределено Тогда
		Сегменты.Добавить(Сегмент2);
	КонецЕсли;
	Если Сегмент3 <> Неопределено Тогда
		Сегменты.Добавить(Сегмент3);
	КонецЕсли;
	Если Сегмент4 <> Неопределено Тогда
		Сегменты.Добавить(Сегмент4);
	КонецЕсли;
	Возврат ПрочитатьФайл(ПутьПроекта(Сегменты));
КонецФункции

Функция ПутьПроекта(Сегмент1, Сегмент2 = Неопределено)
	Путь = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
	Если ТипЗнч(Сегмент1) = Тип("Массив") Тогда
		Сегменты = Сегмент1;
	Иначе
		Сегменты = Новый Массив();
		Сегменты.Добавить(Сегмент1);
		Если Сегмент2 <> Неопределено Тогда
			Сегменты.Добавить(Сегмент2);
		КонецЕсли;
	КонецЕсли;
	Для Каждого Сегмент Из Сегменты Цикл
		Путь = ОбъединитьПути(Путь, Сегмент);
	КонецЦикла;
	Возврат Путь;
КонецФункции

Функция ПрочитатьФайл(Путь)
	Документ = Новый ТекстовыйДокумент();
	Документ.Прочитать(Путь, КодировкаТекста.UTF8);
	Возврат Документ.ПолучитьТекст();
КонецФункции

Функция КоличествоВхождений(Текст, Фрагмент)
	Возврат (СтрДлина(Текст) - СтрДлина(СтрЗаменить(Текст, Фрагмент, ""))) / СтрДлина(Фрагмент);
КонецФункции

#КонецОбласти
