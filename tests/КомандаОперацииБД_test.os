&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

#Область Тесты

&Тест
Процедура ТестДолжен_СоздатьНеизменяемуюПростуюКоманду() Экспорт

	// Подготовка
	Параметры = Новый Массив();
	Параметры.Добавить("значение");

	// Действие
	Команда = Новый КомандаОперацииБД("Получить", Параметры);

	// Проверка
	Ожидаем.Что(Команда.ИмяОперации(), "Имя простой операции сохранено").Равно("Получить");
	Ожидаем.Что(Команда.Параметры() = Параметры, "Параметры не копируются").ЭтоИстина();
	Ожидаем.Что(Команда.ОбработчикТранзакции(), "У простой команды нет callback").ЭтоНеопределено();
	Ожидаем.Что(Команда.ЭтоТранзакция(), "Простая команда не является транзакцией").ЭтоЛожь();
	Свойства = Новый РефлекторОбъекта(Команда).ПолучитьТаблицуСвойств(Неопределено, Ложь);
	Ожидаем.Что(Свойства.Количество(), "Команда не экспортирует изменяемые свойства").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьТранзакционнуюКоманду() Экспорт

	// Подготовка
	Операции = Новый ОперацииТранзакцииБД();
	Обработчик = Новый Действие(Операции, "СохранитьИВернуть");
	Параметры = Новый Массив();
	Параметры.Добавить("значение");

	// Действие
	Команда = Новый КомандаОперацииБД("ВыполнитьВТранзакции", Параметры, Обработчик);

	// Проверка
	Ожидаем.Что(Команда.ИмяОперации(), "Имя транзакционной операции сохранено")
		.Равно("ВыполнитьВТранзакции");
	Ожидаем.Что(Команда.ЭтоТранзакция(), "Команда распознана как транзакция").ЭтоИстина();
	Ожидаем.Что(Команда.ОбработчикТранзакции() = Обработчик, "Callback сохранен без обертки")
		.ЭтоИстина();
	Ожидаем.Что(Команда.Параметры() = Параметры, "Параметры сохранены без копирования").ЭтоИстина();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Получить")
&ИсточникЗначение("ПолучитьОдно")
&ИсточникЗначение("Сохранить")
&ИсточникЗначение("Удалить")
&ИсточникЗначение("ВыполнитьЗапрос")
Процедура ТестДолжен_РазрешитьПростуюОперацию(ИмяОперации) Экспорт

	// Действие
	Команда = Новый КомандаОперацииБД(ИмяОперации, Неопределено);

	// Проверка
	Ожидаем.Что(Команда.ИмяОперации(), "Разрешенное имя принято").Равно(ИмяОперации);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНеизвестнуюОперацию() Экспорт

	// Действие
	Ошибка = ПолучитьОшибкуСоздания("Неизвестная", Неопределено, Неопределено);

	// Проверка
	Ожидаем.Что(Ошибка.Описание, "Неизвестное имя отклонено")
		.Содержит("Неизвестная операция БД: Неизвестная");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьТранзакциюБезОбработчика() Экспорт

	// Действие
	Ошибка = ПолучитьОшибкуСоздания("ВыполнитьВТранзакции", Неопределено, Неопределено);

	// Проверка
	Ожидаем.Что(Ошибка.Описание, "Транзакции требуется Действие")
		.Содержит("ВыполнитьВТранзакции принимает Действие");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьНеДействиеВКачествеОбработчикаТранзакции() Экспорт

	// Действие
	Ошибка = ПолучитьОшибкуСоздания("ВыполнитьВТранзакции", Неопределено, "не действие");

	// Проверка
	Ожидаем.Что(Ошибка.Описание, "Транзакции требуется Действие")
		.Содержит("ВыполнитьВТранзакции принимает Действие");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьОбработчикУПростойОперации() Экспорт

	// Подготовка
	Операции = Новый ОперацииТранзакцииБД();
	Обработчик = Новый Действие(Операции, "СохранитьИВернуть");

	// Действие
	Ошибка = ПолучитьОшибкуСоздания("Получить", Неопределено, Обработчик);

	// Проверка
	Ожидаем.Что(Ошибка.Описание, "Простая команда не принимает callback")
		.Содержит("Обработчик транзакции допустим только для ВыполнитьВТранзакции");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьОшибкуСоздания(ИмяОперации, Параметры, Обработчик)

	Попытка
		Команда = Новый КомандаОперацииБД(ИмяОперации, Параметры, Обработчик);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;
	ВызватьИсключение "Ожидалась ошибка создания команды операции БД";

КонецФункции

#КонецОбласти
