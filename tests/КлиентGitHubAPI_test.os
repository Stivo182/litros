#Использовать asserts
#Использовать autumn
#Использовать httpbin
#Использовать 1connector
#Использовать "../src/internal"

Перем _HttpBin; // HttpBin
Перем _НастройкиОтказоустойчивостиGitHub; // НастройкиОтказоустойчивостиGitHub
Перем _КлиентGitHubAPI; // КлиентGitHubAPI

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

&ПередВсеми
Процедура ПередВсеми() Экспорт

	// HttpBin
	_HttpBin = Новый HttpBin(, 3434);
	_HttpBin.УстановитьТаймаутЗапуска(20);
	_HttpBin.УстановитьРасположениеКонтроллеров("./tests/fixtures/api-mocks");
	_HttpBin.Запустить();

	// Autumn
	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("litros.github.Токен", "token");
	ЗначенияДеталек.Вставить("litros.github.АдресAPI", _HttpBin.URL());
	ЗначенияДеталек.Вставить("litros.github.МинимальнаяЗадержкаВторичногоЛимитаМс", 50);
	ЗначенияДеталек.Вставить("litros.github.МаксимальнаяЗадержкаПовтораМс", 100);
	ЗначенияДеталек.Вставить("litros.github.БазоваяЗадержкаПовтораМс", 0);
	ЗначенияДеталек.Вставить("litros.github.ЛимитВызововПоискаКода", 1);
	ЗначенияДеталек.Вставить("litros.github.ИнтервалЛимитаПоискаКодаМс", 100);
	ЗначенияДеталек.Вставить("litros.github.МаксимальноеОжиданиеЛимитаПоискаКодаМс", 150);

	СоветДругогоМастера = Новый СоветДругогоМастера();
	СоветДругогоМастера.ЗначенияДеталек(ЗначенияДеталек);

	Поделка = Новый Поделка(СоветДругогоМастера);
	Поделка.ЗапуститьПриложение();

	_НастройкиОтказоустойчивостиGitHub = Поделка.НайтиЖелудь("НастройкиОтказоустойчивостиGitHub");

КонецПроцедуры

&ПередКаждым
Процедура ПередКаждым() Экспорт

	ОтключитьЛимитПоискаКода();
	УстановитьРежимПоискаКода("success");
	УстановитьРежимGraphQL("success");

	_КлиентGitHubAPI = Новый КлиентGitHubAPI(
		"token",
		_HttpBin.URL(),
		_НастройкиОтказоустойчивостиGitHub
	);

КонецПроцедуры

&ПослеВсех
Процедура ПослеВсех() Экспорт

	Если _HttpBin <> Неопределено Тогда
		_HttpBin.Остановить();
	КонецЕсли;

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыполнитьGraphQLЗапрос() Экспорт

	// Подготовка
	Идентификаторы = Новый Массив();
	Идентификаторы.Добавить("repo-node-1");
	Идентификаторы.Добавить("repo-node-2");
	Переменные = Новый Структура("ids", Идентификаторы);

	// Действие
	Ответ = _КлиентGitHubAPI.ВыполнитьGraphQL(
		"query GetRepos($ids: [ID!]!) { nodes(ids: $ids) { ... on Repository { id name description url isFork stargazerCount forkCount owner { login } } } }",
		Переменные
	);
	ДанныеОтвета = Ответ.Json();

	// Утверждение
	Ожидаем.Что(Ответ.КодСостояния, "GraphQL запрос выполнен успешно").Равно(200);
	Ожидаем.Что(ДанныеОтвета["data"]["nodes"], "GraphQL вернул оба запрошенных репозитория").ИмеетДлину(2);
	Ожидаем.Что(ДанныеОтвета["data"]["nodes"][0]["id"], "Идентификатор первого репозитория совпадает").Равно("repo-node-1");
	Ожидаем.Что(ДанныеОтвета["data"]["nodes"][1]["owner"]["login"], "Владелец второго репозитория совпадает").Равно("user");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыполнитьПоискКода() Экспорт

	// Подготовка
	СтрокаПоиска = СформироватьСтрокуПоискаКода("totalCount_5_repoCount_2_forkCount_1");

	// Действие
	Ответ = _КлиентGitHubAPI.ВыполнитьПоискКода(СтрокаПоиска, 1, 100);
	ДанныеОтвета = Ответ.Json();

	// Утверждение
	Ожидаем.Что(Ответ.КодСостояния, "Поиск кода выполнен успешно").Равно(200);
	Ожидаем.Что(ДанныеОтвета["total_count"], "Общее количество результатов поиска совпадает").Равно(5);
	Ожидаем.Что(ДанныеОтвета["items"], "Поиск вернул все результаты").ИмеетДлину(5);
	Ожидаем.Что(ДанныеОтвета["items"][0]["repository"]["full_name"], "Полное имя первого репозитория совпадает").Равно("user/repo1");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РаздельноУчитыватьЛимитыGraphQLИПоискаКода() Экспорт

	// Подготовка
	УстановитьРежимПоискаКода("exhausted");
	СтрокаПоиска = СформироватьСтрокуПоискаКода("totalCount_5_repoCount_2_forkCount_1");

	// Действие
	ОтветПоиска = _КлиентGitHubAPI.ВыполнитьПоискКода(СтрокаПоиска, 1, 100);
	ОтветGraphQL = ВыполнитьЗапросСОграничениемЛимита("GraphQL");

	// Проверка
	Ожидаем.Что(ОтветПоиска = Неопределено, "Исчерпание лимита поиска не отбрасывает ответ").ЭтоЛожь();
	Ожидаем.Что(ОтветGraphQL = Неопределено, "Лимит поиска не блокирует GraphQL").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьПоследнийОставшийсяЗапрос() Экспорт

	// Подготовка
	УстановитьРежимПоискаКода("remaining-one");
	СтрокаПоиска = СформироватьСтрокуПоискаКода("totalCount_5_repoCount_2_forkCount_1");

	// Действие
