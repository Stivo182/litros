	// Проверка
	Ожидаем.Что(ПервыйОтвет = Неопределено, "Последний доступный запрос вернул ответ").ЭтоЛожь();
	Ожидаем.Что(ВторойОтвет = Неопределено, "Следующий запрос после обнуления остатка выполнен").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеОжидатьЗадержкуБольшеМаксимальной() Экспорт

	// Подготовка
	УстановитьРежимПоискаКода("long-retry-after");
	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();

	// Действие
	ПервыйОтвет = ВыполнитьЗапросСОграничениемЛимита("SearchCode");
	ВторойОтвет = ВыполнитьЗапросСОграничениемЛимита("SearchCode");
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала;
	Статистика = ПолучитьСтатистикуПоискаКода();

	// Проверка
	Ожидаем.Что(ПервыйОтвет, "Запрос со слишком долгим Retry-After не вернул ответ").ЭтоНеопределено();
	Ожидаем.Что(ВторойОтвет, "Повторный вызов во время cooldown не вернул ответ").ЭтоНеопределено();
	Ожидаем.Что(Статистика["КоличествоЗапросов"], "Во время cooldown новый HTTP-запрос не отправлен").Равно(1);
	Ожидаем.Что(Длительность, "Клиент не ожидал задержку больше максимальной").Меньше(1000);

КонецПроцедуры

