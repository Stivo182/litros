&Тест
Процедура ТестДолжен_СчитатьКоличествоПовторовПриСозданииКлиентаGitHubAPI() Экспорт

	// Подготовка
	УстановитьРежимПоискаКода("temporary-error-always");
	Настройки = Новый НастройкиОтказоустойчивостиGitHub();
	Настройки.КоличествоПовторов = 0;
	Клиент = Новый КлиентGitHubAPI("", _HttpBin.URL(), Настройки);
	Настройки.КоличествоПовторов = 2;

	// Действие
	Ответ = Клиент.ВыполнитьПоискКода(
		СформироватьСтрокуПоискаКода("totalCount_5_repoCount_2_forkCount_1"),
		1,
		100
	);
	Статистика = ПолучитьСтатистикуПоискаКода();

	// Проверка
	Ожидаем.Что(Ответ, "Клиент с нулем повторов не вернул ответ при ошибке").ЭтоНеопределено();
	Ожидаем.Что(Статистика["КоличествоЗапросов"], "Настройка нуля повторов применена при создании клиента").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РавномерноОграничиватьКаждуюПопыткуПоискаКода() Экспорт

	// Подготовка
	УстановитьРежимПоискаКода("temporary-error-once");

	// Действие
	ПервыйОтвет = ВыполнитьЗапросСОграничениемЛимита("SearchCode");
	ВторойОтвет = ВыполнитьЗапросСОграничениемЛимита("SearchCode");
	Статистика = ПолучитьСтатистикуПоискаКода();
	ПервыйРазрыв = Статистика["МоментыЗапросов"][1] - Статистика["МоментыЗапросов"][0];
	ВторойРазрыв = Статистика["МоментыЗапросов"][2] - Статистика["МоментыЗапросов"][1];

	// Проверка
	Ожидаем.Что(ПервыйОтвет.КодСостояния, "Первый поиск после временной ошибки успешен").Равно(200);
	Ожидаем.Что(ВторойОтвет.КодСостояния, "Второй поиск кода успешен").Равно(200);
	Ожидаем.Что(Статистика["КоличествоЗапросов"], "Ограничитель учел каждую попытку поиска").Равно(3);
	Ожидаем.Что(ПервыйРазрыв >= 75, "Между первыми попытками выдержан лимит").ЭтоИстина();
	Ожидаем.Что(ВторойРазрыв >= 75, "Между следующими попытками выдержан лимит").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеОграничиватьGraphQLЛимитомПоискаКода() Экспорт

	// Подготовка
	Настройки = Новый НастройкиОтказоустойчивостиGitHub();
	Настройки.ЛимитВызововПоискаКода = 1;
	Настройки.ИнтервалЛимитаПоискаКодаМс = 1000;
	Настройки.МаксимальноеОжиданиеЛимитаПоискаКодаМс = 10;
	Клиент = Новый КлиентGitHubAPI("", _HttpBin.URL(), Настройки);
	Идентификаторы = Новый Массив();
	Идентификаторы.Добавить("repo-node-1");
	Переменные = Новый Структура("ids", Идентификаторы);

	// Действие
	ОтветПоиска = Клиент.ВыполнитьПоискКода(
		СформироватьСтрокуПоискаКода("totalCount_5_repoCount_2_forkCount_1"),
		1,
		100
	);
	ПервыйОтветGraphQL = Клиент.ВыполнитьGraphQL(
		"query GetRepos($ids: [ID!]!) { nodes(ids: $ids) { ... on Repository { id } } }",
		Переменные
	);
	ВторойОтветGraphQL = Клиент.ВыполнитьGraphQL(
		"query GetRepos($ids: [ID!]!) { nodes(ids: $ids) { ... on Repository { id } } }",
		Переменные
	);

	// Проверка
	Ожидаем.Что(ОтветПоиска.КодСостояния, "Поиск кода до проверки GraphQL успешен").Равно(200);
	Ожидаем.Что(ПервыйОтветGraphQL.КодСостояния, "Первый GraphQL вызов не ограничен лимитом поиска").Равно(200);
	Ожидаем.Что(ВторойОтветGraphQL.КодСостояния, "Второй GraphQL вызов не ограничен лимитом поиска").Равно(200);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроброситьПрограммноеИсключениеКлиента() Экспорт

	// Подготовка
	УстановитьРежимGraphQL("temporary-then-malformed");
	Идентификаторы = Новый Массив();
	Идентификаторы.Добавить("repo-node-1");
	ПараметрыМетода = Новый Массив();
	ПараметрыМетода.Добавить("query GetRepos($ids: [ID!]!) { nodes(ids: $ids) { ... on Repository { id } } }");
	ПараметрыМетода.Добавить(Новый Структура("ids", Идентификаторы));

	// Действие
	ДанныеОшибки = Неопределено;
	Попытка
		_КлиентGitHubAPI.ВыполнитьGraphQL(ПараметрыМетода[0], ПараметрыМетода[1]);
	Исключение
		ДанныеОшибки = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(ДанныеОшибки = Неопределено, "Программная ошибка GraphQL проброшена").ЭтоЛожь();
	Ожидаем.Что(ДанныеОшибки.Причина = Неопределено, "Исходная причина GraphQL ошибки сохранена").ЭтоЛожь();
	Ожидаем.Что(ДанныеОшибки.Причина.ИсходнаяСтрока, "Исходная строка GraphQL ошибки сохранена").Содержит("ОшибкаGraphQL[""message""]");
	ЕстьИсходныйКадрСтека = Ложь;
	Для Каждого КадрСтека Из ДанныеОшибки.Причина.ПолучитьСтекВызовов() Цикл
		Если КадрСтека.Метод = "ПолучитьТекстОшибокGraphQL" Тогда
			ЕстьИсходныйКадрСтека = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(ЕстьИсходныйКадрСтека, "Стек GraphQL ошибки содержит исходный метод").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеРазмыкатьПредохранительИзЗаПрограммныхИсключений() Экспорт

	// Подготовка
	УстановитьРежимGraphQL("malformed-three-times");
	ПараметрыМетода = Новый Массив();
	ПараметрыМетода.Добавить("query Success { viewer { login } }");

	// Действие и Проверка
	Для Индекс = 1 По 3 Цикл
		Ожидаем.Что(_КлиентGitHubAPI, "Программная GraphQL ошибка выбрасывает исключение")
			.Метод("ВыполнитьGraphQL", ПараметрыМетода)
			.ВыбрасываетИсключение();
	КонецЦикла;

	Ответ = _КлиентGitHubAPI.ВыполнитьGraphQL("query Success { viewer { login } }");
	Статистика = ПолучитьСтатистикуGraphQL();

	Ожидаем.Что(Ответ.КодСостояния, "Предохранитель пропустил корректный GraphQL запрос").Равно(200);
	Ожидаем.Что(Статистика["КоличествоЗапросов"], "Программные ошибки не разомкнули предохранитель").Равно(4);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьНеопределеноПриТранспортнойОшибкеКоннектораHTTP() Экспорт

	// Подготовка
	Настройки = Новый НастройкиОтказоустойчивостиGitHub();
	Настройки.БазоваяЗадержкаПовтораМс = 35;
	Настройки.МаксимальнаяЗадержкаПовтораМс = 35;
	КлиентНедоступногоAPI = Новый КлиентGitHubAPI("", "http://127.0.0.1:1", Настройки);
	МоментНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();

	// Действие
	Ответ = КлиентНедоступногоAPI.ВыполнитьGraphQL("query { viewer { login } }");
	Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - МоментНачала;

	// Проверка
	Ожидаем.Что(Ответ, "При транспортной ошибке HTTP ответ не возвращается").ЭтоНеопределено();
	Ожидаем.Что(Длительность >= 50, "Между повторами транспортной ошибки выдержана задержка").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазомкнутьПредохранительПриПятиОшибкахВПоследнихДесятиВызовах() Экспорт

	// Подготовка
	Настройки = Новый НастройкиОтказоустойчивостиGitHub();
	Настройки.БазоваяЗадержкаПовтораМс = 0;
	Клиент = Новый КлиентGitHubAPI("", _HttpBin.URL(), Настройки);
	УстановитьРежимGraphQL("circuit-window");
	ПараметрыУспешногоВызова = Новый Массив();
	ПараметрыУспешногоВызова.Добавить("query Success { viewer { login } }");

	// Действие и Проверка
	Для Индекс = 1 По 5 Цикл
		УспешныйОтвет = Клиент.ВыполнитьGraphQL("query Success { viewer { login } }");
		ОтветСОшибкой = Клиент.ВыполнитьGraphQL("query TemporaryFailure { viewer { login } }");
	КонецЦикла;

	Ожидаем.Что(Клиент, "Предохранитель разомкнут по проценту ошибок")
		.Метод("ВыполнитьGraphQL", ПараметрыУспешногоВызова)
		.ВыбрасываетИсключение();

	Статистика = ПолучитьСтатистикуGraphQL();

	Ожидаем.Что(УспешныйОтвет.КодСостояния, "Успешные вызовы в окне возвращают ответ").Равно(200);
	Ожидаем.Что(ОтветСОшибкой, "Временные ошибки в окне не возвращают ответ").ЭтоНеопределено();
	Ожидаем.Что(Статистика["КоличествоЗапросов"], "Десять вызовов с повторами образовали окно предохранителя").Равно(20);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазомкнутьПредохранительПослеТрехПоследовательныхОшибок() Экспорт

	// Подготовка
	Настройки = Новый НастройкиОтказоустойчивостиGitHub();
	Настройки.БазоваяЗадержкаПовтораМс = 0;
	Клиент = Новый КлиентGitHubAPI("", _HttpBin.URL(), Настройки);
	УстановитьРежимGraphQL("circuit-window");
	ПараметрыУспешногоВызова = Новый Массив();
	ПараметрыУспешногоВызова.Добавить("query Success { viewer { login } }");

	// Действие и Проверка
	Для Индекс = 1 По 3 Цикл
		ОтветСОшибкой = Клиент.ВыполнитьGraphQL("query TemporaryFailure { viewer { login } }");
	КонецЦикла;

	Ожидаем.Что(Клиент, "Предохранитель разомкнут после трех последовательных ошибок")
		.Метод("ВыполнитьGraphQL", ПараметрыУспешногоВызова)
		.ВыбрасываетИсключение();

	Статистика = ПолучитьСтатистикуGraphQL();

	Ожидаем.Что(ОтветСОшибкой, "Последняя временная ошибка не вернула ответ").ЭтоНеопределено();
	Ожидаем.Что(Статистика["КоличествоЗапросов"], "Три ошибочных вызова выполнены с двумя повторами").Равно(9);

КонецПроцедуры

Процедура УстановитьЛимитПоискаКода(Лимит)

	Результат = КоннекторHTTP.Get(_HttpBin.URL(СтрШаблон("search/limits/%1", Формат(Лимит, "ЧН=0; ЧГ="))));
	Если Результат.КодСостояния <> 200 Тогда
		ВызватьИсключение "Не удалось установить лимит поиска кода";
	КонецЕсли;

КонецПроцедуры

Процедура ОтключитьЛимитПоискаКода()

	Результат = КоннекторHTTP.Get(_HttpBin.URL("search/limits/disable"));
	Если Результат.КодСостояния <> 200 Тогда
		ВызватьИсключение "Не удалось отключить лимит поиска кода";
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьРежимПоискаКода(Режим)

	Результат = КоннекторHTTP.Get(_HttpBin.URL(СтрШаблон("search/mode/%1", Режим)));
	Если Результат.КодСостояния <> 200 Тогда
		ВызватьИсключение "Не удалось установить режим поиска кода";
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьРежимGraphQL(Режим)

	Результат = КоннекторHTTP.Get(_HttpBin.URL(СтрШаблон("graphql/mode/%1", Режим)));
	Если Результат.КодСостояния <> 200 Тогда
		ВызватьИсключение "Не удалось установить режим GraphQL";
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьСтатистикуПоискаКода()

	Ответ = КоннекторHTTP.Get(_HttpBin.URL("search/stats"));
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение "Не удалось получить статистику поиска кода";
	КонецЕсли;

	Возврат Ответ.Json();

КонецФункции

Функция ПолучитьСтатистикуGraphQL()

	Ответ = КоннекторHTTP.Get(_HttpBin.URL("graphql/stats"));
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение "Не удалось получить статистику GraphQL";
	КонецЕсли;

	Возврат Ответ.Json();

КонецФункции

Функция ВыполнитьЗапросСОграничениемЛимита(ТипЗапроса)

	Если ТипЗапроса = "SearchCode" Тогда
		Возврат _КлиентGitHubAPI.ВыполнитьПоискКода(
			СформироватьСтрокуПоискаКода("totalCount_5_repoCount_2_forkCount_1"),
			1,
			100
		);
	КонецЕсли;

	Если ТипЗапроса = "GraphQL" Тогда
		Идентификаторы = Новый Массив();
		Идентификаторы.Добавить("repo-node-1");
		Переменные = Новый Структура("ids", Идентификаторы);

		Возврат _КлиентGitHubAPI.ВыполнитьGraphQL(
			"query GetRepos($ids: [ID!]!) { nodes(ids: $ids) { ... on Repository { id } } }",
			Переменные
		);
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Неизвестный тип запроса: %1", ТипЗапроса);

КонецФункции

Функция СформироватьСтрокуПоискаКода(ИмяПакета)

	Возврат СтрШаблон("""#Использовать %1"" extension:os", ИмяПакета);

КонецФункции
