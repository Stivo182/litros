&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

#Область Тесты

&Тест
Процедура ТестДолжен_СоздатьНастройкиПулаМенеджеровСущностейПоУмолчанию() Экспорт

	Настройки = Новый НастройкиПулаМенеджеровСущностей();

	ПроверитьНастройки(Настройки, 1000, 10000, 30000, 0, 0, Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПереопределитьНастройкиПулаМенеджеровСущностейИзДеталек() Экспорт

	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("litros.db.ТаймаутЗанятостиМс", 2000);
	ЗначенияДеталек.Вставить("litros.db.МаксимальноеОжиданиеСлотаМс", 15000);
	ЗначенияДеталек.Вставить("litros.db.МаксимальноеОжиданиеЗакрытияМс", 45000);
	ЗначенияДеталек.Вставить("litros.db.КоличествоЧитателей", 7);
	ЗначенияДеталек.Вставить("litros.db.КоличествоПисателей", 3);
	ЗначенияДеталек.Вставить("litros.db.ИспользоватьWAL", Ложь);

	СоветДругогоМастера = Новый СоветДругогоМастера();
	СоветДругогоМастера.ЗначенияДеталек(ЗначенияДеталек);
	СоветДругогоМастера.ИмяФайлаСоЗначениямиДеталек("заведомо-отсутствующие-настройки-пула-менеджеров-сущностей");
	Поделка = Новый Поделка(СоветДругогоМастера);

	Поделка.ЗапуститьПриложение();
	Настройки = Поделка.НайтиЖелудь("НастройкиПулаМенеджеровСущностей");

	ПроверитьНастройки(Настройки, 2000, 15000, 45000, 7, 3, Ложь);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РассчитатьРазмерыПуловПоЧислуПроцессоров() Экспорт

	Настройки = Новый НастройкиПулаМенеджеровСущностей();

	Ожидаем.Что(Настройки.РассчитатьКоличествоПисателей(1), "На одном CPU остается writer").Равно(1);
	Ожидаем.Что(Настройки.РассчитатьКоличествоЧитателей(1), "Минимум два reader").Равно(2);
	Ожидаем.Что(Настройки.РассчитатьКоличествоПисателей(16), "Writer ограничены четырьмя").Равно(4);
	Ожидаем.Что(Настройки.РассчитатьКоличествоЧитателей(16), "Остальные CPU отданы reader").Равно(12);
	Ожидаем.Что(Настройки.РассчитатьКоличествоЧитателей(64), "Reader ограничены тридцатью двумя").Равно(32);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредпочестьЯвныеРазмерыПулов() Экспорт

	Настройки = Новый НастройкиПулаМенеджеровСущностей();
	Настройки.КоличествоЧитателей = 7;
	Настройки.КоличествоПисателей = 3;

	Ожидаем.Что(Настройки.РассчитатьКоличествоЧитателей(64), "Явное R имеет приоритет").Равно(7);
	Ожидаем.Что(Настройки.РассчитатьКоличествоПисателей(64), "Явное W имеет приоритет").Равно(3);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("CPU", -1)
&ИсточникЗначение("CPU", 1.5)
&ИсточникЗначение("КоличествоЧитателей", -1)
&ИсточникЗначение("КоличествоЧитателей", 1.5)
&ИсточникЗначение("КоличествоПисателей", -1)
&ИсточникЗначение("КоличествоПисателей", 1.5)
&ИсточникЗначение("ТаймаутЗанятостиМс", -1)
&ИсточникЗначение("ТаймаутЗанятостиМс", 1.5)
&ИсточникЗначение("МаксимальноеОжиданиеСлотаМс", -1)
&ИсточникЗначение("МаксимальноеОжиданиеСлотаМс", 1.5)
&ИсточникЗначение("МаксимальноеОжиданиеЗакрытияМс", -1)
&ИсточникЗначение("МаксимальноеОжиданиеЗакрытияМс", 1.5)
Процедура ТестДолжен_ОтклонитьОтрицательныеИлиДробныеЧисловыеНастройки(ИмяНастройки, Значение) Экспорт

	Ошибка = ПолучитьОшибкуРасчета(ИмяНастройки, Значение);

	Ожидаем.Что(Ошибка <> Неопределено, "Некорректная настройка " + ИмяНастройки + " отклонена").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьНастройки(Настройки, ТаймаутЗанятостиМс, МаксимальноеОжиданиеСлотаМс, МаксимальноеОжиданиеЗакрытияМс, КоличествоЧитателей, КоличествоПисателей, ИспользоватьWAL)

	Ожидаем.Что(Настройки.ТаймаутЗанятостиМс, "Таймаут занятой базы данных").Равно(ТаймаутЗанятостиМс);
	Ожидаем.Что(Настройки.МаксимальноеОжиданиеСлотаМс, "Ожидание слота").Равно(МаксимальноеОжиданиеСлотаМс);
	Ожидаем.Что(Настройки.МаксимальноеОжиданиеЗакрытияМс, "Ожидание закрытия").Равно(МаксимальноеОжиданиеЗакрытияМс);
	Ожидаем.Что(Настройки.КоличествоЧитателей, "Количество читателей").Равно(КоличествоЧитателей);
	Ожидаем.Что(Настройки.КоличествоПисателей, "Количество писателей").Равно(КоличествоПисателей);
	Ожидаем.Что(Настройки.ИспользоватьWAL, "Использовать WAL").Равно(ИспользоватьWAL);

КонецПроцедуры

Функция ПолучитьОшибкуРасчета(ИмяНастройки, Значение)

	Настройки = Новый НастройкиПулаМенеджеровСущностей();
	Попытка
		Если ИмяНастройки = "CPU" Тогда
			Настройки.РассчитатьКоличествоПисателей(Значение);
		ИначеЕсли ИмяНастройки = "КоличествоЧитателей" Тогда
			Настройки.КоличествоЧитателей = Значение;
			Настройки.РассчитатьКоличествоЧитателей(4);
		ИначеЕсли ИмяНастройки = "КоличествоПисателей" Тогда
			Настройки.КоличествоПисателей = Значение;
			Настройки.РассчитатьКоличествоПисателей(4);
		ИначеЕсли ИмяНастройки = "ТаймаутЗанятостиМс" Тогда
			Настройки.ТаймаутЗанятостиМс = Значение;
			Настройки.РассчитатьКоличествоПисателей(4);
		ИначеЕсли ИмяНастройки = "МаксимальноеОжиданиеСлотаМс" Тогда
			Настройки.МаксимальноеОжиданиеСлотаМс = Значение;
			Настройки.РассчитатьКоличествоПисателей(4);
		Иначе
			Настройки.МаксимальноеОжиданиеЗакрытияМс = Значение;
			Настройки.РассчитатьКоличествоПисателей(4);
		КонецЕсли;
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

#КонецОбласти
