#Использовать asserts
#Использовать moskito
#Использовать entity
#Использовать autumn
#Использовать reflector
#Использовать "../src/internal"
#Использовать "../src/dto"

Перем _КоличествоОбращений; // Число
Перем _ОжидаемыйРезультат; // Произвольный

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередКаждым() Экспорт
	_КоличествоОбращений = 0;
	_ОжидаемыйРезультат = Новый Массив();
КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ДелегироватьCRUDМенеджеру() Экспорт

	// Подготовка
	Менеджер = Мок.Получить(Тип("МенеджерСущностей"));
	ТипСущности = Тип("СущностьРепозиторий");
	Опции = Новый ОпцииПоиска();
	Сущность = Новый СущностьРепозиторий();
	Менеджер.Когда().Получить(ТипСущности, Опции).ТогдаВозвращает(_ОжидаемыйРезультат);
	Менеджер.Когда().ПолучитьОдно(ТипСущности, Опции).ТогдаВозвращает(Сущность);
	ДоступКБД = Новый ТранзакционныйДоступКБД(Менеджер);

	// Действие
	Все = ДоступКБД.Получить(ТипСущности, Опции);
	Один = ДоступКБД.ПолучитьОдно(ТипСущности, Опции);
	ДоступКБД.Сохранить(Сущность);
	ДоступКБД.Удалить(Сущность);

	// Проверка
	Ожидаем.Что(Все = _ОжидаемыйРезультат, "Результат Получить возвращён без преобразования").ЭтоИстина();
	Ожидаем.Что(Один = Сущность, "Результат ПолучитьОдно возвращён без преобразования").ЭтоИстина();
	Менеджер.ПроверитьЧтоВызывалсяМетод().Получить(ТипСущности, Опции);
	Менеджер.ПроверитьЧтоВызывалсяМетод().ПолучитьОдно(ТипСущности, Опции);
	Менеджер.ПроверитьЧтоВызывалсяМетод().Сохранить(Сущность);
	Менеджер.ПроверитьЧтоВызывалсяМетод().Удалить(Сущность);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗапретитьОбращениеПослеДеактивацииДоВызоваМенеджера() Экспорт

	// Подготовка
	Менеджер = Мок.Получить(Тип("МенеджерСущностей"));
	Менеджер.Когда().Получить(Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение())
		.ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ЗарегистрироватьОбращение"));
	Менеджер.Когда().ПолучитьОдно(Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение())
		.ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ЗарегистрироватьОбращение"));
	Менеджер.Когда().Сохранить(Матчеры.ЛюбоеЗначение())
		.ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ЗарегистрироватьОбращение"));
	Менеджер.Когда().Удалить(Матчеры.ЛюбоеЗначение())
		.ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ЗарегистрироватьОбращение"));
	ДоступКБД = Новый ТранзакционныйДоступКБД(Менеджер);
	ДоступКБД.Деактивировать();
	Проверки = Новый Массив();
	Проверки.Добавить(Новый Структура("ИмяМетода,Параметр", "Получить", Тип("СущностьРепозиторий")));
	Проверки.Добавить(Новый Структура("ИмяМетода,Параметр", "ПолучитьОдно", Тип("СущностьРепозиторий")));
	Проверки.Добавить(Новый Структура("ИмяМетода,Параметр", "Сохранить", Новый СущностьРепозиторий()));
	Проверки.Добавить(Новый Структура("ИмяМетода,Параметр", "Удалить", Новый СущностьРепозиторий()));

	// Действие
	Ошибки = Новый Массив();
	Для Каждого Проверка Из Проверки Цикл
		Ошибки.Добавить(ПолучитьОшибкуОбращения(ДоступКБД, Проверка.ИмяМетода, Проверка.Параметр));
	КонецЦикла;

	// Проверка
	Для Индекс = 0 По Проверки.ВГраница() Цикл
		Ожидаем.Что(Ошибки[Индекс].Описание,
			СтрШаблон("%1 объясняет завершение срока жизни транзакционного доступа", Проверки[Индекс].ИмяМетода))
			.Содержит("ТранзакционныйДоступКБД больше не активен");
	КонецЦикла;
	Ожидаем.Что(_КоличествоОбращений, "Деактивированный транзакционный доступ не обратился к менеджеру").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредоставлятьТолькоCRUDИДеактивацию() Экспорт

	// Подготовка
	ДоступКБД = Новый ТранзакционныйДоступКБД(Мок.Получить(Тип("МенеджерСущностей")));
	ОжидаемыеИмена = Новый Массив();
	ОжидаемыеИмена.Добавить("Получить");
	ОжидаемыеИмена.Добавить("ПолучитьОдно");
	ОжидаемыеИмена.Добавить("Сохранить");
	ОжидаемыеИмена.Добавить("Удалить");
	ОжидаемыеИмена.Добавить("Деактивировать");

	// Действие
	Методы = Новый РефлекторОбъекта(ДоступКБД).ПолучитьТаблицуМетодов();
	ФактическиеИмена = Методы.ВыгрузитьКолонку("Имя");

	// Проверка
	Ожидаем.Что(ФактическиеИмена.Количество(),
		"Транзакционный доступ экспортирует только CRUD и деактивацию").Равно(5);
	Для Каждого ИмяМетода Из ОжидаемыеИмена Цикл
		Ожидаем.Что(ФактическиеИмена.Найти(ИмяМетода) <> Неопределено,
			СтрШаблон("Транзакционный доступ экспортирует утвержденный метод %1", ИмяМетода)).ЭтоИстина();
	КонецЦикла;
	Ожидаем.Что(ФактическиеИмена.Найти("ВыполнитьЗапрос"),
		"Транзакционный доступ не раскрывает сырой SQL").ЭтоНеопределено();

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ЗарегистрироватьОбращение(ИнформацияОВызове) Экспорт
	_КоличествоОбращений = _КоличествоОбращений + 1;
	Возврат _ОжидаемыйРезультат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьОшибкуОбращения(ДоступКБД, ИмяМетода, Параметр)
	Попытка
		Параметры = Новый Массив();
		Параметры.Добавить(Параметр);
		РезультатВызова = Новый Рефлектор().ВызватьМетод(ДоступКБД, ИмяМетода, Параметры);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;
	ВызватьИсключение СтрШаблон("Ожидалась ошибка метода %1 деактивированного транзакционного доступа", ИмяМетода);
КонецФункции

#КонецОбласти
