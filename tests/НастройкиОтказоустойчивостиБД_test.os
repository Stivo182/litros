&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

#Область Тесты

&Тест
Процедура ТестДолжен_СоздатьНастройкиОтказоустойчивостиБДПоУмолчанию() Экспорт

	// Подготовка
	Настройки = Новый НастройкиОтказоустойчивостиБД();

	// Действие и Проверка
	ПроверитьНастройки(Настройки, 1000, 3, 50, 500, 32, 10000, Истина);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПереопределитьНастройкиОтказоустойчивостиБДИзДеталек() Экспорт

	// Подготовка
	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("litros.db.ТаймаутЗанятостиМс", 2000);
	ЗначенияДеталек.Вставить("litros.db.КоличествоПовторов", 5);
	ЗначенияДеталек.Вставить("litros.db.БазоваяЗадержкаПовтораМс", 75);
	ЗначенияДеталек.Вставить("litros.db.МаксимальнаяЗадержкаПовтораМс", 750);
	ЗначенияДеталек.Вставить("litros.db.ЛимитОчереди", 64);
	ЗначенияДеталек.Вставить("litros.db.МаксимальноеОжиданиеСлотаМс", 15000);
	ЗначенияДеталек.Вставить("litros.db.ИспользоватьWAL", Ложь);

	СоветДругогоМастера = Новый СоветДругогоМастера();
	СоветДругогоМастера.ЗначенияДеталек(ЗначенияДеталек);
	СоветДругогоМастера.ИмяФайлаСоЗначениямиДеталек("заведомо-отсутствующие-настройки-отказоустойчивости-бд");
	Поделка = Новый Поделка(СоветДругогоМастера);

	// Действие
	Поделка.ЗапуститьПриложение();
	Настройки = Поделка.НайтиЖелудь("НастройкиОтказоустойчивостиБД");

	// Проверка
	ПроверитьНастройки(Настройки, 2000, 5, 75, 750, 64, 15000, Ложь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьНастройки(
	Настройки,
	ТаймаутЗанятостиМс,
	КоличествоПовторов,
	БазоваяЗадержкаПовтораМс,
	МаксимальнаяЗадержкаПовтораМс,
	ЛимитОчереди,
	МаксимальноеОжиданиеСлотаМс,
	ИспользоватьWAL)

	Ожидаем.Что(Настройки.ТаймаутЗанятостиМс, "Таймаут ожидания освобождения базы данных").Равно(ТаймаутЗанятостиМс);
	Ожидаем.Что(Настройки.КоличествоПовторов, "Количество повторов операций базы данных").Равно(КоличествоПовторов);
	Ожидаем.Что(Настройки.БазоваяЗадержкаПовтораМс, "Базовая задержка повтора операции базы данных").Равно(БазоваяЗадержкаПовтораМс);
	Ожидаем.Что(Настройки.МаксимальнаяЗадержкаПовтораМс, "Максимальная задержка повтора операции базы данных").Равно(МаксимальнаяЗадержкаПовтораМс);
	Ожидаем.Что(Настройки.ЛимитОчереди, "Лимит очереди операций базы данных").Равно(ЛимитОчереди);
	Ожидаем.Что(Настройки.МаксимальноеОжиданиеСлотаМс, "Максимальное ожидание слота операции базы данных").Равно(МаксимальноеОжиданиеСлотаМс);
	Ожидаем.Что(Настройки.ИспользоватьWAL, "Признак использования режима WAL").Равно(ИспользоватьWAL);

КонецПроцедуры

#КонецОбласти
