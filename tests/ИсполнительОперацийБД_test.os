Процедура ПриСозданииОбъекта()

КонецПроцедуры

#Область Тесты

&Тест
Процедура ТестДолжен_ВыполнитьУспешнуюОперациюСПараметрами() Экспорт

	// Подготовка
	Сценарий = Новый СценарийОперацииБД();
	Сценарий.Настроить(0, "", "готово");
	Исполнитель = СоздатьИсполнитель(2);
	Параметры = Новый Структура("Ключ", "значение");

	// Действие
	Результат = Исполнитель.ВыполнитьОперацию(Новый Действие(Сценарий, "ВыполнитьСценарий"), Параметры);

	// Проверка
	Ожидаем.Что(Результат, "Исполнитель вернул точный результат операции").Равно("готово");
	Ожидаем.Что(Сценарий.КоличествоВызовов(), "Успешная операция вызвана один раз").Равно(1);
	Ожидаем.Что(Сценарий.ПоследниеПараметры() = Параметры, "Операция получила исходные параметры").ЭтоИстина();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("database is locked")
&ИсточникЗначение("database table is locked")
Процедура ТестДолжен_ПовторитьВременнуюОшибкуSQLite(ОписаниеОшибки) Экспорт

	// Подготовка
	Сценарий = Новый СценарийОперацииБД();
	Сценарий.Настроить(2, ОписаниеОшибки, "успех");
	Исполнитель = СоздатьИсполнитель(2);

	// Действие
	Результат = Исполнитель.ВыполнитьОперацию(Новый Действие(Сценарий, "ВыполнитьСценарий"));

	// Проверка
	Ожидаем.Что(Результат, "После двух временных ошибок возвращен результат третьей попытки").Равно("успех");
	Ожидаем.Что(Сценарий.КоличествоВызовов(), "Два повтора дали три попытки").Равно(3);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеПовторитьПостояннуюОшибку() Экспорт

	// Подготовка
	Сценарий = Новый СценарийОперацииБД();
	Сценарий.Настроить(3, "SQLITE_CONSTRAINT: constraint failed", Неопределено);
	Исполнитель = СоздатьИсполнитель(2);

	// Действие
	ДанныеОшибки = ПолучитьОшибку(Исполнитель, Сценарий);

	// Проверка
	Ожидаем.Что(Сценарий.КоличествоВызовов(), "Постоянная ошибка не повторялась").Равно(1);
	Ожидаем.Что(ДанныеОшибки.Описание, "Наружу проброшено исходное описание постоянной ошибки").Содержит("SQLITE_CONSTRAINT: constraint failed, попытка 1");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроброситьОшибкуПоследнейПопытки() Экспорт

	// Подготовка
	Сценарий = Новый СценарийОперацииБД();
	Сценарий.Настроить(3, "database is locked", Неопределено);
	Исполнитель = СоздатьИсполнитель(2);

	// Действие
	ДанныеОшибки = ПолучитьОшибку(Исполнитель, Сценарий);

	// Проверка
	Ожидаем.Что(Сценарий.КоличествоВызовов(), "Два повтора дали три неуспешные попытки").Равно(3);
	Ожидаем.Что(ДанныеОшибки.Описание, "Наружу проброшена ошибка последней попытки").Содержит("database is locked, попытка 3");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчестьНеопределеноУспешнымРезультатом() Экспорт

	// Подготовка
	Сценарий = Новый СценарийОперацииБД();
	Сценарий.Настроить(0, "", Неопределено);
	Исполнитель = СоздатьИсполнитель(2);

	// Действие
	Результат = Исполнитель.ВыполнитьОперацию(Новый Действие(Сценарий, "ВыполнитьСценарий"));

	// Проверка
	Ожидаем.Что(Результат, "Штатный результат Неопределено возвращен без повтора").ЭтоНеопределено();
	Ожидаем.Что(Сценарий.КоличествоВызовов(), "Операция с результатом Неопределено вызвана один раз").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазрешитьИсполнительИЗависимостиЧерезAutumn() Экспорт

	// Подготовка
	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("litros.db.КоличествоПовторов", 0);
	ЗначенияДеталек.Вставить("litros.db.БазоваяЗадержкаПовтораМс", 0);
	СоветДругогоМастера = Новый СоветДругогоМастера();
	СоветДругогоМастера.ЗначенияДеталек(ЗначенияДеталек);
	СоветДругогоМастера.ИмяФайлаСоЗначениямиДеталек("заведомо-отсутствующие-настройки-исполнителя-бд");
	Поделка = Новый Поделка(СоветДругогоМастера);

	// Действие
	Поделка.ЗапуститьПриложение();
	ПервыйИсполнитель = Поделка.НайтиЖелудь("ИсполнительОперацийБД");
	ВторойИсполнитель = Поделка.НайтиЖелудь("ИсполнительОперацийБД");
	Настройки = Поделка.НайтиЖелудь("НастройкиОтказоустойчивостиБД");
	Классификатор = Поделка.НайтиЖелудь("КлассификаторОшибокSQLite");

	// Проверка
	Ожидаем.Что(ПервыйИсполнитель = ВторойИсполнитель, "Autumn возвращает один экземпляр исполнителя операций БД").ЭтоИстина();
	Ожидаем.Что(Настройки <> Неопределено, "Autumn разрешил настройки исполнителя").ЭтоИстина();
	Ожидаем.Что(Классификатор <> Неопределено, "Autumn разрешил классификатор SQLite").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОграничитьПараллелизмОперацийБДОднимСлотом() Экспорт

	// Подготовка
	Исполнитель = СоздатьИсполнитель(0);
	Затвор = Новый ЗатворОперацийБД();
	ПараметрыПервойЗадачи = Новый Массив();
	ПараметрыПервойЗадачи.Добавить(Исполнитель);
	ПараметрыПервойЗадачи.Добавить(1);
	ПараметрыВторойЗадачи = Новый Массив();
	ПараметрыВторойЗадачи.Добавить(Исполнитель);
	ПараметрыВторойЗадачи.Добавить(2);

	// Действие
	ПерваяЗадача = ФоновыеЗадания.Выполнить(Затвор, "ВыполнитьЧерез", ПараметрыПервойЗадачи);
	ПерваяВошла = ДождатьсяФлага(Затвор, "ПерваяОперацияВошла");
	ВтораяЗадача = Неопределено;
	ВтораяНачалаВызов = Ложь;
	ВтораяВошлаДоОсвобождения = Ложь;
	Если ПерваяВошла Тогда
		ВтораяЗадача = ФоновыеЗадания.Выполнить(Затвор, "ВыполнитьЧерез", ПараметрыВторойЗадачи);
		ВтораяНачалаВызов = ДождатьсяФлага(Затвор, "ВтораяНачалаВызов");
		Если ВтораяНачалаВызов Тогда
			ВтораяВошлаДоОсвобождения = Затвор.ВтораяОперацияВошла();
		КонецЕсли;
	КонецЕсли;
	Затвор.РазрешитьВыход();
	ПерваяЗадача.ОжидатьЗавершения(5000);
	РезультатПервойЗадачи = ПерваяЗадача.Результат;
	РезультатВторойЗадачи = Неопределено;
	Если ВтораяЗадача <> Неопределено Тогда
		ВтораяЗадача.ОжидатьЗавершения(5000);
		РезультатВторойЗадачи = ВтораяЗадача.Результат;
	КонецЕсли;

	// Проверка
	Ожидаем.Что(ПерваяВошла, "Первая фоновая операция заняла слот за ограниченное время").ЭтоИстина();
	Ожидаем.Что(ВтораяНачалаВызов, "Вторая фоновая задача дошла до исполнителя за ограниченное время").ЭтоИстина();
	Ожидаем.Что(ВтораяВошлаДоОсвобождения, "Вторая операция не вошла до освобождения единственного слота").ЭтоЛожь();
	Ожидаем.Что(Затвор.МаксимумАктивных(), "В общий Bulkhead одновременно вошла не более одной операции").Равно(1);
	Ожидаем.Что(РезультатПервойЗадачи, "Первая фоновая операция завершилась штатно").Равно(1);
	Ожидаем.Что(РезультатВторойЗадачи, "Вторая фоновая операция завершилась штатно").Равно(2);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИсполнитель(КоличествоПовторов)

	Настройки = Новый НастройкиОтказоустойчивостиБД();
	Настройки.КоличествоПовторов = КоличествоПовторов;
	Настройки.БазоваяЗадержкаПовтораМс = 0;
	Настройки.МаксимальнаяЗадержкаПовтораМс = 0;

	Возврат Новый ИсполнительОперацийБД(Настройки, Новый КлассификаторОшибокSQLite());

КонецФункции

Функция ПолучитьОшибку(Исполнитель, Сценарий)

	Попытка
		Исполнитель.ВыполнитьОперацию(Новый Действие(Сценарий, "ВыполнитьСценарий"));
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалась ошибка операции базы данных.";

КонецФункции

Функция ДождатьсяФлага(Затвор, ИмяМетода)

	Рефлектор = Новый Рефлектор();
	Для НомерПопытки = 1 По 200 Цикл
		Если Рефлектор.ВызватьМетод(Затвор, ИмяМетода) Тогда
			Возврат Истина;
		КонецЕсли;
		Приостановить(5);
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти
