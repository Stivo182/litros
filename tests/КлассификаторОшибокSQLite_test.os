&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

#Область Тесты

&ПараметризованныйТест
&ИсточникЗначение("SQLITE_BUSY: database is busy")
&ИсточникЗначение("SQLITE_LOCKED: shared cache conflict")
&ИсточникЗначение("database is locked")
&ИсточникЗначение("database table is locked: packages")
&ИсточникЗначение("SqlItE_BuSy: mixed case")
Процедура ТестДолжен_ОпределитьВременнуюОшибкуSQLite(ОписаниеОшибки) Экспорт

	// Подготовка
	Классификатор = Новый КлассификаторОшибокSQLite();
	ДанныеОшибки = СоздатьИнформациюОбОшибке(ОписаниеОшибки);

	// Действие
	Результат = Классификатор.ЭтоВременнаяОшибка(ДанныеОшибки);

	// Проверка
	Ожидаем.Что(Результат, "Устойчивый маркер временной ошибки SQLite распознан").ЭтоИстина();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("SQLITE_CONSTRAINT: UNIQUE constraint failed")
&ИсточникЗначение("near SELECT: syntax error")
&ИсточникЗначение("database disk image is malformed (SQLITE_CORRUPT)")
&ИсточникЗначение("attempt to write a readonly database")
&ИсточникЗначение("database or disk is full")
&ИсточникЗначение("5")
&ИсточникЗначение("6")
&ИсточникЗначение("locked")
&ИсточникЗначение("NOT_SQLITE_BUSY")
&ИсточникЗначение("SQLITE_LOCKEDNESS")
&ИсточникЗначение("ошибкаsqlite_busy")
&ИсточникЗначение("sqlite_lockedошибка")
&ИсточникЗначение("mydatabase is locked")
&ИсточникЗначение("database is lockeddown")
Процедура ТестДолжен_НеОпределитьПостояннуюИлиНеоднозначнуюОшибкуКакВременную(ОписаниеОшибки) Экспорт

	// Подготовка
	Классификатор = Новый КлассификаторОшибокSQLite();
	ДанныеОшибки = СоздатьИнформациюОбОшибке(ОписаниеОшибки);

	// Действие
	Результат = Классификатор.ЭтоВременнаяОшибка(ДанныеОшибки);

	// Проверка
	Ожидаем.Что(Результат, "Постоянная или неоднозначная ошибка SQLite не классифицирована как временная").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НайтиВременнуюОшибкуSQLiteВоВложеннойПричине() Экспорт

	// Подготовка
	Классификатор = Новый КлассификаторОшибокSQLite();
	ИсходнаяОшибка = СоздатьИнформациюОбОшибке("database table is locked");
	ПромежуточнаяОшибка = СоздатьИнформациюОбОшибке("Ошибка слоя хранения", ИсходнаяОшибка);
	ДанныеОшибки = СоздатьИнформациюОбОшибке("Ошибка выполнения операции", ПромежуточнаяОшибка);

	// Действие
	Результат = Классификатор.ЭтоВременнаяОшибка(ДанныеОшибки);

	// Проверка
	Ожидаем.Что(Результат, "Маркер временной ошибки SQLite найден во вложенной причине").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСчитатьНеопределенныеДанныеВременнойОшибкойSQLite() Экспорт

	// Подготовка
	Классификатор = Новый КлассификаторОшибокSQLite();

	// Действие
	Результат = Классификатор.ЭтоВременнаяОшибка(Неопределено);

	// Проверка
	Ожидаем.Что(Результат, "Отсутствующая информация об ошибке не классифицирована как временная").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СчитатьВерхнеуровневуюОшибкуRollbackПостоянной() Экспорт

	// Подготовка
	Классификатор = Новый КлассификаторОшибокSQLite();
	Причина = СоздатьИнформациюОбОшибке("database is locked");
	ДанныеОшибки = СоздатьИнформациюОбОшибке(
		"LITROS_DB_ROLLBACK_FAILED: database is locked при восстановлении транзакции",
		Причина);

	// Действие
	Результат = Классификатор.ЭтоВременнаяОшибка(ДанныеОшибки);

	// Проверка
	Ожидаем.Что(Результат, "Верхнеуровневая ошибка rollback запрещает повтор независимо от временных маркеров").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеДаватьПриоритетВложенномуМаркеруОшибкиRollback() Экспорт

	// Подготовка
	Классификатор = Новый КлассификаторОшибокSQLite();
	Причина = СоздатьИнформациюОбОшибке("litros_db_rollback_failed: database is locked");
	ДанныеОшибки = СоздатьИнформациюОбОшибке("Ошибка выполнения операции", Причина);

	// Действие
	Результат = Классификатор.ЭтоВременнаяОшибка(ДанныеОшибки);

	// Проверка
	Ожидаем.Что(Результат, "Вложенный маркер rollback не отменяет временную природу причины SQLite").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСчитатьПохожийПрефиксМаркеромОшибкиRollback() Экспорт

	// Подготовка
	Классификатор = Новый КлассификаторОшибокSQLite();
	ДанныеОшибки = СоздатьИнформациюОбОшибке(
		"litros_db_rollback_failedness: database is locked");

	// Действие
	Результат = Классификатор.ЭтоВременнаяОшибка(ДанныеОшибки);

	// Проверка
	Ожидаем.Что(Результат, "Похожий префикс rollback не подавляет точный маркер временной ошибки SQLite").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИнформациюОбОшибке(ОписаниеОшибки, Причина = Неопределено)

	Возврат Новый ИнформацияОбОшибке(ОписаниеОшибки, ЭтотОбъект, Причина);

КонецФункции

#КонецОбласти
