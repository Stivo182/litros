Перем _Менеджер; // МенеджерСущностей
Перем _КоличествоЗакрытий; // Число

#Область ОбработчикиСобытий

// Создает обертку реального менеджера, имитирующую ошибку rollback без завершения транзакции.
//
// Параметры:
//   Менеджер - МенеджерСущностей - Делегат операций с реальной SQLite-базой.
Процедура ПриСозданииОбъекта(Менеджер)

	_Менеджер = Менеджер;
	_КоличествоЗакрытий = 0;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Начинает реальную транзакцию.
Процедура НачатьТранзакцию() Экспорт

	_Менеджер.НачатьТранзакцию();

КонецПроцедуры

// Сохраняет сущность в реальной транзакции.
//
// Параметры:
//   Сущность - Произвольный - Сохраняемая сущность.
Процедура Сохранить(Сущность) Экспорт

	_Менеджер.Сохранить(Сущность);

КонецПроцедуры

// Фиксирует реальную транзакцию.
Процедура ЗафиксироватьТранзакцию() Экспорт

	_Менеджер.ЗафиксироватьТранзакцию();

КонецПроцедуры

// Имитирует ошибку rollback, оставляя реальную транзакцию открытой.
Процедура ОтменитьТранзакцию() Экспорт

	ВызватьИсключение "ошибка реального rollback";

КонецПроцедуры

// Закрывает реальный менеджер и освобождает SQLite-блокировку.
Процедура Закрыть() Экспорт

	_КоличествоЗакрытий = _КоличествоЗакрытий + 1;
	_Менеджер.Закрыть();

КонецПроцедуры

// Возвращает количество попыток закрытия менеджера.
//
// Возвращаемое значение:
//   Число - Количество вызовов Закрыть().
Функция КоличествоЗакрытий() Экспорт

	Возврат _КоличествоЗакрытий;

КонецФункции

#КонецОбласти
