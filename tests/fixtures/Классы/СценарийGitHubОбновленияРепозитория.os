Перем _Ответ; // ОтветGitHubОбновленияРепозитория

#Область ОбработчикиСобытий

// Создает сценарий успешного обновления репозитория через GitHub.
//
// Параметры:
//   УзелРепозитория - Структура - Узел репозитория из ответа GraphQL.
Процедура ПриСозданииОбъекта(УзелРепозитория)
	Узлы = Новый Массив();
	Узлы.Добавить(УзелРепозитория);
	ТелоОтвета = Новый Структура(
		"data,errors",
		Новый Структура("nodes", Узлы),
		Неопределено);
	_Ответ = Новый ОтветGitHubОбновленияРепозитория(ТелоОтвета);
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает подготовленный ответ GraphQL.
//
// Параметры:
//   Запрос - Строка - Текст запроса GraphQL.
//   Переменные - Структура - Переменные запроса.
//
// Возвращаемое значение:
//   ОтветGitHubОбновленияРепозитория - Подготовленный ответ.
Функция ВыполнитьGraphQL(Запрос, Переменные) Экспорт
	Возврат _Ответ;
КонецФункции

// Принимает отладочное сообщение обновлятора.
//
// Параметры:
//   Шаблон - Строка - Шаблон сообщения.
//   Параметр1 - Произвольный - Первый параметр шаблона.
//   Параметр2 - Произвольный - Второй параметр шаблона.
Процедура Отладка(Шаблон, Параметр1 = Неопределено, Параметр2 = Неопределено) Экспорт
КонецПроцедуры

// Принимает сообщение об ошибке обновлятора.
//
// Параметры:
//   Шаблон - Строка - Шаблон сообщения.
//   Параметр1 - Произвольный - Параметр шаблона.
Процедура Ошибка(Шаблон, Параметр1 = Неопределено) Экспорт
КонецПроцедуры

#КонецОбласти
