#Использовать "../../../src/dto"
#Использовать "../../../src/db"
#Использовать entity
#Использовать reflector

Перем _Блокировка; // БлокировкаРесурса
Перем _ОперацииВошли; // Соответствие
Перем _АктивныеЧтения; // Число
Перем _АктивныеЗаписи; // Число
Перем _МаксимумЧтений; // Число
Перем _МаксимумЗаписей; // Число
Перем _РазрешенВыход; // Булево
Перем _КоличествоВызововТранзакции; // Число

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()

	_Блокировка = Новый БлокировкаРесурса(ЭтотОбъект);
	_ОперацииВошли = Новый Соответствие();
	_АктивныеЧтения = 0;
	_АктивныеЗаписи = 0;
	_МаксимумЧтений = 0;
	_МаксимумЗаписей = 0;
	_РазрешенВыход = Ложь;
	_КоличествоВызововТранзакции = 0;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

Функция ВыполнитьЧерезПул(Пул, Роль, НомерОперации, Менеджеры) Экспорт

	ПараметрыОперации = Новый Массив();
	ПараметрыОперации.Добавить(НомерОперации);
	ПараметрыОперации.Добавить(Роль);
	ПараметрыОперации.Добавить(Менеджеры);
	ПараметрыВызова = Новый Массив();
	ПараметрыВызова.Добавить(Роль);
	ПараметрыВызова.Добавить(Новый Действие(ЭтотОбъект, "ВыполнитьSQLИУдерживать"));
	ПараметрыВызова.Добавить(ПараметрыОперации);

	Возврат Новый Рефлектор().ВызватьМетод(Пул, "ВыполнитьСоСлотом", ПараметрыВызова);

КонецФункции

Функция ВыполнитьSQLИУдерживать(Менеджер, НомерОперации, Роль, Менеджеры) Экспорт

	Менеджер.ПолучитьКоннектор().ВыполнитьЗапрос("SELECT 1 AS Проверка;");
	НомерМенеджера = ОпределитьНомерМенеджера(Менеджер, Менеджеры);
	_Блокировка.Заблокировать();
	_ОперацииВошли.Вставить(НомерОперации, Истина);
	Если Роль = "Чтение" Тогда
		_АктивныеЧтения = _АктивныеЧтения + 1;
		_МаксимумЧтений = Макс(_МаксимумЧтений, _АктивныеЧтения);
	Иначе
		_АктивныеЗаписи = _АктивныеЗаписи + 1;
		_МаксимумЗаписей = Макс(_МаксимумЗаписей, _АктивныеЗаписи);
	КонецЕсли;
	_Блокировка.Разблокировать();

	ОжидатьРазрешенияВыхода();

	_Блокировка.Заблокировать();
	Если Роль = "Чтение" Тогда
		_АктивныеЧтения = _АктивныеЧтения - 1;
	Иначе
		_АктивныеЗаписи = _АктивныеЗаписи - 1;
	КонецЕсли;
	_Блокировка.Разблокировать();

	Возврат НомерМенеджера;

КонецФункции

Функция СохранитьИУдерживать(ДоступКБД, ИмяПакета) Экспорт

	ЗарегистрироватьВызовТранзакции();
	Сущность = Новый СущностьОчередьПакета();
	Сущность.ИмяПакета = ИмяПакета;
	Сущность.ДатаДобавления = ТекущаяУниверсальнаяДата();
	ДоступКБД.Сохранить(Сущность);
	УстановитьФлагВхода(1);
	ОжидатьРазрешенияВыхода();
	Возврат Истина;

КонецФункции

Функция СохранитьИПрочитать(ДоступКБД, ИмяПакета) Экспорт

	ЗарегистрироватьВызовТранзакции();
	Сущность = Новый СущностьОчередьПакета();
	Сущность.ИмяПакета = ИмяПакета;
	Сущность.ДатаДобавления = ТекущаяУниверсальнаяДата();
	ДоступКБД.Сохранить(Сущность);
	Опции = Новый ОпцииПоиска();
	Опции.Отбор("ИмяПакета", ВидСравнения.Равно, ИмяПакета);
	Прочитанная = ДоступКБД.ПолучитьОдно(Тип("СущностьОчередьПакета"), Опции);
	Возврат Прочитанная <> Неопределено
		И Прочитанная.ИмяПакета = ИмяПакета;

КонецФункции

Процедура РазрешитьВыход() Экспорт
	_Блокировка.Заблокировать();
	_РазрешенВыход = Истина;
	_Блокировка.Разблокировать();
КонецПроцедуры

Функция ОперацияВошла(НомерОперации) Экспорт
	_Блокировка.Заблокировать();
	Результат = _ОперацииВошли.Получить(НомерОперации) = Истина;
	_Блокировка.Разблокировать();
	Возврат Результат;
КонецФункции

Функция МаксимумЧтений() Экспорт
	_Блокировка.Заблокировать();
	Результат = _МаксимумЧтений;
	_Блокировка.Разблокировать();
	Возврат Результат;
КонецФункции

Функция МаксимумЗаписей() Экспорт
	_Блокировка.Заблокировать();
	Результат = _МаксимумЗаписей;
	_Блокировка.Разблокировать();
	Возврат Результат;
КонецФункции

Функция КоличествоВызововТранзакции() Экспорт
	_Блокировка.Заблокировать();
	Результат = _КоличествоВызововТранзакции;
	_Блокировка.Разблокировать();
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОпределитьНомерМенеджера(Менеджер, Менеджеры)
	Для Номер = 0 По Менеджеры.ВГраница() Цикл
		Если Менеджеры[Номер] = Менеджер Тогда
			Возврат Номер + 1;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "Арендован неизвестный SQLite-менеджер";
КонецФункции

Процедура ЗарегистрироватьВызовТранзакции()
	_Блокировка.Заблокировать();
	_КоличествоВызововТранзакции = _КоличествоВызововТранзакции + 1;
	_Блокировка.Разблокировать();
КонецПроцедуры

Процедура УстановитьФлагВхода(НомерОперации)
	_Блокировка.Заблокировать();
	_ОперацииВошли.Вставить(НомерОперации, Истина);
	_Блокировка.Разблокировать();
КонецПроцедуры

Процедура ОжидатьРазрешенияВыхода()
	Для НомерОжидания = 1 По 1000 Цикл
		_Блокировка.Заблокировать();
		МожноВыйти = _РазрешенВыход;
		_Блокировка.Разблокировать();
		Если МожноВыйти Тогда
			Возврат;
		КонецЕсли;
		Приостановить(5);
	КонецЦикла;
	ВызватьИсключение "SQLite-затвор не был освобожден за 5 секунд";
КонецПроцедуры

#КонецОбласти
