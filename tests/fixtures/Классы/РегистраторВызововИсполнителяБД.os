#Использовать reflector

Перем _КоличествоВызовов; // Число
Перем _ПоследниеПараметры; // Произвольный
Перем _ОперацияВыполняется; // Булево

#Область ОбработчикиСобытий

// Создает регистратор вызовов исполнителя операций базы данных.
Процедура ПриСозданииОбъекта()
	_КоличествоВызовов = 0;
	_ПоследниеПараметры = Неопределено;
	_ОперацияВыполняется = Ложь;
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Выполняет переданную операцию и регистрирует один внешний вызов исполнителя.
//
// Параметры:
//   Операция - Действие - Выполняемая операция.
//   Параметры - Произвольный, Неопределено - Параметры операции.
//
// Возвращаемое значение:
//   Произвольный - Результат операции.
Функция ВыполнитьОперацию(Операция, Параметры = Неопределено) Экспорт

	_КоличествоВызовов = _КоличествоВызовов + 1;
	_ПоследниеПараметры = Параметры;
	ПараметрыВызова = Новый Массив();
	Если Параметры <> Неопределено Тогда
		ПараметрыВызова.Добавить(Параметры);
	КонецЕсли;

	_ОперацияВыполняется = Истина;
	Попытка
		Результат = Новый Рефлектор().ВызватьМетод(Операция, "Выполнить", ПараметрыВызова);
	Исключение
		_ОперацияВыполняется = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	_ОперацияВыполняется = Ложь;

	Возврат Результат;

КонецФункции

// Возвращает количество внешних вызовов исполнителя.
//
// Возвращаемое значение:
//   Число - Количество вызовов.
Функция КоличествоВызовов() Экспорт
	Возврат _КоличествоВызовов;
КонецФункции

// Возвращает параметры последнего вызова исполнителя.
//
// Возвращаемое значение:
//   Произвольный - Последние параметры.
Функция ПоследниеПараметры() Экспорт
	Возврат _ПоследниеПараметры;
КонецФункции

// Возвращает признак выполнения операции внутри исполнителя.
//
// Возвращаемое значение:
//   Булево - Истина во время выполнения callback.
Функция ОперацияВыполняется() Экспорт
	Возврат _ОперацияВыполняется;
КонецФункции

#КонецОбласти
