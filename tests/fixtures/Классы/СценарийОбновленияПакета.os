Перем _Исполнитель; // РегистраторВызововИсполнителяБД
Перем _Успех; // Булево
Перем _КоличествоВызовов; // Число
Перем _ВызванВнутриОперацииБД; // Булево

#Область ОбработчикиСобытий

// Создает сценарий обновления пакета.
Процедура ПриСозданииОбъекта()
	_Исполнитель = Неопределено;
	_Успех = Истина;
	_КоличествоВызовов = 0;
	_ВызванВнутриОперацииБД = Ложь;
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Настраивает результат обновления и наблюдаемый исполнитель.
//
// Параметры:
//   Исполнитель - РегистраторВызововИсполнителяБД - Наблюдаемый исполнитель.
//   Успех - Булево - Результат обновления.
Процедура Настроить(Исполнитель, Успех) Экспорт
	_Исполнитель = Исполнитель;
	_Успех = Успех;
КонецПроцедуры

// Обновляет пакет по сценарию.
//
// Параметры:
//   ИмяПакета - Строка - Имя обновляемого пакета.
//
// Возвращаемое значение:
//   Структура - Результат с признаком Успех.
Функция ОбновитьПакет(ИмяПакета) Экспорт

	_КоличествоВызовов = _КоличествоВызовов + 1;
	_ВызванВнутриОперацииБД = _Исполнитель.ОперацияВыполняется();

	Возврат Новый Структура("Успех", _Успех);

КонецФункции

// Возвращает количество вызовов обновления.
//
// Возвращаемое значение:
//   Число - Количество вызовов.
Функция КоличествоВызовов() Экспорт
	Возврат _КоличествоВызовов;
КонецФункции

// Возвращает признак вызова обновлятора внутри операции базы данных.
//
// Возвращаемое значение:
//   Булево - Признак вложенного вызова.
Функция ВызванВнутриОперацииБД() Экспорт
	Возврат _ВызванВнутриОперацииБД;
КонецФункции

#КонецОбласти
