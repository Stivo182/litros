#Использовать "../../../src/dto"

Перем _Состояние; // БлокировкаРесурса
Перем _ПерваяВошлаВФасад; // Булево
Перем _ВторойНачалВызов; // Булево
Перем _РазрешитьСбойОткатаТранзакции; // Булево
Перем _КоличествоПолучений; // Число

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()
	_Состояние = Новый БлокировкаРесурса(ЭтотОбъект);
	_ПерваяВошлаВФасад = Ложь;
	_ВторойНачалВызов = Ложь;
	_РазрешитьСбойОткатаТранзакции = Ложь;
	_КоличествоПолучений = 0;
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

Функция ОтветитьНаОткатТранзакции(ИнформацияОВызове) Экспорт
	
	_Состояние.Заблокировать();
	_ПерваяВошлаВФасад = Истина;
	_Состояние.Разблокировать();

	Для НомерОжидания = 1 По 400 Цикл
		Если ВторойНачалВызов() И СбойОткатаТранзакцииРазрешен() Тогда
			ВызватьИсключение "database is locked при откате транзакции";
		КонецЕсли;
		Приостановить(5);
	КонецЦикла;

	ВызватьИсключение "Второй вызов не дошёл до фасада";

КонецФункции

Процедура РазрешитьСбойОткатаТранзакции() Экспорт
	_Состояние.Заблокировать();
	_РазрешитьСбойОткатаТранзакции = Истина;
	_Состояние.Разблокировать();
КонецПроцедуры

Функция ОтветитьНаПолучение(ИнформацияОВызове) Экспорт
	_Состояние.Заблокировать();
	_КоличествоПолучений = _КоличествоПолучений + 1;
	_Состояние.Разблокировать();
	Возврат Новый Массив();
КонецФункции

Функция ПерваяВошлаВФасад() Экспорт
	_Состояние.Заблокировать();
	Результат = _ПерваяВошлаВФасад;
	_Состояние.Разблокировать();
	Возврат Результат;
КонецФункции

Функция КоличествоПолучений() Экспорт
	_Состояние.Заблокировать();
	Результат = _КоличествоПолучений;
	_Состояние.Разблокировать();
	Возврат Результат;
КонецФункции

Функция ВыполнитьПервуюОперацию(Фасад, Операция) Экспорт
	Попытка
		Фасад.ВыполнитьВТранзакции(Операция);
	Исключение
		Возврат ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Возврат "ошибка не возникла";
КонецФункции

Функция ВыполнитьВторуюОперацию(Фасад) Экспорт
	_Состояние.Заблокировать();
	_ВторойНачалВызов = Истина;
	_Состояние.Разблокировать();
	Попытка
		Фасад.Получить(Тип("СущностьРепозиторий"));
	Исключение
		Возврат ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Возврат "ошибка не возникла";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВторойНачалВызов()
	_Состояние.Заблокировать();
	Результат = _ВторойНачалВызов;
	_Состояние.Разблокировать();
	Возврат Результат;
КонецФункции

Функция СбойОткатаТранзакцииРазрешен()
	_Состояние.Заблокировать();
	Результат = _РазрешитьСбойОткатаТранзакции;
	_Состояние.Разблокировать();
	Возврат Результат;
КонецФункции

#КонецОбласти
