#Использовать reflector
#Использовать "../../../src/dto"

Перем _Слот; // БлокировкаРесурса
Перем _Состояние; // БлокировкаРесурса
Перем _КоличествоВызовов; // Число
Перем _ПерваяВошлаВExecutor; // Булево
Перем _ВторойВошелВExecutor; // Булево
Перем _КоличествоПолучений; // Число

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()
	_Слот = Новый БлокировкаРесурса();
	_Состояние = Новый БлокировкаРесурса(ЭтотОбъект);
	_КоличествоВызовов = 0;
	_ПерваяВошлаВExecutor = Ложь;
	_ВторойВошелВExecutor = Ложь;
	_КоличествоПолучений = 0;
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

Функция ВыполнитьОперацию(Операция, Параметры = Неопределено) Экспорт
	_Состояние.Заблокировать();
	_КоличествоВызовов = _КоличествоВызовов + 1;
	Если _КоличествоВызовов = 1 Тогда
		_ПерваяВошлаВExecutor = Истина;
	ИначеЕсли _КоличествоВызовов = 2 Тогда
		_ВторойВошелВExecutor = Истина;
	КонецЕсли;
	_Состояние.Разблокировать();
	_Слот.Заблокировать();
	Попытка
		ПараметрыВызова = ПодготовитьПараметры(Параметры);
		Результат = Новый Рефлектор().ВызватьМетод(Операция, "Выполнить", ПараметрыВызова);
	Исключение
		_Слот.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;
	_Слот.Разблокировать();
	Возврат Результат;
КонецФункции

Функция ОтветитьНаRollback(ИнформацияОВызове) Экспорт
	Для НомерОжидания = 1 По 400 Цикл
		Если ВторойВошелВExecutor() Тогда
			ВызватьИсключение "rollback database is locked";
		КонецЕсли;
		Приостановить(5);
	КонецЦикла;
	ВызватьИсключение "Второй вызов не вошел в executor";
КонецФункции

Функция ОтветитьНаПолучение(ИнформацияОВызове) Экспорт
	_Состояние.Заблокировать();
	_КоличествоПолучений = _КоличествоПолучений + 1;
	_Состояние.Разблокировать();
	Возврат Новый Массив();
КонецФункции

Функция ПерваяВошлаВExecutor() Экспорт
	_Состояние.Заблокировать();
	Результат = _ПерваяВошлаВExecutor;
	_Состояние.Разблокировать();
	Возврат Результат;
КонецФункции

Функция КоличествоПолучений() Экспорт
	_Состояние.Заблокировать();
	Результат = _КоличествоПолучений;
	_Состояние.Разблокировать();
	Возврат Результат;
КонецФункции

Функция ВыполнитьПервуюОперацию(Фасад, Операция) Экспорт
	Попытка
		Фасад.ВыполнитьВТранзакции(Операция);
	Исключение
		Возврат ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Возврат "ошибка не возникла";
КонецФункции

Функция ВыполнитьВторуюОперацию(Фасад) Экспорт
	Попытка
		Фасад.Получить(Тип("СущностьРепозиторий"));
	Исключение
		Возврат ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Возврат "ошибка не возникла";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВторойВошелВExecutor()
	_Состояние.Заблокировать();
	Результат = _ВторойВошелВExecutor;
	_Состояние.Разблокировать();
	Возврат Результат;
КонецФункции

Функция ПодготовитьПараметры(Параметры)
	Результат = Новый Массив();
	Если Параметры = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Если ТипЗнч(Параметры) = Тип("Массив")
		Или ТипЗнч(Параметры) = Тип("ФиксированныйМассив") Тогда
		Для Каждого Параметр Из Параметры Цикл
			Результат.Добавить(Параметр);
		КонецЦикла;
	Иначе
		Результат.Добавить(Параметры);
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти
