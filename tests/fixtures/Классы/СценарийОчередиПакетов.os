Перем _КоличествоОшибок; // Число
Перем _ОписаниеОшибки; // Строка
Перем _Дубликат; // Булево
Перем _КоличествоОшибокВыборки; // Число
Перем _ОписаниеОшибкиВыборки; // Строка
Перем _Пачка; // Массив
Перем _КоличествоПроверок; // Число
Перем _КоличествоСохранений; // Число
Перем _КоличествоОшибокПослеСохранения; // Число
Перем _ОписаниеОшибкиПослеСохранения; // Строка
Перем _КоличествоВыборок; // Число
Перем _КоличествоУдалений; // Число
Перем _ПоследнееСохраненноеИмя; // Строка
Перем _КоличествоТранзакций; // Число
Перем _ПоследниеОпцииВыборки; // ОпцииПоиска, Неопределено
Перем _ПоследнееПроверенноеИмя; // Строка
Перем _ПакетДобавлен; // Булево
Перем _ИменаПакетов; // Массив
Перем _РезультатыОбновления; // Соответствие
Перем _ИмяСОшибкойОбновления; // Строка
Перем _ТекстОшибкиОбновления; // Строка
Перем _ИменаДобавления; // Массив
Перем _ИменаОбновления; // Массив
Перем _РезультатыВызововОбновления; // Массив
Перем _УдаленныеИмена; // Массив
Перем _ПоследовательностьВызовов; // Массив
Перем _ВызовХранилищаВыполняется; // Булево
Перем _ОбновляторВызванВнутриХранилища; // Булево
Перем _КоличествоОтладочныхСообщений; // Число
Перем _ПоследнийШаблонОтладки; // Строка
Перем _ПоследнийПараметрОтладки; // Произвольный
Перем _КоличествоСообщенийОбОшибках; // Число
Перем _УдерживатьПервуюТранзакцию; // Булево
Перем _ПерваяТранзакцияВошла; // Булево
Перем _РазрешитьПервуюТранзакцию; // Булево
Перем _АктивныеТранзакции; // Число
Перем _МаксимумТранзакций; // Число
Перем _БлокировкаТранзакций; // БлокировкаРесурса

#Область ОбработчикиСобытий

// Создает сценарий взаимодействия процессора очереди с менеджером сущностей.
Процедура ПриСозданииОбъекта()

	_КоличествоОшибок = 0;
	_ОписаниеОшибки = "";
	_Дубликат = Ложь;
	_КоличествоОшибокВыборки = 0;
	_ОписаниеОшибкиВыборки = "";
	_Пачка = Новый Массив();
	_КоличествоПроверок = 0;
	_КоличествоСохранений = 0;
	_КоличествоОшибокПослеСохранения = 0;
	_ОписаниеОшибкиПослеСохранения = "";
	_КоличествоВыборок = 0;
	_КоличествоУдалений = 0;
	_ПоследнееСохраненноеИмя = "";
	_КоличествоТранзакций = 0;
	_ПоследниеОпцииВыборки = Неопределено;
	_ПоследнееПроверенноеИмя = "";
	_ПакетДобавлен = Истина;
	_ИменаПакетов = Новый Массив();
	_РезультатыОбновления = Новый Соответствие();
	_ИмяСОшибкойОбновления = "";
	_ТекстОшибкиОбновления = "";
	_ИменаДобавления = Новый Массив();
	_ИменаОбновления = Новый Массив();
	_РезультатыВызововОбновления = Новый Массив();
	_УдаленныеИмена = Новый Массив();
	_ПоследовательностьВызовов = Новый Массив();
	_ВызовХранилищаВыполняется = Ложь;
	_ОбновляторВызванВнутриХранилища = Ложь;
	_КоличествоОтладочныхСообщений = 0;
	_ПоследнийШаблонОтладки = "";
	_ПоследнийПараметрОтладки = Неопределено;
	_КоличествоСообщенийОбОшибках = 0;
	_УдерживатьПервуюТранзакцию = Ложь;
	_ПерваяТранзакцияВошла = Ложь;
	_РазрешитьПервуюТранзакцию = Ложь;
	_АктивныеТранзакции = 0;
	_МаксимумТранзакций = 0;
	_БлокировкаТранзакций = Новый БлокировкаРесурса(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Настраивает наличие пакета в очереди.
//
// Параметры:
//   Дубликат - Булево - Истина, если пакет уже находится в очереди.
Процедура НастроитьДубликат(Дубликат) Экспорт
	_Дубликат = Дубликат;
КонецПроцедуры

Процедура УдерживатьПервуюТранзакцию() Экспорт
	_УдерживатьПервуюТранзакцию = Истина;
КонецПроцедуры

Функция ПерваяТранзакцияВошла() Экспорт
	Возврат _ПерваяТранзакцияВошла;
КонецФункции

Процедура РазрешитьПервуюТранзакцию() Экспорт
	_РазрешитьПервуюТранзакцию = Истина;
КонецПроцедуры

Функция МаксимумОдновременныхТранзакций() Экспорт
	Возврат _МаксимумТранзакций;
КонецФункции

// Настраивает результат добавления в замокированное хранилище.
//
// Параметры:
//   ПакетДобавлен - Булево - Признак добавления нового пакета.
Процедура НастроитьДобавление(ПакетДобавлен) Экспорт
	_ПакетДобавлен = ПакетДобавлен;

КонецПроцедуры

// Добавляет имя пакета в пачку замокированного хранилища.
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета.
Процедура ДобавитьИмяВПачку(ИмяПакета) Экспорт

	_ИменаПакетов.Добавить(ИмяПакета);

КонецПроцедуры

// Настраивает результат обновления определенного пакета.
//
// Параметры:
//   ИмяПакета - Строка - Имя обновляемого пакета.
//   Успех - Булево - Результат обновления.
Процедура НастроитьРезультатОбновления(ИмяПакета, Успех) Экспорт

	_РезультатыОбновления.Вставить(ИмяПакета, Успех);

КонецПроцедуры

// Настраивает исключение при обновлении определенного пакета.
//
// Параметры:
//   ИмяПакета - Строка - Имя обновляемого пакета.
//   ТекстОшибки - Строка - Текст выбрасываемой ошибки.
Процедура НастроитьОшибкуОбновления(ИмяПакета, ТекстОшибки) Экспорт

	_ИмяСОшибкойОбновления = ИмяПакета;
	_ТекстОшибкиОбновления = ТекстОшибки;

КонецПроцедуры

// Настраивает ошибки выборки пачки очереди.
//
// Параметры:
//   КоличествоОшибок - Число - Количество ошибок до успешной выборки.
//   ОписаниеОшибки - Строка - Описание выбрасываемой ошибки.
Процедура НастроитьОшибкиВыборки(КоличествоОшибок, ОписаниеОшибки) Экспорт
	_КоличествоОшибокВыборки = КоличествоОшибок;
	_ОписаниеОшибкиВыборки = ОписаниеОшибки;
КонецПроцедуры

// Добавляет пакет в возвращаемую пачку очереди.
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета.
Процедура ДобавитьПакетВПачку(ИмяПакета) Экспорт

	ОчередьПакета = Новый СущностьОчередьПакета();
	ОчередьПакета.ИмяПакета = ИмяПакета;
	_Пачка.Добавить(ОчередьПакета);

КонецПроцедуры

// Настраивает ошибки проверки существующего элемента очереди.
//
// Параметры:
//   КоличествоОшибок - Число - Количество ошибок до успешной проверки.
//   ОписаниеОшибки - Строка - Описание выбрасываемой ошибки.
Процедура НастроитьОшибкиПроверки(КоличествоОшибок, ОписаниеОшибки) Экспорт

	_КоличествоОшибок = КоличествоОшибок;
	_ОписаниеОшибки = ОписаниеОшибки;

КонецПроцедуры

// Настраивает ошибки, возникающие после создания элемента очереди.
//
// Параметры:
//   КоличествоОшибок - Число - Количество сохранений с неоднозначным результатом.
//   ОписаниеОшибки - Строка - Описание выбрасываемой после сохранения ошибки.
Процедура НастроитьОшибкиПослеСохранения(КоличествоОшибок, ОписаниеОшибки) Экспорт

	_КоличествоОшибокПослеСохранения = КоличествоОшибок;
	_ОписаниеОшибкиПослеСохранения = ОписаниеОшибки;

КонецПроцедуры

// Возвращает менеджер сущностей из тестовой табакерки.
//
// Возвращаемое значение:
//   СценарийОчередиПакетов - Тестовый менеджер сущностей.
Функция Достать() Экспорт
	Возврат ЭтотОбъект;
КонецФункции

// Начинает тестовую транзакцию.
Процедура НачатьТранзакцию() Экспорт
	_КоличествоТранзакций = _КоличествоТранзакций + 1;
	_БлокировкаТранзакций.Заблокировать();
	_АктивныеТранзакции = _АктивныеТранзакции + 1;
	_МаксимумТранзакций = Макс(_МаксимумТранзакций, _АктивныеТранзакции);
	_БлокировкаТранзакций.Разблокировать();
КонецПроцедуры

// Фиксирует тестовую транзакцию.
Процедура ЗафиксироватьТранзакцию() Экспорт
	ЗавершитьТранзакцию();
КонецПроцедуры

// Отменяет тестовую транзакцию, сохраняя неоднозначный результат операции.
Процедура ОтменитьТранзакцию() Экспорт
	ЗавершитьТранзакцию();
КонецПроцедуры

// Закрывает тестовый менеджер сущностей.
Процедура Закрыть() Экспорт
КонецПроцедуры

// Получает настроенную пачку элементов очереди.
//
// Параметры:
//   ТипСущности - Тип - Тип элемента очереди.
//   ОпцииПоиска - ОпцииПоиска - Параметры выборки.
//
// Возвращаемое значение:
//   Массив - Настроенная пачка очереди.
Функция Получить(ТипСущности, ОпцииПоиска) Экспорт

	_КоличествоВыборок = _КоличествоВыборок + 1;
	_ПоследниеОпцииВыборки = ОпцииПоиска;
	Если _КоличествоВыборок <= _КоличествоОшибокВыборки Тогда
		ВызватьИсключение _ОписаниеОшибкиВыборки;
	КонецЕсли;

	Возврат _Пачка;

КонецФункции

// Проверяет наличие элемента очереди по сценарию.
//
// Параметры:
//   ТипСущности - Тип - Тип элемента очереди.
//   ОпцииПоиска - ОпцииПоиска - Условия поиска.
//
// Возвращаемое значение:
//   Неопределено - Элемент очереди отсутствует.
Функция ПолучитьОдно(ТипСущности, ОпцииПоиска) Экспорт

	Если _УдерживатьПервуюТранзакцию Тогда
		_БлокировкаТранзакций.Заблокировать();
		ЭтоПерваяТранзакция = Не _ПерваяТранзакцияВошла;
		Если ЭтоПерваяТранзакция Тогда
			_ПерваяТранзакцияВошла = Истина;
		КонецЕсли;
		_БлокировкаТранзакций.Разблокировать();
		Если ЭтоПерваяТранзакция Тогда
			Пока Не _РазрешитьПервуюТранзакцию Цикл
				Приостановить(5);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	_КоличествоПроверок = _КоличествоПроверок + 1;
	Отборы = ОпцииПоиска.Отборы();
	Если Отборы.Количество() > 0 Тогда
		_ПоследнееПроверенноеИмя = Отборы[0].Значение;
	КонецЕсли;
	Если _КоличествоПроверок <= _КоличествоОшибок Тогда
		ВызватьИсключение _ОписаниеОшибки;
	КонецЕсли;

	Если _Дубликат Тогда
		ОчередьПакета = Новый СущностьОчередьПакета();
		ОчередьПакета.ИмяПакета = _ПоследнееПроверенноеИмя;
		Возврат ОчередьПакета;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Сохраняет элемент очереди по сценарию.
//
// Параметры:
//   Сущность - СущностьОчередьПакета - Сохраняемый элемент очереди.
Процедура Сохранить(Сущность) Экспорт
	_ПоследнееСохраненноеИмя = Сущность.ИмяПакета;
	_КоличествоСохранений = _КоличествоСохранений + 1;
	Если _КоличествоСохранений <= _КоличествоОшибокПослеСохранения Тогда
		_Дубликат = Истина;
		ВызватьИсключение _ОписаниеОшибкиПослеСохранения;
	КонецЕсли;
КонецПроцедуры

// Возвращает имя пакета последней переданной на сохранение сущности.
//
// Возвращаемое значение:
//   Строка - Нормализованное имя пакета.
Функция ПоследнееСохраненноеИмя() Экспорт
	Возврат _ПоследнееСохраненноеИмя;
КонецФункции

// Удаляет элемент очереди по сценарию.
//
// Параметры:
//   Сущность - СущностьОчередьПакета - Удаляемый элемент очереди.
Процедура Удалить(Сущность) Экспорт
	_КоличествоУдалений = _КоличествоУдалений + 1;
КонецПроцедуры

// Возвращает количество проверок существующего элемента очереди.
//
// Возвращаемое значение:
//   Число - Количество проверок.
Функция КоличествоПроверок() Экспорт
	Возврат _КоличествоПроверок;
КонецФункции

// Возвращает количество сохранений элемента очереди.
//
// Возвращаемое значение:
//   Число - Количество сохранений.
Функция КоличествоСохранений() Экспорт
	Возврат _КоличествоСохранений;
КонецФункции

// Возвращает количество выборок пачки очереди.
//
// Возвращаемое значение:
//   Число - Количество выборок.
Функция КоличествоВыборок() Экспорт
	Возврат _КоличествоВыборок;
КонецФункции

// Возвращает количество удалений элементов очереди.
//
// Возвращаемое значение:
//   Число - Количество удалений.
Функция КоличествоУдалений() Экспорт
	Возврат _КоличествоУдалений;
КонецФункции

// Возвращает количество начатых транзакций.
//
// Возвращаемое значение:
//   Число - Количество попыток транзакционной операции.
Функция КоличествоТранзакций() Экспорт
	Возврат _КоличествоТранзакций;
КонецФункции

// Возвращает опции последней выборки пачки.
//
// Возвращаемое значение:
//   ОпцииПоиска, Неопределено - Последние полученные опции.
Функция ПоследниеОпцииВыборки() Экспорт
	Возврат _ПоследниеОпцииВыборки;
КонецФункции

// Возвращает имя из отбора последней проверки или удаления.
//
// Возвращаемое значение:
//   Строка - Нормализованное имя пакета.
Функция ПоследнееПроверенноеИмя() Экспорт
	Возврат _ПоследнееПроверенноеИмя;
КонецФункции

// Регистрирует добавление, вызванное замокированным хранилищем.
Функция ЗарегистрироватьДобавление(ИнформацияОВызове) Экспорт

	ИмяПакета = ИнформацияОВызове.Параметры()[0];
	_ИменаДобавления.Добавить(ИмяПакета);
	_ПоследовательностьВызовов.Добавить("Добавить:" + ИмяПакета);

	Возврат _ПакетДобавлен;

КонецФункции

// Регистрирует получение пачки, вызванное замокированным хранилищем.
Функция ЗарегистрироватьПолучениеПачки(ИнформацияОВызове) Экспорт

	_ВызовХранилищаВыполняется = Истина;
	_ПоследовательностьВызовов.Добавить("ПолучитьПачку");
	_ВызовХранилищаВыполняется = Ложь;

	Возврат _ИменаПакетов;

КонецФункции

// Регистрирует удаление, вызванное замокированным хранилищем.
Функция ЗарегистрироватьУдаление(ИнформацияОВызове) Экспорт

	ИмяПакета = ИнформацияОВызове.Параметры()[0];
	_УдаленныеИмена.Добавить(ИмяПакета);
	_ПоследовательностьВызовов.Добавить("Удалить:" + ИмяПакета);

	Возврат Неопределено;

КонецФункции

// Регистрирует обновление, вызванное замокированным обновлятором.
Функция ЗарегистрироватьОбновление(ИнформацияОВызове) Экспорт

	ИмяПакета = ИнформацияОВызове.Параметры()[0];
	_ИменаОбновления.Добавить(ИмяПакета);
	_ПоследовательностьВызовов.Добавить("ОбновитьПакет:" + ИмяПакета);
	Если _ВызовХранилищаВыполняется Тогда
		_ОбновляторВызванВнутриХранилища = Истина;
	КонецЕсли;
	Если ИмяПакета = _ИмяСОшибкойОбновления Тогда
		ВызватьИсключение _ТекстОшибкиОбновления;
	КонецЕсли;
	Успех = _РезультатыОбновления[ИмяПакета];
	Если Успех = Неопределено Тогда
		Успех = Истина;
	КонецЕсли;
	_РезультатыВызововОбновления.Добавить(Успех);

	Возврат Новый Структура("Успех", Успех);

КонецФункции

// Регистрирует отладочное сообщение процессора.
Процедура Отладка(Шаблон, Параметр = Неопределено) Экспорт

	_КоличествоОтладочныхСообщений = _КоличествоОтладочныхСообщений + 1;
	_ПоследнийШаблонОтладки = Шаблон;
	_ПоследнийПараметрОтладки = Параметр;

КонецПроцедуры

// Регистрирует сообщение об ошибке процессора.
Процедура Ошибка(Шаблон, Параметр = Неопределено) Экспорт

	_КоличествоСообщенийОбОшибках = _КоличествоСообщенийОбОшибках + 1;

КонецПроцедуры

// Возвращает число добавлений в замокированное хранилище.
Функция КоличествоДобавлений() Экспорт

	Возврат _ИменаДобавления.Количество();

КонецФункции

// Возвращает последнее имя, переданное в замокированное хранилище.
Функция ПоследнееДобавленноеИмя() Экспорт

	Возврат _ИменаДобавления[_ИменаДобавления.ВГраница()];

КонецФункции

// Возвращает имена, переданные обновлятору.
Функция ИменаОбновления() Экспорт

	Возврат _ИменаОбновления;

КонецФункции

// Возвращает результаты обновлений, сформированные сценарием.
Функция РезультатыВызововОбновления() Экспорт

	Возврат _РезультатыВызововОбновления;

КонецФункции

// Возвращает имена, переданные на удаление.
Функция УдаленныеИмена() Экспорт

	Возврат _УдаленныеИмена;

КонецФункции

// Возвращает порядок вызовов компонентов процессора.
Функция ПоследовательностьВызовов() Экспорт

	Возврат _ПоследовательностьВызовов;

КонецФункции

// Возвращает признак вызова обновлятора из обработчика хранилища.
Функция ОбновляторВызванВнутриХранилища() Экспорт

	Возврат _ОбновляторВызванВнутриХранилища;

КонецФункции

// Возвращает число отладочных сообщений.
Функция КоличествоОтладочныхСообщений() Экспорт

	Возврат _КоличествоОтладочныхСообщений;

КонецФункции

// Возвращает шаблон последнего отладочного сообщения.
Функция ПоследнийШаблонОтладки() Экспорт

	Возврат _ПоследнийШаблонОтладки;

КонецФункции

// Возвращает параметр последнего отладочного сообщения.
Функция ПоследнийПараметрОтладки() Экспорт

	Возврат _ПоследнийПараметрОтладки;

КонецФункции

// Возвращает число сообщений об ошибке.
Функция КоличествоОшибок() Экспорт

	Возврат _КоличествоСообщенийОбОшибках;

КонецФункции

Процедура ЗавершитьТранзакцию()
	_БлокировкаТранзакций.Заблокировать();
	_АктивныеТранзакции = Макс(0, _АктивныеТранзакции - 1);
	_БлокировкаТранзакций.Разблокировать();
КонецПроцедуры

#КонецОбласти
