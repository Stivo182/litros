Перем _КоличествоОшибок; // Число
Перем _ОписаниеОшибки; // Строка
Перем _Дубликат; // Булево
Перем _КоличествоОшибокВыборки; // Число
Перем _ОписаниеОшибкиВыборки; // Строка
Перем _Пачка; // Массив
Перем _КоличествоПроверок; // Число
Перем _КоличествоСохранений; // Число
Перем _КоличествоОшибокПослеСохранения; // Число
Перем _ОписаниеОшибкиПослеСохранения; // Строка
Перем _КоличествоВыборок; // Число
Перем _КоличествоУдалений; // Число
Перем _ПоследнееСохраненноеИмя; // Строка
Перем _КоличествоТранзакций; // Число
Перем _ПоследниеОпцииВыборки; // ОпцииПоиска, Неопределено
Перем _ПоследнееПроверенноеИмя; // Строка

#Область ОбработчикиСобытий

// Создает сценарий взаимодействия процессора очереди с менеджером сущностей.
Процедура ПриСозданииОбъекта()

	_КоличествоОшибок = 0;
	_ОписаниеОшибки = "";
	_Дубликат = Ложь;
	_КоличествоОшибокВыборки = 0;
	_ОписаниеОшибкиВыборки = "";
	_Пачка = Новый Массив();
	_КоличествоПроверок = 0;
	_КоличествоСохранений = 0;
	_КоличествоОшибокПослеСохранения = 0;
	_ОписаниеОшибкиПослеСохранения = "";
	_КоличествоВыборок = 0;
	_КоличествоУдалений = 0;
	_ПоследнееСохраненноеИмя = "";
	_КоличествоТранзакций = 0;
	_ПоследниеОпцииВыборки = Неопределено;
	_ПоследнееПроверенноеИмя = "";

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Настраивает наличие пакета в очереди.
//
// Параметры:
//   Дубликат - Булево - Истина, если пакет уже находится в очереди.
Процедура НастроитьДубликат(Дубликат) Экспорт
	_Дубликат = Дубликат;
КонецПроцедуры

// Настраивает ошибки выборки пачки очереди.
//
// Параметры:
//   КоличествоОшибок - Число - Количество ошибок до успешной выборки.
//   ОписаниеОшибки - Строка - Описание выбрасываемой ошибки.
Процедура НастроитьОшибкиВыборки(КоличествоОшибок, ОписаниеОшибки) Экспорт
	_КоличествоОшибокВыборки = КоличествоОшибок;
	_ОписаниеОшибкиВыборки = ОписаниеОшибки;
КонецПроцедуры

// Добавляет пакет в возвращаемую пачку очереди.
//
// Параметры:
//   ИмяПакета - Строка - Имя пакета.
Процедура ДобавитьПакетВПачку(ИмяПакета) Экспорт

	ОчередьПакета = Новый СущностьОчередьПакета();
	ОчередьПакета.ИмяПакета = ИмяПакета;
	_Пачка.Добавить(ОчередьПакета);

КонецПроцедуры

// Настраивает ошибки проверки существующего элемента очереди.
//
// Параметры:
//   КоличествоОшибок - Число - Количество ошибок до успешной проверки.
//   ОписаниеОшибки - Строка - Описание выбрасываемой ошибки.
Процедура НастроитьОшибкиПроверки(КоличествоОшибок, ОписаниеОшибки) Экспорт

	_КоличествоОшибок = КоличествоОшибок;
	_ОписаниеОшибки = ОписаниеОшибки;

КонецПроцедуры

// Настраивает ошибки, возникающие после создания элемента очереди.
//
// Параметры:
//   КоличествоОшибок - Число - Количество сохранений с неоднозначным результатом.
//   ОписаниеОшибки - Строка - Описание выбрасываемой после сохранения ошибки.
Процедура НастроитьОшибкиПослеСохранения(КоличествоОшибок, ОписаниеОшибки) Экспорт

	_КоличествоОшибокПослеСохранения = КоличествоОшибок;
	_ОписаниеОшибкиПослеСохранения = ОписаниеОшибки;

КонецПроцедуры

// Возвращает менеджер сущностей из тестовой табакерки.
//
// Возвращаемое значение:
//   СценарийОчередиПакетов - Тестовый менеджер сущностей.
Функция Достать() Экспорт
	Возврат ЭтотОбъект;
КонецФункции

// Начинает тестовую транзакцию.
Процедура НачатьТранзакцию() Экспорт
	_КоличествоТранзакций = _КоличествоТранзакций + 1;
КонецПроцедуры

// Фиксирует тестовую транзакцию.
Процедура ЗафиксироватьТранзакцию() Экспорт
КонецПроцедуры

// Отменяет тестовую транзакцию, сохраняя неоднозначный результат операции.
Процедура ОтменитьТранзакцию() Экспорт
КонецПроцедуры

// Закрывает тестовый менеджер сущностей.
Процедура Закрыть() Экспорт
КонецПроцедуры

// Получает настроенную пачку элементов очереди.
//
// Параметры:
//   ТипСущности - Тип - Тип элемента очереди.
//   ОпцииПоиска - ОпцииПоиска - Параметры выборки.
//
// Возвращаемое значение:
//   Массив - Настроенная пачка очереди.
Функция Получить(ТипСущности, ОпцииПоиска) Экспорт

	_КоличествоВыборок = _КоличествоВыборок + 1;
	_ПоследниеОпцииВыборки = ОпцииПоиска;
	Если _КоличествоВыборок <= _КоличествоОшибокВыборки Тогда
		ВызватьИсключение _ОписаниеОшибкиВыборки;
	КонецЕсли;

	Возврат _Пачка;

КонецФункции

// Проверяет наличие элемента очереди по сценарию.
//
// Параметры:
//   ТипСущности - Тип - Тип элемента очереди.
//   ОпцииПоиска - ОпцииПоиска - Условия поиска.
//
// Возвращаемое значение:
//   Неопределено - Элемент очереди отсутствует.
Функция ПолучитьОдно(ТипСущности, ОпцииПоиска) Экспорт

	_КоличествоПроверок = _КоличествоПроверок + 1;
	Отборы = ОпцииПоиска.Отборы();
	Если Отборы.Количество() > 0 Тогда
		_ПоследнееПроверенноеИмя = Отборы[0].Значение;
	КонецЕсли;
	Если _КоличествоПроверок <= _КоличествоОшибок Тогда
		ВызватьИсключение _ОписаниеОшибки;
	КонецЕсли;

	Если _Дубликат Тогда
		ОчередьПакета = Новый СущностьОчередьПакета();
		ОчередьПакета.ИмяПакета = _ПоследнееПроверенноеИмя;
		Возврат ОчередьПакета;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

// Сохраняет элемент очереди по сценарию.
//
// Параметры:
//   Сущность - СущностьОчередьПакета - Сохраняемый элемент очереди.
Процедура Сохранить(Сущность) Экспорт
	_ПоследнееСохраненноеИмя = Сущность.ИмяПакета;
	_КоличествоСохранений = _КоличествоСохранений + 1;
	Если _КоличествоСохранений <= _КоличествоОшибокПослеСохранения Тогда
		_Дубликат = Истина;
		ВызватьИсключение _ОписаниеОшибкиПослеСохранения;
	КонецЕсли;
КонецПроцедуры

// Возвращает имя пакета последней переданной на сохранение сущности.
//
// Возвращаемое значение:
//   Строка - Нормализованное имя пакета.
Функция ПоследнееСохраненноеИмя() Экспорт
	Возврат _ПоследнееСохраненноеИмя;
КонецФункции

// Удаляет элемент очереди по сценарию.
//
// Параметры:
//   Сущность - СущностьОчередьПакета - Удаляемый элемент очереди.
Процедура Удалить(Сущность) Экспорт
	_КоличествоУдалений = _КоличествоУдалений + 1;
КонецПроцедуры

// Возвращает количество проверок существующего элемента очереди.
//
// Возвращаемое значение:
//   Число - Количество проверок.
Функция КоличествоПроверок() Экспорт
	Возврат _КоличествоПроверок;
КонецФункции

// Возвращает количество сохранений элемента очереди.
//
// Возвращаемое значение:
//   Число - Количество сохранений.
Функция КоличествоСохранений() Экспорт
	Возврат _КоличествоСохранений;
КонецФункции

// Возвращает количество выборок пачки очереди.
//
// Возвращаемое значение:
//   Число - Количество выборок.
Функция КоличествоВыборок() Экспорт
	Возврат _КоличествоВыборок;
КонецФункции

// Возвращает количество удалений элементов очереди.
//
// Возвращаемое значение:
//   Число - Количество удалений.
Функция КоличествоУдалений() Экспорт
	Возврат _КоличествоУдалений;
КонецФункции

// Возвращает количество начатых транзакций.
//
// Возвращаемое значение:
//   Число - Количество попыток транзакционной операции.
Функция КоличествоТранзакций() Экспорт
	Возврат _КоличествоТранзакций;
КонецФункции

// Возвращает опции последней выборки пачки.
//
// Возвращаемое значение:
//   ОпцииПоиска, Неопределено - Последние полученные опции.
Функция ПоследниеОпцииВыборки() Экспорт
	Возврат _ПоследниеОпцииВыборки;
КонецФункции

// Возвращает имя из отбора последней проверки или удаления.
//
// Возвращаемое значение:
//   Строка - Нормализованное имя пакета.
Функция ПоследнееПроверенноеИмя() Экспорт
	Возврат _ПоследнееПроверенноеИмя;
КонецФункции

#КонецОбласти
