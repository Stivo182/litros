Перем _Блокировка; // БлокировкаРесурса
Перем _КоличествоАктивных; // Число
Перем _МаксимумАктивных; // Число
Перем _ПерваяОперацияВошла; // Булево
Перем _ВтораяОперацияВошла; // Булево
Перем _ВтораяНачалаВызов; // Булево
Перем _РазрешеноВыйти; // Булево

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()

	_Блокировка = Новый БлокировкаРесурса(ЭтотОбъект);
	_КоличествоАктивных = 0;
	_МаксимумАктивных = 0;
	_ПерваяОперацияВошла = Ложь;
	_ВтораяОперацияВошла = Ложь;
	_ВтораяНачалаВызов = Ложь;
	_РазрешеноВыйти = Ложь;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

Функция ВыполнитьЧерез(Исполнитель, НомерОперации) Экспорт

	Если НомерОперации = 2 Тогда
		_Блокировка.Заблокировать();
		_ВтораяНачалаВызов = Истина;
		_Блокировка.Разблокировать();
	КонецЕсли;

	Возврат Исполнитель.ВыполнитьОперацию(Новый Действие(ЭтотОбъект, "УдерживатьСлот"), НомерОперации);

КонецФункции

Функция УдерживатьСлот(НомерОперации) Экспорт

	_Блокировка.Заблокировать();
	_КоличествоАктивных = _КоличествоАктивных + 1;
	_МаксимумАктивных = Макс(_МаксимумАктивных, _КоличествоАктивных);
	Если НомерОперации = 1 Тогда
		_ПерваяОперацияВошла = Истина;
	Иначе
		_ВтораяОперацияВошла = Истина;
	КонецЕсли;
	_Блокировка.Разблокировать();

	Пока НомерОперации = 1 И Не РазрешеноВыйти() Цикл
		Приостановить(5);
	КонецЦикла;

	_Блокировка.Заблокировать();
	_КоличествоАктивных = _КоличествоАктивных - 1;
	_Блокировка.Разблокировать();

	Возврат НомерОперации;

КонецФункции

Функция ПерваяОперацияВошла() Экспорт
	_Блокировка.Заблокировать();
	Результат = _ПерваяОперацияВошла;
	_Блокировка.Разблокировать();
	Возврат Результат;
КонецФункции

Функция ВтораяОперацияВошла() Экспорт
	_Блокировка.Заблокировать();
	Результат = _ВтораяОперацияВошла;
	_Блокировка.Разблокировать();
	Возврат Результат;
КонецФункции

Функция ВтораяНачалаВызов() Экспорт
	_Блокировка.Заблокировать();
	Результат = _ВтораяНачалаВызов;
	_Блокировка.Разблокировать();
	Возврат Результат;
КонецФункции

Функция МаксимумАктивных() Экспорт
	_Блокировка.Заблокировать();
	Результат = _МаксимумАктивных;
	_Блокировка.Разблокировать();
	Возврат Результат;
КонецФункции

Процедура РазрешитьВыход() Экспорт
	_Блокировка.Заблокировать();
	_РазрешеноВыйти = Истина;
	_Блокировка.Разблокировать();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазрешеноВыйти()
	_Блокировка.Заблокировать();
	Результат = _РазрешеноВыйти;
	_Блокировка.Разблокировать();
	Возврат Результат;
КонецФункции

#КонецОбласти
