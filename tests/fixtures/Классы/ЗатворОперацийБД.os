Перем _Блокировка; // БлокировкаРесурса
Перем _КоличествоАктивных; // Число
Перем _МаксимумАктивных; // Число
Перем _ПерваяОперацияВошла; // Булево
Перем _ВтораяОперацияВошла; // Булево
Перем _ВтораяНачалаВызов; // Булево
Перем _РазрешеноВыйти; // Булево

#Область ОбработчикиСобытий

// Создает управляемый затвор для параллельных операций базы данных.
Процедура ПриСозданииОбъекта()

	_Блокировка = Новый БлокировкаРесурса(ЭтотОбъект);
	_КоличествоАктивных = 0;
	_МаксимумАктивных = 0;
	_ПерваяОперацияВошла = Ложь;
	_ВтораяОперацияВошла = Ложь;
	_ВтораяНачалаВызов = Ложь;
	_РазрешеноВыйти = Ложь;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Запускает управляемую операцию через исполнитель.
//
// Параметры:
//   Исполнитель - ИсполнительОперацийБД - Проверяемый исполнитель.
//   НомерОперации - Число - Номер фоновой операции.
//
// Возвращаемое значение:
//   Число - Номер завершённой операции.
Функция ВыполнитьЧерез(Исполнитель, НомерОперации) Экспорт

	Если НомерОперации = 2 Тогда
		_Блокировка.Заблокировать();
		_ВтораяНачалаВызов = Истина;
		_Блокировка.Разблокировать();
	КонецЕсли;

	Возврат Исполнитель.ВыполнитьОперацию(Новый Действие(ЭтотОбъект, "УдерживатьСлот"), НомерОперации);

КонецФункции

// Удерживает слот первой операцией до разрешения выхода.
//
// Параметры:
//   НомерОперации - Число - Номер фоновой операции.
//
// Возвращаемое значение:
//   Число - Номер завершённой операции.
Функция УдерживатьСлот(НомерОперации) Экспорт

	_Блокировка.Заблокировать();
	_КоличествоАктивных = _КоличествоАктивных + 1;
	_МаксимумАктивных = Макс(_МаксимумАктивных, _КоличествоАктивных);
	Если НомерОперации = 1 Тогда
		_ПерваяОперацияВошла = Истина;
	Иначе
		_ВтораяОперацияВошла = Истина;
	КонецЕсли;
	_Блокировка.Разблокировать();

	ВыходРазрешен = НомерОперации <> 1;
	Для НомерОжидания = 1 По 600 Цикл
		Если ВыходРазрешен Или РазрешеноВыйти() Тогда
			ВыходРазрешен = Истина;
			Прервать;
		КонецЕсли;
		Приостановить(5);
	КонецЦикла;

	_Блокировка.Заблокировать();
	_КоличествоАктивных = _КоличествоАктивных - 1;
	_Блокировка.Разблокировать();
	Если Не ВыходРазрешен Тогда
		ВызватьИсключение "Превышено ожидание разрешения выхода из операции БД.";
	КонецЕсли;

	Возврат НомерОперации;

КонецФункции

// Возвращает признак входа первой операции.
//
// Возвращаемое значение:
//   Булево - Признак входа.
Функция ПерваяОперацияВошла() Экспорт
	_Блокировка.Заблокировать();
	Результат = _ПерваяОперацияВошла;
	_Блокировка.Разблокировать();
	Возврат Результат;
КонецФункции

// Возвращает признак входа второй операции.
//
// Возвращаемое значение:
//   Булево - Признак входа.
Функция ВтораяОперацияВошла() Экспорт
	_Блокировка.Заблокировать();
	Результат = _ВтораяОперацияВошла;
	_Блокировка.Разблокировать();
	Возврат Результат;
КонецФункции

// Возвращает признак начала второго вызова.
//
// Возвращаемое значение:
//   Булево - Признак начала вызова.
Функция ВтораяНачалаВызов() Экспорт
	_Блокировка.Заблокировать();
	Результат = _ВтораяНачалаВызов;
	_Блокировка.Разблокировать();
	Возврат Результат;
КонецФункции

// Возвращает максимальное число одновременно активных операций.
//
// Возвращаемое значение:
//   Число - Максимум активных операций.
Функция МаксимумАктивных() Экспорт
	_Блокировка.Заблокировать();
	Результат = _МаксимумАктивных;
	_Блокировка.Разблокировать();
	Возврат Результат;
КонецФункции

// Разрешает удерживаемой операции выйти.
Процедура РазрешитьВыход() Экспорт
	_Блокировка.Заблокировать();
	_РазрешеноВыйти = Истина;
	_Блокировка.Разблокировать();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазрешеноВыйти()
	_Блокировка.Заблокировать();
	Результат = _РазрешеноВыйти;
	_Блокировка.Разблокировать();
	Возврат Результат;
КонецФункции

#КонецОбласти
