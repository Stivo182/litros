Перем _Блокировка; // БлокировкаРесурса
Перем _РеальныйКлассификатор; // КлассификаторОшибокSQLite
Перем _ПерваяОшибкаКлассифицируется; // Булево
Перем _ВтораяОперацияВошла; // Булево
Перем _ВтораяВошлаДоРазрешенияПовтора; // Булево
Перем _КоличествоПопытокПервойОперации; // Число

#Область ОбработчикиСобытий

// Создает затвор для проверки порядка Retry и Bulkhead.
Процедура ПриСозданииОбъекта()

	_Блокировка = Новый БлокировкаРесурса(ЭтотОбъект);
	_РеальныйКлассификатор = Новый КлассификаторОшибокSQLite();
	_ПерваяОшибкаКлассифицируется = Ложь;
	_ВтораяОперацияВошла = Ложь;
	_ВтораяВошлаДоРазрешенияПовтора = Ложь;
	_КоличествоПопытокПервойОперации = 0;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Классифицирует ошибку и дает второй операции ограниченное время на вход.
//
// Параметры:
//   ДанныеОшибки - ИнформацияОбОшибке - Ошибка текущей попытки.
//
// Возвращаемое значение:
//   Булево - Реальная классификация ошибки SQLite.
Функция ЭтоВременнаяОшибка(ДанныеОшибки) Экспорт

	Результат = _РеальныйКлассификатор.ЭтоВременнаяОшибка(ДанныеОшибки);
	_Блокировка.Заблокировать();
	_ПерваяОшибкаКлассифицируется = Истина;
	_Блокировка.Разблокировать();

	Для НомерОжидания = 1 По 200 Цикл
		Если ВтораяОперацияВошла() Тогда
			Прервать;
		КонецЕсли;
		Приостановить(5);
	КонецЦикла;

	_Блокировка.Заблокировать();
	_ВтораяВошлаДоРазрешенияПовтора = _ВтораяОперацияВошла;
	_Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Запускает первую операцию через исполнитель.
//
// Параметры:
//   Исполнитель - ИсполнительОперацийБД - Проверяемый исполнитель.
//
// Возвращаемое значение:
//   Строка - Результат первой операции.
Функция ВыполнитьПервуюЧерез(Исполнитель) Экспорт
	Возврат Исполнитель.ВыполнитьОперацию(Новый Действие(ЭтотОбъект, "ВыполнитьПервую"));
КонецФункции

// Первая операция: первая попытка ошибочна, вторая успешна.
//
// Возвращаемое значение:
//   Строка - Успешный результат.
Функция ВыполнитьПервую() Экспорт
	_Блокировка.Заблокировать();
	_КоличествоПопытокПервойОперации = _КоличествоПопытокПервойОперации + 1;
	НомерПопытки = _КоличествоПопытокПервойОперации;
	_Блокировка.Разблокировать();
	Если НомерПопытки = 1 Тогда
		ВызватьИсключение "database is locked, первая попытка";
	КонецЕсли;
	Возврат "первая завершена";
КонецФункции

// Запускает вторую операцию через исполнитель.
//
// Параметры:
//   Исполнитель - ИсполнительОперацийБД - Проверяемый исполнитель.
//
// Возвращаемое значение:
//   Строка - Результат второй операции.
Функция ВыполнитьВторуюЧерез(Исполнитель) Экспорт
	Возврат Исполнитель.ВыполнитьОперацию(Новый Действие(ЭтотОбъект, "ВыполнитьВторую"));
КонецФункции

// Фиксирует вход второй операции.
//
// Возвращаемое значение:
//   Строка - Успешный результат.
Функция ВыполнитьВторую() Экспорт
	_Блокировка.Заблокировать();
	_ВтораяОперацияВошла = Истина;
	_Блокировка.Разблокировать();
	Возврат "вторая завершена";
КонецФункции

// Возвращает признак классификации первой ошибки.
//
// Возвращаемое значение:
//   Булево - Признак входа в классификатор.
Функция ПерваяОшибкаКлассифицируется() Экспорт
	_Блокировка.Заблокировать();
	Результат = _ПерваяОшибкаКлассифицируется;
	_Блокировка.Разблокировать();
	Возврат Результат;
КонецФункции

// Возвращает признак входа второй операции.
//
// Возвращаемое значение:
//   Булево - Признак входа.
Функция ВтораяОперацияВошла() Экспорт
	_Блокировка.Заблокировать();
	Результат = _ВтораяОперацияВошла;
	_Блокировка.Разблокировать();
	Возврат Результат;
КонецФункции

// Возвращает, вошла ли вторая операция до разрешения retry.
//
// Возвращаемое значение:
//   Булево - Снимок состояния перед retry.
Функция ВтораяВошлаДоРазрешенияПовтора() Экспорт
	_Блокировка.Заблокировать();
	Результат = _ВтораяВошлаДоРазрешенияПовтора;
	_Блокировка.Разблокировать();
	Возврат Результат;
КонецФункции

// Возвращает число попыток первой операции.
//
// Возвращаемое значение:
//   Число - Число попыток.
Функция КоличествоПопытокПервойОперации() Экспорт
	_Блокировка.Заблокировать();
	Результат = _КоличествоПопытокПервойОперации;
	_Блокировка.Разблокировать();
	Возврат Результат;
КонецФункции

#КонецОбласти
