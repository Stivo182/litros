#Использовать reflector

Перем _Блокировка; // БлокировкаРесурса
Перем _ВызовыНачаты; // Соответствие
Перем _ОперацииВошли; // Соответствие
Перем _АктивныеПоМенеджеру; // Соответствие
Перем _МаксимумПоМенеджеру; // Соответствие
Перем _АктивныеЧтения; // Число
Перем _АктивныеЗаписи; // Число
Перем _МаксимумЧтений; // Число
Перем _МаксимумЗаписей; // Число
Перем _МаксимумВсего; // Число
Перем _РазрешенВыход; // Булево
Перем _Удерживать; // Булево
Перем _НомерОшибочнойОперации; // Число

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()
	_Блокировка = Новый БлокировкаРесурса(ЭтотОбъект);
	_ВызовыНачаты = Новый Соответствие();
	_ОперацииВошли = Новый Соответствие();
	_АктивныеПоМенеджеру = Новый Соответствие();
	_МаксимумПоМенеджеру = Новый Соответствие();
	_АктивныеЧтения = 0;
	_АктивныеЗаписи = 0;
	_МаксимумЧтений = 0;
	_МаксимумЗаписей = 0;
	_МаксимумВсего = 0;
	_РазрешенВыход = Ложь;
	_Удерживать = Истина;
	_НомерОшибочнойОперации = 0;
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

Функция ВыполнитьЧерез(Пул, Роль, НомерОперации) Экспорт

	УстановитьФлаг(_ВызовыНачаты, НомерОперации);
	ПараметрыОперации = Новый Массив();
	ПараметрыОперации.Добавить(НомерОперации);
	ПараметрыОперации.Добавить(Роль);
	ПараметрыВызова = Новый Массив();
	ПараметрыВызова.Добавить(Роль);
	ПараметрыВызова.Добавить(Новый Действие(ЭтотОбъект, "УдерживатьСлот"));
	ПараметрыВызова.Добавить(ПараметрыОперации);
	Возврат Новый Рефлектор().ВызватьМетод(Пул, "ВыполнитьСоСлотом", ПараметрыВызова);

КонецФункции

Функция УдерживатьСлот(Менеджер, НомерОперации, Роль) Экспорт

	НомерМенеджера = Менеджер.Номер;
	_Блокировка.Заблокировать();
	УстановитьФлагБезБлокировки(_ОперацииВошли, НомерОперации);
	Активных = ПолучитьЧисло(_АктивныеПоМенеджеру, НомерМенеджера) + 1;
	_АктивныеПоМенеджеру.Вставить(НомерМенеджера, Активных);
	_МаксимумПоМенеджеру.Вставить(НомерМенеджера,
		Макс(ПолучитьЧисло(_МаксимумПоМенеджеру, НомерМенеджера), Активных));
	Если Роль = "Чтение" Тогда
		_АктивныеЧтения = _АктивныеЧтения + 1;
		_МаксимумЧтений = Макс(_МаксимумЧтений, _АктивныеЧтения);
	Иначе
		_АктивныеЗаписи = _АктивныеЗаписи + 1;
		_МаксимумЗаписей = Макс(_МаксимумЗаписей, _АктивныеЗаписи);
	КонецЕсли;
	_МаксимумВсего = Макс(_МаксимумВсего, _АктивныеЧтения + _АктивныеЗаписи);
	НужноУдерживать = _Удерживать;
	ОшибкаОперации = НомерОперации = _НомерОшибочнойОперации;
	_Блокировка.Разблокировать();

	Если НужноУдерживать И Не ОшибкаОперации Тогда
		Для НомерОжидания = 1 По 600 Цикл
			Если РазрешенВыход() Тогда
				Прервать;
			КонецЕсли;
			Приостановить(5);
		КонецЦикла;
	КонецЕсли;

	_Блокировка.Заблокировать();
	_АктивныеПоМенеджеру.Вставить(
		НомерМенеджера, ПолучитьЧисло(_АктивныеПоМенеджеру, НомерМенеджера) - 1);
	Если Роль = "Чтение" Тогда
		_АктивныеЧтения = _АктивныеЧтения - 1;
	Иначе
		_АктивныеЗаписи = _АктивныеЗаписи - 1;
	КонецЕсли;
	_Блокировка.Разблокировать();

	Если ОшибкаОперации Тогда
		ВызватьИсключение СтрШаблон("ошибка операции %1", НомерОперации);
	КонецЕсли;
	Возврат НомерМенеджера;

КонецФункции

Процедура НеУдерживать() Экспорт
	_Блокировка.Заблокировать();
	_Удерживать = Ложь;
	_Блокировка.Разблокировать();
КонецПроцедуры

Процедура НастроитьОшибку(НомерОперации) Экспорт
	_Блокировка.Заблокировать();
	_НомерОшибочнойОперации = НомерОперации;
	_Блокировка.Разблокировать();
КонецПроцедуры

Процедура РазрешитьВыход() Экспорт
	_Блокировка.Заблокировать();
	_РазрешенВыход = Истина;
	_Блокировка.Разблокировать();
КонецПроцедуры

Функция ВызовНачат(НомерОперации) Экспорт
	Возврат ПолучитьФлаг(_ВызовыНачаты, НомерОперации);
КонецФункции

Функция ОперацияВошла(НомерОперации) Экспорт
	Возврат ПолучитьФлаг(_ОперацииВошли, НомерОперации);
КонецФункции

Функция МаксимумМенеджера(НомерМенеджера) Экспорт
	_Блокировка.Заблокировать();
	Результат = ПолучитьЧисло(_МаксимумПоМенеджеру, НомерМенеджера);
	_Блокировка.Разблокировать();
	Возврат Результат;
КонецФункции

Функция МаксимумЧтений() Экспорт
	_Блокировка.Заблокировать();
	Результат = _МаксимумЧтений;
	_Блокировка.Разблокировать();
	Возврат Результат;
КонецФункции

Функция МаксимумЗаписей() Экспорт
	_Блокировка.Заблокировать();
	Результат = _МаксимумЗаписей;
	_Блокировка.Разблокировать();
	Возврат Результат;
КонецФункции

Функция МаксимумВсего() Экспорт
	_Блокировка.Заблокировать();
	Результат = _МаксимумВсего;
	_Блокировка.Разблокировать();
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьФлаг(СоответствиеФлагов, Ключ)
	_Блокировка.Заблокировать();
	УстановитьФлагБезБлокировки(СоответствиеФлагов, Ключ);
	_Блокировка.Разблокировать();
КонецПроцедуры

Процедура УстановитьФлагБезБлокировки(СоответствиеФлагов, Ключ)
	СоответствиеФлагов.Вставить(Ключ, Истина);
КонецПроцедуры

Функция ПолучитьФлаг(СоответствиеФлагов, Ключ)
	_Блокировка.Заблокировать();
	Результат = СоответствиеФлагов.Получить(Ключ) = Истина;
	_Блокировка.Разблокировать();
	Возврат Результат;
КонецФункции

Функция ПолучитьЧисло(СоответствиеЧисел, Ключ)
	Результат = СоответствиеЧисел.Получить(Ключ);
	Возврат ?(Результат = Неопределено, 0, Результат);
КонецФункции

Функция РазрешенВыход()
	_Блокировка.Заблокировать();
	Результат = _РазрешенВыход;
	_Блокировка.Разблокировать();
	Возврат Результат;
КонецФункции

#КонецОбласти
