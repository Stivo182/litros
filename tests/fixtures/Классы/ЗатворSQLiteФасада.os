#Использовать "../../../src/dto"

Перем _КоличествоПопыток; // Число
Перем _Блокировка; // БлокировкаРесурса
Перем _ОперацияНачалась; // Булево

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()

	_КоличествоПопыток = 0;
	_Блокировка = Новый БлокировкаРесурса(ЭтотОбъект);
	_ОперацияНачалась = Ложь;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Сохраняет сущность через фасад из фонового задания.
//
// Параметры:
//   Фасад - УстойчивыйМенеджерСущностей - Фасад доступа к базе данных.
//   Сущность - СущностьОчередьПакета - Сохраняемая сущность.
//
// Возвращаемое значение:
//   Булево - Истина после успешного сохранения.
Функция СохранитьЧерезФасад(Фасад, Сущность) Экспорт

	_Блокировка.Заблокировать();
	_ОперацияНачалась = Истина;
	_Блокировка.Разблокировать();
	Фасад.Сохранить(Сущность);
	Возврат Истина;

КонецФункции

// Возвращает признак входа фонового задания в операцию фасада.
//
// Возвращаемое значение:
//   Булево - Истина, если фоновая операция началась.
Функция ОперацияНачалась() Экспорт

	_Блокировка.Заблокировать();
	Результат = _ОперацияНачалась;
	_Блокировка.Разблокировать();
	Возврат Результат;

КонецФункции

// Сохраняет два пакета и имитирует временную ошибку после первой записи первой попытки.
//
// Параметры:
//   ЕдиницаРаботы - ЕдиницаРаботыБД - Единица работы текущей попытки транзакции.
//
// Возвращаемое значение:
//   Число - Номер успешной попытки.
Функция СохранитьДваПакетаСПервойВременнойОшибкой(ЕдиницаРаботы) Экспорт

	_КоличествоПопыток = _КоличествоПопыток + 1;
	Первый = Новый СущностьОчередьПакета();
	Первый.ИмяПакета = "transaction-first";
	Первый.ДатаДобавления = ТекущаяУниверсальнаяДата();
	ЕдиницаРаботы.Сохранить(Первый);
	Если _КоличествоПопыток = 1 Тогда
		ВызватьИсключение "database is locked после первой записи";
	КонецЕсли;
	Второй = Новый СущностьОчередьПакета();
	Второй.ИмяПакета = "transaction-second";
	Второй.ДатаДобавления = ТекущаяУниверсальнаяДата();
	ЕдиницаРаботы.Сохранить(Второй);
	Возврат _КоличествоПопыток;

КонецФункции

// Сохраняет пакет и завершает callback программной ошибкой.
//
// Параметры:
//   ЕдиницаРаботы - ЕдиницаРаботыБД - Единица работы текущей попытки транзакции.
Функция СохранитьИЗавершитьПрограммнойОшибкой(ЕдиницаРаботы) Экспорт

	Сущность = Новый СущностьОчередьПакета();
	Сущность.ИмяПакета = "program-error";
	Сущность.ДатаДобавления = ТекущаяУниверсальнаяДата();
	ЕдиницаРаботы.Сохранить(Сущность);
	ВызватьИсключение "программная ошибка после записи";

КонецФункции

// Возвращает число попыток многошаговой транзакции.
//
// Возвращаемое значение:
//   Число - Число выполненных callback.
Функция КоличествоПопыток() Экспорт

	Возврат _КоличествоПопыток;

КонецФункции

#КонецОбласти
