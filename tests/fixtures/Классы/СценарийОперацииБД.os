Перем _КоличествоВызовов; // Число
Перем _КоличествоОшибокДоУспеха; // Число
Перем _ОписаниеОшибки; // Строка
Перем _Результат; // Произвольный
Перем _ПоследниеПараметры; // Произвольный

#Область ОбработчикиСобытий

Процедура ПриСозданииОбъекта()

	_КоличествоВызовов = 0;
	_КоличествоОшибокДоУспеха = 0;
	_ОписаниеОшибки = "";
	_Результат = Неопределено;
	_ПоследниеПараметры = Неопределено;

КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

Процедура Настроить(КоличествоОшибокДоУспеха, ОписаниеОшибки, Результат) Экспорт

	_КоличествоОшибокДоУспеха = КоличествоОшибокДоУспеха;
	_ОписаниеОшибки = ОписаниеОшибки;
	_Результат = Результат;

КонецПроцедуры

Функция ВыполнитьСценарий(Параметры = Неопределено) Экспорт

	_КоличествоВызовов = _КоличествоВызовов + 1;
	_ПоследниеПараметры = Параметры;

	Если _КоличествоВызовов <= _КоличествоОшибокДоУспеха Тогда
		ВызватьИсключение СтрШаблон("%1, попытка %2", _ОписаниеОшибки, _КоличествоВызовов);
	КонецЕсли;

	Возврат _Результат;

КонецФункции

Функция КоличествоВызовов() Экспорт

	Возврат _КоличествоВызовов;

КонецФункции

Функция ПоследниеПараметры() Экспорт

	Возврат _ПоследниеПараметры;

КонецФункции

#КонецОбласти
