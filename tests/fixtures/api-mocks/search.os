#Использовать jason
#Использовать asserts

Перем _МаксимальноеКоличествоВыдачи; // Число
Перем _ДиапазонРазмераФайла; // Число
Перем _СериализаторJson; // СериализаторJson
Перем _ОстатокЛимитаЗапросов; // Число
Перем _УстановленЛимит; // Булево
Перем _РежимОтвета; // Строка
Перем _КоличествоЗапросовВРежиме; // Число
Перем _МоментыЗапросовВРежиме; // Массив

&Контроллер("/search")
Процедура ПриСозданииОбъекта()
	_МаксимальноеКоличествоВыдачи = 1000;
	_ДиапазонРазмераФайла = 20000;
	_СериализаторJson = Новый СериализаторJson();
	_ОстатокЛимитаЗапросов = 0;
	_УстановленЛимит = Ложь;
	_РежимОтвета = "success";
	_КоличествоЗапросовВРежиме = 0;
	_МоментыЗапросовВРежиме = Новый Массив();
КонецПроцедуры

&ТочкаМаршрута("mode/{Режим}")
Процедура УстановитьРежимОтвета(Ответ, Режим) Экспорт

	_РежимОтвета = Режим;
	_КоличествоЗапросовВРежиме = 0;
	_МоментыЗапросовВРежиме.Очистить();
	Ответ.УстановитьСостояниеОК();

КонецПроцедуры

&ТочкаМаршрута("stats")
Процедура ПолучитьСтатистикуОтветов(Ответ) Экспорт

	Статистика = Новый Структура(
		"КоличествоЗапросов, МоментыЗапросов",
		_КоличествоЗапросовВРежиме,
		_МоментыЗапросовВРежиме
	);

	Ответ.УстановитьТипКонтента("json");
	Ответ.УстановитьСостояниеОК();
	Ответ.ТелоТекст = _СериализаторJson.Сериализовать(Статистика);

КонецПроцедуры

&ТочкаМаршрута("limits/{Лимит}")
Процедура УстановкаЛимита(Ответ, Лимит) Экспорт

	Ответ.УстановитьСостояниеОК();

	Если Лимит = "disable" Тогда
		_УстановленЛимит = Ложь;
	Иначе
		_ОстатокЛимитаЗапросов = Число(Лимит);
		_УстановленЛимит = Истина;
	КонецЕсли;

КонецПроцедуры

&ТочкаМаршрута("code")
Процедура ПоискаКода(Ответ, ПараметрыЗапросаИменные) Экспорт

	_КоличествоЗапросовВРежиме = _КоличествоЗапросовВРежиме + 1;
	_МоментыЗапросовВРежиме.Добавить(ТекущаяУниверсальнаяДатаВМиллисекундах());

	НастройкиТеста = ОпределитьНастройкиТеста(ПараметрыЗапросаИменные);
	ПараметрыСтраницы = ОпределитьПараметрыСтраницы(ПараметрыЗапросаИменные);

	СгенерироватьОтвет(
		Ответ,
		НастройкиТеста,
		ПараметрыСтраницы.МаксимальноеКоличествоНаСтранице,
		ПараметрыСтраницы.НомерСтраницы);

КонецПроцедуры

Процедура СгенерироватьОтвет(Ответ, НастройкиТеста, МаксимальноеКоличествоНаСтранице, НомерСтраницы)

	ПоказателиВыдачи = ОпределитьПоказателиВыдачи(НастройкиТеста, МаксимальноеКоличествоНаСтранице);

	Ответ.УстановитьТипКонтента("json");
	Ответ.УстановитьСостояниеОК();

	Если ПоказателиВыдачи.КоличествоСтраниц > НомерСтраницы Тогда
		Ответ.Заголовки.Вставить("Link", "<link rel=""next"" href=""/"" />");
	КонецЕсли;

	Результат = СоздатьРезультат(ПоказателиВыдачи.КоличествоЭлементов);

	Если ОбработатьРежимОтвета(Ответ, Результат) Тогда
		Возврат;
	КонецЕсли;

	Если ОбработатьОграничениеЛимита(Ответ, Результат) Тогда
		Возврат;
	КонецЕсли;

	Если ОбработатьОграничениеВыдачи(
		Ответ,
		Результат,
		ПоказателиВыдачи.КоличествоЭлементов,
		МаксимальноеКоличествоНаСтранице,
		НомерСтраницы) Тогда
		Возврат;
	КонецЕсли;
	
	Если ПоказателиВыдачи.КоличествоСтраниц < НомерСтраницы Тогда
		Ответ.ТелоТекст = _СериализаторJson.Сериализовать(Результат);
		Возврат;
	КонецЕсли;

	ЗаполнитьЭлементыРезультата(
		Результат,
		НастройкиТеста,
		ПоказателиВыдачи.КоличествоЭлементов,
		ПоказателиВыдачи.КоличествоРепозиториев,
		МаксимальноеКоличествоНаСтранице,
		НомерСтраницы);

	Ответ.ТелоТекст = _СериализаторJson.Сериализовать(Результат);

КонецПроцедуры

Функция ОпределитьПараметрыСтраницы(ПараметрыЗапросаИменные)

	Возврат Новый Структура(
		"МаксимальноеКоличествоНаСтранице, НомерСтраницы",
		ОпределитьЧисловойПараметр(ПараметрыЗапросаИменные, "per_page", 10),
		ОпределитьЧисловойПараметр(ПараметрыЗапросаИменные, "page", 1));

КонецФункции

Функция ОпределитьЧисловойПараметр(ПараметрыЗапросаИменные, ИмяПараметра, ЗначениеПоУмолчанию)

	ЗначениеПараметра = ПараметрыЗапросаИменные[ИмяПараметра];
	Если ЗначениеЗаполнено(ЗначениеПараметра) Тогда
		Возврат Число(ЗначениеПараметра);
	КонецЕсли;

	Возврат ЗначениеПоУмолчанию;

КонецФункции

Функция ОпределитьПоказателиВыдачи(НастройкиТеста, МаксимальноеКоличествоНаСтранице)

	ПроверитьДиапазонРазмераФайла(НастройкиТеста);

	КоэффициентЭлементов = ОпределитьКоэффициентЭлементов(НастройкиТеста);
	КоличествоЭлементов = Окр(НастройкиТеста["КоличествоЭлементов"] * КоэффициентЭлементов, 0);
	КоличествоОснонвыхРепозиториев = НастройкиТеста["КоличествоОснонвыхРепозиториев"];
	КоличествоФорков = НастройкиТеста["КоличествоФорков"];
	КоличествоРепозиториев = ?(НастройкиТеста.ТолькоФорки, КоличествоФорков, КоличествоОснонвыхРепозиториев);
	КоличествоСтраниц = Макс(КоличествоЭлементов / МаксимальноеКоличествоНаСтранице, 1);
	КоличествоСтраниц = ?(Цел(КоличествоСтраниц) <> КоличествоСтраниц, Цел(КоличествоСтраниц) + 1, КоличествоСтраниц);

	Возврат Новый Структура(
		"КоличествоЭлементов, КоличествоРепозиториев, КоличествоСтраниц",
		КоличествоЭлементов,
		КоличествоРепозиториев,
		КоличествоСтраниц);

КонецФункции

Процедура ПроверитьДиапазонРазмераФайла(НастройкиТеста)

	Если НастройкиТеста.МинимальныйРазмерФайла = 0
		И НастройкиТеста.МаксимальныйРазмерФайла = 0 Тогда
		Возврат;
	КонецЕсли;

	Разница = НастройкиТеста.МаксимальныйРазмерФайла - НастройкиТеста.МинимальныйРазмерФайла;
	Ожидаем.Что(Разница, "Неверный диапазон файлов").Равно(_ДиапазонРазмераФайла);

КонецПроцедуры

Функция ОпределитьКоэффициентЭлементов(НастройкиТеста)

	КоличествоДиапазонов = 5;
	НомерДиапазонаРазмераФайла = Цел(НастройкиТеста["МаксимальныйРазмерФайла"] / _ДиапазонРазмераФайла);

	Если НомерДиапазонаРазмераФайла = 0 Тогда
		Возврат 1;
	ИначеЕсли НомерДиапазонаРазмераФайла > КоличествоДиапазонов Тогда
		Возврат 0;
	КонецЕсли;

	Возврат 1 / КоличествоДиапазонов;

КонецФункции

Функция СоздатьРезультат(КоличествоЭлементов)

	Результат = Новый Структура();
	Результат.Вставить("items", Новый Массив());
	Результат.Вставить("message", "");
	Результат.Вставить("total_count", КоличествоЭлементов);
	Результат.Вставить("incomplete_results", Ложь);

	Возврат Результат;

КонецФункции

Функция ОбработатьОграничениеЛимита(Ответ, Результат)

	Если Не _УстановленЛимит Тогда
		Возврат Ложь;
	КонецЕсли;

	Если _ОстатокЛимитаЗапросов = 0 Тогда
		Результат["message"] = "API rate limit exceeded";
		Ответ.УстановитьСостояние(403);
		Ответ.Заголовки.Вставить("X-RateLimit-Remaining", "0");
		Ответ.ТелоТекст = _СериализаторJson.Сериализовать(Результат);
		Возврат Истина;
	КонецЕсли;

	_ОстатокЛимитаЗапросов = Макс(_ОстатокЛимитаЗапросов - 1, 0);
	Ответ.Заголовки.Вставить("X-RateLimit-Remaining", Формат(_ОстатокЛимитаЗапросов, "ЧН=0; ЧГ="));

	Возврат Ложь;

КонецФункции

Функция ОбработатьРежимОтвета(Ответ, Результат)

	Если _РежимОтвета = "temporary-error-always"
		Или _РежимОтвета = "temporary-error-once" И _КоличествоЗапросовВРежиме = 1 Тогда

		Результат["message"] = "Service temporarily unavailable";
		Ответ.УстановитьСостояние(503);
		Ответ.ТелоТекст = _СериализаторJson.Сериализовать(Результат);

		Возврат Истина;
	КонецЕсли;

	Если _РежимОтвета = "remaining-one" Тогда
		ДатаСброса = Цел(ТекущаяУниверсальнаяДата() - Дата(1970, 1, 1) + 2);
		Ответ.Заголовки.Вставить("X-RateLimit-Remaining", "1");
		Ответ.Заголовки.Вставить("X-RateLimit-Reset", Формат(ДатаСброса, "ЧН=0; ЧГ="));
		Возврат Ложь;
	КонецЕсли;

	Если _РежимОтвета = "exhausted" Тогда
		ДатаСброса = Цел(ТекущаяУниверсальнаяДата() - Дата(1970, 1, 1) + 2);
		Ответ.Заголовки.Вставить("X-RateLimit-Remaining", "0");
		Ответ.Заголовки.Вставить("X-RateLimit-Reset", Формат(ДатаСброса, "ЧН=0; ЧГ="));
		Возврат Ложь;
	КонецЕсли;

	Если _РежимОтвета <> "long-retry-after" Тогда
		Возврат Ложь;
	КонецЕсли;

	Результат["message"] = "You have exceeded a secondary rate limit";
	Ответ.УстановитьСостояние(403);
	Ответ.Заголовки.Вставить("Retry-After", "2");
	Ответ.ТелоТекст = _СериализаторJson.Сериализовать(Результат);

	Возврат Истина;

КонецФункции

Функция ОбработатьОграничениеВыдачи(Ответ, Результат, КоличествоЭлементов, МаксимальноеКоличествоНаСтранице, НомерСтраницы)

	Если КоличествоЭлементов <= _МаксимальноеКоличествоВыдачи
		Или НомерСтраницы * МаксимальноеКоличествоНаСтранице <= _МаксимальноеКоличествоВыдачи Тогда
		Возврат Ложь;
	КонецЕсли;

	Результат["message"] = СтрШаблон(
		"Cannot access beyond the first %1 results",
		Формат(_МаксимальноеКоличествоВыдачи, "ЧГ="));
	Ответ.ТелоТекст = _СериализаторJson.Сериализовать(Результат);
	Ответ.УстановитьСостояние(422);

	Возврат Истина;

КонецФункции

Процедура ЗаполнитьЭлементыРезультата(Результат, НастройкиТеста, КоличествоЭлементов, КоличествоРепозиториев, МаксимальноеКоличествоНаСтранице, НомерСтраницы)

	Для Индекс = 1 По МаксимальноеКоличествоНаСтранице Цикл

		НомерЭлемента = МаксимальноеКоличествоНаСтранице * (НомерСтраницы - 1) + Индекс;
		Если НомерЭлемента > КоличествоЭлементов Тогда
			Прервать;
		КонецЕсли;

		Результат["items"].Добавить(СоздатьЭлементВыдачи(НастройкиТеста, НомерЭлемента, КоличествоРепозиториев));

	КонецЦикла;

КонецПроцедуры

Функция СоздатьЭлементВыдачи(НастройкиТеста, НомерЭлемента, КоличествоРепозиториев)

	ЭтоНерелевантнаяВыдача = КоличествоРепозиториев = 0;
	ИмяРепозитория = ОпределитьИмяРепозитория(НастройкиТеста, НомерЭлемента, КоличествоРепозиториев, ЭтоНерелевантнаяВыдача);
	ПолноеИмя = "user/" + ИмяРепозитория;
	Фрагмент = "#Использовать " + НастройкиТеста.ИмяПакета;

	Если ЭтоНерелевантнаяВыдача Тогда
		Фрагмент = Фрагмент + "fake";
	КонецЕсли;

	Элемент = Новый Структура();
	Элемент.Вставить("text_matches", Новый Массив());
	Элемент["text_matches"].Добавить(Новый Структура("fragment", Фрагмент));
	Элемент.Вставить("repository", Новый Соответствие());
	Элемент["repository"]["html_url"] = "https://github.com/" + ПолноеИмя;
	Элемент["repository"]["private"] = Ложь;
	Элемент["repository"]["full_name"] = ПолноеИмя;
	Элемент["repository"]["owner"] = Новый Структура("login", "user");
	Элемент["repository"]["fork"] = НастройкиТеста.ТолькоФорки;

	Возврат Элемент;

КонецФункции

Функция ОпределитьИмяРепозитория(НастройкиТеста, НомерЭлемента, КоличествоРепозиториев, ЭтоНерелевантнаяВыдача)

	Если ЭтоНерелевантнаяВыдача Тогда
		Возврат "fake";
	КонецЕсли;

	НомерРепозитория = (НомерЭлемента - 1) % КоличествоРепозиториев + 1;
	ПрефиксРепозитория = ?(НастройкиТеста.ТолькоФорки, "fork", "repo");

	Возврат ПрефиксРепозитория + НомерРепозитория;

КонецФункции

Функция ОпределитьНастройкиТеста(ПараметрыЗапросаИменные)

	НастройкиТеста = Новый Структура();
	НастройкиТеста.Вставить("ИмяПакета", "");
	НастройкиТеста.Вставить("ТолькоФорки", Ложь);
	НастройкиТеста.Вставить("КоличествоЭлементов", 0);
	НастройкиТеста.Вставить("КоличествоОснонвыхРепозиториев", 0);
	НастройкиТеста.Вставить("КоличествоФорков", 0);
	НастройкиТеста.Вставить("МинимальныйРазмерФайла", 0);
	НастройкиТеста.Вставить("МаксимальныйРазмерФайла", 0);

	РегулярноеВыражение = Новый РегулярноеВыражение("""#Использовать\s+([a-zA-Z_][a-zA-Z0-9_]*)""(?:.*?\b(fork:only)\b)?(?:.*?\b(size:\d+\.\.\d+)\b)?");
	Совпадения = РегулярноеВыражение.НайтиСовпадения(ПараметрыЗапросаИменные["q"]);

	Если Совпадения.Количество() = 0 Тогда
		Возврат НастройкиТеста;
	КонецЕсли;

	Совпадение = Совпадения[0];

	// Имя пакета
	ИмяПакета = Совпадение.Группы[1].Значение;
	НастройкиТеста.ИмяПакета = ИмяПакета;
	Части = СтрРазделить(ИмяПакета, "_");

	Параметры = Новый Соответствие();
	Для к = 1 По Части.Количество() / 2 Цикл
		Параметры[НРег(Части[к * 2 - 2])] = Части[к * 2 - 1];
	КонецЦикла;

	НастройкиТеста.КоличествоЭлементов = Число(Параметры["totalcount"]);
	НастройкиТеста.КоличествоОснонвыхРепозиториев = Число(Параметры["repocount"]);
	НастройкиТеста.КоличествоФорков = Число(Параметры["forkcount"]);

	// Только форки
	ТолькоФоркиТекст = Совпадение.Группы[2].Значение;
	Если ЗначениеЗаполнено(ТолькоФоркиТекст) Тогда
		НастройкиТеста.ТолькоФорки = Истина;
	КонецЕсли;

	// Размер файла
	РазмерТекст = Совпадение.Группы[3].Значение;
	Если ЗначениеЗаполнено(РазмерТекст) Тогда
		ПозицияРазделения = СтрНайти(РазмерТекст, "..") ;
		РазмерФайла = Число(Сред(РазмерТекст, 6, ПозицияРазделения - 6));
		НастройкиТеста.МинимальныйРазмерФайла = РазмерФайла;
		РазмерФайла = Число(Сред(РазмерТекст, ПозицияРазделения + 2));
		НастройкиТеста.МаксимальныйРазмерФайла = РазмерФайла;
	КонецЕсли;

	Возврат НастройкиТеста;
	
КонецФункции
