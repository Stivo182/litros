#Использовать jason

Перем _СериализаторJson; // СериализаторJson
Перем _РежимОтвета; // Строка
Перем _КоличествоЗапросовВРежиме; // Число

&Контроллер("/")
Процедура ПриСозданииОбъекта()
	_СериализаторJson = Новый СериализаторJson();
	_РежимОтвета = "success";
	_КоличествоЗапросовВРежиме = 0;
КонецПроцедуры

&ТочкаМаршрута("graphql/mode/{Режим}")
Процедура УстановитьРежимОтвета(Ответ, Режим) Экспорт

	_РежимОтвета = Режим;
	_КоличествоЗапросовВРежиме = 0;
	Ответ.УстановитьСостояниеОК();

КонецПроцедуры

&ТочкаМаршрута("graphql/stats")
Процедура ПолучитьСтатистикуОтветов(Ответ) Экспорт

	Статистика = Новый Структура("КоличествоЗапросов", _КоличествоЗапросовВРежиме);

	Ответ.УстановитьТипКонтента("json");
	Ответ.УстановитьСостояниеОК();
	Ответ.ТелоТекст = _СериализаторJson.Сериализовать(Статистика);

КонецПроцедуры

&ТочкаМаршрута("graphql")
Процедура GraphQL(Запрос, ДанныеФормы, Ответ) Экспорт

	_КоличествоЗапросовВРежиме = _КоличествоЗапросовВРежиме + 1;

	ТелоЗапроса = Запрос.ТелоЗапросаОбъект(Тип("Соответствие"));
	Идентификаторы = Новый Массив();

	Если ТелоЗапроса <> Неопределено Тогда
		ТекстЗапроса = ТелоЗапроса["query"];
		Переменные = ТелоЗапроса["variables"];
		Если Переменные <> Неопределено Тогда
			ЗначениеИдентификаторов = Переменные["ids"];
			Если ЗначениеИдентификаторов <> Неопределено Тогда
				Идентификаторы = ЗначениеИдентификаторов;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если _РежимОтвета = "circuit-window"
		И СтрНайти(ТекстЗапроса, "TemporaryFailure") > 0 Тогда

		Результат = Новый Структура("message", "Service temporarily unavailable");

		Ответ.УстановитьТипКонтента("json");
		Ответ.УстановитьСостояние(503);
		Ответ.ТелоТекст = _СериализаторJson.Сериализовать(Результат);

		Возврат;
	КонецЕсли;

	Если _РежимОтвета = "rate-limit" Тогда
		Ошибки = Новый Массив();
		Ошибки.Добавить(Новый Структура("message", "API rate limit exceeded"));

		Результат = Новый Структура("errors", Ошибки);

		Ответ.УстановитьТипКонтента("json");
		Ответ.УстановитьСостояниеОК();
		Ответ.ТелоТекст = _СериализаторJson.Сериализовать(Результат);

		Возврат;
	КонецЕсли;

	Если _РежимОтвета = "temporary-then-malformed"
		И _КоличествоЗапросовВРежиме = 1 Тогда

		Результат = Новый Структура("message", "Service temporarily unavailable");

		Ответ.УстановитьТипКонтента("json");
		Ответ.УстановитьСостояние(503);
		Ответ.ТелоТекст = _СериализаторJson.Сериализовать(Результат);

		Возврат;
	КонецЕсли;

	Если _РежимОтвета = "temporary-remaining-one-once"
		И _КоличествоЗапросовВРежиме = 1 Тогда

		ДатаСброса = Цел(ТекущаяУниверсальнаяДата() - Дата(1970, 1, 1) + 2);
		Результат = Новый Структура("message", "Service temporarily unavailable");

		Ответ.УстановитьТипКонтента("json");
		Ответ.УстановитьСостояние(503);
		Ответ.Заголовки.Вставить("X-RateLimit-Remaining", "1");
		Ответ.Заголовки.Вставить("X-RateLimit-Reset", Формат(ДатаСброса, "ЧН=0; ЧГ="));
		Ответ.ТелоТекст = _СериализаторJson.Сериализовать(Результат);

		Возврат;
	КонецЕсли;

	Если _РежимОтвета = "secondary-retry-after-once"
		И _КоличествоЗапросовВРежиме = 1 Тогда

		Результат = Новый Структура("message", "You have exceeded a secondary rate limit");

		Ответ.УстановитьТипКонтента("json");
		Ответ.УстановитьСостояние(429);
		Ответ.Заголовки.Вставить("Retry-After", "0.08");
		Ответ.ТелоТекст = _СериализаторJson.Сериализовать(Результат);

		Возврат;
	КонецЕсли;

	Если _РежимОтвета = "temporary-then-malformed"
		Или _РежимОтвета = "malformed-three-times"
			И _КоличествоЗапросовВРежиме <= 3 Тогда

		Ошибки = Новый Массив();
		Ошибки.Добавить(42);
		Результат = Новый Структура("errors", Ошибки);

		Ответ.УстановитьТипКонтента("json");
		Ответ.УстановитьСостояниеОК();
		Ответ.ТелоТекст = _СериализаторJson.Сериализовать(Результат);

		Возврат;
	КонецЕсли;

	Если _РежимОтвета = "secondary-rate-limit-once"
		И _КоличествоЗапросовВРежиме = 1 Тогда

		Результат = Новый Структура("message", "You have exceeded a secondary rate limit");

		Ответ.УстановитьТипКонтента("json");
		Ответ.УстановитьСостояние(403);
		Ответ.ТелоТекст = _СериализаторJson.Сериализовать(Результат);

		Возврат;
	КонецЕсли;

	Если _РежимОтвета = "secondary-graphql-rate-limit-once"
		И _КоличествоЗапросовВРежиме = 1 Тогда

		Ошибки = Новый Массив();
		Ошибки.Добавить(Новый Структура("message", "You have exceeded a secondary rate limit"));
		Результат = Новый Структура("errors", Ошибки);

		Ответ.УстановитьТипКонтента("json");
		Ответ.УстановитьСостояниеОК();
		Ответ.ТелоТекст = _СериализаторJson.Сериализовать(Результат);

		Возврат;
	КонецЕсли;

	Узлы = Новый Массив();
	Счетчик = 0;

	Для Каждого Идентификатор Из Идентификаторы Цикл
		Счетчик = Счетчик + 1;

		Узел = Новый Соответствие();
		Узел["id"] = Идентификатор;
		Узел["name"] = СтрШаблон("repo-%1", Счетчик);
		Узел["description"] = СтрШаблон("description-%1", Счетчик);
		Узел["url"] = СтрШаблон("https://github.com/user/repo-%1", Счетчик);
		Узел["isFork"] = Ложь;
		Узел["stargazerCount"] = 10 * Счетчик;
		Узел["forkCount"] = Счетчик;
		Узел["owner"] = Новый Структура("login", "user");
		Узлы.Добавить(Узел);
	КонецЦикла;

	Результат = Новый Структура("data", Новый Структура("nodes", Узлы));

	Ответ.УстановитьТипКонтента("json");
	Ответ.УстановитьСостояниеОК();

	Если _РежимОтвета = "success-remaining-zero" Тогда
		ДатаСброса = Цел(ТекущаяУниверсальнаяДата() - Дата(1970, 1, 1) + 2);
		Ответ.Заголовки.Вставить("X-RateLimit-Remaining", "0");
		Ответ.Заголовки.Вставить("X-RateLimit-Reset", Формат(ДатаСброса, "ЧН=0; ЧГ="));
	КонецЕсли;

	Ответ.ТелоТекст = _СериализаторJson.Сериализовать(Результат);

КонецПроцедуры
