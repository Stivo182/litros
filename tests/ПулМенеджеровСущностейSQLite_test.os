#Использовать asserts
#Использовать autumn
#Использовать entity
#Использовать reflector
#Использовать tempfiles
#Использовать "../src/internal"
#Использовать "../src/db"
#Использовать "../src/dto"
#Использовать "fixtures"

Перем _Пулы; // Массив
Перем _Коннекторы; // Массив
Перем _КоннекторыСТранзакцией; // Массив
Перем _ФоновыеЗадачи; // Массив
Перем _Затворы; // Массив
Перем _МенеджерВременныхФайлов; // МенеджерВременныхФайлов

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

&ПередКаждым
Процедура ПередКаждым() Экспорт

	_Пулы = Новый Массив();
	_Коннекторы = Новый Массив();
	_КоннекторыСТранзакцией = Новый Массив();
	_ФоновыеЗадачи = Новый Массив();
	_Затворы = Новый Массив();
	_МенеджерВременныхФайлов = Новый МенеджерВременныхФайлов();
	_МенеджерВременныхФайлов.БазовыйКаталог = _МенеджерВременныхФайлов.СоздатьКаталог();

КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт

	Для Каждого Затвор Из _Затворы Цикл
		Затвор.РазрешитьВыход();
	КонецЦикла;

	Для Каждого Задача Из _ФоновыеЗадачи Цикл
		Задача.ОжидатьЗавершения(5000);
	КонецЦикла;

	Для Каждого Коннектор Из _КоннекторыСТранзакцией Цикл
		Попытка
			Коннектор.ОтменитьТранзакцию();
		Исключение
		КонецПопытки;
	КонецЦикла;

	Для Каждого Коннектор Из _Коннекторы Цикл
		Попытка
			Коннектор.Закрыть();
		Исключение
		КонецПопытки;
	КонецЦикла;

	Для Каждого Пул Из _Пулы Цикл
		Попытка
			Пул.Закрыть();
		Исключение
		КонецПопытки;
	КонецЦикла;

	ВыполнитьСборкуМусора();
	Если _МенеджерВременныхФайлов <> Неопределено Тогда
		_МенеджерВременныхФайлов.Удалить();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ПроверитьНастройкиДоСозданияSQLiteБазы() Экспорт

	ПутьКБД = НовыйПутьКБД();

	СоздатьПул(ПутьКБД, -1, 1, Истина);

	Ожидаем.Что(Новый Файл(ПутьКБД).Существует(),
		"Некорректные настройки не создают и не изменяют базу").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПерекрытьДваРеальныхЧтенияПриДвухСлотахЧитателей() Экспорт

	// Подготовка
	Пул = СоздатьПул(НовыйПутьКБД(), 2, 1, Истина);
	Затвор = Новый ЗатворSQLiteПула();
	_Затворы.Добавить(Затвор);
	Менеджеры = МенеджерыРоли(Пул, "_СлотыЧтения");

	// Действие
	Первая = ЗапуститьСлот(Затвор, Пул, "Чтение", 1, Менеджеры);
	ПерваяВошла = ДождатьсяВхода(Затвор, 1);
	Вторая = ЗапуститьСлот(Затвор, Пул, "Чтение", 2, Менеджеры);
	ВтораяВошла = ДождатьсяВхода(Затвор, 2);
	Затвор.РазрешитьВыход();
	ЗавершитьЗадачу(Первая);
	ЗавершитьЗадачу(Вторая);

	// Проверка
	Ожидаем.Что(ПерваяВошла И ВтораяВошла, "Два читателя вошли до освобождения затвора").ЭтоИстина();
	Ожидаем.Что(Затвор.МаксимумЧтений(), "Реальные SQLite-чтения перекрылись").Равно(2);
	Ожидаем.Что(Первая.Результат = Вторая.Результат, "Чтения использовали разные менеджеры").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗавершитьЧтениеВоВремяНезавершеннойWALЗаписи() Экспорт

	// Подготовка
	ПутьКБД = НовыйПутьКБД();
	Пул = СоздатьПул(ПутьКБД, 1, 1, Истина);
	Ожидаем.Что(ПолучитьРежимЖурнала(Пул), "SQLite-пул с включенным WAL применил режим журнала").Равно("wal");
	Затвор = Новый ЗатворSQLiteПула();
	_Затворы.Добавить(Затвор);
	Параметры = Новый Массив();
	Параметры.Добавить(Новый Действие(Затвор, "СохранитьИУдерживать"));
	Параметры.Добавить("wal-pending");
	Задача = ФоновыеЗадания.Выполнить(Пул, "ВыполнитьВТранзакции", Параметры);
	_ФоновыеЗадачи.Добавить(Задача);
	ТранзакцияУдерживается = ДождатьсяВхода(Затвор, 1);

	// Действие
	СтрокиВоВремяЗаписи = Пул.ВыполнитьЗапрос(
		"SELECT COUNT(*) AS Количество FROM ОчередьПакетов WHERE ИмяПакета = 'wal-pending';");
	Затвор.РазрешитьВыход();
	ЗавершитьЗадачу(Задача);
	СтрокиПослеЗаписи = Пул.ВыполнитьЗапрос(
		"SELECT COUNT(*) AS Количество FROM ОчередьПакетов WHERE ИмяПакета = 'wal-pending';");

	// Проверка
	Ожидаем.Что(ТранзакцияУдерживается, "Слот записи успел записать незафиксированную строку").ЭтоИстина();
	Ожидаем.Что(СтрокиВоВремяЗаписи[0].Количество,
		"Слот чтения завершил операцию и не увидел незафиксированную WAL-запись").Равно(0);
	Ожидаем.Что(СтрокиПослеЗаписи[0].Количество, "После commit строка видна слоту чтения").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтключитьWALНаСуществующейSQLiteБазе() Экспорт

	ПутьКБД = НовыйПутьКБД();
	ПулСWAL = СоздатьПул(ПутьКБД, 1, 1, Истина);
	Ожидаем.Что(ПолучитьРежимЖурнала(ПулСWAL), "Первый SQLite-пул включил WAL").Равно("wal");
	ПулСWAL.Закрыть();

	ПулБезWAL = СоздатьПул(ПутьКБД, 1, 1, Ложь);

	Ожидаем.Что(ПолучитьРежимЖурнала(ПулБезWAL), "Новый SQLite-пул отключил WAL существующей базы").Равно("delete");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеВыдатьОдинSQLiteМенеджерДвумОперациямЗаписи() Экспорт

	// Подготовка
	Пул = СоздатьПул(НовыйПутьКБД(), 1, 2, Истина);
	Затвор = Новый ЗатворSQLiteПула();
	_Затворы.Добавить(Затвор);
	Менеджеры = МенеджерыРоли(Пул, "_СлотыЗаписи");

	// Действие
	Первая = ЗапуститьСлот(Затвор, Пул, "Запись", 1, Менеджеры);
	ПерваяВошла = ДождатьсяВхода(Затвор, 1);
	Вторая = ЗапуститьСлот(Затвор, Пул, "Запись", 2, Менеджеры);
	ВтораяВошла = ДождатьсяВхода(Затвор, 2);
	Затвор.РазрешитьВыход();
	ЗавершитьЗадачу(Первая);
	ЗавершитьЗадачу(Вторая);

	// Проверка
	Ожидаем.Что(ПерваяВошла И ВтораяВошла, "Оба слота записи арендованы одновременно").ЭтоИстина();
	Ожидаем.Что(Затвор.МаксимумЗаписей()).Равно(2);
	Ожидаем.Что(Первая.Результат = Вторая.Результат,
		"Двум операциям записи выданы разные менеджеры").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьРеальнуюLockОшибкуПослеОдногоВызова() Экспорт

	ПутьКБД = НовыйПутьКБД();
	Пул = СоздатьПул(ПутьКБД, 1, 1, Истина, 25);
	БлокирующийКоннектор = СоздатьКоннектор(ПутьКБД, 25);
	БлокирующийКоннектор.НачатьТранзакцию();
	_КоннекторыСТранзакцией.Добавить(БлокирующийКоннектор);
	БлокирующийКоннектор.ВыполнитьЗапрос(
		"INSERT INTO ОчередьПакетов (ИмяПакета, ДатаДобавления) VALUES ('locker', '2026-07-30 00:00:00');");
	Сущность = Новый СущностьОчередьПакета();
	Сущность.ИмяПакета = "locked-write";
	Сущность.ДатаДобавления = ТекущаяУниверсальнаяДата();

	Ошибка = ПолучитьОшибкуСохранения(Пул, Сущность);

	Ожидаем.Что(Ошибка.Описание, "Возвращена фактическая SQLite-блокировка").Содержит("database is locked");
	Ожидаем.Что(Пул.ПолучитьСтатистику().КоличествоЗаписей, "Пул не повторял lock-операцию").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОсвободитьSQLiteБлокировкуПослеНеудачногоОтката() Экспорт

	// Подготовка
	Пул = СоздатьПул(НовыйПутьКБД(), 1, 2, Истина, 25);
	СлотыЗаписи = Новый Рефлектор().ПолучитьСвойство(Пул, "_СлотыЗаписи");
	МенеджерСНеудачнымОткатом = Новый МенеджерСНеудачнымОткатом(СлотыЗаписи[0].Менеджер);
	СлотыЗаписи[0].Менеджер = МенеджерСНеудачнымОткатом;
	Операции = Новый ОперацииТранзакцииБД();
	Операции.НастроитьОшибки(1, "ошибка callback");

	// Действие
	Операция = Новый Действие(Операции, "СохранитьПакетИВернуть");
	ПерваяОшибка = ПолучитьОшибкуТранзакции(Пул, Операция, "rollback-row");
	Результат = Пул.ВыполнитьВТранзакции(Операция, "committed-row");

	// Проверка
	Ожидаем.Что(ПерваяОшибка.Описание).Содержит("ошибка реального rollback");
	Ожидаем.Что(МенеджерСНеудачнымОткатом.КоличествоЗакрытий(), "Повреждённый слот записи закрыт").Равно(1);
	Ожидаем.Что(Результат, "Исправный слот записи записал после освобождения SQLite-lock").Равно(
		"результат транзакции");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИспользоватьОдногоПисателяВоВсейТранзакции() Экспорт

	// Подготовка
	Пул = СоздатьПул(НовыйПутьКБД(), 1, 2, Истина);
	Затвор = Новый ЗатворSQLiteПула();

	// Действие
	ВиднаВнутриТранзакции = Пул.ВыполнитьВТранзакции(Новый Действие(Затвор, "СохранитьИПрочитать"), "pinned-writer");
	Строки = Пул.ВыполнитьЗапрос("SELECT COUNT(*) AS Количество FROM ОчередьПакетов WHERE ИмяПакета = 'pinned-writer';");

	// Проверка
	Ожидаем.Что(ВиднаВнутриТранзакции,
		"Второй шаг увидел незафиксированную строку того же слота записи").ЭтоИстина();
	Ожидаем.Что(Затвор.КоличествоВызововТранзакции(), "Callback выполнен один раз").Равно(1);
	Ожидаем.Что(Строки[0].Количество, "Транзакция зафиксирована").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ФизическиЗапретитьЗаписьЧерезЧитателя() Экспорт

	// Подготовка
	Пул = СоздатьПул(НовыйПутьКБД(), 1, 1, Истина);
	Читатель = МенеджерыРоли(Пул, "_СлотыЧтения")[0];

	// Действие
	Ошибка = ПолучитьОшибкуИзменяющегоЗапроса(Читатель);

	// Проверка
	Ожидаем.Что(Ошибка, "Соединение чтения реально отклонило DELETE").Не_().ЭтоНеопределено();
	Ожидаем.Что(НРег(Ошибка.Описание)).Содержит("readonly");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПослеЗакрытияОсвободитьВременнуюSQLiteБазуДляУдаления() Экспорт

	// Подготовка
	ПутьКБД = НовыйПутьКБД();
	Пул = СоздатьПул(ПутьКБД, 2, 2, Истина);
	Ожидаем.Что(Новый Файл(ПутьКБД).Существует()).ЭтоИстина();

	// Действие
	Пул.Закрыть();
	ВыполнитьСборкуМусора();
	_МенеджерВременныхФайлов.Удалить();
	_МенеджерВременныхФайлов = Неопределено;

	// Проверка
	Ожидаем.Что(Новый Файл(ПутьКБД).Существует(), "После close каталог с SQLite-базой удален").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьПул(ПутьКБД, КоличествоЧитателей, КоличествоПисателей, ИспользоватьWAL, ТаймаутЗанятостиМс = 100)

	Значения = Новый Соответствие();
	Значения.Вставить("litros.ПутьКБД", ПутьКБД);
	Значения.Вставить("litros.db.ТаймаутЗанятостиМс", ТаймаутЗанятостиМс);
	Значения.Вставить("litros.db.МаксимальноеОжиданиеСлотаМс", 3000);
	Значения.Вставить("litros.db.МаксимальноеОжиданиеЗакрытияМс", 5000);
	Значения.Вставить("litros.db.КоличествоЧитателей", КоличествоЧитателей);
	Значения.Вставить("litros.db.КоличествоПисателей", КоличествоПисателей);
	Значения.Вставить("litros.db.ИспользоватьWAL", ИспользоватьWAL);
	Совет = Новый СоветДругогоМастера();
	Совет.ЗначенияДеталек(Значения);
	Совет.ИмяФайлаСоЗначениямиДеталек("заведомо-отсутствующие-настройки-sqlite-пула");
	Поделка = Новый Поделка(Совет);
	Поделка.ЗапуститьПриложение();
	Пул = Поделка.НайтиЖелудь("ПулМенеджеровСущностей");
	_Пулы.Добавить(Пул);
	Возврат Пул;

КонецФункции

Функция МенеджерыРоли(Пул, ИмяСвойстваСлотов)

	Слоты = Новый Рефлектор().ПолучитьСвойство(Пул, ИмяСвойстваСлотов);
	Менеджеры = Новый Массив();
	Для Каждого Слот Из Слоты Цикл
		Менеджеры.Добавить(Слот.Менеджер);
	КонецЦикла;

	Возврат Менеджеры;

КонецФункции

Функция ПолучитьРежимЖурнала(Пул)

	Строки = Пул.ВыполнитьЗапрос("PRAGMA journal_mode;");
	Возврат НРег(СокрЛП(Строки[0].journal_mode));

КонецФункции

Функция ЗапуститьСлот(Затвор, Пул, Роль, НомерОперации, Менеджеры)

	Параметры = Новый Массив();
	Параметры.Добавить(Пул);
	Параметры.Добавить(Роль);
	Параметры.Добавить(НомерОперации);
	Параметры.Добавить(Менеджеры);
	Задача = ФоновыеЗадания.Выполнить(Затвор, "ВыполнитьЧерезПул", Параметры);
	_ФоновыеЗадачи.Добавить(Задача);
	Возврат Задача;

КонецФункции

Функция ДождатьсяВхода(Затвор, НомерОперации)

	Для НомерОжидания = 1 По 600 Цикл
		Если Затвор.ОперацияВошла(НомерОперации) Тогда
			Возврат Истина;
		КонецЕсли;

		Приостановить(5);
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Процедура ЗавершитьЗадачу(Задача)

	Если Не Задача.ОжидатьЗавершения(5000) Тогда
		ВызватьИсключение "Фоновая SQLite-операция не завершилась за 5 секунд";
	КонецЕсли;

	Если Задача.ИнформацияОбОшибке <> Неопределено Тогда
		ВызватьИсключение Задача.ИнформацияОбОшибке;
	КонецЕсли;

КонецПроцедуры

Функция СоздатьКоннектор(ПутьКБД, ТаймаутЗанятостиМс)

	СтрокаСоединения = СтрШаблон(
		"FullUri=%1;DefaultTimeout=0;BusyTimeout=%2;", URIФайлаSQLite(ПутьКБД), ТаймаутЗанятостиМс);
	Коннектор = Новый КоннекторSQLite();
	Коннектор.Открыть(СтрокаСоединения, Новый Массив());
	_Коннекторы.Добавить(Коннектор);
	Возврат Коннектор;

КонецФункции

Функция URIФайлаSQLite(ПутьКБД)

	Путь = (Новый Файл(ПутьКБД)).ПолноеИмя;
	Путь = СтрЗаменить(Путь, "\", "/");

	Возврат ?(Лев(Путь, 1) = "/", "file://" + Путь, "file:///" + Путь);

КонецФункции

Функция ПолучитьОшибкуСохранения(Пул, Сущность)

	Попытка
		Пул.Сохранить(Сущность);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалась SQLite lock-ошибка";

КонецФункции

Функция ПолучитьОшибкуТранзакции(Пул, Операция, Параметры = Неопределено)

	Попытка
		Пул.ВыполнитьВТранзакции(Операция, Параметры);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалась ошибка транзакции";

КонецФункции

Функция ПолучитьОшибкуИзменяющегоЗапроса(Читатель)

	Попытка
		Читатель.ПолучитьКоннектор().ВыполнитьЗапрос("DELETE FROM ОчередьПакетов;");
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидался физический запрет записи соединением чтения";

КонецФункции

Функция НовыйПутьКБД()

	Возврат _МенеджерВременныхФайлов.НовоеИмяФайла("db");

КонецФункции

#КонецОбласти
