&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&Тест
Процедура ТестДолжен_НеПередатьОдинМенеджерДвумОперациямОдновременно() Экспорт

	Затвор = Новый ЗатворПулаМенеджеровСущностей();
	Пул = Новый ПулМенеджеровСущностей(
		Новый Массив(), МассивМенеджеров(1), Настройки(1000));
	Первая = ЗапуститьОперацию(Затвор, Пул, "Чтение", 1);
	Ожидаем.Что(ДождатьсяВхода(Затвор, 1), "Первая операция заняла reader").ЭтоИстина();
	Вторая = ЗапуститьОперацию(Затвор, Пул, "Чтение", 2);
	Ожидаем.Что(ДождатьсяНачалаВызова(Затвор, 2), "Вторая операция дошла до пула").ЭтоИстина();
	Приостановить(30);
	ВтораяВошлаДоОсвобождения = Затвор.ОперацияВошла(2);

	ЗавершитьОперации(Затвор, МассивИз(Первая, Вторая));

	Ожидаем.Что(ВтораяВошлаДоОсвобождения, "Вторая операция ждала единственный слот").ЭтоЛожь();
	Ожидаем.Что(Затвор.МаксимумМенеджера(1), "Менеджер не обслуживал два вызова одновременно").Равно(1);
	Ожидаем.Что(Первая.Результат).Равно(1);
	Ожидаем.Что(Вторая.Результат).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВыполнитьЧтениеИЗаписьОдновременно() Экспорт

	Затвор = Новый ЗатворПулаМенеджеровСущностей();
	Пул = Новый ПулМенеджеровСущностей(
		МассивМенеджеров(2), МассивМенеджеров(1), Настройки(1000));
	Чтение = ЗапуститьОперацию(Затвор, Пул, "Чтение", 1);
	Запись = ЗапуститьОперацию(Затвор, Пул, "Запись", 2);

	ОбаВошли = ДождатьсяВхода(Затвор, 1) И ДождатьсяВхода(Затвор, 2);
	ЗавершитьОперации(Затвор, МассивИз(Чтение, Запись));

	Ожидаем.Что(ОбаВошли, "Независимые read/write операции вошли одновременно").ЭтоИстина();
	Ожидаем.Что(Затвор.МаксимумВсего(), "Чтение и запись перекрывались").Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДопуститьДвеОдновременныеЗаписиПриДвухПисателях() Экспорт

	Затвор = Новый ЗатворПулаМенеджеровСущностей();
	Пул = Новый ПулМенеджеровСущностей(
		МассивМенеджеров(1, 2), Новый Массив(), Настройки(1000));
	Первая = ЗапуститьОперацию(Затвор, Пул, "Запись", 1);
	Вторая = ЗапуститьОперацию(Затвор, Пул, "Запись", 2);

	ОбеВошли = ДождатьсяВхода(Затвор, 1) И ДождатьсяВхода(Затвор, 2);
	ЗавершитьОперации(Затвор, МассивИз(Первая, Вторая));

	Ожидаем.Что(ОбеВошли, "Оба writer-слота выданы одновременно").ЭтоИстина();
	Ожидаем.Что(Затвор.МаксимумЗаписей(), "Две записи выполнялись одновременно").Равно(2);
	Ожидаем.Что(Затвор.МаксимумМенеджера(1)).Равно(1);
	Ожидаем.Что(Затвор.МаксимумМенеджера(2)).Равно(1);

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение("Чтение", "Пул чтения насыщен")
&ИсточникЗначение("Запись", "Пул записи насыщен")
Процедура ТестДолжен_СообщитьОРолевомТаймаутеНасыщения(Роль, ОжидаемыйТекст) Экспорт

	Затвор = Новый ЗатворПулаМенеджеровСущностей();
	Если Роль = "Чтение" Тогда
		Писатели = Новый Массив();
		Читатели = МассивМенеджеров(1);
	Иначе
		Писатели = МассивМенеджеров(1);
		Читатели = Новый Массив();
	КонецЕсли;
	Пул = Новый ПулМенеджеровСущностей(Писатели, Читатели, Настройки(20));
	Первая = ЗапуститьОперацию(Затвор, Пул, Роль, 1);
	Ожидаем.Что(ДождатьсяВхода(Затвор, 1), "Первая операция заняла слот").ЭтоИстина();

	Ошибка = ПолучитьОшибкуОперации(Затвор, Пул, Роль, 2);
	ЗавершитьОперации(Затвор, МассивИз(Первая));

	Ожидаем.Что(Ошибка.Описание, "Таймаут объясняет насыщение нужной роли").Содержит(ОжидаемыйТекст);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОсвободитьСлотПослеИсключенияОперации() Экспорт

	Затвор = Новый ЗатворПулаМенеджеровСущностей();
	Затвор.НеУдерживать();
	Затвор.НастроитьОшибку(1);
	Пул = Новый ПулМенеджеровСущностей(
		Новый Массив(), МассивМенеджеров(1), Настройки(50));

	Ошибка = ПолучитьОшибкуОперации(Затвор, Пул, "Чтение", 1);
	Результат = Затвор.ВыполнитьЧерез(Пул, "Чтение", 2);

	Ожидаем.Что(Ошибка.Описание, "Исходная ошибка проброшена").Содержит("ошибка операции 1");
	Ожидаем.Что(Результат, "Следующая операция получила освобожденный слот").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеВыбиратьСломанныйСлот() Экспорт

	Затвор = Новый ЗатворПулаМенеджеровСущностей();
	Затвор.НеУдерживать();
	Пул = Новый ПулМенеджеровСущностей(
		Новый Массив(), МассивМенеджеров(1, 2), Настройки(50));
	Слоты = Новый Рефлектор().ПолучитьСвойство(Пул, "_СлотыЧтения");
	Слоты[0].Сломан = Истина;

	Результат = Затвор.ВыполнитьЧерез(Пул, "Чтение", 1);

	Ожидаем.Что(Результат, "Сломанный первый слот исключен из round-robin").Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_МаршрутизироватьCRUDИЗапретитьИзменяющийSQL() Экспорт

	Читатель = Мок.Получить(Тип("МенеджерСущностей"));
	Писатель = Мок.Получить(Тип("МенеджерСущностей"));
	Коннектор = Мок.Получить(Тип("КоннекторSQLite"));
	ТипСущности = Тип("СущностьРепозиторий");
	Сущность = Новый СущностьРепозиторий();
	РезультатПолучения = Новый Массив();
	РезультатЗапроса = Новый ТаблицаЗначений();
	Читатель.Когда().Получить(ТипСущности, Неопределено).ТогдаВозвращает(РезультатПолучения);
	Читатель.Когда().ПолучитьОдно(ТипСущности, Неопределено).ТогдаВозвращает(Сущность);
	Читатель.Когда().ПолучитьКоннектор().ТогдаВозвращает(Коннектор);
	Коннектор.Когда().ВыполнитьЗапрос("SELECT 1;").ТогдаВозвращает(РезультатЗапроса);
	Пул = Новый ПулМенеджеровСущностей(
		МассивИз(Писатель), МассивИз(Читатель), Настройки(50));

	Все = Пул.Получить(ТипСущности);
	Один = Пул.ПолучитьОдно(ТипСущности);
	Пул.Сохранить(Сущность);
	Пул.Удалить(Сущность);
	Строки = Пул.ВыполнитьЗапрос("SELECT 1;");
	ОшибкаSQL = ПолучитьОшибкуЗапроса(Пул, "DELETE FROM Репозитории;");

	Ожидаем.Что(Все = РезультатПолучения).ЭтоИстина();
	Ожидаем.Что(Один = Сущность).ЭтоИстина();
	Ожидаем.Что(Строки = РезультатЗапроса).ЭтоИстина();
	Читатель.ПроверитьЧтоВызывалсяМетод().Получить(ТипСущности, Неопределено);
	Читатель.ПроверитьЧтоВызывалсяМетод().ПолучитьОдно(ТипСущности, Неопределено);
	Писатель.ПроверитьЧтоВызывалсяМетод().Сохранить(Сущность);
	Писатель.ПроверитьЧтоВызывалсяМетод().Удалить(Сущность);
	Ожидаем.Что(ОшибкаSQL.Описание, "Изменяющий SQL отклонен до обращения к reader").Содержит("read-only SQL");

КонецПроцедуры

#Область Тесты

&Тест
Процедура ТестДолжен_ВыдатьЧитателейПоКругу() Экспорт

	Первый = Мок.Получить(Тип("МенеджерСущностей"));
	Второй = Мок.Получить(Тип("МенеджерСущностей"));
	Первый.Когда().Получить(Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение()).ТогдаВозвращает("reader-1");
	Второй.Когда().Получить(Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение()).ТогдаВозвращает("reader-2");
	Пул = Новый ПулМенеджеровСущностей(
		Новый Массив(), МассивИз(Первый, Второй), Настройки(50));

	ПервыйРезультат = Пул.Получить(Тип("СущностьРепозиторий"));
	ВторойРезультат = Пул.Получить(Тип("СущностьРепозиторий"));
	ТретийРезультат = Пул.Получить(Тип("СущностьРепозиторий"));

	Ожидаем.Что(ПервыйРезультат).Равно("reader-1");
	Ожидаем.Что(ВторойРезультат).Равно("reader-2");
	Ожидаем.Что(ТретийРезультат).Равно("reader-1");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Настройки(МаксимальноеОжиданиеСлотаМс)
	Результат = Новый НастройкиПулаМенеджеровСущностей();
	Результат.МаксимальноеОжиданиеСлотаМс = МаксимальноеОжиданиеСлотаМс;
	Возврат Результат;
КонецФункции

Функция МассивИз(Первый, Второй = Неопределено)
	Результат = Новый Массив();
	Результат.Добавить(Первый);
	Если Второй <> Неопределено Тогда
		Результат.Добавить(Второй);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция МассивМенеджеров(ПервыйНомер, ВторойНомер = Неопределено)
	Первый = Новый Структура("Номер", ПервыйНомер);
	Если ВторойНомер = Неопределено Тогда
		Возврат МассивИз(Первый);
	КонецЕсли;
	Возврат МассивИз(Первый, Новый Структура("Номер", ВторойНомер));
КонецФункции

Функция ЗапуститьОперацию(Затвор, Пул, Роль, НомерОперации)
	Параметры = Новый Массив();
	Параметры.Добавить(Пул);
	Параметры.Добавить(Роль);
	Параметры.Добавить(НомерОперации);
	Возврат ФоновыеЗадания.Выполнить(Затвор, "ВыполнитьЧерез", Параметры);
КонецФункции

Функция ДождатьсяВхода(Затвор, НомерОперации)
	Для НомерПопытки = 1 По 200 Цикл
		Если Затвор.ОперацияВошла(НомерОперации) Тогда
			Возврат Истина;
		КонецЕсли;
		Приостановить(5);
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ДождатьсяНачалаВызова(Затвор, НомерОперации)
	Для НомерПопытки = 1 По 200 Цикл
		Если Затвор.ВызовНачат(НомерОперации) Тогда
			Возврат Истина;
		КонецЕсли;
		Приостановить(5);
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Процедура ЗавершитьОперации(Затвор, Задачи)
	Затвор.РазрешитьВыход();
	Для Каждого Задача Из Задачи Цикл
		Если Не Задача.ОжидатьЗавершения(5000) Тогда
			ВызватьИсключение "Фоновая операция пула не завершилась за 5 секунд";
		КонецЕсли;
		Если Задача.ИнформацияОбОшибке <> Неопределено Тогда
			ВызватьИсключение Задача.ИнформацияОбОшибке;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьОшибкуОперации(Затвор, Пул, Роль, НомерОперации)
	Попытка
		Затвор.ВыполнитьЧерез(Пул, Роль, НомерОперации);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;
	ВызватьИсключение "Ожидалась ошибка операции пула";
КонецФункции

Функция ПолучитьОшибкуЗапроса(Пул, ТекстЗапроса)
	Попытка
		Пул.ВыполнитьЗапрос(ТекстЗапроса);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;
	ВызватьИсключение "Ожидался запрет изменяющего SQL";
КонецФункции

#КонецОбласти
