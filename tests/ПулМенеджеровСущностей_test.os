&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьНезависимыйСнимокСтатистики() Экспорт

	Читатель = Мок.Получить(Тип("МенеджерСущностей"));
	Писатель = Мок.Получить(Тип("МенеджерСущностей"));
	Читатель.Когда().Получить(Матчеры.ЛюбоеЗначение(), Матчеры.ЛюбоеЗначение())
		.ТогдаВозвращает(Новый Массив());
	Пул = Новый ПулМенеджеровСущностей(
		МассивИз(Писатель), МассивИз(Читатель), Настройки(50));

	Пул.Получить(Тип("СущностьРепозиторий"));
	Пул.Сохранить(Новый СущностьРепозиторий());
	ПервыйСнимок = Пул.ПолучитьСтатистику();
	ПервыйСнимок.КоличествоЧтений = 999;
	ВторойСнимок = Пул.ПолучитьСтатистику();

	Ожидаем.Что(ВторойСнимок.НастроеноЧитателей).Равно(1);
	Ожидаем.Что(ВторойСнимок.НастроеноПисателей).Равно(1);
	Ожидаем.Что(ВторойСнимок.ДоступноЧитателей).Равно(1);
	Ожидаем.Что(ВторойСнимок.ДоступноПисателей).Равно(1);
	Ожидаем.Что(ВторойСнимок.КоличествоЧтений).Равно(1);
	Ожидаем.Что(ВторойСнимок.КоличествоЗаписей).Равно(1);
	Ожидаем.Что(ВторойСнимок.Ожидают).Равно(0);
	Ожидаем.Что(ВторойСнимок.СреднееОжиданиеМс >= 0).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗакрытьКаждыйМенеджерОдинРазИЗапретитьНовыеОперации() Экспорт

	РегистраторПисателя = Новый РегистраторТранзакцииБД();
	РегистраторЧитателя = Новый РегистраторТранзакцииБД();
	Писатель = СоздатьЗакрываемыйМенеджер(РегистраторПисателя);
	Читатель = СоздатьЗакрываемыйМенеджер(РегистраторЧитателя);
	Пул = Новый ПулМенеджеровСущностей(
		МассивИз(Писатель), МассивИз(Читатель), Настройки(50));

	Пул.Закрыть();
	Пул.Закрыть();
	ОшибкаОперации = ПолучитьОшибкуПолучения(Пул);

	Ожидаем.Что(РегистраторПисателя.Количество("CLOSE"), "Writer закрыт ровно один раз").Равно(1);
	Ожидаем.Что(РегистраторЧитателя.Количество("CLOSE"), "Reader закрыт ровно один раз").Равно(1);
	Ожидаем.Что(Пул.ПолучитьСтатистику().Состояние).Равно("Закрыт");
	Ожидаем.Что(ОшибкаОперации.Описание, "После close новые аренды запрещены").Содержит(
		"не принимает операции");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПовторитьЗакрытиеМенеджераПослеОшибки() Экспорт

	Регистратор = Новый РегистраторТранзакцииБД();
	Регистратор.НастроитьОшибку("CLOSE", 1, "ошибка закрытия");
	Менеджер = СоздатьЗакрываемыйМенеджер(Регистратор);
	Пул = Новый ПулМенеджеровСущностей(
		Новый Массив(), МассивИз(Менеджер), Настройки(50));

	Ошибка = ПолучитьОшибкуЗакрытия(Пул);
	СостояниеПослеОшибки = Пул.ПолучитьСтатистику().Состояние;
	Пул.Закрыть();

	Ожидаем.Что(Ошибка.Описание).Содержит("ошибка закрытия");
	Ожидаем.Что(СостояниеПослеОшибки, "Неуспешное закрытие допускает повтор").Равно("Закрывается");
	Ожидаем.Что(Регистратор.Количество("CLOSE"), "Менеджер закрыт повторно").Равно(2);
	Ожидаем.Что(Пул.ПолучитьСтатистику().Состояние).Равно("Закрыт");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ДождатьсяАктивнойАрендыПередЗакрытием() Экспорт

	Регистратор = Новый РегистраторТранзакцииБД();
	Менеджер = СоздатьЗакрываемыйМенеджер(Регистратор);
	Пул = Новый ПулМенеджеровСущностей(
		Новый Массив(), МассивИз(Менеджер), Настройки(50));
	Слот = Новый Рефлектор().ПолучитьСвойство(Пул, "_СлотыЧтения")[0];
	Слот.Занят = Истина;

	Задача = ФоновыеЗадания.Выполнить(Пул, "Закрыть", Новый Массив());
	ЗавершиласьДоОсвобождения = Задача.ОжидатьЗавершения(30);
	Слот.Занят = Ложь;
	ЗавершиласьПослеОсвобождения = Задача.ОжидатьЗавершения(5000);

	Если Задача.ИнформацияОбОшибке <> Неопределено Тогда
		ВызватьИсключение Задача.ИнформацияОбОшибке;
	КонецЕсли;
	Ожидаем.Что(ЗавершиласьДоОсвобождения, "Close ждал активную аренду").ЭтоЛожь();
	Ожидаем.Что(ЗавершиласьПослеОсвобождения, "Close продолжился после освобождения").ЭтоИстина();
	Ожидаем.Что(Регистратор.Количество("CLOSE")).Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗавершитьОжиданиеЗакрытияПоТаймауту() Экспорт

	Регистратор = Новый РегистраторТранзакцииБД();
	Менеджер = СоздатьЗакрываемыйМенеджер(Регистратор);
	НастройкиПула = Настройки(50);
	НастройкиПула.МаксимальноеОжиданиеЗакрытияМс = 20;
	Пул = Новый ПулМенеджеровСущностей(
		Новый Массив(), МассивИз(Менеджер), НастройкиПула);
	Слот = Новый Рефлектор().ПолучитьСвойство(Пул, "_СлотыЧтения")[0];
	Слот.Занят = Истина;

	ОшибкаЗакрытия = ПолучитьОшибкуЗакрытия(Пул);
	ОшибкаОперации = ПолучитьОшибкуПолучения(Пул);
	Слот.Занят = Ложь;
	Пул.Закрыть();

	Ожидаем.Что(ОшибкаЗакрытия.Описание).Содержит("максимальное ожидание закрытия");
	Ожидаем.Что(ОшибкаОперации.Описание, "После таймаута пул остается закрывающимся").Содержит(
		"состояние Закрывается");
	Ожидаем.Что(Регистратор.Количество("CLOSE"), "Повторный close завершил закрытие один раз").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьПередачуПраваПослеИстеченияDeadline() Экспорт

	НастройкиПула = Настройки(50);
	НастройкиПула.МаксимальноеОжиданиеЗакрытияМс = -1;
	Пул = Новый ПулМенеджеровСущностей(
		Новый Массив(), Новый Массив(), НастройкиПула);
	Рефлектор = Новый Рефлектор();
	Рефлектор.УстановитьСвойство(Пул, "_Состояние", "Закрывается");
	Рефлектор.УстановитьСвойство(Пул, "_ЗакрытиеВыполняется", Ложь);

	Ошибка = ПолучитьОшибкуЗакрытия(Пул);

	Ожидаем.Что(Ошибка.Описание).Содержит("максимальное ожидание закрытия");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПодхватитьЗакрытиеПослеОсвобожденияПрава() Экспорт

	Регистратор = Новый РегистраторТранзакцииБД();
	Менеджер = СоздатьЗакрываемыйМенеджер(Регистратор);
	НастройкиПула = Настройки(50);
	НастройкиПула.МаксимальноеОжиданиеЗакрытияМс = 200;
	Пул = Новый ПулМенеджеровСущностей(
		Новый Массив(), МассивИз(Менеджер), НастройкиПула);
	Рефлектор = Новый Рефлектор();
	Рефлектор.УстановитьСвойство(Пул, "_Состояние", "Закрывается");
	Рефлектор.УстановитьСвойство(Пул, "_ЗакрытиеВыполняется", Истина);
	Затвор = Новый ЗатворПулаМенеджеровСущностей();
	Параметры = Новый Массив();
	Параметры.Добавить(Пул);
	Параметры.Добавить(20);
	Задача = ФоновыеЗадания.Выполнить(
		Затвор, "СброситьПравоНаЗакрытие", Параметры);

	Пул.Закрыть();
	Если Не Задача.ОжидатьЗавершения(5000) Тогда
		ВызватьИсключение "Сброс права на закрытие не завершился за 5 секунд";
	КонецЕсли;

	Если Задача.ИнформацияОбОшибке <> Неопределено Тогда
		ВызватьИсключение Задача.ИнформацияОбОшибке;
	КонецЕсли;
	Ожидаем.Что(Регистратор.Количество("CLOSE")).Равно(1);
	Ожидаем.Что(Пул.ПолучитьСтатистику().Состояние).Равно("Закрыт");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗакрепитьWriterОтBeginДоCommitИДеактивироватьДоступ() Экспорт

	Регистратор = Новый РегистраторТранзакцииБД();
	ДанныеПула = СоздатьТранзакционныйПул(Регистратор);
	Операции = Новый ОперацииТранзакцииБД();

	Результат = ДанныеПула.Пул.ВыполнитьВТранзакции(
		Новый Действие(Операции, "СохранитьИВернуть"));
	ОшибкаДоступа = ПолучитьОшибкуДоступаКБД(Операции.ДоступКБД(0));

	Ожидаем.Что(Результат).Равно("результат транзакции");
	Ожидаем.Что(Регистратор.Порядок(), "Один writer выполнил всю транзакцию").Равно(
		"BEGIN,CALLBACK,COMMIT");
	Ожидаем.Что(ОшибкаДоступа.Описание, "Доступ деактивирован после COMMIT").Содержит("больше не активен");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОткатитьПослеОшибкиОбработчикаБезПовтора() Экспорт

	Регистратор = Новый РегистраторТранзакцииБД();
	ДанныеПула = СоздатьТранзакционныйПул(Регистратор);
	Операции = Новый ОперацииТранзакцииБД();
	Операции.НастроитьОшибки(1, "ошибка обработчика");

	Ошибка = ПолучитьОшибкуТранзакции(
		ДанныеПула.Пул, Новый Действие(Операции, "СохранитьИВернуть"));

	Ожидаем.Что(Регистратор.Порядок(), "Ошибка callback завершилась одним rollback").Равно(
		"BEGIN,CALLBACK,ROLLBACK");
	Ожидаем.Что(Операции.КоличествоПопыток(), "Пул не повторяет транзакцию").Равно(1);
	Ожидаем.Что(Ошибка.Описание, "Исходная ошибка проброшена").Содержит("ошибка обработчика");
	Ожидаем.Что(ПолучитьОшибкуДоступаКБД(Операции.ДоступКБД(0)).Описание,
		"Доступ деактивирован перед rollback").Содержит("больше не активен");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОткатитьПослеОшибкиCommitБезПовтора() Экспорт

	Регистратор = Новый РегистраторТранзакцииБД();
