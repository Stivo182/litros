КонецПроцедуры

&Тест
Процедура ТестДолжен_РазрешитьФасадИЗависимостиЧерезAutumn() Экспорт

	// Подготовка
	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("litros.db.КоличествоПовторов", 0);
	ЗначенияДеталек.Вставить("litros.db.БазоваяЗадержкаПовтораМс", 0);
	СоветДругогоМастера = Новый СоветДругогоМастера();
	СоветДругогоМастера.ЗначенияДеталек(ЗначенияДеталек);
	СоветДругогоМастера.ИмяФайлаСоЗначениямиДеталек("заведомо-отсутствующие-настройки-фасада-бд");
	Поделка = Новый Поделка(СоветДругогоМастера);
	Сценарий = Новый СценарийОперацииБД();
	Сценарий.Настроить(2, "database is locked", Неопределено);
	Рефлектор = Новый Рефлектор();

	// Действие
	Поделка.ЗапуститьПриложение();
	ПервыйФасад = Поделка.НайтиЖелудь("УстойчивыйМенеджерСущностей");
	ВторойФасад = Поделка.НайтиЖелудь("УстойчивыйМенеджерСущностей");
	Настройки = Поделка.НайтиЖелудь("НастройкиОтказоустойчивостиБД");
	Классификатор = Поделка.НайтиЖелудь("КлассификаторОшибокSQLite");
	ВнедренныеНастройки = Рефлектор.ПолучитьСвойство(ПервыйФасад, "_Настройки");
	ВнедренныйКлассификатор = Рефлектор.ПолучитьСвойство(ПервыйФасад, "_Классификатор");
	ДанныеОшибки = ПолучитьОшибку(ПервыйФасад, Сценарий);

	// Проверка
	Ожидаем.Что(ПервыйФасад = ВторойФасад, "Autumn возвращает один экземпляр устойчивого фасада").ЭтоИстина();
	Ожидаем.Что(ВнедренныеНастройки = Настройки, "В фасад внедрен желудь настроек из той же Поделки").ЭтоИстина();
	Ожидаем.Что(ВнедренныйКлассификатор = Классификатор, "В фасад внедрен желудь классификатора из той же Поделки").ЭтоИстина();
	Ожидаем.Что(Сценарий.КоличествоВызовов(), "Внедренная настройка нулевых повторов ограничила выполнение одной попыткой").Равно(1);
	Ожидаем.Что(ДанныеОшибки.Описание, "Временная ошибка нулевой настройки повторов проброшена наружу").Содержит("database is locked, попытка 1");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОграничитьПараллелизмОперацийБДОднимСлотом() Экспорт

	// Подготовка
	Фасад = СоздатьФасад(0);
	Затвор = Новый ЗатворОперацийБД();
	ПараметрыПервойЗадачи = Новый Массив();
	ПараметрыПервойЗадачи.Добавить(Фасад);
	ПараметрыПервойЗадачи.Добавить(1);
	ПараметрыВторойЗадачи = Новый Массив();
	ПараметрыВторойЗадачи.Добавить(Фасад);
	ПараметрыВторойЗадачи.Добавить(2);

	// Действие
	ПерваяЗадача = ФоновыеЗадания.Выполнить(Затвор, "ВыполнитьЧерез", ПараметрыПервойЗадачи);
	ВтораяЗадача = Неопределено;
	ОшибкаДействия = Неопределено;
	ПерваяВошла = Ложь;
	ВтораяНачалаВызов = Ложь;
	ВтораяВошлаДоОсвобождения = Ложь;
	Попытка
		ПерваяВошла = ДождатьсяФлага(Затвор, "ПерваяОперацияВошла");
		Если ПерваяВошла Тогда
			ВтораяЗадача = ФоновыеЗадания.Выполнить(Затвор, "ВыполнитьЧерез", ПараметрыВторойЗадачи);
			ВтораяНачалаВызов = ДождатьсяФлага(Затвор, "ВтораяНачалаВызов");
			Если ВтораяНачалаВызов Тогда
				ВтораяВошлаДоОсвобождения = Затвор.ВтораяОперацияВошла();
			КонецЕсли;
		КонецЕсли;
	Исключение
		ОшибкаДействия = ИнформацияОбОшибке();
	КонецПопытки;

	// Общий cleanup для любого исхода действия
	ОшибкаОчистки = Неопределено;
	Попытка
		Затвор.РазрешитьВыход();
	Исключение
		ОшибкаОчистки = ИнформацияОбОшибке();
	КонецПопытки;
	ОчисткаПервойЗадачи = ДождатьсяЗадачи(ПерваяЗадача);
	ОчисткаВторойЗадачи = ДождатьсяЗадачи(ВтораяЗадача);
	Если ОшибкаОчистки = Неопределено Тогда
		ОшибкаОчистки = ?(ОчисткаПервойЗадачи.ДанныеОшибки <> Неопределено,
			ОчисткаПервойЗадачи.ДанныеОшибки, ОчисткаВторойЗадачи.ДанныеОшибки);
	КонецЕсли;
	Если ОшибкаДействия <> Неопределено Тогда
		ВызватьИсключение ОшибкаДействия;
	КонецЕсли;
	Если ОшибкаОчистки <> Неопределено Тогда
		ВызватьИсключение ОшибкаОчистки;
	КонецЕсли;

	// Проверка
	Ожидаем.Что(ОчисткаПервойЗадачи.Завершена, "Первая фоновая задача завершилась за ограниченное время").ЭтоИстина();
	Ожидаем.Что(ОчисткаВторойЗадачи.Завершена, "Вторая фоновая задача завершилась за ограниченное время").ЭтоИстина();
	РезультатПервойЗадачи = ПерваяЗадача.Результат;
	РезультатВторойЗадачи = ВтораяЗадача.Результат;
	Ожидаем.Что(ПерваяВошла, "Первая фоновая операция заняла слот за ограниченное время").ЭтоИстина();
	Ожидаем.Что(ВтораяНачалаВызов, "Вторая фоновая задача дошла до фасада за ограниченное время").ЭтоИстина();
	Ожидаем.Что(ВтораяВошлаДоОсвобождения, "Вторая операция не вошла до освобождения единственного слота").ЭтоЛожь();
	Ожидаем.Что(Затвор.МаксимумАктивных(), "В общий Bulkhead одновременно вошла не более одной операции").Равно(1);
	Ожидаем.Что(РезультатПервойЗадачи, "Первая фоновая операция завершилась штатно").Равно(1);
	Ожидаем.Что(РезультатВторойЗадачи, "Вторая фоновая операция завершилась штатно").Равно(2);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОсвободитьСлотBulkheadМеждуПопыткамиRetry() Экспорт

	// Подготовка
	Затвор = Новый ЗатворПорядкаСтратегийБД();
	Фасад = СоздатьФасад(1, Затвор);
	ПараметрыПервойЗадачи = Новый Массив();
	ПараметрыПервойЗадачи.Добавить(Фасад);
	ПараметрыВторойЗадачи = Новый Массив();
	ПараметрыВторойЗадачи.Добавить(Фасад);

	// Действие
	ПерваяЗадача = ФоновыеЗадания.Выполнить(Затвор, "ВыполнитьПервуюЧерез", ПараметрыПервойЗадачи);
	ВтораяЗадача = Неопределено;
	ОшибкаДействия = Неопределено;
	КлассификацияНачалась = Ложь;
	Попытка
		КлассификацияНачалась = ДождатьсяФлага(Затвор, "ПерваяОшибкаКлассифицируется");
		Если КлассификацияНачалась Тогда
			ВтораяЗадача = ФоновыеЗадания.Выполнить(Затвор, "ВыполнитьВторуюЧерез", ПараметрыВторойЗадачи);
		КонецЕсли;
	Исключение
		ОшибкаДействия = ИнформацияОбОшибке();
	КонецПопытки;

	// Общий cleanup для любого исхода действия
	ОчисткаПервойЗадачи = ДождатьсяЗадачи(ПерваяЗадача);
	ОчисткаВторойЗадачи = ДождатьсяЗадачи(ВтораяЗадача);
	ОшибкаОчистки = ?(ОчисткаПервойЗадачи.ДанныеОшибки <> Неопределено,
		ОчисткаПервойЗадачи.ДанныеОшибки, ОчисткаВторойЗадачи.ДанныеОшибки);
	Если ОшибкаДействия <> Неопределено Тогда
		ВызватьИсключение ОшибкаДействия;
	КонецЕсли;
	Если ОшибкаОчистки <> Неопределено Тогда
		ВызватьИсключение ОшибкаОчистки;
	КонецЕсли;

	// Проверка
	Ожидаем.Что(КлассификацияНачалась, "Retry дошёл до классификации первой временной ошибки").ЭтоИстина();
	Ожидаем.Что(ОчисткаПервойЗадачи.Завершена, "Первая операция с retry завершилась за ограниченное время").ЭтоИстина();
	Ожидаем.Что(ОчисткаВторойЗадачи.Завершена, "Вторая операция завершилась за ограниченное время").ЭтоИстина();
	Ожидаем.Что(Затвор.ВтораяВошлаДоРазрешенияПовтора(), "Внутренний Bulkhead освободил слот до разрешения retry").ЭтоИстина();
	Ожидаем.Что(Затвор.КоличествоПопытокПервойОперации(), "Первая операция выполнила исходную и повторную попытки").Равно(2);
	Ожидаем.Что(ПерваяЗадача.Результат, "Первая операция вернула результат retry").Равно("первая завершена");
	Ожидаем.Что(ВтораяЗадача.Результат, "Вторая операция вернула успешный результат").Равно("вторая завершена");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьФасад(КоличествоПовторов, Классификатор = Неопределено)

	Настройки = Новый НастройкиОтказоустойчивостиБД();
	Настройки.КоличествоПовторов = КоличествоПовторов;
	Настройки.БазоваяЗадержкаПовтораМс = 0;
	Настройки.МаксимальнаяЗадержкаПовтораМс = 0;

	Если Классификатор = Неопределено Тогда
		Классификатор = Новый КлассификаторОшибокSQLite();
	КонецЕсли;

	Возврат Новый УстойчивыйМенеджерСущностей(
		Настройки, Классификатор, Неопределено);

КонецФункции

Функция ПолучитьОшибку(Фасад, Сценарий)

	Попытка
		ВыполнитьЧерезPipeline(Фасад, Новый Действие(Сценарий, "ВыполнитьСценарий"));
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалась ошибка операции базы данных.";

КонецФункции

Функция ВыполнитьЧерезPipeline(Фасад, Операция, Параметры = Неопределено)
	Пайплайн = Новый Рефлектор().ПолучитьСвойство(Фасад, "_Пайплайн");
	Возврат Пайплайн.Запустить(Операция, Параметры);
КонецФункции

Функция ДождатьсяФлага(Затвор, ИмяМетода)

	Рефлектор = Новый Рефлектор();
	Для НомерПопытки = 1 По 200 Цикл
		Если Рефлектор.ВызватьМетод(Затвор, ИмяМетода) Тогда
			Возврат Истина;
		КонецЕсли;
		Приостановить(5);
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ДождатьсяЗадачи(Задача)

	Результат = Новый Структура("Завершена,ДанныеОшибки", Задача = Неопределено, Неопределено);
	Если Задача = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Результат.Завершена = Задача.ОжидатьЗавершения(5000);
	Исключение
		Результат.ДанныеОшибки = ИнформацияОбОшибке();
	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти
