#Область Тесты

&Тест
Процедура ТестДолжен_НормализоватьИДобавитьПакетОднойТранзакцией() Экспорт

	// Подготовка
	Сценарий = Новый СценарийОчередиПакетов();
	Хранилище = СоздатьХранилище(Сценарий);

	// Действие
	ПакетДобавлен = Хранилище.Добавить(" Test-Package ");

	// Проверка
	Ожидаем.Что(ПакетДобавлен, "Новый пакет добавлен в очередь").ЭтоИстина();
	Ожидаем.Что(Сценарий.КоличествоПроверок(),
		"Наличие пакета проверено в транзакции один раз").Равно(1);
	Ожидаем.Что(Сценарий.КоличествоСохранений(),
		"Пакет сохранен в той же транзакции один раз").Равно(1);
	Ожидаем.Что(Сценарий.ПоследнееСохраненноеИмя(),
		"Перед сохранением имя пакета нормализовано").Равно("test-package");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СериализоватьКонкурентноеДобавлениеПакетов() Экспорт

	Сценарий = Новый СценарийОчередиПакетов();
	Сценарий.УдерживатьПервуюТранзакцию();
	Хранилище = СоздатьХранилище(Сценарий, 2);
	Параметры = Новый Массив();
	Параметры.Добавить("test-package");

	Первая = ФоновыеЗадания.Выполнить(Хранилище, "Добавить", Параметры);
	ПерваяВошла = ДождатьсяПервойТранзакции(Сценарий);
	Вторая = ФоновыеЗадания.Выполнить(Хранилище, "Добавить", Параметры);
	Приостановить(30);
	МаксимумТранзакций = Сценарий.МаксимумОдновременныхТранзакций();
	Сценарий.РазрешитьПервуюТранзакцию();
	ЗавершитьЗадачу(Первая);
	ЗавершитьЗадачу(Вторая);

	Ожидаем.Что(ПерваяВошла, "Первая операция вошла в транзакцию").ЭтоИстина();
	Ожидаем.Что(МаксимумТранзакций,
		"Проверка отсутствия и сохранение одного ключа не выполняются конкурентно").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеСохранятьСуществующийПакет() Экспорт

	// Подготовка
	Сценарий = Новый СценарийОчередиПакетов();
	Сценарий.НастроитьДубликат(Истина);
	Хранилище = СоздатьХранилище(Сценарий);

	// Действие
	ПакетДобавлен = Хранилище.Добавить("test-package");

	// Проверка
	Ожидаем.Что(ПакетДобавлен, "Существующий пакет не считается добавленным").ЭтоЛожь();
	Ожидаем.Что(Сценарий.КоличествоПроверок(), "Наличие пакета проверено один раз").Равно(1);
	Ожидаем.Что(Сценарий.КоличествоСохранений(), "Дубликат повторно не сохранен").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроброситьОшибкуПроверкиБезПовтора() Экспорт

	// Подготовка
	Сценарий = Новый СценарийОчередиПакетов();
	Сценарий.НастроитьОшибкиПроверки(1, "database is locked");
	Хранилище = СоздатьХранилище(Сценарий);

	// Действие
	Ошибка = ПолучитьОшибкуДобавления(Хранилище, "test-package");

	// Проверка
	Ожидаем.Что(Ошибка.Описание, "Ошибка проверки проброшена наружу").Содержит("database is locked");
	Ожидаем.Что(Сценарий.КоличествоТранзакций(),
		"Транзакция выполнена без повтора").Равно(1);
	Ожидаем.Что(Сценарий.КоличествоПроверок(),
		"Проверка наличия выполнена один раз").Равно(1);
	Ожидаем.Что(Сценарий.КоличествоСохранений(),
		"После ошибки проверки сохранения не было").Равно(0);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроброситьНеоднозначнуюОшибкуСохраненияБезПовтора() Экспорт

	// Подготовка
	Сценарий = Новый СценарийОчередиПакетов();
	Сценарий.НастроитьОшибкиПослеСохранения(1, "database is locked");
	Хранилище = СоздатьХранилище(Сценарий);

	// Действие
	Ошибка = ПолучитьОшибкуДобавления(Хранилище, "test-package");

	// Проверка
	Ожидаем.Что(Ошибка.Описание, "Неоднозначная ошибка проброшена без повтора").Содержит(
		"database is locked");
	Ожидаем.Что(Сценарий.КоличествоПроверок(),
		"Наличие пакета проверено один раз").Равно(1);
	Ожидаем.Что(Сценарий.КоличествоСохранений(),
		"Попытка сохранения выполнена один раз").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПолучитьОграниченнуюПачкуИВернутьТолькоИмена() Экспорт

	// Подготовка
	Сценарий = Новый СценарийОчередиПакетов();
	Сценарий.ДобавитьПакетВПачку("first-package");
	Сценарий.ДобавитьПакетВПачку("second-package");
	Хранилище = СоздатьХранилище(Сценарий);

	// Действие
	ИменаПакетов = Хранилище.ПолучитьПачку(2);

	// Проверка
	Ожидаем.Что(ИменаПакетов, "Хранилище вернуло два имени пакетов").ИмеетДлину(2);
	Ожидаем.Что(ИменаПакетов[0], "Первое имя извлечено из сущности").Равно("first-package");
	Ожидаем.Что(ИменаПакетов[1], "Второе имя извлечено из сущности").Равно("second-package");
	ОпцииПоиска = Сценарий.ПоследниеОпцииВыборки();
	Ожидаем.Что(ОпцииПоиска.ВыбираютсяПервые(),
		"Размер выборки передан менеджеру сущностей").Равно(2);
	Сортировки = ОпцииПоиска.Сортировки();
	Ожидаем.Что(Сортировки, "Для пачки задана одна сортировка").ИмеетДлину(1);
	Ожидаем.Что(Сортировки[0].ПутьКДанным,
		"Пачка сортируется по времени добавления").Равно("ДатаДобавления");
	Ожидаем.Что(Сортировки[0].НаправлениеСортировки,
		"Старые элементы выбираются первыми").Равно(НаправлениеСортировки.Возр);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ИдемпотентноУдалитьПакетПоНормализованномуИмени() Экспорт

	// Подготовка
	Сценарий = Новый СценарийОчередиПакетов();
	Хранилище = СоздатьХранилище(Сценарий);

	// Действие
	Хранилище.Удалить(" Test-Package ");
	Хранилище.Удалить(" TEST-PACKAGE ");

	// Проверка
	Ожидаем.Что(Сценарий.КоличествоПроверок(),
		"Удаление не использует отдельное чтение и не содержит TOCTOU").Равно(0);
	Ожидаем.Что(Сценарий.КоличествоУдалений(),
		"Повторное удаление остается атомарным и идемпотентным").Равно(2);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьХранилище(Сценарий, КоличествоПисателей = 1)

	Настройки = Новый НастройкиПулаМенеджеровСущностей();
	Настройки.МаксимальноеОжиданиеСлотаМс = 50;
	Писатели = Новый Массив();
	Для НомерПисателя = 1 По КоличествоПисателей Цикл
		Писатели.Добавить(Сценарий);
	КонецЦикла;

	Читатели = Новый Массив();
	Читатели.Добавить(Сценарий);
	Пул = Новый ПулМенеджеровСущностей(Писатели, Читатели, Настройки);

	Возврат Новый ХранилищеОчередиПакетов(Пул);

КонецФункции

Функция ПолучитьОшибкуДобавления(Хранилище, ИмяПакета)
	Попытка
		Хранилище.Добавить(ИмяПакета);
	Исключение
		Возврат ИнформацияОбОшибке();
	КонецПопытки;

	ВызватьИсключение "Ожидалась ошибка добавления пакета";
КонецФункции

Функция ДождатьсяПервойТранзакции(Сценарий)
	Для НомерОжидания = 1 По 200 Цикл
		Если Сценарий.ПерваяТранзакцияВошла() Тогда
			Возврат Истина;
		КонецЕсли;

		Приостановить(5);
	КонецЦикла;

	Возврат Ложь;
КонецФункции

Процедура ЗавершитьЗадачу(Задача)
	Если Не Задача.ОжидатьЗавершения(5000) Тогда
		ВызватьИсключение "Операция добавления не завершилась";
	КонецЕсли;

	Если Задача.ИнформацияОбОшибке <> Неопределено Тогда
		ВызватьИсключение Задача.ИнформацияОбОшибке;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
