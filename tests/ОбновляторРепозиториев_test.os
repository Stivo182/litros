#Использовать asserts
#Использовать autumn
#Использовать autumn-logos
#Использовать moskito
#Использовать reflector
#Использовать "../src/repository"
#Использовать "../src/service"
#Использовать "fixtures"

Перем _СохраненныйРепозиторий; // СущностьРепозиторий

#Область ОбработчикиСобытий

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()
КонецПроцедуры

&ПередКаждым
Процедура ПередКаждым() Экспорт
	_СохраненныйРепозиторий = Неопределено;
КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_ОбновитьNodeIDОбычнымСохранением() Экспорт

	// Подготовка
	Хранилище = Мок.Получить(Тип("ХранилищеРепозиториев"));
	Хранилище
		.Когда()
		.Сохранить(Матчеры.ЛюбоеЗначение())
		.ТогдаОтвечает(Новый Ответ(ЭтотОбъект, "ЗарегистрироватьСохранение"));

	Обновлятор = Новый ОбновляторРепозиториев();
	СценарийGitHub = Новый СценарийGitHubОбновленияРепозитория(СоздатьУзелРепозитория());
	
	Рефлектор = Новый Рефлектор();
	Рефлектор.УстановитьСвойство(Обновлятор, "_ХранилищеРепозиториев", Хранилище);
	Рефлектор.УстановитьСвойство(Обновлятор, "_КлиентGitHubAPI", СценарийGitHub);
	Рефлектор.УстановитьСвойство(Обновлятор, "_Лог", СценарийGitHub);
	
	Задание = Новый Структура("Идентификатор,ИдентификаторУзла", 1180299150, "MDEwOlJlcG9zaXRvcnkxMTgwMjk5MTUw");
	Задания = Новый Массив();
	Задания.Добавить(Задание);
	
	// Действие
	Обновлятор.ОбновитьРепозитории(Задания);

	// Проверка
	Ожидаем.Что(_СохраненныйРепозиторий, "Репозиторий передан обычному сохранению").Не_().ЭтоНеопределено();
	Ожидаем.Что(_СохраненныйРепозиторий.Идентификатор, "Числовой ID не изменен").Равно(1180299150);
	Ожидаем.Что(_СохраненныйРепозиторий.ИдентификаторУзла, "Node ID заменен актуальным").Равно("R_kgDORlnvjg");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗарегистрироватьСохранение(ИнформацияОВызове) Экспорт
	_СохраненныйРепозиторий = ИнформацияОВызове.Параметры()[0];
	Возврат Неопределено;
КонецФункции

Функция СоздатьУзелРепозитория()
	Возврат Новый Структура(
		"id,name,description,url,isFork,stargazerCount,forkCount,owner",
		"R_kgDORlnvjg",
		"litros",
		"Описание",
		"https://github.com/example/litros",
		Ложь,
		10,
		2,
		Новый Структура("login", "example"));
КонецФункции

#КонецОбласти
