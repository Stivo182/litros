#Использовать asserts
#Использовать autumn
#Использовать "../src/internal"

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

#Область Тесты

&Тест
Процедура ТестДолжен_ПолучитьНовыеНастройкиПодключенияGitHub() Экспорт

	// Подготовка
	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("litros.github.Токен", "новый-токен");
	ЗначенияДеталек.Вставить("litros.github.АдресAPI", "https://new.example.test");

	// Действие
	Клиент = СоздатьКлиентИзДеталек(ЗначенияДеталек);

	// Проверка
	ПроверитьПодключениеКлиента(Клиент, "новый-токен", "https://new.example.test");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПоддержатьУстаревшиеНастройкиПодключенияGitHub() Экспорт

	// Подготовка
	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("litros.ТокенGitHub", "старый-токен");
	ЗначенияДеталек.Вставить("litros.АдресGitHubAPI", "https://legacy.example.test");

	// Действие
	Клиент = СоздатьКлиентИзДеталек(ЗначенияДеталек);

	// Проверка
	ПроверитьПодключениеКлиента(Клиент, "старый-токен", "https://legacy.example.test");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредпочестьНовыеНастройкиПодключенияGitHubУстаревшим() Экспорт

	// Подготовка
	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("litros.github.Токен", "новый-токен");
	ЗначенияДеталек.Вставить("litros.github.АдресAPI", "https://new.example.test");
	ЗначенияДеталек.Вставить("litros.ТокенGitHub", "старый-токен");
	ЗначенияДеталек.Вставить("litros.АдресGitHubAPI", "https://legacy.example.test");

	// Действие
	Клиент = СоздатьКлиентИзДеталек(ЗначенияДеталек);

	// Проверка
	ПроверитьПодключениеКлиента(Клиент, "новый-токен", "https://new.example.test");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПредпочестьПустойНовыйТокенУстаревшему() Экспорт

	// Подготовка
	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("litros.github.Токен", "");
	ЗначенияДеталек.Вставить("litros.ТокенGitHub", "старый-токен");

	// Действие
	Клиент = СоздатьКлиентИзДеталек(ЗначенияДеталек);

	// Проверка
	ПроверитьПодключениеКлиента(Клиент, "", "https://api.github.com");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьКлиентИзДеталек(ЗначенияДеталек)

	СоветДругогоМастера = Новый СоветДругогоМастера();
	СоветДругогоМастера.ЗначенияДеталек(ЗначенияДеталек);
	СоветДругогоМастера.ИмяФайлаСоЗначениямиДеталек("заведомо-отсутствующие-настройки-подключения-github");
	Поделка = Новый Поделка(СоветДругогоМастера);
	Поделка.ЗапуститьПриложение();

	Возврат Поделка.НайтиЖелудь("КлиентGitHubAPI");

КонецФункции

Процедура ПроверитьПодключениеКлиента(Клиент, ОжидаемыйТокен, ОжидаемыйАдресAPI)

	Рефлектор = Новый Рефлектор();
	Ожидаем.Что(Рефлектор.ПолучитьСвойство(Клиент, "_Токен"), "Токен клиента GitHub").Равно(ОжидаемыйТокен);
	Ожидаем.Что(Рефлектор.ПолучитьСвойство(Клиент, "_АдресAPI"), "Адрес API клиента GitHub").Равно(ОжидаемыйАдресAPI);

КонецПроцедуры

#КонецОбласти
