&Тест
Процедура ТестДолжен_ИзолироватьПулыСущностейReaderСлотов() Экспорт

	Менеджеры = СоздатьПулМенеджеров(НовыйПутьКБД(), 2, 1);
	ТипСущности = Тип("СущностьРепозиторий");

	ПервыйПулСущностей = Менеджеры.Читатели[0].ПолучитьПулСущностей(ТипСущности);
	ВторойПулСущностей = Менеджеры.Читатели[1].ПолучитьПулСущностей(ТипСущности);
	ПервоеЧтение = Менеджеры.Читатели[0].Получить(ТипСущности);
	ВтороеЧтение = Менеджеры.Читатели[1].Получить(ТипСущности);

	Ожидаем.Что(ПервыйПулСущностей = ВторойПулСущностей,
		"Reader-слоты не разделяют изменяемый cache entity").ЭтоЛожь();
	Ожидаем.Что(ПервоеЧтение.Количество()).Равно(ВтороеЧтение.Количество());

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьОдинПулНаКонтекстAutumn() Экспорт

	ПутьКБД = НовыйПутьКБД();
	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("litros.ПутьКБД", ПутьКБД);
	ЗначенияДеталек.Вставить("litros.db.КоличествоПисателей", 1);
	ЗначенияДеталек.Вставить("litros.db.КоличествоЧитателей", 1);
	СоветДругогоМастера = Новый СоветДругогоМастера();
	СоветДругогоМастера.ЗначенияДеталек(ЗначенияДеталек);
	СоветДругогоМастера.ИмяФайлаСоЗначениямиДеталек(
		"заведомо-отсутствующие-настройки-singleton-пула");
	Поделка = Новый Поделка(СоветДругогоМастера);
	Поделка.ЗапуститьПриложение();

	ПервыйПул = Поделка.НайтиЖелудь("ПулМенеджеровСущностей");
	ВторойПул = Поделка.НайтиЖелудь("ПулМенеджеровСущностей");
	_Пулы.Добавить(ПервыйПул);
	Если ВторойПул <> ПервыйПул Тогда
		_Пулы.Добавить(ВторойПул);
	КонецЕсли;

	Ожидаем.Что(ПервыйПул = ВторойПул,
		"Все хранилища контекста используют один пул").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьПулНаВременнойБазе()

	Возврат СоздатьПулМенеджеров(НовыйПутьКБД());

КонецФункции

Функция СоздатьПулМенеджеров(ПутьКБД, КоличествоЧитателей = 1, КоличествоПисателей = 1)

	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("litros.ПутьКБД", ПутьКБД);
	ЗначенияДеталек.Вставить("litros.db.ТаймаутЗанятостиМс", 137);
	ЗначенияДеталек.Вставить("litros.db.КоличествоПисателей", КоличествоПисателей);
	ЗначенияДеталек.Вставить("litros.db.КоличествоЧитателей", КоличествоЧитателей);
	ЗначенияДеталек.Вставить("litros.db.ИспользоватьWAL", Ложь);
	СоветДругогоМастера = Новый СоветДругогоМастера();
	СоветДругогоМастера.ЗначенияДеталек(ЗначенияДеталек);
	СоветДругогоМастера.ИмяФайлаСоЗначениямиДеталек("заведомо-отсутствующие-настройки-пула-бд");
	Поделка = Новый Поделка(СоветДругогоМастера);
	Поделка.ЗапуститьПриложение();
	Пул = Поделка.НайтиЖелудь("ПулМенеджеровСущностей");
	_Пулы.Добавить(Пул);
	Рефлектор = Новый Рефлектор();
	Писатели = МенеджерыИзСлотов(Рефлектор.ПолучитьСвойство(Пул, "_СлотыЗаписи"));
	Читатели = МенеджерыИзСлотов(Рефлектор.ПолучитьСвойство(Пул, "_СлотыЧтения"));
	Возврат Новый Структура("Писатели,Читатели", Писатели, Читатели);

КонецФункции

Функция МенеджерыИзСлотов(Слоты)

	Менеджеры = Новый Массив();
	Для Каждого Слот Из Слоты Цикл
		Менеджеры.Добавить(Слот.Менеджер);
	КонецЦикла;

	Возврат Менеджеры;

КонецФункции

Функция ТаблицаСодержит(Таблица, ИмяТаблицы)

	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если СтрокаТаблицы.name = ИмяТаблицы Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция НовыйПутьКБД()

	Возврат _МенеджерВременныхФайлов.НовоеИмяФайла("db");

КонецФункции

#КонецОбласти
