&Тест
Процедура ТестДолжен_ИспользоватьПервыйСлотПриВызовеЭкспортныхФабрикСОднимАргументом() Экспорт

	Завязь = Новый ЗавязьПулМенеджеровСущностей();
	Настройки = Новый НастройкиПулаМенеджеровСущностей();
	Рефлектор = Новый Рефлектор();
	Рефлектор.УстановитьСвойство(Завязь, "_ПутьКБД", НовыйПутьКБД());

	Писатель = Завязь.СоздатьМенеджерЗаписи(Настройки);
	Читатель = Завязь.СоздатьМенеджерЧтения(Настройки);
	СтрокаПисателя = Рефлектор.ПолучитьСвойство(Писатель, "СтрокаСоединенияКоннектора");
	СтрокаЧитателя = Рефлектор.ПолучитьСвойство(Читатель, "СтрокаСоединенияКоннектора");

	Ожидаем.Что(СтрокаПисателя, "Фабрика writer по умолчанию использует слот 1")
		.Содержит("?mode=rw#litros-writer-1;");
	Ожидаем.Что(СтрокаЧитателя, "Фабрика reader по умолчанию использует слот 1")
		.Содержит("?mode=ro#litros-reader-1;");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьИУдалитьСущностьПисателем() Экспорт

	// Подготовка
	Менеджеры = СоздатьПулНаВременнойБазе();
	Писатель = Менеджеры.Писатели[0];
	Сущность = Новый СущностьРепозиторий();
	Сущность.Идентификатор = "writer-repository";
	Сущность.Имя = "writer-repository";

	// Действие
	Писатель.Сохранить(Сущность);
	СохраненнаяСущность = Писатель.ПолучитьОдно(Тип("СущностьРепозиторий"));
	Писатель.Удалить(СохраненнаяСущность);

	// Проверка
	Ожидаем.Что(СохраненнаяСущность, "Писатель сохранил сущность").Не_().ЭтоНеопределено();
	Ожидаем.Что(Писатель.ПолучитьОдно(Тип("СущностьРепозиторий")), "Писатель удалил сущность").ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрочитатьСущностьЧитателем() Экспорт

	// Подготовка
	Менеджеры = СоздатьПулНаВременнойБазе();
	Сущность = Новый СущностьРепозиторий();
	Сущность.Идентификатор = "reader-repository";
	Сущность.Имя = "reader-repository";
	Менеджеры.Писатели[0].Сохранить(Сущность);

	// Действие
	ПрочитаннаяСущность = Менеджеры.Читатели[0].ПолучитьОдно(Тип("СущностьРепозиторий"));

	// Проверка
	Ожидаем.Что(ПрочитаннаяСущность, "Читатель получил сохраненную сущность").Не_().ЭтоНеопределено();
	Ожидаем.Что(ПрочитаннаяСущность.Идентификатор, "Читатель получил исходную сущность").Равно("reader-repository");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗапретитьЗаписьЧерезКоннекторЧитателя() Экспорт

	// Подготовка
	Менеджеры = СоздатьПулНаВременнойБазе();
	Менеджеры.Писатели[0].ПолучитьКоннектор().ВыполнитьЗапрос(
		"CREATE TABLE СущностьРепозиторий (Идентификатор TEXT PRIMARY KEY);");
	Ошибка = Неопределено;

	// Действие
	Попытка
		Менеджеры.Читатели[0].ПолучитьКоннектор().ВыполнитьЗапрос(
			"DELETE FROM СущностьРепозиторий");
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(Ошибка, "Reader физически запрещает запись").Не_().ЭтоНеопределено();

КонецПроцедуры

