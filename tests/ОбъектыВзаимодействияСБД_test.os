#Использовать asserts
#Использовать autumn
#Использовать entity
#Использовать "../src/internal"
#Использовать "../src/db"

Перем _Менеджеры; // Массив
Перем _Коннекторы; // Массив
Перем _КоннекторыСТранзакцией; // Массив
Перем _ПутиКБД; // Массив

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередКаждым() Экспорт

	_Менеджеры = Новый Массив();
	_Коннекторы = Новый Массив();
	_КоннекторыСТранзакцией = Новый Массив();
	_ПутиКБД = Новый Массив();

КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт

	ОшибкаОчистки = Неопределено;
	Для Каждого Коннектор Из _КоннекторыСТранзакцией Цикл
		Попытка
			Коннектор.ОтменитьТранзакцию();
		Исключение
			Если ОшибкаОчистки = Неопределено Тогда
				ОшибкаОчистки = ИнформацияОбОшибке();
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;
	_КоннекторыСТранзакцией.Очистить();

	Для Каждого Коннектор Из _Коннекторы Цикл
		Попытка
			Коннектор.Закрыть();
		Исключение
			Если ОшибкаОчистки = Неопределено Тогда
				ОшибкаОчистки = ИнформацияОбОшибке();
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;
	_Коннекторы.Очистить();

	Для Каждого Менеджер Из _Менеджеры Цикл
		Попытка
			Менеджер.Закрыть();
		Исключение
			Если ОшибкаОчистки = Неопределено Тогда
				ОшибкаОчистки = ИнформацияОбОшибке();
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;
	_Менеджеры.Очистить();
	ВыполнитьСборкуМусора();

	Для Каждого ПутьКБД Из _ПутиКБД Цикл
		Попытка
			УдалитьФайлБД(ПутьКБД);
		Исключение
			Если ОшибкаОчистки = Неопределено Тогда
				ОшибкаОчистки = ИнформацияОбОшибке();
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;
	_ПутиКБД.Очистить();
	Если ОшибкаОчистки <> Неопределено Тогда
		ВызватьИсключение ОшибкаОчистки;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_РаспознатьРеальнуюОшибкуБлокировкиSQLite() Экспорт

	// Подготовка
	ПутьКБД = НовыйПутьКБД();
	СтрокаСоединения = СтрШаблон(
		"DataSource=%1;DefaultTimeout=0;BusyTimeout=50;JournalMode=Delete;",
		ПутьКБД);
	ПервыйКоннектор = СоздатьКоннектор(СтрокаСоединения);
	ВторойКоннектор = СоздатьКоннектор(СтрокаСоединения);
	ПервыйКоннектор.ВыполнитьЗапрос("CREATE TABLE lock_test (id INTEGER PRIMARY KEY);");
	ПервыйКоннектор.НачатьТранзакцию();
	_КоннекторыСТранзакцией.Добавить(ПервыйКоннектор);
	ПервыйКоннектор.ВыполнитьЗапрос("INSERT INTO lock_test (id) VALUES (1);");

	// Действие
	ДанныеОшибки = ПолучитьОшибкуЗаписи(ВторойКоннектор);

	// Проверка
	Ожидаем.Что(ДанныеОшибки <> Неопределено, "Конкурирующая запись завершилась ошибкой блокировки").ЭтоИстина();
	Ожидаем.Что(ДанныеОшибки.Описание, "Провайдер SQLite вернул фактический текст ошибки блокировки").Содержит(
		"database is locked");
	Ожидаем.Что(ДанныеОшибки.Причина, "Внешняя ошибка провайдера не содержит вложенной причины OneScript").ЭтоНеопределено();
	Классификатор = Новый КлассификаторОшибокSQLite();
	Ожидаем.Что(Классификатор.ЭтоВременнаяОшибка(ДанныеОшибки), "Классификатор распознал реальную блокировку SQLite как временную").ЭтоИстина();

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(0)
&ИсточникЗначение(137)
&ИсточникЗначение(2345)
Процедура ТестДолжен_ПрименитьТаймаутЗанятостиSQLite(ТаймаутЗанятостиМс) Экспорт

	// Подготовка
	ПутьКБД = НовыйПутьКБД();

	// Действие
	Менеджер = СоздатьМенеджер(ПутьКБД, ТаймаутЗанятостиМс, Ложь);
	Коннектор = Менеджер.ПолучитьКоннектор();
	Результат = Коннектор.ВыполнитьЗапрос("PRAGMA busy_timeout;");
	СтрокаСоединения = Коннектор.Соединение.СтрокаСоединения;

	// Проверка
	Ожидаем.Что(Результат[0].timeout, "SQLite применил заданный таймаут занятости в миллисекундах").Равно(ТаймаутЗанятостиМс);
	Ожидаем.Что(СтрокаСоединения, "Строка соединения содержит точные параметры ожидания и режима журнала").Равно(
		СтрШаблон(
			"DataSource=%1;DefaultTimeout=0;BusyTimeout=%2;JournalMode=Delete;",
			ПутьКБД,
			Формат(ТаймаутЗанятостиМс, "ЧН=0; ЧГ=")));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВключитьWALДоИнициализацииТаблиц() Экспорт

	// Подготовка
	ПутьКБД = НовыйПутьКБД();

	// Действие
	Менеджер = СоздатьМенеджер(ПутьКБД, 137, Истина);
	Коннектор = Менеджер.ПолучитьКоннектор();
	РежимЖурнала = Коннектор.ВыполнитьЗапрос("PRAGMA journal_mode;");
	СостояниеЖурнала = Коннектор.ВыполнитьЗапрос("PRAGMA wal_checkpoint(PASSIVE);");

	// Проверка
	Ожидаем.Что(НРег(РежимЖурнала[0].journal_mode), "SQLite работает в режиме WAL").Равно("wal");
	Ожидаем.Что(СостояниеЖурнала[0].log > 0, "Таблицы приложения созданы после включения WAL").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтключитьРанееВключенныйWAL() Экспорт

	// Подготовка
	ПутьКБД = НовыйПутьКБД();
	МенеджерWAL = СоздатьМенеджер(ПутьКБД, 137, Истина);
	РежимWAL = МенеджерWAL.ПолучитьКоннектор().ВыполнитьЗапрос("PRAGMA journal_mode;");
	ЗакрытьМенеджер(МенеджерWAL);

	// Действие
	МенеджерDelete = СоздатьМенеджер(ПутьКБД, 137, Ложь);
	РежимDelete = МенеджерDelete.ПолучитьКоннектор().ВыполнитьЗапрос("PRAGMA journal_mode;");

	// Проверка
	Ожидаем.Что(НРег(РежимWAL[0].journal_mode), "Перед отключением база действительно была в режиме WAL").Равно("wal");
	Ожидаем.Что(НРег(РежимDelete[0].journal_mode), "Настройка Ложь вернула постоянную базу из WAL в DELETE").Равно("delete");

КонецПроцедуры

&ПараметризованныйТест
&ИсточникЗначение(-1)
&ИсточникЗначение(1.5)
&ИсточникЗначение(2147483648)
&ИсточникЗначение("не число")
Процедура ТестДолжен_ОтклонитьНекорректныйТаймаутДоОткрытияБД(ТаймаутЗанятостиМс) Экспорт

	// Подготовка
	Настройки = Новый НастройкиОтказоустойчивостиБД();
	Настройки.ТаймаутЗанятостиМс = ТаймаутЗанятостиМс;
	ОбъектыВзаимодействия = Новый ОбъектыВзаимодействияСБД();

	// Действие
	ДанныеОшибки = ПолучитьОшибкуСозданияМенеджера(ОбъектыВзаимодействия, Настройки);

	// Проверка
	Ожидаем.Что(ДанныеОшибки <> Неопределено, "Некорректный таймаут отклонен исключением").ЭтоИстина();
	Ожидаем.Что(ДанныеОшибки.Описание, "Ошибка объясняет допустимый диапазон и тип таймаута").Содержит(
		"litros.db.ТаймаутЗанятостиМс должна быть целым числом от 0 до 2147483647");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьМенеджер(ПутьКБД, ТаймаутЗанятостиМс, ИспользоватьWAL)

	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("litros.ПутьКБД", ПутьКБД);
	ЗначенияДеталек.Вставить("litros.db.ТаймаутЗанятостиМс", ТаймаутЗанятостиМс);
	ЗначенияДеталек.Вставить("litros.db.ИспользоватьWAL", ИспользоватьWAL);
	СоветДругогоМастера = Новый СоветДругогоМастера();
	СоветДругогоМастера.ЗначенияДеталек(ЗначенияДеталек);
	СоветДругогоМастера.ИмяФайлаСоЗначениямиДеталек("заведомо-отсутствующие-настройки-объектов-бд");
	Поделка = Новый Поделка(СоветДругогоМастера);
	Поделка.ЗапуститьПриложение();
	Менеджер = Поделка.НайтиЖелудь("ВнутреннийМенеджерСущностей");
	Если Менеджер <> Неопределено Тогда
		_Менеджеры.Добавить(Менеджер);
	КонецЕсли;

	Возврат Менеджер;

КонецФункции

Функция ПолучитьОшибкуСозданияМенеджера(ОбъектыВзаимодействия, Настройки)

	ДанныеОшибки = Неопределено;
	Попытка
		ОбъектыВзаимодействия.ВнутреннийМенеджерСущностей(Настройки);
	Исключение
		ДанныеОшибки = ИнформацияОбОшибке();
	КонецПопытки;

	Возврат ДанныеОшибки;

КонецФункции

Процедура ЗакрытьМенеджер(Менеджер)

	Менеджер.Закрыть();
	Индекс = _Менеджеры.Найти(Менеджер);
	Если Индекс <> Неопределено Тогда
		_Менеджеры.Удалить(Индекс);
	КонецЕсли;

КонецПроцедуры

Функция СоздатьКоннектор(СтрокаСоединения)

	Коннектор = Новый КоннекторSQLite();
	Коннектор.Открыть(СтрокаСоединения, Новый Массив());
	_Коннекторы.Добавить(Коннектор);
	Возврат Коннектор;

КонецФункции

Функция ПолучитьОшибкуЗаписи(Коннектор)

	ДанныеОшибки = Неопределено;
	Попытка
		Коннектор.ВыполнитьЗапрос("INSERT INTO lock_test (id) VALUES (2);");
	Исключение
		ДанныеОшибки = ИнформацияОбОшибке();
	КонецПопытки;

	Возврат ДанныеОшибки;

КонецФункции

Функция НовыйПутьКБД()

	ПутьКБД = ПолучитьИмяВременногоФайла("db");
	_ПутиКБД.Добавить(ПутьКБД);
	Возврат ПутьКБД;

КонецФункции

Процедура УдалитьФайлБД(ПутьКБД)

	Пути = Новый Массив();
	Пути.Добавить(ПутьКБД);
	Пути.Добавить(ПутьКБД + "-wal");
	Пути.Добавить(ПутьКБД + "-shm");
	Для Каждого Путь Из Пути Цикл
		Если Новый Файл(Путь).Существует() Тогда
			УдалитьФайлы(Путь);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
