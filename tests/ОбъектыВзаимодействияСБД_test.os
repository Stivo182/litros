#Использовать asserts
#Использовать autumn
#Использовать entity
#Использовать tempfiles
#Использовать "../src/internal"
#Использовать "../src/db"

Перем _Менеджеры; // Массив
Перем _Коннекторы; // Массив
Перем _КоннекторыСТранзакцией; // Массив
Перем _МенеджерВременныхФайлов; // МенеджерВременныхФайлов

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередКаждым() Экспорт

	_Менеджеры = Новый Массив();
	_Коннекторы = Новый Массив();
	_КоннекторыСТранзакцией = Новый Массив();
	_МенеджерВременныхФайлов = Новый МенеджерВременныхФайлов();
	_МенеджерВременныхФайлов.БазовыйКаталог = _МенеджерВременныхФайлов.СоздатьКаталог();

КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт

	ОшибкаОчистки = Неопределено;
	Для Каждого Коннектор Из _КоннекторыСТранзакцией Цикл
		Попытка
			Коннектор.ОтменитьТранзакцию();
		Исключение
			Если ОшибкаОчистки = Неопределено Тогда
				ОшибкаОчистки = ИнформацияОбОшибке();
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;
	_КоннекторыСТранзакцией.Очистить();

	Для Каждого Коннектор Из _Коннекторы Цикл
		Попытка
			Коннектор.Закрыть();
		Исключение
			Если ОшибкаОчистки = Неопределено Тогда
				ОшибкаОчистки = ИнформацияОбОшибке();
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;
	_Коннекторы.Очистить();

	Для Каждого Менеджер Из _Менеджеры Цикл
		Попытка
			Менеджер.Закрыть();
		Исключение
			Если ОшибкаОчистки = Неопределено Тогда
				ОшибкаОчистки = ИнформацияОбОшибке();
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;
	_Менеджеры.Очистить();
	ВыполнитьСборкуМусора();

	_МенеджерВременныхФайлов.Удалить();
	Если ОшибкаОчистки <> Неопределено Тогда
		ВызватьИсключение ОшибкаОчистки;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_РаспознатьРеальнуюОшибкуБлокировкиSQLite() Экспорт

	// Подготовка
	ПутьКБД = НовыйПутьКБД();
	СтрокаСоединения = СтрШаблон(
		"DataSource=%1;DefaultTimeout=0;BusyTimeout=50;JournalMode=Delete;",
		ПутьКБД);
	ПервыйКоннектор = СоздатьКоннектор(СтрокаСоединения);
	ВторойКоннектор = СоздатьКоннектор(СтрокаСоединения);
	ПервыйКоннектор.ВыполнитьЗапрос("CREATE TABLE lock_test (id INTEGER PRIMARY KEY);");
	ПервыйКоннектор.НачатьТранзакцию();
	_КоннекторыСТранзакцией.Добавить(ПервыйКоннектор);
	ПервыйКоннектор.ВыполнитьЗапрос("INSERT INTO lock_test (id) VALUES (1);");

	// Действие
	ДанныеОшибки = ПолучитьОшибкуЗаписи(ВторойКоннектор);

	// Проверка
	Ожидаем.Что(ДанныеОшибки <> Неопределено, "Конкурирующая запись завершилась ошибкой блокировки").ЭтоИстина();
	Ожидаем.Что(ДанныеОшибки.Описание, "Провайдер SQLite вернул фактический текст ошибки блокировки").Содержит(
		"database is locked");
	Ожидаем.Что(ДанныеОшибки.Причина, "Внешняя ошибка провайдера не содержит вложенной причины OneScript").ЭтоНеопределено();
	Классификатор = Новый КлассификаторОшибокSQLite();
	Ожидаем.Что(Классификатор.ЭтоВременнаяОшибка(ДанныеОшибки), "Классификатор распознал реальную блокировку SQLite как временную").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьВсеТаблицыBootstrapМенеджером() Экспорт

	// Подготовка
	ПутьКБД = НовыйПутьКБД();

	// Действие
	Менеджеры = СоздатьПулМенеджеров(ПутьКБД);
	Таблицы = Менеджеры.Писатели[0].ПолучитьКоннектор().ВыполнитьЗапрос(
		"SELECT name FROM sqlite_master WHERE type = 'table';");

	// Проверка
	Ожидаем.Что(ТаблицаСодержит(Таблицы, "ОчередьПакетов"), "Создана таблица очереди пакета").ЭтоИстина();
	Ожидаем.Что(ТаблицаСодержит(Таблицы, "СтатистикаПакетов"), "Создана таблица статистики пакета").ЭтоИстина();
	Ожидаем.Что(ТаблицаСодержит(Таблицы, "ЗависимыеРепозитории"), "Создана таблица зависимого репозитория").ЭтоИстина();
	Ожидаем.Что(ТаблицаСодержит(Таблицы, "Репозитории"), "Создана таблица репозитория").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьИУдалитьСущностьПисателем() Экспорт

	// Подготовка
	Менеджеры = СоздатьПулНаВременнойБазе();
	Писатель = Менеджеры.Писатели[0];
	Сущность = Новый СущностьРепозиторий();
	Сущность.Идентификатор = "writer-repository";
	Сущность.Имя = "writer-repository";

	// Действие
	Писатель.Сохранить(Сущность);
	СохраненнаяСущность = Писатель.ПолучитьОдно(Тип("СущностьРепозиторий"));
	Писатель.Удалить(СохраненнаяСущность);

	// Проверка
	Ожидаем.Что(СохраненнаяСущность, "Писатель сохранил сущность").Не_().ЭтоНеопределено();
	Ожидаем.Что(Писатель.ПолучитьОдно(Тип("СущностьРепозиторий")), "Писатель удалил сущность").ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПрочитатьСущностьЧитателем() Экспорт

	// Подготовка
	Менеджеры = СоздатьПулНаВременнойБазе();
	Сущность = Новый СущностьРепозиторий();
	Сущность.Идентификатор = "reader-repository";
	Сущность.Имя = "reader-repository";
	Менеджеры.Писатели[0].Сохранить(Сущность);

	// Действие
	ПрочитаннаяСущность = Менеджеры.Читатели[0].ПолучитьОдно(Тип("СущностьРепозиторий"));

	// Проверка
	Ожидаем.Что(ПрочитаннаяСущность, "Читатель получил сохраненную сущность").Не_().ЭтоНеопределено();
	Ожидаем.Что(ПрочитаннаяСущность.Идентификатор, "Читатель получил исходную сущность").Равно("reader-repository");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗапретитьЗаписьЧерезКоннекторЧитателя() Экспорт

	// Подготовка
	Менеджеры = СоздатьПулНаВременнойБазе();
	Менеджеры.Писатели[0].ПолучитьКоннектор().ВыполнитьЗапрос(
		"CREATE TABLE СущностьРепозиторий (Идентификатор TEXT PRIMARY KEY);");
	Ошибка = Неопределено;

	// Действие
	Попытка
		Менеджеры.Читатели[0].ПолучитьКоннектор().ВыполнитьЗапрос(
			"DELETE FROM СущностьРепозиторий");
	Исключение
		Ошибка = ИнформацияОбОшибке();
	КонецПопытки;

	// Проверка
	Ожидаем.Что(Ошибка, "Reader физически запрещает запись").Не_().ЭтоНеопределено();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОткрытьЧитателейТолькоПослеИнициализацииСхемы() Экспорт

	// Подготовка
	ПутьКБД = НовыйПутьКБД();

	// Действие
	Менеджеры = СоздатьПулМенеджеров(ПутьКБД);
	Результат = Менеджеры.Читатели[0].ПолучитьКоннектор().ВыполнитьЗапрос("SELECT 1 AS Проверка;");

	// Проверка
	Ожидаем.Что(Результат[0].Проверка, "Читатель открыт после bootstrap-инициализации схемы").Равно(1);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьРазныеЭкземплярыЧитателяИПисателя() Экспорт

	// Действие
	Менеджеры = СоздатьПулНаВременнойБазе();

	// Проверка
	Ожидаем.Что(Менеджеры.Писатели[0] = Менеджеры.Читатели[0], "Запрошенные R/W используют разные менеджеры").ЭтоЛожь();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьПулНаВременнойБазе()

	Возврат СоздатьПулМенеджеров(НовыйПутьКБД());

КонецФункции

Функция СоздатьПулМенеджеров(ПутьКБД)

	ЗначенияДеталек = Новый Соответствие();
	ЗначенияДеталек.Вставить("litros.ПутьКБД", ПутьКБД);
	ЗначенияДеталек.Вставить("litros.db.ТаймаутЗанятостиМс", 137);
	ЗначенияДеталек.Вставить("litros.db.КоличествоПисателей", 1);
	ЗначенияДеталек.Вставить("litros.db.КоличествоЧитателей", 1);
	ЗначенияДеталек.Вставить("litros.db.ИспользоватьWAL", Ложь);
	СоветДругогоМастера = Новый СоветДругогоМастера();
	СоветДругогоМастера.ЗначенияДеталек(ЗначенияДеталек);
	СоветДругогоМастера.ИмяФайлаСоЗначениямиДеталек("заведомо-отсутствующие-настройки-пула-бд");
	Поделка = Новый Поделка(СоветДругогоМастера);
	Поделка.ЗапуститьПриложение();
	Менеджеры = Поделка.НайтиЖелудь("МенеджерыПулаСущностей");
	ДобавитьМенеджерыВОчистку(Менеджеры);

	Возврат Менеджеры;

КонецФункции

Процедура ДобавитьМенеджерыВОчистку(Менеджеры)

	Для Каждого Менеджер Из Менеджеры.Писатели Цикл
		_Менеджеры.Добавить(Менеджер);
	КонецЦикла;
	Для Каждого Менеджер Из Менеджеры.Читатели Цикл
		_Менеджеры.Добавить(Менеджер);
	КонецЦикла;

КонецПроцедуры

Функция ТаблицаСодержит(Таблица, ИмяТаблицы)

	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если СтрокаТаблицы.name = ИмяТаблицы Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Процедура ЗакрытьМенеджер(Менеджер)

	Менеджер.Закрыть();
	Индекс = _Менеджеры.Найти(Менеджер);
	Если Индекс <> Неопределено Тогда
		_Менеджеры.Удалить(Индекс);
	КонецЕсли;

КонецПроцедуры

Функция СоздатьКоннектор(СтрокаСоединения)

	Коннектор = Новый КоннекторSQLite();
	Коннектор.Открыть(СтрокаСоединения, Новый Массив());
	_Коннекторы.Добавить(Коннектор);
	Возврат Коннектор;

КонецФункции

Функция ПолучитьОшибкуЗаписи(Коннектор)

	ДанныеОшибки = Неопределено;
	Попытка
		Коннектор.ВыполнитьЗапрос("INSERT INTO lock_test (id) VALUES (2);");
	Исключение
		ДанныеОшибки = ИнформацияОбОшибке();
	КонецПопытки;

	Возврат ДанныеОшибки;

КонецФункции

Функция НовыйПутьКБД()

	Возврат _МенеджерВременныхФайлов.НовоеИмяФайла("db");

КонецФункции

#КонецОбласти
