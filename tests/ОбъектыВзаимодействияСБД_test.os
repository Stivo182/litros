#Использовать asserts
#Использовать autumn
#Использовать entity
#Использовать tempfiles
#Использовать "../src/internal"
#Использовать "../src/db"

Перем _Пулы; // Массив
Перем _МенеджерВременныхФайлов; // МенеджерВременныхФайлов

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта()

КонецПроцедуры

#Область ОбработчикиСобытий

&ПередКаждым
Процедура ПередКаждым() Экспорт

	_Пулы = Новый Массив();
	_МенеджерВременныхФайлов = Новый МенеджерВременныхФайлов();
	_МенеджерВременныхФайлов.БазовыйКаталог = _МенеджерВременныхФайлов.СоздатьКаталог();

КонецПроцедуры

&ПослеКаждого
Процедура ПослеКаждого() Экспорт

	ОшибкаОчистки = Неопределено;
	Для Каждого Пул Из _Пулы Цикл
		Попытка
			Пул.Закрыть();
		Исключение
			Если ОшибкаОчистки = Неопределено Тогда
				ОшибкаОчистки = ИнформацияОбОшибке();
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;
	_Пулы.Очистить();
	ВыполнитьСборкуМусора();

	_МенеджерВременныхФайлов.Удалить();
	Если ОшибкаОчистки <> Неопределено Тогда
		ВызватьИсключение ОшибкаОчистки;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область Тесты

&Тест
Процедура ТестДолжен_СоздатьВсеТаблицыBootstrapМенеджером() Экспорт

	// Подготовка
	ПутьКБД = НовыйПутьКБД();

	// Действие
	Менеджеры = СоздатьПулМенеджеров(ПутьКБД);
	Таблицы = Менеджеры.Писатели[0].ПолучитьКоннектор().ВыполнитьЗапрос(
		"SELECT name FROM sqlite_master WHERE type = 'table';");

	// Проверка
	Ожидаем.Что(ТаблицаСодержит(Таблицы, "ОчередьПакетов"), "Создана таблица очереди пакета").ЭтоИстина();
	Ожидаем.Что(ТаблицаСодержит(Таблицы, "СтатистикаПакетов"), "Создана таблица статистики пакета").ЭтоИстина();
	Ожидаем.Что(ТаблицаСодержит(Таблицы, "ЗависимыеРепозитории"), "Создана таблица зависимого репозитория").ЭтоИстина();
	Ожидаем.Что(ТаблицаСодержит(Таблицы, "Репозитории"), "Создана таблица репозитория").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОткрытьBootstrapБазуЧерезРабочийСлотДляПутиСПаттерномPercentHH() Экспорт

	ПутьКБД = (Новый Файл(НовыйПутьКБД())).Путь + "base%41.db";
	Менеджеры = СоздатьПулМенеджеров(ПутьКБД);

	Таблицы = Менеджеры.Писатели[0].ПолучитьКоннектор().ВыполнитьЗапрос(
		"SELECT name FROM sqlite_master WHERE type = 'table';");

	Ожидаем.Что(ТаблицаСодержит(Таблицы, "ОчередьПакетов"),
		"Рабочий слот открыл ту же базу, которую инициализировал bootstrap").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОткрытьНастроеннуюSQLiteБазуДляПутиСТочкойСЗапятой() Экспорт

	КаталогБД = (Новый Файл(НовыйПутьКБД())).Путь;
	ПутьКБД = КаталогБД + "base;semi.db";
	УсеченныйПутьКБД = КаталогБД + "base";

	Менеджеры = СоздатьПулМенеджеров(ПутьКБД);
	Результат = Менеджеры.Писатели[0].ПолучитьКоннектор().ВыполнитьЗапрос("SELECT 1 AS Проверка;");

	Ожидаем.Что(Результат[0].Проверка, "Рабочий слот выполнил запрос").Равно(1);
	Ожидаем.Что(Новый Файл(ПутьКБД).Существует(), "Создан настроенный файл SQLite").ЭтоИстина();
	Ожидаем.Что(Новый Файл(УсеченныйПутьКБД).Существует(), "Не создан усеченный sibling-файл").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ТестДолжен_СформироватьSQLiteURIСЧетырьмяСлешамиДляUNCПути() Экспорт

	Завязь = Новый ЗавязьПулМенеджеровСущностей();
	Настройки = Новый НастройкиПулаМенеджеровСущностей();
	Рефлектор = Новый Рефлектор();
	Рефлектор.УстановитьСвойство(Завязь, "_ПутьКБД", "\\server\share\path.db");

	Менеджер = Завязь.СоздатьМенеджерЗаписи(Настройки, 7);
	СтрокаСоединения = Рефлектор.ПолучитьСвойство(Менеджер, "СтрокаСоединенияКоннектора");

	Ожидаем.Что(СтрокаСоединения, "UNC URI содержит четыре слеша после file:")
		.Содержит("FullUri=file:////server/share/path.db?mode=rw#litros-writer-7;");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОднократноЭкранироватьВопросИРешеткуВПутиSQLite() Экспорт

	Завязь = Новый ЗавязьПулМенеджеровСущностей();
	Настройки = Новый НастройкиПулаМенеджеровСущностей();
	Рефлектор = Новый Рефлектор();
	Рефлектор.УстановитьСвойство(Завязь, "_ПутьКБД", "C:\sqlite-uri\base?query#fragment.db");

	Менеджер = Завязь.СоздатьМенеджерЗаписи(Настройки, 9);
	СтрокаСоединения = Рефлектор.ПолучитьСвойство(Менеджер, "СтрокаСоединенияКоннектора");

	Ожидаем.Что(СтрокаСоединения, "Вопрос и решетка экранированы до query и fragment SQLite")
		.Содержит("FullUri=file:///C:/sqlite-uri/base%3fquery%23fragment.db?mode=rw#litros-writer-9;");
	Ожидаем.Что(СтрокаСоединения, "Вопрос не закодирован повторно").Не_().Содержит("%253f");
	Ожидаем.Что(СтрокаСоединения, "Решетка не закодирована повторно").Не_().Содержит("%2523");

КонецПроцедуры

